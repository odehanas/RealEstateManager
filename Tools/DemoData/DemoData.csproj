<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds the fictional demo company used for the help screenshots, in a LOCAL SQL Server
    LocalDB database called RemDemo. It never touches the live database: the connection
    string is fixed to (localdb)\ClaudeREM in Program.cs.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\RealEstateManager.csproj" />
  </ItemGroup>
</Project>
