<?xml version="1.0" encoding="utf-8"?>
<!--
  Project-level web.config.

  Until now this file did not exist, so the .NET SDK generated one from scratch on
  every publish and any edit made on the server was silently discarded by the next
  deployment. With this file in the project, the SDK MERGES instead: it rewrites
  processPath and arguments to match the built output and leaves everything else
  here intact. Anything you add below now survives deployments.

  DIAGNOSTICS
    To capture startup failures (HTTP 500.30), set stdoutLogEnabled="true" and make
    sure a "logs" folder exists next to the deployed application. Turn it back off
    afterwards - the log file grows without limit.

    The commented-out environmentVariables block below makes ASP.NET Core return a
    full exception page instead of a generic 500. Uncomment it ONLY while
    diagnosing: in Development mode the site publishes stack traces, including
    database errors, to anyone who visits it.

    For a one-off investigation it is still faster to edit web.config directly on
    the server through the hosting control panel. Just remember the next deployment
    resets it to whatever this file says.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <aspNetCore processPath="dotnet"
                  arguments=".\RealEstateManager.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <!--
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Development" />
          <environmentVariable name="ASPNETCORE_DETAILEDERRORS" value="true" />
        </environmentVariables>
        -->
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
