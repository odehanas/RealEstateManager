@model List<RealEstateManager.Domain.EmployeeRequest>
@using RealEstateManager.Domain
@{
    ViewData["Title"] = "Employee Requests";
    var status = (string)ViewBag.Status;
}

<h2>Employee Requests</h2>
<p class="text-muted">Certificates and letters employees asked for in the employee portal (/me). Issuing gives the letter a reference number; the employee then prints it from their phone.</p>

@if (TempData["HrSuccess"] is string ok) { <div class="alert alert-success">@ok</div> }
@if (TempData["HrError"] is string err) { <div class="alert alert-danger">@err</div> }

<div class="btn-group mb-3">
    @foreach (var s in new[] { EmployeeRequestStatuses.Pending, EmployeeRequestStatuses.Issued, EmployeeRequestStatuses.Declined, "All" })
    {
        <a asp-action="Index" asp-route-status="@s" class="btn btn-sm @(s == status ? "btn-dark" : "btn-outline-dark")">@s</a>
    }
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light"><tr><th>Asked</th><th>Employee</th><th>Document</th><th>Addressed to</th><th>Purpose</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @if (Model.Count == 0) { <tr><td colspan="7" class="text-muted text-center py-3">Nothing here.</td></tr> }
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.RequestedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                    <td>@r.Employee?.EmployeeCode @r.Employee?.FullName</td>
                    <td>@EmployeeRequestTypes.Describe(r.RequestType)</td>
                    <td>@r.AddressedTo</td>
                    <td>@r.Purpose</td>
                    <td>@r.Status @if (r.DecidedByName != null) { <div class="small text-muted">@r.DecidedByName · @r.ReferenceNumber @r.Comment</div> }</td>
                    <td class="text-end text-nowrap">
                        @if (r.Status == EmployeeRequestStatuses.Pending)
                        {
                            <form asp-action="Issue" asp-route-id="@r.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-sm btn-success">Issue</button></form>
                            <form asp-action="Decline" asp-route-id="@r.Id" method="post" class="d-inline-flex gap-1">
                                @Html.AntiForgeryToken()
                                <input name="comment" class="form-control form-control-sm" placeholder="Reason" style="width:140px" />
                                <button class="btn btn-sm btn-outline-danger">Decline</button>
                            </form>
                        }
                        else if (r.Status == EmployeeRequestStatuses.Issued)
                        {
                            <a asp-action="Certificate" asp-route-id="@r.Id" target="_blank" class="btn btn-sm btn-outline-primary">Print</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
