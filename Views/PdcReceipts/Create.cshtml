@model RealEstateManager.Models.PdcReceiptCreateViewModel
@using RealEstateManager.Domain

@{
    ViewData["Title"] = T["Receive PDC"];
    var leases = ViewBag.Leases as List<Lease> ?? new();
    var invoices = ViewBag.Invoices as List<CustomerInvoice> ?? new();
    var selectedLeaseId = ViewBag.SelectedLeaseId as int?;
    var selectedInvoiceId = ViewBag.SelectedInvoiceId as int?;
}

<h2>@T["Receive PDC"]</h2>

<div class="alert alert-info">
    @T.Html("Use <strong>Advance</strong> when the cheque is still only a noted item for future collection. Use <strong>Receivable</strong> only when the cheque is linked to an outstanding invoice and should settle A/R once cleared.")
</div>

@if (Model.ReplacesPdcId.HasValue)
{
    <div class="alert alert-warning">
        This cheque replaces cheque <strong>@Model.ReplacesChequeNumber</strong>, which will be marked <strong>Replaced</strong> once this one is saved.
    </div>
}

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="ReplacesPdcId" type="hidden" />
    <input asp-for="ReplacesChequeNumber" type="hidden" />

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="LeaseId" class="form-label">@T["Lease"]</label>
            <select asp-for="LeaseId" class="form-select">
                <option value="">@T["Select Lease"]</option>
                @foreach (var lease in leases)
                {
                    var isSelected = Model.LeaseId == lease.Id || selectedLeaseId == lease.Id;
                    <option value="@lease.Id" selected="@(isSelected ? "selected" : null)">
                        @lease.ContractNumber - @lease.Tenant?.FullName - @lease.Unit?.Property?.Code/@lease.Unit?.UnitNumber
                    </option>
                }
            </select>
        </div>

        <div class="col-md-6">
            <label asp-for="CustomerInvoiceId" class="form-label">@T["Invoice (Optional)"]</label>
            <select asp-for="CustomerInvoiceId" class="form-select">
                <option value="">@T["No linked invoice"]</option>
                @foreach (var invoice in invoices)
                {
                    var outstanding = invoice.TotalAmount - invoice.AmountPaid;
                    var isSelected = Model.CustomerInvoiceId == invoice.Id || selectedInvoiceId == invoice.Id;

                    <option value="@invoice.Id" selected="@(isSelected ? "selected" : null)">
                        @invoice.InvoiceNumber - @invoice.Lease?.Tenant?.FullName - @invoice.Lease?.Unit?.Property?.Code/@invoice.Lease?.Unit?.UnitNumber - Outstanding: @outstanding.ToString("N2")
                    </option>
                }
            </select>
            <small class="text-muted">@T["Required only when settlement mode is Receivable."]</small>
        </div>

        <div class="col-md-4">
            <label asp-for="ChequeNumber" class="form-label"></label>
            <input asp-for="ChequeNumber" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="BankName" class="form-label"></label>
            <input asp-for="BankName" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="SettlementMode" class="form-label">@T["Settlement Mode"]</label>
            <select asp-for="SettlementMode" class="form-select">
                <option>@T["Advance"]</option>
                <option>@T["Receivable"]</option>
            </select>
        </div>

        <div class="col-md-3">
            <label asp-for="ChequeDate" class="form-label">@T["Cheque Date"]</label>
            <input asp-for="ChequeDate" type="date" class="form-control" />
            <div class="form-text">
                @T.Html("The future date written on the cheque. <strong>Does not affect the accounts.</strong>")
            </div>
            <span asp-validation-for="ChequeDate" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="ReceivedDate" class="form-label">@T["Received Date — accounting date"]</label>
            <input asp-for="ReceivedDate" type="date" class="form-control" />
            <div class="form-text">
                @T.Html("The day the cheque was handed to you. <strong>This is the date the entry posts on</strong> and when it appears in the Trial Balance.")
            </div>
            <span asp-validation-for="ReceivedDate" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="Amount" class="form-label"></label>
            <input asp-for="Amount" class="form-control" />
        </div>

        <div class="col-md-12">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-dark">@T["Save and Receive"]</button>
        <a asp-action="Index" class="btn btn-outline-secondary">@T["Back"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}