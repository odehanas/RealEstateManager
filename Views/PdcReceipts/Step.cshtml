@model RealEstateManager.Models.PdcStepViewModel
@using RealEstateManager.Models
@using RealEstateManager.Domain

@{
    ViewData["Title"] = Model.Title;
    var deposited = Model.Status == PdcStatuses.Deposited;
}

<h2>@Model.Title</h2>

@switch (Model.Kind)
{
    case PdcStepViewModel.Deposit:
        <div class="alert alert-info">
            @T.HtmlFormat("The cheque leaves the drawer and goes to the bank for collection. The memorandum entry is reversed and the tenant is credited now: <code>Dr Cheques Under Collection / Cr {0}</code>. When the bank clears it, <strong>Clear</strong> moves it into the bank; if the bank returns it, <strong>Bounced</strong> charges it back.", Model.SettlementMode == "Receivable" ? T["Accounts Receivable"] : "Advances from Customers")
        </div>
        break;
    case PdcStepViewModel.Bounce:
        <div class="alert alert-danger">
            @if (deposited)
            {
                <text>@T.HtmlFormat("The bank returned the cheque unpaid. The amount is charged back to the tenant: <code>Dr {0} / Cr Cheques Under Collection</code>{1}.", Model.SettlementMode == "Receivable" ? T["Accounts Receivable"] : "Advances from Customers", Model.SettlementMode == "Receivable" ? ", and the invoice is open again" : "")</text>
            }
            else
            {
                <text>This cheque was never deposited here, so the tenant was not credited for it. Recording it as bounced only
                reverses the memorandum entry; the rent stays owed.</text>
            }
            The tenant is held as having a returned cheque (maintenance requests are blocked) until it is replaced.
        </div>
        break;
    case PdcStepViewModel.Withdraw:
        <div class="alert alert-warning">
            @T.HtmlFormat("The tenant takes the cheque back before it is deposited. The memorandum entry is reversed and the cheque stays in the register as <strong>Withdrawn</strong>. {0} The charge below is raised to the tenant as a tax invoice.", Model.SettlementMode == "Receivable" ? T["The invoice it was for stays open."] : "")
        </div>
        break;
}

<form asp-action="Step" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="PdcReceiptId" type="hidden" />
    <input asp-for="Kind" type="hidden" />

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-3"><label class="form-label">@T["Cheque number"]</label><input class="form-control" value="@Model.ChequeNumber" readonly /></div>
        <div class="col-md-3"><label class="form-label">@T["Bank"]</label><input class="form-control" value="@Model.BankName" readonly /></div>
        <div class="col-md-3"><label class="form-label">@T["Amount"]</label><input class="form-control" value="@Model.Amount.ToString("N2")" readonly /></div>
        <div class="col-md-3"><label class="form-label">@T["Status"]</label><input class="form-control" value="@PdcStatuses.Describe(Model.Status)" readonly /></div>
        <div class="col-md-6"><label class="form-label">@T["Lease"]</label><input class="form-control" value="@Model.LeaseDisplay" readonly /></div>
        <div class="col-md-2"><label class="form-label">@T["Invoice"]</label><input class="form-control" value="@Model.InvoiceDisplay" readonly /></div>
        <div class="col-md-2"><label class="form-label">@T["Cheque date"]</label><input class="form-control" value="@Model.ChequeDate.ToString("dd/MM/yyyy")" readonly /></div>
        <div class="col-md-2"><label class="form-label">@(Model.DepositedDate.HasValue ? T["Deposited"] : T["Received"])</label><input class="form-control" value="@((Model.DepositedDate ?? Model.ReceivedDate).ToString("dd/MM/yyyy"))" readonly /></div>

        <div class="col-md-3">
            <label asp-for="StepDate" class="form-label">
                @T.Format("{0} — accounting date", Model.Kind switch { PdcStepViewModel.Bounce => "Date returned", PdcStepViewModel.Withdraw => "Date withdrawn", _ => "Date deposited" })
            </label>
            <input asp-for="StepDate" type="date" class="form-control" />
        </div>

        @if (Model.TakesCharge)
        {
            <div class="col-md-3">
                <label asp-for="Charge" class="form-label">@T["Charge to tenant (before VAT)"]</label>
                <input asp-for="Charge" type="number" step="0.01" min="0" class="form-control" id="charge" />
                <div class="form-text" id="chargeTotal"></div>
            </div>
            <div class="col-md-6">
                <label asp-for="Reason" class="form-label">@(Model.Kind == PdcStepViewModel.Bounce ? T["Reason given by the bank"] : T["Note"])</label>
                <input asp-for="Reason" class="form-control" maxlength="300"
                       placeholder="@(Model.Kind == PdcStepViewModel.Bounce ? "e.g. insufficient funds, signature mismatch" : "e.g. tenant to pay by bank transfer")" />
            </div>
        }
    </div>

    <div class="mt-4">
        <button type="submit" class="btn @(Model.Kind == PdcStepViewModel.Bounce ? "btn-danger" : "btn-dark")">
            @(Model.Kind switch { PdcStepViewModel.Bounce => "Record Bounce and Post", PdcStepViewModel.Withdraw => "Withdraw and Post", _ => "Deposit and Post" })
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">@T["Back"]</a>
    </div>
</form>

@if (Model.TakesCharge)
{
    <script>
        (function () {
            var input = document.getElementById('charge'), out = document.getElementById('chargeTotal'), rate = @Model.VatRate.ToString(System.Globalization.CultureInfo.InvariantCulture);
            function show() {
                var net = parseFloat(input.value) || 0, vat = Math.round(net * rate) / 100;
                out.textContent = net <= 0 ? 'No charge will be raised.'
                    : (rate > 0 ? 'Plus VAT ' + vat.toFixed(2) + ' = ' + (net + vat).toFixed(2) + ' on a tax invoice.' : 'Invoiced without VAT.');
            }
            input.addEventListener('input', show); show();
        })();
    </script>
}
