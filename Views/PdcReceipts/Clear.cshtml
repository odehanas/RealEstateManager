@model RealEstateManager.Models.PdcClearViewModel

@{
    ViewData["Title"] = T["Clear PDC"];
}

<h2>@T["Clear PDC"]</h2>

@if (Model.DepositedDate.HasValue)
{
    <div class="alert alert-info">
        @T.HtmlFormat("This cheque was deposited on <strong>{0}</strong> and the tenant was credited then. Clearing it moves the amount from Cheques Under Collection into the bank: <code>Dr Bank / Cr Cheques Under Collection</code>.", Model.DepositedDate.Value.ToString("dd/MM/yyyy"))
    </div>
}
else
{
    <div class="alert alert-warning">
        Clearing this cheque will reverse the memorandum entry and post the real accounting entry to bank and the settlement account.
        To follow it through the bank, <a asp-action="Step" asp-route-id="@Model.PdcReceiptId" asp-route-kind="deposit">deposit it first</a>.
    </div>
}

<form asp-action="Clear" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="PdcReceiptId" type="hidden" />

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="ChequeNumber" class="form-label">@T["Cheque Number"]</label>
            <input asp-for="ChequeNumber" class="form-control" readonly />
        </div>

        <div class="col-md-4">
            <label asp-for="BankName" class="form-label">@T["Bank"]</label>
            <input asp-for="BankName" class="form-control" readonly />
        </div>

        <div class="col-md-4">
            <label asp-for="SettlementMode" class="form-label">@T["Settlement Mode"]</label>
            <input asp-for="SettlementMode" class="form-control" readonly />
        </div>

        <div class="col-md-4">
            <label asp-for="LeaseDisplay" class="form-label">@T["Lease"]</label>
            <input asp-for="LeaseDisplay" class="form-control" readonly />
        </div>

        <div class="col-md-4">
            <label asp-for="InvoiceDisplay" class="form-label">@T["Invoice"]</label>
            <input asp-for="InvoiceDisplay" class="form-control" readonly />
        </div>

        <div class="col-md-4">
            <label asp-for="Amount" class="form-label"></label>
            <input asp-for="Amount" class="form-control" readonly />
        </div>

        <div class="col-md-4">
            <label asp-for="ChequeDate" class="form-label"></label>
            <input asp-for="ChequeDate" type="date" class="form-control" readonly />
        </div>

        <div class="col-md-4">
            <label asp-for="ReceivedDate" class="form-label"></label>
            <input asp-for="ReceivedDate" type="date" class="form-control" readonly />
        </div>

        <div class="col-md-4">
            <label asp-for="ClearedDate" class="form-label">@T["Cleared Date — accounting date"]</label>
            <input asp-for="ClearedDate" type="date" class="form-control" />
            <div class="form-text">@T["The day the bank honoured the cheque. The cash entry posts on this date."]</div>
        </div>
    </div>

    @if (Model.RequiresEarlyClearanceConfirmation)
    {
        <div class="alert alert-warning border-warning mt-4">
            <div class="fw-bold mb-2">@T.Format("Clearing {0} day(s) before the cheque date", Model.DaysEarly)</div>
            <p class="mb-2">
                @T.HtmlFormat("The cheque is dated <strong>{0}</strong> but you are clearing it on <strong>{1}</strong>. A bank will not normally honour a post-dated cheque before its date.", Model.ChequeDate.ToString("dd/MM/yyyy"), Model.ClearedDate.ToString("dd/MM/yyyy"))
            </p>
            <p class="mb-3 small">
                @T.Format("If the cleared date is simply wrong, correct it above. If the cheque genuinely was presented and honoured early — by agreement with the tenant, for example — tick below and post. The cash entry will be dated {0}.", Model.ClearedDate.ToString("dd/MM/yyyy"))
            </p>
            <div class="form-check">
                <input asp-for="ConfirmEarlyClearance" class="form-check-input" id="confirmEarly" />
                <label class="form-check-label fw-semibold" for="confirmEarly">
                    @T["I confirm this cheque was honoured on the cleared date shown above."]
                </label>
            </div>
        </div>
    }

    <div class="mt-4">
        <button type="submit" class="btn @(Model.RequiresEarlyClearanceConfirmation ? "btn-warning" : "btn-dark")">
            @(Model.RequiresEarlyClearanceConfirmation ? T["Confirm and Post"] : T["Clear and Post"])
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">@T["Back"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}