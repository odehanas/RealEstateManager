@model IEnumerable<RealEstateManager.Domain.JournalEntry>
@using RealEstateManager.Models

@{
    ViewData["Title"] = T["Manual Journals"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@T["Manual Journals"]</h2>
    <a asp-action="Create" class="btn btn-dark">@T["New Manual Journal"]</a>
</div>

@if (TempData["JournalSuccess"] is string journalSuccess)
{
    <div class="alert alert-success py-2">@journalSuccess</div>
}
@if (TempData["JournalError"] is string journalError)
{
    <div class="alert alert-danger py-2"><strong>Cannot do that.</strong> @journalError</div>
}

<div class="alert alert-light border small">
    @T.Html("A journal is saved as a <strong>Draft</strong> and has no effect on the accounts until you press <strong>Post</strong>. Only posted entries appear in the Trial Balance, Profit &amp; Loss, Balance Sheet and General Ledger.")
</div>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>@T["Entry No."]</th>
            <th>@T["Date"]</th>
            <th>@T["Type"]</th>
            <th>@T["Description"]</th>
            <th>@T["Document"]</th>
            <th>@T["Reference"]</th>
            <th class="text-end">@T["Debit"]</th>
            <th class="text-end">@T["Credit"]</th>
            <th>@T["Status"]</th>
            <th>@T["Action"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var totalDebit = item.Lines.Sum(x => x.Debit);
            var totalCredit = item.Lines.Sum(x => x.Credit);

            <tr>
                <td>@item.EntryNumber</td>
                <td>@item.EntryDate.ToString("dd/MM/yyyy")</td>
                <td>@item.JournalType</td>
                <td>@item.Description</td>
                <td>@item.DocumentNumber</td>
                <td>@item.ReferenceNumber</td>
                <td class="text-end">@totalDebit.ToString("N2")</td>
                <td class="text-end">@totalCredit.ToString("N2")</td>
                <td>
                    @if (item.IsPosted)
                    {
                        <span class="badge bg-success">@T["Posted"]</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">@T["Draft"]</span>
                    }
                </td>
                <td>
                    <partial name="_JournalStateButtons" model="JournalStateButtonsViewModel.For(item)" />
                </td>
            </tr>
        }
    </tbody>
</table>