@model RealEstateManager.Domain.OwnerCommissionInvoice

@{
    var isTaxInvoice = Model.VatAmount > 0;
    var title = isTaxInvoice ? "Tax Invoice" : "Commission Invoice";
    ViewData["Title"] = title + " " + (Model.TaxInvoiceNumber ?? Model.InvoiceNumber);
    var company = Model.Company;
    var currency = company?.BaseCurrency ?? "AED";
}

<style>
    @@media print {
        .statement-no-print, nav, footer { display: none !important; }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3 statement-no-print">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">@T["Back to Owner Settlements"]</a>
    <button type="button" class="btn btn-primary btn-sm" onclick="window.print()">@T["Print"]</button>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between mb-4">
            <div>
                <h3 class="mb-0">@(company?.LegalName ?? company?.Name)</h3>
                <div class="small">
                    @company?.AddressLine1 @company?.AddressLine2 @company?.City @company?.Country
                </div>
                @if (!string.IsNullOrWhiteSpace(company?.TrnNumber))
                {
                    <div class="small">@T.HtmlFormat("TRN: <strong>{0}</strong>", company.TrnNumber)</div>
                }
            </div>
            <div class="text-end">
                <h4 class="mb-1">@title</h4>
                @if (isTaxInvoice)
                {
                    <div>@T.HtmlFormat("Tax invoice no.: <strong>{0}</strong>", Model.TaxInvoiceNumber)</div>
                }
                <div>@T.Format("Reference: {0}", Model.InvoiceNumber)</div>
                <div>@T.Format("Date of issue: {0}", Model.InvoiceDate.ToString("dd/MM/yyyy"))</div>
                <div>@T.Format("Date of supply: {0}", Model.InvoiceDate.ToString("dd/MM/yyyy"))</div>
                @if (!Model.IsPosted)
                {
                    <span class="badge bg-warning text-dark">@T["Draft - not posted"]</span>
                }
            </div>
        </div>

        <p class="mb-1">@T.HtmlFormat("<strong>Bill to:</strong> {0}", Model.OwnerName)</p>
        @if (!string.IsNullOrWhiteSpace(Model.RecipientTrn))
        {
            <p class="mb-1">@T.Format("TRN: {0}", Model.RecipientTrn)</p>
        }
        <p class="text-muted">
            @T.Format("Property management commission for {0}{1}.", Model.PeriodStart.ToString("MMMM yyyy"), Model.PeriodStart.Month != Model.PeriodEnd.Month || Model.PeriodStart.Year != Model.PeriodEnd.Year ? " to " + Model.PeriodEnd.ToString("MMMM yyyy") : "")
        </p>

        <table class="table table-bordered table-sm mb-4">
            <thead>
                <tr>
                    <th>@T["Description"]</th>
                    <th class="text-end">@T.Format("Amount ({0})", currency)</th>
                    <th class="text-end">@T["VAT Rate"]</th>
                    <th class="text-end">@T.Format("VAT ({0})", currency)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Model.Lines.OrderBy(x => x.RecognitionDate).ThenBy(x => x.Description))
                {
                    <tr>
                        <td>@line.Description</td>
                        <td class="text-end">@line.Commission.ToString("N2")</td>
                        <td class="text-end">@Model.VatRate.ToString("0.##")%</td>
                        <td class="text-end">@RealEstateManager.Services.VatDeterminationService.Round(line.Commission * Model.VatRate / 100m).ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>

        <table class="table table-sm ms-auto" style="max-width: 420px;">
            <tbody>
                <tr><td>@T["Total excluding VAT"]</td><td class="text-end">@Model.Commission.ToString("N2")</td></tr>
                <tr><td>@T.Format("VAT at {0}%", Model.VatRate.ToString("0.##"))</td><td class="text-end">@Model.VatAmount.ToString("N2")</td></tr>
                <tr class="fw-bold table-primary"><td>@T.Format("Total including VAT ({0})", currency)</td><td class="text-end">@Model.TotalAmount.ToString("N2")</td></tr>
            </tbody>
        </table>

        <p class="small text-muted mb-0">
            @T.Format("This amount has been deducted from the rent we collected on your behalf, and is shown on your owner settlement statement. {0}", isTaxInvoice ? "VAT is charged on our management service; it is not charged on the rent." : "")
        </p>
    </div>
</div>
