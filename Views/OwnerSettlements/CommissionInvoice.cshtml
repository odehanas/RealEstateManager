@model RealEstateManager.Domain.OwnerCommissionInvoice

@{
    var isTaxInvoice = Model.VatAmount > 0;
    var title = isTaxInvoice ? "Tax Invoice" : "Commission Invoice";
    ViewData["Title"] = title + " " + (Model.TaxInvoiceNumber ?? Model.InvoiceNumber);
    var company = Model.Company;
    var currency = company?.BaseCurrency ?? "AED";
}

<style>
    @@media print {
        .statement-no-print, nav, footer { display: none !important; }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3 statement-no-print">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Owner Settlements</a>
    <button type="button" class="btn btn-primary btn-sm" onclick="window.print()">Print</button>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between mb-4">
            <div>
                <h3 class="mb-0">@(company?.LegalName ?? company?.Name)</h3>
                <div class="small">
                    @company?.AddressLine1 @company?.AddressLine2 @company?.City @company?.Country
                </div>
                @if (!string.IsNullOrWhiteSpace(company?.TrnNumber))
                {
                    <div class="small">TRN: <strong>@company.TrnNumber</strong></div>
                }
            </div>
            <div class="text-end">
                <h4 class="mb-1">@title</h4>
                @if (isTaxInvoice)
                {
                    <div>Tax invoice no.: <strong>@Model.TaxInvoiceNumber</strong></div>
                }
                <div>Reference: @Model.InvoiceNumber</div>
                <div>Date of issue: @Model.InvoiceDate.ToString("dd/MM/yyyy")</div>
                <div>Date of supply: @Model.InvoiceDate.ToString("dd/MM/yyyy")</div>
                @if (!Model.IsPosted)
                {
                    <span class="badge bg-warning text-dark">Draft - not posted</span>
                }
            </div>
        </div>

        <p class="mb-1"><strong>Bill to:</strong> @Model.OwnerName</p>
        @if (!string.IsNullOrWhiteSpace(Model.RecipientTrn))
        {
            <p class="mb-1">TRN: @Model.RecipientTrn</p>
        }
        <p class="text-muted">
            Property management commission for @Model.PeriodStart.ToString("MMMM yyyy")@(Model.PeriodStart.Month != Model.PeriodEnd.Month || Model.PeriodStart.Year != Model.PeriodEnd.Year ? " to " + Model.PeriodEnd.ToString("MMMM yyyy") : "").
        </p>

        <table class="table table-bordered table-sm mb-4">
            <thead>
                <tr>
                    <th>Description</th>
                    <th class="text-end">Amount (@currency)</th>
                    <th class="text-end">VAT Rate</th>
                    <th class="text-end">VAT (@currency)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Model.Lines.OrderBy(x => x.RecognitionDate).ThenBy(x => x.Description))
                {
                    <tr>
                        <td>@line.Description</td>
                        <td class="text-end">@line.Commission.ToString("N2")</td>
                        <td class="text-end">@Model.VatRate.ToString("0.##")%</td>
                        <td class="text-end">@RealEstateManager.Services.VatDeterminationService.Round(line.Commission * Model.VatRate / 100m).ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>

        <table class="table table-sm ms-auto" style="max-width: 420px;">
            <tbody>
                <tr><td>Total excluding VAT</td><td class="text-end">@Model.Commission.ToString("N2")</td></tr>
                <tr><td>VAT at @Model.VatRate.ToString("0.##")%</td><td class="text-end">@Model.VatAmount.ToString("N2")</td></tr>
                <tr class="fw-bold table-primary"><td>Total including VAT (@currency)</td><td class="text-end">@Model.TotalAmount.ToString("N2")</td></tr>
            </tbody>
        </table>

        <p class="small text-muted mb-0">
            This amount has been deducted from the rent we collected on your behalf, and is shown on your owner
            settlement statement. @(isTaxInvoice ? "VAT is charged on our management service; it is not charged on the rent." : "")
        </p>
    </div>
</div>
