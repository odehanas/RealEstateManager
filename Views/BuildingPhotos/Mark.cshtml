@model RealEstateManager.Domain.PropertyPhoto
@using RealEstateManager.Services

@{
    ViewData["Title"] = "Mark Units - " + Model.Title;
    var units = ViewBag.Units as List<RealEstateManager.Controllers.BuildingPhotosController.MarkUnit> ?? new();
    var areas = Model.Areas.ToDictionary(a => a.UnitId, a => BuildingPhotoService.Read(a.PointsJson));
    var json = System.Text.Json.JsonSerializer.Serialize(new
    {
        photoId = Model.Id,
        units = units.Select(u => new { u.Id, u.UnitNumber, u.Floor, u.Side, u.Usage }),
        areas
    }, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase });
    var floors = units.Select(u => u.Floor).Distinct().OrderBy(f => f).ToList();
    string F(int f) => f == 0 ? "G" : f < 0 ? "B" + -f : f.ToString();
}

<style>
    #stage { position: relative; display: inline-block; max-width: 100%; user-select: none; }
    #stage img { display: block; max-width: 100%; max-height: 78vh; }
    #overlay { position: absolute; left: 0; top: 0; width: 100%; height: 100%; cursor: crosshair; }
    #overlay .area { fill: rgba(13,110,253,.22); stroke: #0d6efd; stroke-width: 2; vector-effect: non-scaling-stroke; cursor: pointer; }
    #overlay .area.sel { fill: rgba(255,193,7,.35); stroke: #e0a800; stroke-width: 3; }
    #overlay .draft { fill: rgba(220,53,69,.18); stroke: #dc3545; stroke-width: 2; vector-effect: non-scaling-stroke; stroke-dasharray: 6 4; }
    #overlay text { font-size: 15px; fill: #052c65; paint-order: stroke; stroke: rgba(255,255,255,.85); stroke-width: 3px; pointer-events: none; font-weight: 600; }
    #unitList { max-height: 52vh; overflow-y: auto; }
    #unitList .unit { cursor: pointer; padding: 3px 8px; border-radius: 4px; font-size: 14px; display: flex; justify-content: space-between; }
    #unitList .unit:hover { background: #f1f3f5; }
    #unitList .unit.sel { background: #fff3cd; font-weight: 600; }
    #unitList .floor { font-size: 12px; color: #6c757d; margin-top: 6px; }
</style>

<div class="d-flex justify-content-between align-items-center mb-2">
    <div>
        <h2 class="mb-0">@T.Format("Mark Units: {0}", Model.Title)</h2>
        <div class="text-muted">@Model.Property?.Code - @Model.Property?.Name</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" asp-route-id="@Model.PropertyId" class="btn btn-outline-secondary btn-sm">@T["All photos"]</a>
        <a asp-controller="BuildingView" asp-action="Property" asp-route-id="@Model.PropertyId" class="btn btn-outline-dark btn-sm">@T["See it in the building view"]</a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="row g-3">
    <div class="col-lg-8">
        <div id="stage">
            <img id="photo" src="@Url.Action("Image", new { id = Model.Id })" alt="@Model.Title" />
            <svg id="overlay"></svg>
        </div>
        <div class="small text-muted mt-2">
            @T.Html("Choose a unit on the right, then click the corners of its windows or balcony on the photo. <strong>Save outline</strong> (or Enter) keeps it and moves on to the next unit; <strong>Undo corner</strong> (or Backspace) removes the last click. Click a saved outline to select its unit again.")
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong id="current">@T["Choose a unit"]</strong>
                    <span class="small text-muted" id="progress"></span>
                </div>
                <div class="d-flex flex-wrap gap-2 mb-2">
                    <button type="button" class="btn btn-sm btn-success" id="save">@T["Save outline"]</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="undo">@T["Undo corner"]</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="restart">@T["Start again"]</button>
                    <button type="button" class="btn btn-sm btn-outline-danger" id="remove">@T["Remove outline"]</button>
                </div>
                <div class="small text-danger" id="message"></div>
                <div id="unitList" class="border-top pt-2"></div>
            </div>
        </div>

        @if (floors.Count > 2)
        {
            <div class="card shadow-sm">
                <div class="card-header bg-light">@T.Html("<strong>Repeat Floors Up the Building</strong>")</div>
                <div class="card-body">
                    <p class="small text-muted">
                        @T["Mark the units of two floors one above the other. The step between them is measured, and the upper floor's outlines are repeated on every floor up to the last one - matched to its units left to right. Check the result and correct any outline that does not sit right."]
                    </p>
                    <form asp-action="Repeat" asp-route-id="@Model.Id" method="post" class="row g-2">
                        <div class="col-4"><label class="form-label small">@T["Lower floor"]</label>
                            <select name="lowerFloor" class="form-select form-select-sm">@foreach (var f in floors) { <option value="@f">@F(f)</option> }</select></div>
                        <div class="col-4"><label class="form-label small">@T["Upper floor"]</label>
                            <select name="upperFloor" class="form-select form-select-sm">@foreach (var f in floors) { <option value="@f" selected="@(f == floors[Math.Min(1, floors.Count - 1)] ? "selected" : null)">@F(f)</option> }</select></div>
                        <div class="col-4"><label class="form-label small">@T["Up to floor"]</label>
                            <select name="lastFloor" class="form-select form-select-sm">@foreach (var f in floors) { <option value="@f" selected="@(f == floors[^1] ? "selected" : null)">@F(f)</option> }</select></div>
                        <div class="col-12">
                            <div class="form-check">
                                <input type="checkbox" name="overwrite" value="true" class="form-check-input" id="overwrite" />
                                <input type="hidden" name="overwrite" value="false" />
                                <label class="form-check-label small" for="overwrite">@T["Replace outlines already marked on those floors"]</label>
                            </div>
                        </div>
                        <div class="col-12"><button type="submit" class="btn btn-sm btn-dark">@T["Repeat floors"]</button></div>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
<script>
(function () {
    const data = @Html.Raw(json);
    const img = document.getElementById('photo'), svg = document.getElementById('overlay');
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    const urls = { save: '@Url.Action("SaveArea")', remove: '@Url.Action("DeleteArea")' };
    const areas = {}; Object.keys(data.areas || {}).forEach(k => areas[+k] = data.areas[k]);
    const floorLabel = f => f === 0 ? 'G' : f < 0 ? 'B' + (-f) : String(f);
    let W = 1000, H = 1000, selected = null, draft = [];

    function setSize() {
        if (!img.naturalWidth) return;
        H = Math.round(1000 * img.naturalHeight / img.naturalWidth);
        svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
        draw();
    }
    img.addEventListener('load', setSize);

    const ns = 'http://www.w3.org/2000/svg';
    const el = (t, a) => { const e = document.createElementNS(ns, t); for (const k in a) e.setAttribute(k, a[k]); svg.appendChild(e); return e; };
    const pts = list => list.map(p => `${p[0] * W},${p[1] * H}`).join(' ');

    function draw() {
        svg.innerHTML = '';
        Object.keys(areas).forEach(id => {
            const unit = data.units.find(u => u.id === +id); if (!unit) return;
            const poly = el('polygon', { points: pts(areas[id]), class: 'area' + (+id === selected ? ' sel' : '') });
            poly.addEventListener('click', e => { if (draft.length) return; e.stopPropagation(); choose(+id); });
            const cx = areas[id].reduce((a, p) => a + p[0], 0) / areas[id].length * W;
            const cy = areas[id].reduce((a, p) => a + p[1], 0) / areas[id].length * H;
            const t = el('text', { x: cx, y: cy + 5, 'text-anchor': 'middle' });
            t.textContent = unit.unitNumber.split('-').pop();
        });
        if (draft.length) {
            el(draft.length > 2 ? 'polygon' : 'polyline', { points: pts(draft), class: 'draft' });
            draft.forEach(p => el('circle', { cx: p[0] * W, cy: p[1] * H, r: 5, fill: '#dc3545' }));
        }
        list();
    }

    svg.addEventListener('click', e => {
        if (selected == null) { message('Choose a unit on the right first.'); return; }
        const r = svg.getBoundingClientRect();
        const x = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
        const y = Math.min(1, Math.max(0, (e.clientY - r.top) / r.height));
        draft.push([+x.toFixed(5), +y.toFixed(5)]);
        message(''); draw();
    });

    function list() {
        const box = document.getElementById('unitList'); box.innerHTML = '';
        let last = null;
        data.units.forEach(u => {
            if (u.floor !== last) { const h = document.createElement('div'); h.className = 'floor'; h.textContent = 'Floor ' + floorLabel(u.floor); box.appendChild(h); last = u.floor; }
            const d = document.createElement('div');
            d.className = 'unit' + (u.id === selected ? ' sel' : '');
            d.innerHTML = `<span>${u.unitNumber}${u.side ? ' · ' + u.side : ''}</span><span class="${areas[u.id] ? 'text-success' : 'text-muted'}">${areas[u.id] ? 'marked' : '-'}</span>`;
            d.addEventListener('click', () => choose(u.id));
            box.appendChild(d);
        });
        const marked = data.units.filter(u => areas[u.id]).length;
        document.getElementById('progress').textContent = `${marked} of ${data.units.length} marked`;
        const u = data.units.find(x => x.id === selected);
        document.getElementById('current').textContent = u ? `Unit ${u.unitNumber} (floor ${floorLabel(u.floor)})` + (draft.length ? ` - ${draft.length} corner(s)` : '') : 'Choose a unit';
    }

    function choose(id) { selected = id; draft = []; message(''); draw(); }
    function message(t) { document.getElementById('message').textContent = t; }

    async function post(url, body) {
        const form = new URLSearchParams(body); form.append('__RequestVerificationToken', token);
        const r = await fetch(url, { method: 'POST', body: form, headers: { 'Content-Type': 'application/x-www-form-urlencoded' } });
        return r.ok ? r.json() : { ok: false, message: 'The server refused the request (' + r.status + ').' };
    }

    async function save() {
        if (selected == null) return message('Choose a unit first.');
        if (draft.length < 3) return message('Click at least three corners of the unit on the photo.');
        const res = await post(urls.save, { photoId: data.photoId, unitId: selected, points: JSON.stringify(draft) });
        if (!res.ok) return message(res.message || 'Not saved.');
        areas[selected] = draft; draft = [];
        // Straight on to the next unit not yet marked.
        const next = data.units.find(u => !areas[u.id]);
        selected = next ? next.id : selected;
        draw();
    }

    document.getElementById('save').addEventListener('click', save);
    document.getElementById('undo').addEventListener('click', () => { draft.pop(); draw(); });
    document.getElementById('restart').addEventListener('click', () => { draft = []; draw(); });
    document.getElementById('remove').addEventListener('click', async () => {
        if (selected == null || !areas[selected]) return message('This unit has no outline on this photo.');
        if (!confirm('Remove this unit\'s outline from the photo?')) return;
        const res = await post(urls.remove, { photoId: data.photoId, unitId: selected });
        if (res.ok) { delete areas[selected]; draft = []; draw(); }
    });
    document.addEventListener('keydown', e => {
        if (e.target.closest('input, select, textarea')) return;
        if (e.key === 'Enter') { e.preventDefault(); save(); }
        if (e.key === 'Backspace') { e.preventDefault(); draft.pop(); draw(); }
    });

    const first = data.units.find(u => !areas[u.id]) || data.units[0];
    if (first) selected = first.id;
    if (img.complete) setSize(); else draw();
})();
</script>
}
