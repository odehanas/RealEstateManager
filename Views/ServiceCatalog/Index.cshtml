@model List<RealEstateManager.Domain.ServiceCatalogItem>
@using RealEstateManager.Domain

@{
    ViewData["Title"] = T["Paid Services Price List"];
    var accounts = ViewBag.Accounts as List<Account> ?? new();
    var editing = ViewBag.Editing as ServiceCatalogItem;
    var form = editing ?? new ServiceCatalogItem();
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h2 class="mb-1">@T["Paid Services Price List"]</h2>
        <p class="text-muted mb-0" style="max-width:820px">
            @T["Services a tenant asks for and pays for: special maintenance that is not the landlord's to do free of charge, and special requests such as cleaning that the company may give to a subcontractor. A tenant orders from this list in the portal, or staff order for them; the tenant is invoiced, and the work waits for the payment where the service says so."]
        </p>
    </div>
    <a asp-action="Orders" class="btn btn-outline-dark">@T["Orders and margin"]</a>
</div>

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-warning">@errorMessage</div>
}
@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

<form asp-action="Save" method="post" class="card mb-4" id="serviceForm">
    <div class="card-header bg-white fw-semibold">@(form.Id == 0 ? T["Add a service"] : T.Format("Change: {0}", form.Name))</div>
    <div class="card-body row g-3">
        <input type="hidden" name="Id" value="@form.Id" />
        <div class="col-md-5">
            <label class="form-label" for="svcName">@T["Service"]</label>
            <input id="svcName" name="Name" value="@form.Name" class="form-control" maxlength="@ServiceCatalogItem.MaxNameLength" required
                   placeholder="@T["e.g. Deep cleaning - one bedroom"]" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="svcKind">@T["Type"]</label>
            <select id="svcKind" name="Kind" class="form-select">
                @foreach (var kind in ServiceKinds.All)
                {
                    <option value="@kind" selected="@(kind == form.Kind ? "selected" : null)">@T[ServiceKinds.Describe(kind)]</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label" for="svcCategory">@T["Kind of work"]</label>
            <select id="svcCategory" name="Category" class="form-select">
                <option value="">@T["-- choose --"]</option>
                @foreach (var category in await MaintenanceCategories.NamesAsync(form.Category))
                {
                    <option value="@category" selected="@(category == form.Category ? "selected" : null)">@category</option>
                }
            </select>
        </div>
        <div class="col-12">
            <label class="form-label" for="svcDescription">@T["What is included"]</label>
            <input id="svcDescription" name="Description" value="@form.Description" class="form-control" maxlength="500"
                   placeholder="@T["The tenant reads this when choosing the service."]" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="svcPrice">@T["Selling price (before VAT)"]</label>
            <input id="svcPrice" name="SellingPrice" value="@form.SellingPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" type="number" step="0.01" min="0" class="form-control" required />
            <div class="form-text">@T["0 = priced when the invoice is issued."]</div>
        </div>
        <div class="col-md-3">
            <label class="form-label" for="svcCost">@T["Expected cost"]</label>
            <input id="svcCost" name="ExpectedCost" value="@form.ExpectedCost.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" type="number" step="0.01" min="0" class="form-control" required />
            <div class="form-text">@T["The subcontractor's price, or materials and time."]</div>
        </div>
        <div class="col-md-6">
            <label class="form-label" for="svcAccount">@T["Income account"]</label>
            <select id="svcAccount" name="IncomeAccountId" class="form-select">
                <option value="">@T["-- the company's Other Income account --"]</option>
                @foreach (var account in accounts)
                {
                    <option value="@account.Id" selected="@(account.Id == form.IncomeAccountId ? "selected" : null)">@account.Code - @account.Name</option>
                }
            </select>
            <div class="form-text">@T["Where the price is credited when the invoice is posted."]</div>
        </div>
        <div class="col-12 d-flex flex-wrap gap-4">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="svcPayFirst" name="PayBeforeWork" value="true" checked="@(form.PayBeforeWork ? "checked" : null)" />
                <input type="hidden" name="PayBeforeWork" value="false" />
                <label class="form-check-label" for="svcPayFirst">@T["The tenant pays before the work starts"]</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="svcSub" name="Subcontracted" value="true" checked="@(form.Subcontracted ? "checked" : null)" />
                <input type="hidden" name="Subcontracted" value="false" />
                <label class="form-check-label" for="svcSub">@T["Done by a subcontractor"]</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="svcActive" name="IsActive" value="true" checked="@(form.IsActive ? "checked" : null)" />
                <input type="hidden" name="IsActive" value="false" />
                <label class="form-check-label" for="svcActive">@T["Offered to tenants"]</label>
            </div>
        </div>
        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-primary">@(form.Id == 0 ? T["Add service"] : T["Save"])</button>
            @if (form.Id != 0)
            {
                <a asp-action="Index" class="btn btn-outline-secondary">@T["Cancel"]</a>
            }
        </div>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-info">@T["No services yet. Add the first one above; tenants see the list as soon as it has an entry."]</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead>
                <tr>
                    <th>@T["Service"]</th>
                    <th>@T["Type"]</th>
                    <th class="text-end">@T["Selling price"]</th>
                    <th class="text-end">@T["Expected cost"]</th>
                    <th class="text-end">@T["Expected margin"]</th>
                    <th>@T["Income account"]</th>
                    <th>@T["Terms"]</th>
                    <th>@T["Status"]</th>
                    <th>@T["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="@(item.IsActive ? "" : "text-muted")">
                        <td>
                            <div class="fw-semibold">@item.Name</div>
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <div class="small text-muted">@item.Description</div>
                            }
                        </td>
                        <td>
                            @T[ServiceKinds.Describe(item.Kind)]
                            @if (!string.IsNullOrWhiteSpace(item.Category))
                            {
                                <div class="small text-muted">@item.Category</div>
                            }
                        </td>
                        <td class="text-end">@(item.SellingPrice == 0m ? T["on quotation"] : item.SellingPrice.ToString("N2"))</td>
                        <td class="text-end">@item.ExpectedCost.ToString("N2")</td>
                        <td class="text-end">
                            @if (item.SellingPrice > 0m)
                            {
                                var margin = item.SellingPrice - item.ExpectedCost;
                                <span class="@(margin < 0m ? "text-danger" : "")">@margin.ToString("N2")</span>
                                <div class="small text-muted">@((margin / item.SellingPrice).ToString("P0"))</div>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>@(item.IncomeAccount != null ? $"{item.IncomeAccount.Code} - {item.IncomeAccount.Name}" : T["Other Income"])</td>
                        <td class="small">
                            <div>@(item.PayBeforeWork ? T["Paid before the work"] : T["Invoiced, work not held"])</div>
                            @if (item.Subcontracted)
                            {
                                <div class="text-muted">@T["Subcontracted"]</div>
                            }
                        </td>
                        <td><span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? T["Offered"] : T["Switched off"])</span></td>
                        <td><a asp-action="Index" asp-route-edit="@item.Id" asp-fragment="serviceForm" class="btn btn-sm btn-outline-secondary">@T["Edit"]</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<p class="text-muted small" style="max-width:820px">
    @T["The price is charged to the tenant as a tax invoice in the company's own name, with VAT where the company is registered. It is the company's income whoever owns the building, and is never part of what an owner is paid. An order keeps the price it was made at: changing the list does not change orders already made."]
</p>
