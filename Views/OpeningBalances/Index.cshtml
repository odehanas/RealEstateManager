@model RealEstateManager.Models.OpeningBalanceReconciliationViewModel
@inject PermissionService PermissionService

@{
    ViewData["Title"] = T["Opening Balances"];

    // Typing balances needs the same right as the chart of accounts; anyone else sees the figures only.
    var canEdit = await PermissionService.HasPermissionAsync(User, AppPermissions.AccountingManage);
    var canEditMasterData = await PermissionService.HasPermissionAsync(User, AppPermissions.MasterDataManage);
    var entryIndex = 0;
}

<style>
    .ob-input { max-width: 150px; margin-left: auto; text-align: right; }
    .ob-input.ob-changed { border-color: #f0b429; background: #fff8e1; }
    .ob-savebar { position: sticky; bottom: 0; z-index: 5; }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">@T["Opening Balances"]</h2>
        <div class="text-muted">
            Per-account opening balances combined with sub-ledger detail for
            Accounts Receivable, Accounts Payable and Fixed Assets.
            @if (canEdit)
            {
                <text>Type the figures straight into the Manual OB column and save.</text>
            }
        </div>
    </div>
    <div>
        <a asp-controller="ChartOfAccounts" asp-action="Index" class="btn btn-sm btn-outline-secondary">@T["Chart of Accounts"]</a>
        <a asp-controller="Tenants" asp-action="Index" class="btn btn-sm btn-outline-secondary">@T["Tenants"]</a>
        <a asp-controller="Vendors" asp-action="Index" class="btn btn-sm btn-outline-secondary">@T["Vendors"]</a>
        <a asp-controller="FixedAssets" asp-action="Index" class="btn btn-sm btn-outline-secondary">@T["Fixed Assets"]</a>
    </div>
</div>

@if (TempData["OpeningBalanceMessage"] != null)
{
    <div class="alert alert-success">@TempData["OpeningBalanceMessage"]</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">@T["Total Debit Opening Balance"]</div>
                <div class="h4 mb-0 text-success">@Model.TotalDebitOpeningBalance.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">@T["Total Credit Opening Balance"]</div>
                <div class="h4 mb-0 text-danger">@Model.TotalCreditOpeningBalance.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">@T["Net Imbalance (Dr - Cr)"]</div>
                @if (Model.NetImbalance == 0m)
                {
                    <div class="h4 mb-0 text-success">0.00 &nbsp;<span class="badge bg-success">Balanced</span></div>
                }
                else
                {
                    <div class="h4 mb-0 text-danger">@Model.NetImbalance.ToString("N2") &nbsp;<span class="badge bg-danger">Out of Balance</span></div>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.NetImbalance != 0m)
{
    <div class="alert alert-warning">
        @T.Html("<strong>Opening balances are not balanced.</strong> Total debit opening balances must equal total credit opening balances for the Trial Balance and Balance Sheet to remain in balance from day one. Review the manual opening balance on the equity / retained earnings account (or the contra account you use for the opening journal) so that the difference is zero.")
    </div>
}

<form asp-action="Save" method="post" id="openingForm">
<div class="card shadow-sm mb-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <strong>@T["GL Account Opening Balances"]</strong>
        <span class="text-muted small">
            Postable accounts only.
            @if (canEdit)
            {
                <text>Enter each balance on the account's normal side (debit for assets and expenses, credit for liabilities, equity and revenue); a negative figure goes to the other side.</text>
            }
        </span>
    </div>
    <div class="table-responsive">
        <table class="table table-sm table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>@T["Code"]</th>
                    <th>@T["Account"]</th>
                    <th>@T["Type"]</th>
                    <th>@T["Source"]</th>
                    <th class="text-end">@T["Manual OB"]</th>
                    <th class="text-end">@T["Sub-ledger Total"]</th>
                    <th class="text-end">@T["Effective OB"]</th>
                    <th class="text-end">@T["Debit"]</th>
                    <th class="text-end">@T["Credit"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>
                            @if (canEdit)
                            {
                                <a asp-controller="ChartOfAccounts" asp-action="Edit" asp-route-id="@row.AccountId" title="@T["Open the account"]"><code>@row.AccountCode</code></a>
                            }
                            else
                            {
                                <code>@row.AccountCode</code>
                            }
                        </td>
                        <td>@row.AccountName</td>
                        <td><span class="badge bg-secondary">@row.AccountType</span></td>
                        <td>
                            @switch (row.Source)
                            {
                                case "AccountsReceivable":
                                    <span class="badge bg-primary">@T["AR Sub-ledger"]</span>
                                    break;
                                case "AccountsPayable":
                                    <span class="badge bg-primary">@T["AP Sub-ledger"]</span>
                                    break;
                                case "FixedAssetCost":
                                    <span class="badge bg-primary">@T["Fixed Asset Cost"]</span>
                                    break;
                                case "FixedAssetAccumDepreciation":
                                    <span class="badge bg-primary">@T["Fixed Asset Acc. Dep."]</span>
                                    break;
                                case "OpeningBalanceControl":
                                    <span class="badge bg-warning text-dark">@T["Balancing line"]</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">@T["Manual"]</span>
                                    break;
                            }
                        </td>
                        <td class="text-end">
                            @if (row.Source == RealEstateManager.Services.OpeningBalanceService.SourceOpeningBalanceControl)
                            {
                                <span class="text-muted small" title="@T["The difference left by every other account's opening balance"]">@T["worked out"]</span>
                            }
                            else if (row.IsControlAccount)
                            {
                                var (controller, label) = row.Source switch
                                {
                                    "AccountsReceivable" => ("Tenants", "Edit per tenant"),
                                    "AccountsPayable" => ("Vendors", "Edit per vendor"),
                                    _ => ("FixedAssets", "Edit per asset")
                                };
                                <a asp-controller="@controller" asp-action="Index" class="small" title="@T["This figure is the total of the detail below"]">@label</a>
                            }
                            else if (canEdit && row.IsEditable)
                            {
                                <input type="hidden" name="entries[@entryIndex].AccountId" value="@row.AccountId" class="ob-id" />
                                <input type="number" step="0.01" name="entries[@entryIndex].OpeningBalance"
                                       value="@row.ManualOpeningBalance.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                       data-original="@row.ManualOpeningBalance.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                       class="form-control form-control-sm ob-input" aria-label="Opening balance of @row.AccountCode @row.AccountName" />
                                entryIndex++;
                            }
                            else
                            {
                                @row.ManualOpeningBalance.ToString("N2")
                            }
                        </td>
                        <td class="text-end">
                            @if (row.IsControlAccount)
                            {
                                @row.SubLedgerTotal.ToString("N2")
                            }
                            else
                            {
                                <span class="text-muted">&mdash;</span>
                            }
                        </td>
                        <td class="text-end fw-semibold">@row.EffectiveOpeningBalance.ToString("N2")</td>
                        <td class="text-end">@(row.DebitOpeningBalance == 0m ? "" : row.DebitOpeningBalance.ToString("N2"))</td>
                        <td class="text-end">@(row.CreditOpeningBalance == 0m ? "" : row.CreditOpeningBalance.ToString("N2"))</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-light fw-semibold">
                    <td colspan="7" class="text-end">@T["Totals"]</td>
                    <td class="text-end">@Model.TotalDebitOpeningBalance.ToString("N2")</td>
                    <td class="text-end">@Model.TotalCreditOpeningBalance.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
    </div>
    @if (canEdit)
    {
        <div class="card-footer bg-white d-flex align-items-center gap-2 ob-savebar">
            <button type="submit" class="btn btn-dark btn-sm" id="obSave">@T["Save opening balances"]</button>
            <span class="text-muted small" id="obChanged">@T["No changes yet."]</span>
            <span class="ms-auto text-muted small">@T["Totals and the balancing line are recalculated when you save."]</span>
        </div>
    }
</div>
</form>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <strong>@T["Tenant Opening Balances (Accounts Receivable)"]</strong>
        <a asp-controller="Tenants" asp-action="Index" class="btn btn-sm btn-outline-primary">@T["Manage Tenants"]</a>
    </div>
    @if (Model.TenantOpeningBalances.Any(x => x.OpeningBalance != 0m))
    {
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@T["Code"]</th>
                        <th>@T["Tenant"]</th>
                        <th class="text-end">@T["Opening Balance"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.TenantOpeningBalances.Where(x => x.OpeningBalance != 0m))
                    {
                        <tr>
                            <td>@if (canEditMasterData) { <a asp-controller="Tenants" asp-action="Edit" asp-route-id="@t.EntityId" title="@T["Edit the tenant's opening balance"]"><code>@t.EntityCode</code></a> } else { <code>@t.EntityCode</code> }</td>
                            <td>@t.EntityName</td>
                            <td class="text-end">@t.OpeningBalance.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="table-light fw-semibold">
                        <td colspan="2" class="text-end">@T["Total"]</td>
                        <td class="text-end">@Model.TenantOpeningTotal.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
    else
    {
        <div class="card-body text-muted">@T["No tenant opening balances captured."]</div>
    }
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <strong>@T["Vendor Opening Balances (Accounts Payable)"]</strong>
        <a asp-controller="Vendors" asp-action="Index" class="btn btn-sm btn-outline-primary">@T["Manage Vendors"]</a>
    </div>
    @if (Model.VendorOpeningBalances.Any(x => x.OpeningBalance != 0m))
    {
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@T["Code"]</th>
                        <th>@T["Vendor"]</th>
                        <th class="text-end">@T["Opening Balance"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model.VendorOpeningBalances.Where(x => x.OpeningBalance != 0m))
                    {
                        <tr>
                            <td>@if (canEditMasterData) { <a asp-controller="Vendors" asp-action="Edit" asp-route-id="@v.EntityId" title="@T["Edit the vendor's opening balance"]"><code>@v.EntityCode</code></a> } else { <code>@v.EntityCode</code> }</td>
                            <td>@v.EntityName</td>
                            <td class="text-end">@v.OpeningBalance.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="table-light fw-semibold">
                        <td colspan="2" class="text-end">@T["Total"]</td>
                        <td class="text-end">@Model.VendorOpeningTotal.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
    else
    {
        <div class="card-body text-muted">@T["No vendor opening balances captured."]</div>
    }
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <strong>@T["Fixed Asset Opening Balances"]</strong>
        <a asp-controller="FixedAssets" asp-action="Index" class="btn btn-sm btn-outline-primary">@T["Manage Fixed Assets"]</a>
    </div>
    @if (Model.FixedAssetOpeningBalances.Any(x => x.OpeningCost != 0m || x.OpeningAccumulatedDepreciation != 0m))
    {
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@T["Code"]</th>
                        <th>@T["Asset"]</th>
                        <th>@T["Asset Account"]</th>
                        <th>@T["Acc. Dep. Account"]</th>
                        <th class="text-end">@T["Opening Cost"]</th>
                        <th class="text-end">@T["Opening Acc. Dep."]</th>
                        <th class="text-end">@T["Opening NBV"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fa in Model.FixedAssetOpeningBalances.Where(x => x.OpeningCost != 0m || x.OpeningAccumulatedDepreciation != 0m))
                    {
                        <tr>
                            <td><a asp-controller="FixedAssets" asp-action="Acquisition" asp-route-id="@fa.AssetId" title="@T["Open the asset"]"><code>@fa.AssetCode</code></a></td>
                            <td>@fa.AssetName</td>
                            <td>@fa.AssetAccountDisplay</td>
                            <td>@fa.AccumulatedDepreciationAccountDisplay</td>
                            <td class="text-end">@fa.OpeningCost.ToString("N2")</td>
                            <td class="text-end">@fa.OpeningAccumulatedDepreciation.ToString("N2")</td>
                            <td class="text-end">@fa.OpeningNetBookValue.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="table-light fw-semibold">
                        <td colspan="4" class="text-end">@T["Totals"]</td>
                        <td class="text-end">@Model.FixedAssetOpeningCostTotal.ToString("N2")</td>
                        <td class="text-end">@Model.FixedAssetOpeningAccumDepTotal.ToString("N2")</td>
                        <td class="text-end">@Model.FixedAssetOpeningNetBookValueTotal.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
    else
    {
        <div class="card-body text-muted">@T["No fixed asset opening balances captured."]</div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('openingForm');
            const status = document.getElementById('obChanged');
            if (!form || !status) return;
            const inputs = Array.from(form.querySelectorAll('.ob-input'));
            const isChanged = i => (parseFloat(i.value || '0') || 0).toFixed(2) !== i.dataset.original;

            function refresh() {
                const changed = inputs.filter(isChanged);
                inputs.forEach(i => i.classList.toggle('ob-changed', isChanged(i)));
                status.textContent = changed.length === 0 ? 'No changes yet.' : changed.length + ' account(s) changed, not saved yet.';
            }

            inputs.forEach(i => i.addEventListener('input', refresh));
            // Only the accounts that changed are sent, numbered from 0 so the list binds.
            form.addEventListener('submit', function () {
                let index = 0;
                inputs.forEach(i => {
                    const id = i.previousElementSibling;
                    if (isChanged(i)) {
                        id.name = 'entries[' + index + '].AccountId';
                        i.name = 'entries[' + index + '].OpeningBalance';
                        index++;
                    } else {
                        id.removeAttribute('name');
                        i.removeAttribute('name');
                    }
                });
            });
            window.addEventListener('beforeunload', function (e) {
                if (!form.dataset.submitting && inputs.some(isChanged)) { e.preventDefault(); e.returnValue = ''; }
            });
            form.addEventListener('submit', () => form.dataset.submitting = '1');
        })();
    </script>
}
