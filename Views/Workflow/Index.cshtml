    <symbol id="i-revenue" viewBox="0 0 24 24"><rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9h18M8 2.5v4M16 2.5v4"/><path d="M8.5 14.5l2.2 2.2 4.3-4.3"/></symbol>
    <symbol id="i-vendor" viewBox="0 0 24 24"><path d="M3 9.5l1.8-5A1.5 1.5 0 0 1 6.2 3.5h11.6a1.5 1.5 0 0 1 1.4 1l1.8 5"/><path d="M3 9.5h18v10a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 19.5z"/><path d="M9 13.5h6"/></symbol>
    <symbol id="i-bill" viewBox="0 0 24 24"><path d="M5 2.5h14v19l-2.3-1.5-2.3 1.5-2.4-1.5-2.3 1.5L5 21.5z"/><path d="M8.5 8.5h7M8.5 12h7M8.5 15.5h4"/></symbol>
