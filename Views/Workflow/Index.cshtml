@using RealEstateManager.Services
@inject PermissionService PermissionService

@{
    ViewData["Title"] = "Workflow";

    var canMasterData = await PermissionService.HasPermissionAsync(User, AppPermissions.MasterDataManage);
    var canLeases = await PermissionService.HasPermissionAsync(User, AppPermissions.LeasesManage);
    var canAccounting = await PermissionService.HasPermissionAsync(User, AppPermissions.AccountingManage);
    var canReports = await PermissionService.HasPermissionAsync(User, AppPermissions.ReportsView);
    var canVendors = canMasterData || canAccounting;
}

<style>
    .wf-page-head { margin-bottom: 1.25rem; }

    .wf-canvas {
        border: 1px solid #d8dee6;
        border-radius: 10px;
        background: #fbfcfe;
        padding: 1rem .85rem .9rem;
        margin-bottom: 1.15rem;
    }

    .wf-band-title {
        font-size: .72rem;
        text-transform: uppercase;
        letter-spacing: .09em;
        font-weight: 700;
        color: #5b6774;
        border-bottom: 1px solid #e3e8ee;
        padding-bottom: .4rem;
        margin-bottom: .9rem;
    }

    .wf-row {
        display: flex;
        align-items: stretch;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0;
    }

    .wf-node {
        width: 132px;
        text-align: center;
        border: 1px solid #d8dee6;
        border-radius: 10px;
        background: #fff;
        padding: .7rem .4rem .6rem;
        box-shadow: 0 1px 2px rgba(15, 39, 64, .06);
        text-decoration: none;
        color: inherit;
        display: block;
        transition: transform .12s ease, box-shadow .12s ease, border-color .12s ease;
    }

    a.wf-node:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(15, 39, 64, .14);
        border-color: #1e6fd9;
        color: inherit;
    }

    .wf-node.disabled {
        opacity: .45;
        filter: grayscale(1);
        pointer-events: none;
    }

    .wf-node .tile {
        width: 60px;
        height: 60px;
        margin: 0 auto .5rem;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e8f1fd;
        border: 1px solid #c8ddf8;
    }

    .wf-node .tile svg {
        width: 32px;
        height: 32px;
        stroke: #1e6fd9;
        fill: none;
        stroke-width: 1.7;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .wf-node .lbl {
        font-weight: 700;
        font-size: .82rem;
        color: #0f2740;
        line-height: 1.2;
    }

    .wf-node .hint {
        font-size: .68rem;
        color: #5b6774;
        line-height: 1.3;
        margin-top: .25rem;
    }

    .wf-node .step-no {
        display: inline-block;
        background: #0f2740;
        color: #fff;
        font-size: .62rem;
        font-weight: 700;
        letter-spacing: .04em;
        border-radius: 10px;
        padding: .1rem .5rem;
        margin-bottom: .4rem;
    }

    .wf-arrow {
        align-self: center;
        width: 38px;
        flex: 0 0 38px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .wf-arrow svg {
        width: 28px;
        height: 15px;
        stroke: #7f9dbd;
        fill: none;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .wf-elbow {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: .5rem;
        color: #5b6774;
        font-size: .72rem;
        margin: .55rem 0 .75rem;
    }

    .wf-elbow .line { height: 1px; background: #b9cbdd; width: 110px; }
    .wf-elbow svg { width: 15px; height: 15px; stroke: #7f9dbd; fill: none; stroke-width: 1.8; }

    .wf-node.support .tile { background: #f3f5f8; border-color: #dfe4ea; }
    .wf-node.support .tile svg { stroke: #1b3a5c; }
    .wf-node.support .lbl { color: #1b3a5c; }

    .wf-legend { display: flex; gap: 1.2rem; flex-wrap: wrap; font-size: .74rem; color: #5b6774; margin-top: .7rem; }
    .wf-legend .k { display: inline-flex; align-items: center; gap: .4rem; }
    .wf-legend .sw { width: 15px; height: 15px; border-radius: 4px; border: 1px solid #c8ddf8; background: #e8f1fd; }
    .wf-legend .sw.s2 { background: #f3f5f8; border-color: #dfe4ea; }

    @@media (max-width: 991.98px) {
        .wf-arrow { display: none; }
        .wf-row { gap: .6rem; }
        .wf-elbow { display: none; }
    }

    @@media print {
        .wf-no-print { display: none !important; }
        a.wf-node { box-shadow: none; }
    }
</style>

