@model RealEstateManager.Models.ServiceRequestCreateViewModel
@using RealEstateManager.Domain
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = T["Order a service"];
    var service = (PaidServiceService.Option)ViewBag.Service;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h5 mb-0">@T["Order a service"]</h1>
    <a asp-action="Services" class="btn btn-outline-secondary btn-sm">@T["Cancel"]</a>
</div>

<div class="card shadow-sm mb-3 border-primary">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start gap-3">
            <div>
                <div class="small text-uppercase text-muted">@T[ServiceKinds.Describe(service.Kind)]</div>
                <div class="fw-semibold">@service.Name</div>
                @if (!string.IsNullOrWhiteSpace(service.Description))
                {
                    <div class="small text-muted">@service.Description</div>
                }
            </div>
            <div class="text-end text-nowrap">
                @if (service.Price > 0m)
                {
                    <div class="fw-bold fs-5">@service.PriceWithVat.ToString("N2")</div>
                    @if (service.PriceWithVat > service.Price)
                    {
                        <div class="small text-muted">@T.Format("{0} + VAT {1}", service.Price.ToString("N2"), (service.PriceWithVat - service.Price).ToString("N2"))</div>
                    }
                }
                else
                {
                    <div class="fw-semibold">@T["On quotation"]</div>
                }
            </div>
        </div>
        <div class="alert alert-info small mb-0 mt-3">
            @(service.Price <= 0m
                ? T["We will confirm the price with you and send the invoice here."]
                : service.PayBeforeWork
                    ? T["We will confirm your order and send the invoice here. The work starts once the invoice is paid."]
                    : T["We will confirm your order and send the invoice here."])
        </div>
    </div>
</div>

<form asp-action="OrderService" asp-route-id="@service.Id" method="post" id="requestForm" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label fw-semibold" for="LeaseId">@T["Which property?"]</label>
                <select id="LeaseId" name="LeaseId" class="form-select" required>
                    @if (Model.Leases.Count != 1)
                    {
                        <option value="">@T["-- choose --"]</option>
                    }
                    @foreach (var lease in Model.Leases)
                    {
                        <option value="@lease.LeaseId" selected="@(lease.LeaseId == Model.LeaseId ? "selected" : null)">@lease.Description (@lease.ContractNumber)</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label" for="PreferredVisitDate">@T["Preferred date"]</label>
                <input id="PreferredVisitDate" name="PreferredVisitDate" type="date" class="form-control"
                       value="@Model.PreferredVisitDate?.ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <div class="form-text">@T["We will do our best, but cannot promise this exact day."]</div>
            </div>

            <div class="mb-3">
                <label class="form-label" for="Description">@T["Anything we should know? (optional)"]</label>
                <textarea id="Description" name="Description" class="form-control" rows="3" maxlength="4000"
                          placeholder="@T["e.g. The best time to come, or what exactly you need."]">@Model.Description</textarea>
            </div>

            <div class="mb-0">
                <label class="form-label" for="photos">@T["Photos (optional)"]</label>
                <input id="photos" name="photos" type="file" class="form-control request-photos" accept="image/jpeg,image/png,image/webp" multiple
                       data-max="@ServiceRequestPhotoService.MaxPerRequest"
                       data-too-many="@T.Format("Only the first {0} photos will be sent.", ServiceRequestPhotoService.MaxPerRequest)" />
                <div class="form-text text-danger request-photos-note"></div>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-dark w-100">
        @(service.Price > 0m ? T.Format("Order for {0}", service.PriceWithVat.ToString("N2")) : T["Send the order"])
    </button>
</form>

@section Scripts {
    <script src="~/js/request-photos.js" asp-append-version="true"></script>
}
