@model List<RealEstateManager.Models.PortalReceiptViewModel>
@using RealEstateManager.Models
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "My Payments";
    var pdcs = ViewBag.Pdcs as List<PortalPdcViewModel> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h5 mb-0">My Payments</h1>
    <button type="button" class="btn btn-outline-secondary btn-sm no-print" onclick="window.print()">Print</button>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light"><strong>Payments Received</strong></div>
    @if (Model.Count == 0)
    {
        <div class="card-body text-muted">No payments recorded yet.</div>
    }
    else
    {
        <div class="scroll-x">
            <table class="table table-bordered table-sm mb-0">
                <thead>
                    <tr>
                        <th>Receipt</th>
                        <th>Date</th>
                        <th>Method</th>
                        <th>Against invoice</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var receipt in Model)
                    {
                        <tr>
                            <td>@receipt.ReceiptNumber</td>
                            <td>@receipt.ReceiptDate.ToString("dd/MM/yyyy")</td>
                            <td>@receipt.PaymentMethod</td>
                            <td>@receipt.AgainstInvoice</td>
                            <td class="text-end fw-semibold">@receipt.Amount.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <th colspan="4">Total received</th>
                        <th class="text-end">@Model.Sum(x => x.Amount).ToString("N2")</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>

<div class="card shadow-sm">
    <div class="card-header bg-light"><strong>My Cheques</strong></div>
    @if (pdcs.Count == 0)
    {
        <div class="card-body text-muted">No cheques on record.</div>
    }
    else
    {
        <div class="scroll-x">
            <table class="table table-bordered table-sm mb-0">
                <thead>
                    <tr>
                        <th>Cheque</th>
                        <th>Bank</th>
                        <th>Cheque date</th>
                        <th>Cleared</th>
                        <th class="text-end">Amount</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pdc in pdcs)
                    {
                        var badge = pdc.Status switch
                        {
                            "Cleared" => "bg-success",
                            "Received" => "bg-primary",
                            "Bounced" => "bg-danger",
                            _ => "bg-secondary"
                        };
                        <tr>
                            <td>@pdc.ChequeNumber</td>
                            <td>@(string.IsNullOrWhiteSpace(pdc.BankName) ? "-" : pdc.BankName)</td>
                            <td>@pdc.ChequeDate.ToString("dd/MM/yyyy")</td>
                            <td>@(pdc.ClearedDate.HasValue ? pdc.ClearedDate.Value.ToString("dd/MM/yyyy") : "-")</td>
                            <td class="text-end fw-semibold">@pdc.Amount.ToString("N2")</td>
                            <td><span class="badge @badge">@pdc.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-body small text-muted">
            A cheque marked <strong>Received</strong> is being held and has not yet been presented to the
            bank &mdash; it does not reduce your balance until it clears. Make sure funds are available on the
            cheque date.
        </div>
    }
</div>
