@model List<RealEstateManager.Models.ServiceRequestListItemViewModel>
@using RealEstateManager.Domain
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = T["My Requests"];

    var open = Model.Where(x => x.Status != ServiceRequestStatuses.Closed
                                && x.Status != ServiceRequestStatuses.Cancelled
                                && x.Status != ServiceRequestStatuses.Rejected).ToList();
    var closed = Model.Except(open).ToList();
}

@if (TempData["PortalSuccess"] != null)
{
    <div class="alert alert-success">@TempData["PortalSuccess"]</div>
}
@if (TempData["PortalError"] != null)
{
    <div class="alert alert-danger">@TempData["PortalError"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h5 mb-0">@T["My Requests"]</h1>
    <a asp-action="NewRequest" class="btn btn-dark btn-sm">@T["New request"]</a>
</div>

@if (Model.Count == 0)
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <p class="mb-2">@T.Html("<strong>You have not made any requests yet.</strong>")</p>
            <p class="text-muted small mb-3">
                @T["Use this to report something that needs fixing, ask for more time to pay an invoice, ask about renewing your contract, or raise anything else with us."]
            </p>
            <a asp-action="NewRequest" class="btn btn-dark">@T["Make a request"]</a>
        </div>
    </div>
}
else
{
    @if (open.Count > 0)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white">@T.Html("<strong>Open</strong>")</div>
            <div class="list-group list-group-flush">
                @foreach (var request in open)
                {
                    <a asp-action="RequestDetails" asp-route-id="@request.Id"
                       class="list-group-item list-group-item-action">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div>
                                <div class="fw-semibold">@request.Subject</div>
                                <div class="small text-muted">
                                    @request.RequestNumber &middot;
                                    @ServiceRequestTypes.Describe(request.RequestType)
                                    @if (!string.IsNullOrWhiteSpace(request.Category))
                                    {
                                        <text>&middot; @request.Category</text>
                                    }
                                </div>
                                <div class="small text-muted">
                                    Sent @request.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy")
                                    @if (request.MessageCount > 0)
                                    {
                                        <text>&middot; @request.MessageCount message@(request.MessageCount == 1 ? "" : "s")</text>
                                    }
                                </div>
                            </div>
                            <span class="badge @ServiceRequestStatuses.BadgeClass(request.Status)">
                                @ServiceRequestStatuses.Describe(request.Status)
                            </span>
                        </div>
                    </a>
                }
            </div>
        </div>
    }

    @if (closed.Count > 0)
    {
        <div class="card shadow-sm">
            <div class="card-header bg-white">@T.Html("<strong>Finished</strong>")</div>
            <div class="list-group list-group-flush">
                @foreach (var request in closed)
                {
                    <a asp-action="RequestDetails" asp-route-id="@request.Id"
                       class="list-group-item list-group-item-action">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div>
                                <div class="fw-semibold text-muted">@request.Subject</div>
                                <div class="small text-muted">
                                    @request.RequestNumber &middot;
                                    @request.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy")
                                </div>
                            </div>
                            <span class="badge @ServiceRequestStatuses.BadgeClass(request.Status)">
                                @ServiceRequestStatuses.Describe(request.Status)
                            </span>
                        </div>
                    </a>
                }
            </div>
        </div>
    }
}
