@model RealEstateManager.Models.ServiceRequestCreateViewModel
@using RealEstateManager.Domain
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "New Request";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h5 mb-0">New Request</h1>
    <a asp-action="Requests" class="btn btn-outline-secondary btn-sm">Cancel</a>
</div>

@if (ViewBag.MaintenanceHold is string hold)
{
    <div class="alert alert-warning" id="maintenanceHold">
        <strong>Maintenance requests are on hold.</strong> @hold
        You can still send other requests, such as asking for more time to pay.
    </div>
}

<form asp-action="NewRequest" method="post" id="requestForm">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="mb-3">
                <label asp-for="RequestType" class="form-label fw-semibold">What do you need?</label>
                <select asp-for="RequestType" class="form-select" id="requestType">
                    @foreach (var type in ServiceRequestTypes.All)
                    {
                        <option value="@type" selected="@(type == Model.RequestType ? "selected" : null)">
                            @ServiceRequestTypes.Describe(type)
                        </option>
                    }
                </select>
            </div>

            @* Shown only for maintenance. *@
            <div class="mb-3 type-maintenance">
                <label asp-for="Category" class="form-label">What kind of problem?</label>
                <select asp-for="Category" class="form-select">
                    <option value="">-- choose --</option>
                    @foreach (var category in ServiceRequestCategories.Maintenance)
                    {
                        <option value="@category" selected="@(category == Model.Category ? "selected" : null)">
                            @category
                        </option>
                    }
                </select>
            </div>

            @if (Model.Leases.Count > 0)
            {
                <div class="mb-3">
                    <label asp-for="LeaseId" class="form-label">Which property?</label>
                    <select asp-for="LeaseId" class="form-select">
                        <option value="">-- not about a specific property --</option>
                        @foreach (var lease in Model.Leases)
                        {
                            <option value="@lease.LeaseId" selected="@(lease.LeaseId == Model.LeaseId ? "selected" : null)">
                                @lease.Description (@lease.ContractNumber)
                            </option>
                        }
                    </select>
                </div>
            }

            <div class="mb-3">
                <label asp-for="Subject" class="form-label fw-semibold">Short title</label>
                <input asp-for="Subject" class="form-control" maxlength="200"
                       placeholder="e.g. Kitchen tap is leaking" />
                <span asp-validation-for="Subject" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-semibold">Tell us more</label>
                <textarea asp-for="Description" class="form-control" rows="5" maxlength="4000"
                          placeholder="Describe it as fully as you can - when it started, where exactly, and anything you have already tried."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Priority" class="form-label">How urgent is it?</label>
                <select asp-for="Priority" class="form-select">
                    @foreach (var priority in ServiceRequestPriorities.All)
                    {
                        <option value="@priority" selected="@(priority == Model.Priority ? "selected" : null)">
                            @priority
                        </option>
                    }
                </select>
                <div class="form-text">
                    Choose <strong>Urgent</strong> only for something unsafe or causing damage right now,
                    such as a burst pipe or no electricity.
                </div>
            </div>

            @* Maintenance only. *@
            <div class="mb-3 type-maintenance">
                <label asp-for="PreferredVisitDate" class="form-label">Preferred visit date</label>
                <input asp-for="PreferredVisitDate" type="date" class="form-control" />
                <div class="form-text">We will do our best, but cannot promise this exact day.</div>
                <span asp-validation-for="PreferredVisitDate" class="text-danger small"></span>
            </div>

            @* Payment postponement only. *@
            <div class="type-postponement">
                <hr />
                @if (Model.OutstandingInvoices.Count == 0)
                {
                    <div class="alert alert-info mb-0">
                        You have no unpaid invoices at the moment, so there is nothing to postpone.
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <label asp-for="RelatedInvoiceId" class="form-label fw-semibold">Which invoice?</label>
                        <select asp-for="RelatedInvoiceId" class="form-select">
                            <option value="">-- choose the invoice --</option>
                            @foreach (var invoice in Model.OutstandingInvoices)
                            {
                                <option value="@invoice.InvoiceId" selected="@(invoice.InvoiceId == Model.RelatedInvoiceId ? "selected" : null)">
                                    @invoice.Display
                                </option>
                            }
                        </select>
                        <span asp-validation-for="RelatedInvoiceId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RequestedNewDueDate" class="form-label fw-semibold">
                            What date could you pay by?
                        </label>
                        <input asp-for="RequestedNewDueDate" type="date" class="form-control" />
                        <span asp-validation-for="RequestedNewDueDate" class="text-danger small"></span>
                    </div>

                    <div class="alert alert-warning mb-0 small">
                        <strong>Please note.</strong> This is a request, not an agreement. The amount you owe
                        does not change, and the current due date stays in force unless and until we confirm
                        otherwise. We will reply here.
                    </div>
                }
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-dark w-100">Send request</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            // Show only the fields that belong to the chosen kind of request, so the
            // form stays short rather than asking about invoices when a tap is leaking.
            var typeSelect = document.getElementById('requestType');

            function sync() {
                var type = typeSelect.value;

                document.querySelectorAll('.type-maintenance').forEach(function (el) {
                    el.style.display = (type === 'Maintenance') ? '' : 'none';
                });

                document.querySelectorAll('.type-postponement').forEach(function (el) {
                    el.style.display = (type === 'PaymentPostponement') ? '' : 'none';
                });
            }

            typeSelect.addEventListener('change', sync);
            sync();
        })();
    </script>
}
