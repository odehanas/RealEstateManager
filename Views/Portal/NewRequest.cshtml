@model RealEstateManager.Models.ServiceRequestCreateViewModel
@using RealEstateManager.Domain
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = T["New Request"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h5 mb-0">@T["New Request"]</h1>
    <a asp-action="Requests" class="btn btn-outline-secondary btn-sm">@T["Cancel"]</a>
</div>

@if (ViewBag.MaintenanceHold is string hold)
{
    <div class="alert alert-warning" id="maintenanceHold">
        @T.HtmlFormat("<strong>Maintenance requests are on hold.</strong> {0} You can still send other requests, such as asking for more time to pay.", hold)
    </div>
}

<form asp-action="NewRequest" method="post" id="requestForm" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="mb-3">
                <label asp-for="RequestType" class="form-label fw-semibold">@T["What do you need?"]</label>
                <select asp-for="RequestType" class="form-select" id="requestType">
                    @foreach (var type in ServiceRequestTypes.All)
                    {
                        <option value="@type" selected="@(type == Model.RequestType ? "selected" : null)">
                            @ServiceRequestTypes.Describe(type)
                        </option>
                    }
                </select>
            </div>

            @if (Model.Services.Count > 0)
            {
                <div class="alert alert-light border small py-2">
                    @T["Looking for cleaning or another service you pay for?"]
                    <a asp-action="Services">@T["See the paid services"]</a>
                </div>
            }

            @* Shown only for maintenance. *@
            <div class="mb-3 type-maintenance">
                <label asp-for="Category" class="form-label">@T["What kind of problem?"]</label>
                <select asp-for="Category" class="form-select">
                    <option value="">@T["-- choose --"]</option>
                    @foreach (var category in await MaintenanceCategories.NamesAsync(Model.Category))
                    {
                        <option value="@category" selected="@(category == Model.Category ? "selected" : null)">
                            @category
                        </option>
                    }
                </select>
            </div>

            @if (Model.Leases.Count > 0)
            {
                <div class="mb-3">
                    <label asp-for="LeaseId" class="form-label">@T["Which property?"]</label>
                    <select asp-for="LeaseId" class="form-select">
                        <option value="">@T["-- not about a specific property --"]</option>
                        @foreach (var lease in Model.Leases)
                        {
                            <option value="@lease.LeaseId" selected="@(lease.LeaseId == Model.LeaseId ? "selected" : null)">
                                @lease.Description (@lease.ContractNumber)
                            </option>
                        }
                    </select>
                </div>
            }

            <div class="mb-3">
                <label asp-for="Subject" class="form-label fw-semibold">@T["Short title"]</label>
                <input asp-for="Subject" class="form-control" maxlength="200"
                       placeholder="@T["e.g. Kitchen tap is leaking"]" />
                <span asp-validation-for="Subject" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-semibold">@T["Tell us more"]</label>
                <textarea asp-for="Description" class="form-control" rows="5" maxlength="4000"
                          placeholder="@T["Describe it as fully as you can - when it started, where exactly, and anything you have already tried."]"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Priority" class="form-label">@T["How urgent is it?"]</label>
                <select asp-for="Priority" class="form-select">
                    @foreach (var priority in ServiceRequestPriorities.All)
                    {
                        <option value="@priority" selected="@(priority == Model.Priority ? "selected" : null)">
                            @priority
                        </option>
                    }
                </select>
                <div class="form-text">
                    @T.Html("Choose <strong>Urgent</strong> only for something unsafe or causing damage right now, such as a burst pipe or no electricity.")
                </div>
            </div>

            @* Maintenance and paid services. *@
            <div class="mb-3 type-visit">
                <label asp-for="PreferredVisitDate" class="form-label">@T["Preferred visit date"]</label>
                <input asp-for="PreferredVisitDate" type="date" class="form-control" />
                <div class="form-text">@T["We will do our best, but cannot promise this exact day."]</div>
                <span asp-validation-for="PreferredVisitDate" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" for="photos">@T["Photos (optional)"]</label>
                <input id="photos" name="photos" type="file" class="form-control request-photos" accept="image/jpeg,image/png,image/webp" multiple
                       data-max="@ServiceRequestPhotoService.MaxPerRequest"
                       data-too-many="@T.Format("Only the first {0} photos will be sent.", ServiceRequestPhotoService.MaxPerRequest)" />
                <div class="form-text">@T.Format("Up to {0} photos of the problem. You can add them later too, from the request.", ServiceRequestPhotoService.MaxPerRequest)</div>
                <div class="form-text text-danger request-photos-note"></div>
            </div>

            @* Payment postponement only. *@
            <div class="type-postponement">
                <hr />
                @if (Model.OutstandingInvoices.Count == 0)
                {
                    <div class="alert alert-info mb-0">
                        @T["You have no unpaid invoices at the moment, so there is nothing to postpone."]
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <label asp-for="RelatedInvoiceId" class="form-label fw-semibold">@T["Which invoice?"]</label>
                        <select asp-for="RelatedInvoiceId" class="form-select">
                            <option value="">@T["-- choose the invoice --"]</option>
                            @foreach (var invoice in Model.OutstandingInvoices)
                            {
                                <option value="@invoice.InvoiceId" selected="@(invoice.InvoiceId == Model.RelatedInvoiceId ? "selected" : null)">
                                    @invoice.Display
                                </option>
                            }
                        </select>
                        <span asp-validation-for="RelatedInvoiceId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RequestedNewDueDate" class="form-label fw-semibold">
                            @T["What date could you pay by?"]
                        </label>
                        <input asp-for="RequestedNewDueDate" type="date" class="form-control" />
                        <span asp-validation-for="RequestedNewDueDate" class="text-danger small"></span>
                    </div>

                    <div class="alert alert-warning mb-0 small">
                        @T.Html("<strong>Please note.</strong> This is a request, not an agreement. The amount you owe does not change, and the current due date stays in force unless and until we confirm otherwise. We will reply here.")
                    </div>
                }
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-dark w-100">@T["Send request"]</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/request-photos.js" asp-append-version="true"></script>
    <script>
        (function () {
            // Show only the fields that belong to the chosen kind of request, so the
            // form stays short rather than asking about invoices when a tap is leaking.
            var typeSelect = document.getElementById('requestType');

            function sync() {
                var type = typeSelect.value;

                document.querySelectorAll('.type-maintenance').forEach(function (el) {
                    el.style.display = (type === 'Maintenance') ? '' : 'none';
                });

                document.querySelectorAll('.type-postponement').forEach(function (el) {
                    el.style.display = (type === 'PaymentPostponement') ? '' : 'none';
                });

                // A paid service: the service list in place of the kind of problem.
                document.querySelectorAll('.type-service').forEach(function (el) {
                    el.style.display = (typeSelect.value === 'PaidService') ? '' : 'none';
                });
                document.querySelectorAll('.type-visit').forEach(function (el) {
                    el.style.display = (typeSelect.value === 'Maintenance' || typeSelect.value === 'PaidService') ? '' : 'none';
                });
                var chosen = document.getElementById('serviceSelect');
                var about = document.getElementById('serviceAbout');
                if (chosen && about) {
                    about.textContent = chosen.selectedOptions.length ? (chosen.selectedOptions[0].getAttribute('data-about') || '') : '';
                    chosen.onchange = function () {
                        // Picking a service is enough: its name fills the title and the text
                        // unless something has been typed there.
                        var option = chosen.selectedOptions[0];
                        var name = option ? (option.getAttribute('data-name') || '') : '';
                        var subject = document.getElementById('Subject');
                        var text = document.getElementById('Description');
                        if (name && subject && (!subject.value || subject.dataset.filled === subject.value)) {
                            subject.value = name;
                            subject.dataset.filled = name;
                        }
                        if (name && text && (!text.value || text.dataset.filled === text.value)) {
                            text.value = (option.getAttribute('data-about') || name);
                            text.dataset.filled = text.value;
                        }
                        sync();
                    };
                }
            }

            typeSelect.addEventListener('change', sync);
            sync();
        })();
    </script>
}
