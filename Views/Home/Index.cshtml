@using RealEstateManager.Models
@model RealEstateManager.Models.HomeDashboardViewModel
@inject RealEstateManager.Services.ICurrentCompanyAccessor CurrentCompanyAccessor
@inject RealEstateManager.Services.SubscriptionService SubscriptionService
@inject RealEstateManager.Services.ApprovalService ApprovalService
@inject RealEstateManager.Services.PermissionService PermissionService

@{
    ViewData["Title"] = T["Home"];
    var dateValue = Model.Today.ToString("yyyy-MM-dd");

    // The subscription is always in view on the dashboard, not only when it is about to end.
    // The layout's own warning banner stands aside on this page so it is not said twice.
    ViewData["SubscriptionShownOnPage"] = true;
    var subscription = CurrentCompanyAccessor.CompanyId.HasValue
        ? await SubscriptionService.GetStatusAsync(CurrentCompanyAccessor.CompanyId.Value)
        : null;
    var endingSoon = subscription != null && !subscription.IsExpired
                     && subscription.DaysRemaining <= (subscription.IsInTrial ? 5 : 14);
    // Contracts waiting for this person to approve (never their own).
    var approvalsWaiting = CurrentCompanyAccessor.UserId.HasValue
                           && await PermissionService.HasPermissionAsync(User, RealEstateManager.Services.AppPermissions.LeasesApprove)
        ? await ApprovalService.CountAwaitingAsync(CurrentCompanyAccessor.UserId.Value)
        : 0;
    var daysText = subscription == null ? string.Empty
        : subscription.DaysRemaining == 0 ? "ends today"
        : $"{subscription.DaysRemaining} day{(subscription.DaysRemaining == 1 ? "" : "s")} left";
    var (noteClass, noteIcon, noteLabel) = subscription switch
    {
        null => ("", "", ""),
        { IsSuspended: true } => ("alert-danger", "&#9888;", "Suspended"),
        { IsExpired: true } => ("alert-danger", "&#9888;", "Expired"),
        { IsInTrial: true } when endingSoon => ("alert-warning", "&#9201;", "Free trial ending soon"),
        _ when endingSoon => ("alert-warning", "&#9201;", "Ending soon"),
        { IsInTrial: true } => ("alert-info", "&#9432;", "Free trial"),
        _ => ("alert-success", "&#10003;", "Active")
    };
}

<style>
    @@media print {
        .dashboard-no-print {
            display: none !important;
        }

        .dashboard-print-card {
            break-inside: avoid;
        }

        .container {
            max-width: 100% !important;
        }
    }
</style>

@if (subscription != null)
{
    <div class="alert @noteClass d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 py-2 dashboard-no-print"
         role="status">
        <div>
            <span class="me-1" aria-hidden="true">@Html.Raw(noteIcon)</span>
            <strong>Subscription: @noteLabel</strong>
            @if (subscription.IsSuspended)
            {
                <span> - access to @subscription.CompanyName has been suspended. Please contact your service provider.</span>
            }
            else if (subscription.IsExpired)
            {
                <span> - ended on @subscription.AccessEndDate?.ToString("dd/MM/yyyy"). Enter an activation code to continue working.</span>
            }
            else
            {
                <span> - <strong>@daysText</strong>, until @subscription.AccessEndDate?.ToString("dd/MM/yyyy").</span>
                @if (endingSoon)
                {
                    <span> @T["Renew in time to keep working without interruption."]</span>
                }
            }
        </div>
        <a asp-controller="Subscription" asp-action="Index" class="btn btn-sm btn-outline-dark text-nowrap">@T["Manage subscription"]</a>
    </div>
}

@if (approvalsWaiting > 0)
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center gap-2 py-2 dashboard-no-print" role="status">
        <div>
            <span class="me-1" aria-hidden="true">&#9998;</span>
            <strong>@approvalsWaiting contract@(approvalsWaiting == 1 ? " is" : "s are") waiting for your approval.</strong>
            They take effect only once approved.
        </div>
        <a asp-controller="Approvals" asp-action="Index" class="btn btn-sm btn-outline-dark text-nowrap">@T["Review"]</a>
    </div>
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success dashboard-no-print">@successMessage</div>
}

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4 gap-3 dashboard-no-print">
    <div>
        <h1 class="fw-bold mb-1">@T["Dashboard"]</h1>
        <p class="text-muted mb-0">@T["Portfolio, collections, liabilities, and tenant activity in one operational view."]</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <div class="text-muted">
            <strong>Today:</strong> @Model.Today.ToString("dd/MM/yyyy")
        </div>
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">@T["Print Dashboard"]</button>
    </div>
</div>

<div class="d-none d-print-block mb-4">
    <h1 class="fw-bold mb-1">@T["Management Dashboard Snapshot"]</h1>
    <div>Printed on @Model.Today.ToString("dd/MM/yyyy")</div>
    <div>Current Period: @Model.CurrentPeriodName</div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm h-100 border-0 bg-primary text-white">
            <div class="card-body">
                <div class="small text-uppercase opacity-75">@T["Properties"]</div>
                <div class="display-6 fw-bold">@Model.PropertiesCount</div>
                <div>Owned: @Model.OwnedPropertiesCount</div>
                <div>Managed: @Model.ManagedPropertiesCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm h-100 border-0 bg-success text-white">
            <div class="card-body">
                <div class="small text-uppercase opacity-75">@T["Occupancy"]</div>
                <div class="display-6 fw-bold">@Model.OccupancyRate.ToString("N2")%</div>
                <div>Occupied: @Model.OccupiedUnitsCount</div>
                <div>Vacant: @Model.VacantUnitsCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm h-100 border-0 bg-dark text-white">
            <div class="card-body">
                <div class="small text-uppercase opacity-75">@T["Receivables"]</div>
                <div class="display-6 fw-bold">@Model.OutstandingReceivables.ToString("N2")</div>
                <div>Open invoices: @Model.OutstandingInvoicesCount</div>
                <div>Overdue: @Model.OverdueReceivables.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm h-100 border-0 bg-warning">
            <div class="card-body">
                <div class="small text-uppercase text-muted">@T["Accounting Period"]</div>
                <div class="fw-bold fs-4">@Model.CurrentPeriodName</div>
                <div>Open periods: @Model.OpenPeriodsCount</div>
                <div>Active leases: @Model.ActiveLeasesCount</div>
            </div>
        </div>
    </div>
</div>

@if (Model.HrAlerts is { } hr && (hr.ExpiredDocuments + hr.ExpiringDocuments + hr.PendingLeave > 0 || hr.PayrollDueMonth != null))
{
    <div class="card shadow-sm border-0 mb-4 dashboard-print-card">
        <div class="card-header bg-light d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h5 class="mb-0">@T["HR & Payroll"]</h5>
            <span class="small text-muted">@hr.ActiveEmployees active employee(s)</span>
        </div>
        <div class="card-body d-flex flex-wrap gap-3">
            @if (hr.PayrollDueMonth != null)
            {
                <a asp-controller="Payroll" asp-action="Index" class="btn btn-outline-danger">Payroll for @hr.PayrollDueMonth @hr.PayrollDueStatus</a>
            }
            @if (hr.ExpiredDocuments > 0)
            {
                <a asp-controller="Employees" asp-action="Documents" class="btn btn-danger">@hr.ExpiredDocuments document(s) expired</a>
            }
            @if (hr.ExpiringDocuments > 0)
            {
                <a asp-controller="Employees" asp-action="Documents" asp-route-days="30" class="btn btn-warning">@hr.ExpiringDocuments document(s) expire within 30 days</a>
            }
            @if (hr.PendingLeave > 0)
            {
                <a asp-controller="Leave" asp-action="Index" class="btn btn-outline-dark">@hr.PendingLeave leave request(s) to decide</a>
            }
        </div>
    </div>
}

@if (Model.UnclosedPeriods is { } unclosed)
{
    var needsAttention = unclosed.OverdueCount > 0 || unclosed.UnclosedFiscalYears.Count > 0 || unclosed.PendingReopenRequests > 0;
    <div class="card shadow-sm border-0 mb-4 dashboard-print-card @(needsAttention ? "border-start border-4 border-danger" : "")">
        <div class="card-header bg-light d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h5 class="mb-0">@T["Unclosed Periods"]</h5>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                @if (unclosed.OverdueCount > 0)
                {
                    <span class="badge bg-danger">@unclosed.OverdueCount overdue for closing</span>
                }
                @if (unclosed.PendingReopenRequests > 0)
                {
                    <a asp-controller="Closing" asp-action="ReopenRequests" class="badge bg-warning text-dark text-decoration-none">
                        @unclosed.PendingReopenRequests reopen request(s) waiting
                    </a>
                }
                <a asp-controller="Closing" asp-action="Index" class="btn btn-sm btn-dark dashboard-no-print">@T["Open Closing Cockpit"]</a>
            </div>
        </div>
        <div class="card-body p-0">
            @if (unclosed.UnclosedFiscalYears.Count > 0)
            {
                <div class="alert alert-danger rounded-0 mb-0 py-2">
                    Fiscal year @string.Join(", ", unclosed.UnclosedFiscalYears) has ended but is not closed:
                    its profit or loss is not yet in retained earnings.
                </div>
            }
            @if (unclosed.Periods.Count == 0)
            {
                <div class="p-3 text-muted">@T["Every period up to today is closed."]</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>@T["Period"]</th>
                                <th>@T["Dates"]</th>
                                <th>@T["Status"]</th>
                                <th class="text-end">@T["Draft journals"]</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in unclosed.Periods)
                            {
                                <tr>
                                    <td class="fw-semibold">@p.Name <span class="text-muted fw-normal small">FY @p.FiscalYear</span></td>
                                    <td class="small">@p.StartDate.ToString("dd/MM/yyyy") - @p.EndDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (p.DaysOverdue > 0)
                                        {
                                            <span class="badge bg-danger">Overdue @p.DaysOverdue day(s)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">@T["Current period"]</span>
                                        }
                                        @if (p.IsReopened)
                                        {
                                            <span class="badge bg-primary">@T["Reopened - to close again"]</span>
                                        }
                                    </td>
                                    <td class="text-end">@(p.DraftJournals > 0 ? p.DraftJournals.ToString() : "-")</td>
                                    <td class="text-end dashboard-no-print">
                                        <a asp-controller="Closing" asp-action="Index" asp-route-fiscalYear="@p.FiscalYear" asp-route-period="@p.PeriodNumber"
                                           class="btn btn-sm btn-outline-dark">@T["Checklist"]</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@{
    var occupancyGauge = new GaugeModel
    {
        Title = "Occupancy",
        Value = Model.OccupancyRate,
        HasValue = Model.ActiveUnitsCount > 0,
        Bands = GaugeModel.HigherIsBetter(0, DashboardTargets.OccupancyWatch, DashboardTargets.OccupancyGood, 100),
        Notes = { $"{Model.OccupiedUnitsCount} of {Model.ActiveUnitsCount} units let",
                  $"Vacant {Model.VacantUnitsCount} · maintenance {Model.UnderMaintenanceUnitsCount} · reserved {Model.ReservedUnitsCount}" },
        Link = Url.Action("Index", "BuildingView"), LinkText = "Building view"
    };
    var collectionGauge = new GaugeModel
    {
        Title = "Collection This Month",
        Value = Model.MonthlyCollectionRate,
        Max = DashboardTargets.CollectionMax,
        HasValue = Model.ThisMonthInvoices > 0m,
        Bands = GaugeModel.HigherIsBetter(0, DashboardTargets.CollectionWatch, DashboardTargets.CollectionGood, DashboardTargets.CollectionMax),
        Notes = { $"Received {Model.ThisMonthReceipts:N0} of {Model.ThisMonthInvoices:N0} billed" },
        Link = Url.Action("Index", "CustomerReceipts"), LinkText = "Customer receipts"
    };
    var overdueGauge = new GaugeModel
    {
        Title = "Overdue Pressure",
        Value = Model.OverdueReceivablesRate,
        HasValue = Model.OutstandingReceivables > 0m,
        Bands = GaugeModel.LowerIsBetter(0, DashboardTargets.OverdueWatch, DashboardTargets.OverdueHigh, 100),
        Notes = { $"{Model.OverdueReceivables:N0} overdue of {Model.OutstandingReceivables:N0} owed",
                  $"{Model.OverdueInvoicesCount} overdue invoice(s)" },
        Link = Url.Action("TenantHealth", "Reports"), LinkText = "Who is overdue"
    };
    var healthGauge = new GaugeModel
    {
        Title = "Tenant Health",
        Value = Model.AverageTenantHealth ?? 0m,
        Unit = "",
        HasValue = Model.AverageTenantHealth.HasValue,
        Bands = GaugeModel.HigherIsBetter(0, DashboardTargets.HealthWatch, DashboardTargets.HealthGood, 100),
        Notes = { $"Average score of {Model.ScoredTenantsCount} current tenant(s), out of 100",
                  $"{Model.TenantsAtRiskCount} below {DashboardTargets.HealthWatch:0}" },
        Link = Url.Action("TenantHealth", "Reports"), LinkText = "Tenant health & ranking"
    };
}

<div class="row g-3 mb-4">
    @foreach (var gauge in new[] { occupancyGauge, collectionGauge, overdueGauge, healthGauge })
    {
        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm border-0 h-100 dashboard-print-card">
                <div class="card-body">
                    <partial name="_Gauge" model="gauge" />
                </div>
            </div>
        </div>
    }
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-4">
        <div class="card shadow-sm h-100 border-0 dashboard-print-card">
            <div class="card-header bg-light">
                @T.Html("<strong>Cash KPI</strong>")
            </div>
            <div class="card-body">
                @if (Model.CashKpiAvailable)
                {
                    <div class="text-muted small">@T["Mapped cash account"]</div>
                    <div class="fw-semibold mb-2">@Model.CashAccountName</div>
                    <div class="fs-3 fw-bold">@Model.CashBalance.ToString("N2")</div>
                    <div class="text-muted small mt-2">@T["Based on posted journal lines and account opening balance."]</div>
                }
                else
                {
                    <div class="text-muted">@T["Cash KPI is not available until the default cash account mapping is configured."]</div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm h-100 border-0 dashboard-print-card">
            <div class="card-header bg-light">
                @T.Html("<strong>Landlord KPI</strong>")
            </div>
            <div class="card-body">
                @if (Model.LandlordKpiAvailable)
                {
                    <div class="text-muted small">@T["Mapped landlord liability account"]</div>
                    <div class="fw-semibold mb-2">@Model.DueToLandlordsAccountName</div>
                    <div class="fs-3 fw-bold">@Model.DueToLandlordsBalance.ToString("N2")</div>
                    <div class="text-muted small mt-2">@T["Shows current posted balance due to landlords."]</div>
                }
                else
                {
                    <div class="text-muted">@T["Landlord KPI is not available until the due-to-landlords account mapping is configured."]</div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm h-100 border-0 dashboard-print-card">
            <div class="card-header bg-light">
                @T.Html("<strong>PDC Summary</strong>")
            </div>
            <div class="card-body">
                @if (Model.PdcDataAvailable)
                {
                    <div class="text-muted small">@T["Uncleared PDC total"]</div>
                    <div class="fs-3 fw-bold">@Model.UnclearedPdcAmount.ToString("N2")</div>
                    <div>Uncleared cheques: @Model.UnclearedPdcCount</div>
                    <div class="mt-3">
                        <a class="btn btn-outline-dark btn-sm" href="/PdcReceipts">@T["Open PDC Receipts"]</a>
                    </div>
                }
                else
                {
                    <div class="text-muted">@T["PDC data is not available yet. Apply the `PdcReceipts` migration to enable this section."]</div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4 dashboard-print-card">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <strong>@T["Landlord Drilldown"]</strong>
        <div class="dashboard-no-print">
            <a class="btn btn-outline-dark btn-sm" href="/Properties">@T["Open Properties"]</a>
            <a class="btn btn-outline-dark btn-sm" href="/Leases">@T["Open Leases"]</a>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-striped mb-0">
                <thead>
                    <tr>
                        <th>@T["Property"]</th>
                        <th>@T["Owner"]</th>
                        <th class="text-end">@T["Units"]</th>
                        <th class="text-end">@T["Occupied"]</th>
                        <th class="text-end">@T["Active Leases"]</th>
                        <th class="text-end">@T["Occupancy"]</th>
                        <th class="text-end">@T["Open A/R"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ManagedPropertyDrilldown.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-3">@T["No managed property drilldown data found."]</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var property in Model.ManagedPropertyDrilldown)
                        {
                            <tr>
                                <td>
                                    <div>@property.PropertyCode - @property.PropertyName</div>
                                    <small class="text-muted dashboard-no-print">
                                        <a href="/Properties">@T["Properties"]</a> |
                                        <a href="/Leases">@T["Leases"]</a> |
                                        <a href="/TenantStatements">@T["Tenant Statements"]</a>
                                    </small>
                                </td>
                                <td>@property.OwnerName</td>
                                <td class="text-end">@property.UnitsCount</td>
                                <td class="text-end">@property.OccupiedUnitsCount</td>
                                <td class="text-end">@property.ActiveLeasesCount</td>
                                <td class="text-end">@property.OccupancyRate.ToString("N2")%</td>
                                <td class="text-end">@property.OutstandingReceivables.ToString("N2")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="row g-4 mb-4 dashboard-no-print">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-light">
                @T.Html("<strong>Quick Reports</strong>")
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <h5>@T["Trial Balance"]</h5>
                            <p class="text-muted mb-3">@T["Review debit and credit balances from posted journal entries."]</p>
                            <a class="btn btn-dark btn-sm" href="/Reports/TrialBalance?asOfDate=@dateValue">@T["Open Trial Balance"]</a>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <h5>@T["Profit & Loss"]</h5>
                            <p class="text-muted mb-3">@T["Review revenue, expenses, and current year result."]</p>
                            <a class="btn btn-dark btn-sm" href="/Reports/ProfitAndLoss?asOfDate=@dateValue">@T["Open Profit & Loss"]</a>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <h5>@T["Balance Sheet"]</h5>
                            <p class="text-muted mb-3">@T["Review assets, liabilities, equity, and current year result."]</p>
                            <a class="btn btn-dark btn-sm" href="/Reports/BalanceSheet?asOfDate=@dateValue">@T["Open Balance Sheet"]</a>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <h5>@T["Tenant Statement"]</h5>
                            <p class="text-muted mb-3">@T["Review tenant balance movements and noted PDC items."]</p>
                            <a class="btn btn-dark btn-sm" href="/TenantStatements">@T["Open Tenant Statement"]</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-light">
                @T.Html("<strong>Quick Actions</strong>")
            </div>
            <div class="list-group list-group-flush">
                <a class="list-group-item list-group-item-action" href="/Properties">@T["Manage Properties"]</a>
                <a class="list-group-item list-group-item-action" href="/Units">@T["Manage Units"]</a>
                <a class="list-group-item list-group-item-action" href="/Leases">@T["Manage Leases"]</a>
                <a class="list-group-item list-group-item-action" href="/CustomerInvoices">@T["Manage Customer Invoices"]</a>
                <a class="list-group-item list-group-item-action" href="/CustomerReceipts">@T["Manage Customer Receipts"]</a>
                <a class="list-group-item list-group-item-action" href="/PdcReceipts">@T["Manage PDC Receipts"]</a>
                <a class="list-group-item list-group-item-action" href="/ManualJournals">@T["Open Manual Journals"]</a>
                <a class="list-group-item list-group-item-action" href="/AccountMappings">@T["Open Account Mappings"]</a>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-light">
                @T.Html("<strong>Recent Invoices</strong>")
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-striped mb-0">
                        <thead>
                            <tr>
                                <th>@T["Invoice"]</th>
                                <th>@T["Date"]</th>
                                <th>@T["Tenant"]</th>
                                <th>@T["Status"]</th>
                                <th class="text-end">@T["Outstanding"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentInvoices.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-3">@T["No invoices found."]</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var invoice in Model.RecentInvoices)
                                {
                                    var invoiceBadgeClass = invoice.Status switch
                                    {
                                        "Paid" => "bg-success",
                                        "PartiallyPaid" => "bg-warning text-dark",
                                        "Posted" => "bg-primary",
                                        "Draft" => "bg-secondary",
                                        "Cancelled" => "bg-danger",
                                        _ => "bg-dark"
                                    };

                                    <tr>
                                        <td>
                                            <div>@invoice.InvoiceNumber</div>
                                            <small class="text-muted">@invoice.LeaseDisplay</small>
                                        </td>
                                        <td>@invoice.InvoiceDate.ToString("dd/MM/yyyy")</td>
                                        <td>@invoice.TenantName</td>
                                        <td><span class="badge @invoiceBadgeClass">@invoice.Status</span></td>
                                        <td class="text-end">@invoice.OutstandingAmount.ToString("N2")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-light">
                @T.Html("<strong>Recent Receipts</strong>")
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-striped mb-0">
                        <thead>
                            <tr>
                                <th>@T["Receipt"]</th>
                                <th>@T["Date"]</th>
                                <th>@T["Tenant"]</th>
                                <th>@T["Method"]</th>
                                <th class="text-end">@T["Amount"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentReceipts.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-3">@T["No receipts found."]</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var receipt in Model.RecentReceipts)
                                {
                                    var methodBadgeClass = receipt.PaymentMethod switch
                                    {
                                        "Cash" => "bg-success",
                                        "Bank" => "bg-primary",
                                        "Cheque" => "bg-warning text-dark",
                                        _ => "bg-secondary"
                                    };

                                    <tr>
                                        <td>@receipt.ReceiptNumber</td>
                                        <td>@receipt.ReceiptDate.ToString("dd/MM/yyyy")</td>
                                        <td>@receipt.TenantName</td>
                                        <td><span class="badge @methodBadgeClass">@receipt.PaymentMethod</span></td>
                                        <td class="text-end">@receipt.Amount.ToString("N2")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-light">
        @T.Html("<strong>Recent PDC Activity</strong>")
    </div>
    <div class="card-body p-0">
        @if (!Model.PdcDataAvailable)
        {
            <div class="p-3 text-muted">@T["PDC activity will appear here after the `PdcReceipts` database migration is applied."]</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-striped mb-0">
                    <thead>
                        <tr>
                            <th>@T["Cheque"]</th>
                            <th>@T["Received"]</th>
                            <th>@T["Tenant"]</th>
                            <th>@T["Mode"]</th>
                            <th>@T["Status"]</th>
                            <th class="text-end">@T["Amount"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentPdcReceipts.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-3">@T["No PDC activity found."]</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var pdc in Model.RecentPdcReceipts)
                            {
                                var pdcBadgeClass = pdc.Status switch
                                {
                                    "Cleared" => "bg-success",
                                    "Received" => "bg-primary",
                                    "Deposited" => "bg-info text-dark",
                                    "Withdrawn" => "bg-warning text-dark",
                                    "Draft" => "bg-warning text-dark",
                                    "Bounced" => "bg-danger",
                                    "Cancelled" => "bg-secondary",
                                    "Replaced" => "bg-secondary",
                                    _ => "bg-dark"
                                };

                                <tr>
                                    <td>@pdc.ChequeNumber</td>
                                    <td>@pdc.ReceivedDate.ToString("dd/MM/yyyy")</td>
                                    <td>@pdc.TenantName</td>
                                    <td>@pdc.SettlementMode</td>
                                    <td><span class="badge @pdcBadgeClass">@pdc.Status</span></td>
                                    <td class="text-end">@pdc.Amount.ToString("N2")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
