@model RealEstateManager.Models.CompanyFormViewModel

@{
    ViewData["Title"] = T["Edit Company"];
}

<h2>@T["Edit Company"]</h2>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (TempData["GeneratedActivationCode"] is string generatedCode)
{
    var generatedMessage = TempData["GeneratedActivationMessage"] as string ?? string.Empty;

    <div class="card border-success shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                <div>
                    <h4 class="mb-1 text-success">@T["Activation Code Ready"]</h4>
                    <div class="text-muted small">@T["Copy the code or send the prepared message to the customer."]</div>
                </div>
                <button type="button" class="btn btn-outline-success btn-sm js-copy-text" data-copy="@generatedCode">@T["Copy Code"]</button>
            </div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">@T["Generated Code"]</label>
                    <div class="input-group">
                        <input type="text" class="form-control" value="@generatedCode" readonly />
                        <button type="button" class="btn btn-outline-secondary js-copy-text" data-copy="@generatedCode">@T["Copy"]</button>
                    </div>
                </div>
                <div class="col-md-8">
                    <label class="form-label">@T["Ready-To-Send Message"]</label>
                    <div class="input-group">
                        <textarea class="form-control" rows="7" readonly>@generatedMessage</textarea>
                        <button type="button" class="btn btn-outline-secondary js-copy-text" data-copy="@generatedMessage">@T["Copy Message"]</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<form asp-action="Edit" method="post" class="row g-3">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-6">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="BaseCurrency" class="form-label"></label>
        <input asp-for="BaseCurrency" class="form-control" />
        <span asp-validation-for="BaseCurrency" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="FiscalYearStartMonth" class="form-label"></label>
        <select asp-for="FiscalYearStartMonth" class="form-select">
            @for (var month = 1; month <= 12; month++)
            {
                <option value="@month">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)</option>
            }
        </select>
        <span asp-validation-for="FiscalYearStartMonth" class="text-danger"></span>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">@T["Save Changes"]</button>
        <a asp-action="Index" class="btn btn-secondary">@T["Back"]</a>
    </div>
</form>

<div class="card mt-4 shadow-sm">
    <div class="card-body">
        <h4 class="mb-2">@T["Sample Data for Training"]</h4>
        <p class="text-muted mb-3">
            @T["Fills this company with a fictional year of business, from the start of the fiscal year to today: owned and managed properties, tenants, leases, receipts, cheques, deposits, supplier bills, petty cash, journals, VAT, prepayments, fixed assets and tenant requests, property documents, development projects, unit sales and a handover, a contract awaiting approval, the Capital Assets Scheme and e-invoices sent and received, so every screen and report has something to show. It only works on a company with no properties, tenants, vendors, leases or journals yet, and takes up to a minute."]
        </p>
        <form asp-action="LoadSampleData" method="post"
              onsubmit="return confirm('Fill this company with sample data? This cannot be undone.');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-outline-secondary">@T["Load Sample Data"]</button>
        </form>
    </div>
</div>

<div class="card mt-4 shadow-sm">
    <div class="card-body">
        <h4 class="mb-3">@T["Subscription"]</h4>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <label class="form-label">@T["Status"]</label>
                <input class="form-control" value="@Model.SubscriptionStatus" readonly />
            </div>
            <div class="col-md-4">
                <label class="form-label">@T["Trial Start"]</label>
                <input class="form-control" value="@(Model.TrialStartDate?.ToString("dd/MM/yyyy") ?? "-")" readonly />
            </div>
            <div class="col-md-4">
                <label class="form-label">@T["Trial End"]</label>
                <input class="form-control" value="@(Model.TrialEndDate?.ToString("dd/MM/yyyy") ?? "-")" readonly />
            </div>
            <div class="col-md-4">
                <label class="form-label">@T["Paid Until"]</label>
                <input class="form-control" value="@(Model.SubscriptionEndDate?.ToString("dd/MM/yyyy") ?? "-")" readonly />
            </div>
            <div class="col-md-4">
                <label class="form-label">@T["Access Until"]</label>
                <input class="form-control" value="@(Model.AccessEndDate?.ToString("dd/MM/yyyy") ?? "-")" readonly />
            </div>
            <div class="col-md-4">
                <label class="form-label">@T["Days Remaining"]</label>
                <input class="form-control" value="@Model.DaysRemaining" readonly />
            </div>
        </div>

        @if (Model.IsSuspended)
        {
            <div class="alert alert-danger d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <strong>Suspended.</strong> This company's users are blocked.
                    @if (!string.IsNullOrWhiteSpace(Model.SubscriptionNotes))
                    {
                        <div class="small mt-1">@Model.SubscriptionNotes</div>
                    }
                    <div class="small mt-1">@T["Applying a new activation code also lifts the suspension."]</div>
                </div>
                <form asp-action="Reactivate" method="post"
                      onsubmit="return confirm('Reactivate this company now, without a new code?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-sm btn-success">@T["Reactivate"]</button>
                </form>
            </div>
        }
        else
        {
            <form asp-action="Suspend" method="post" class="row g-2 align-items-end mb-4"
                  onsubmit="return confirm('Suspend this company? Its users will be blocked straight away, and its unused codes cancelled.');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="col-md-9">
                    <label class="form-label" for="suspendReason">@T["Suspend access - reason (kept on record, not shown to the customer)"]</label>
                    <input id="suspendReason" name="reason" class="form-control" maxlength="300"
                           placeholder="@T["e.g. Payment for the annual renewal was returned by the bank"]" required />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-outline-danger w-100">@T["Suspend Company"]</button>
                </div>
            </form>
            @if (!string.IsNullOrWhiteSpace(Model.SubscriptionNotes))
            {
                <p class="small text-muted mb-4">@T.Format("Last change: {0}", Model.SubscriptionNotes)</p>
            }
        }

        <form asp-action="GenerateActivationCode" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />

            <div class="col-md-3">
                <label asp-for="ActivationCodeDurationDays" class="form-label"></label>
                <input asp-for="ActivationCodeDurationDays" class="form-control" />
                <span asp-validation-for="ActivationCodeDurationDays" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="ActivationCodeNotes" class="form-label"></label>
                <input asp-for="ActivationCodeNotes" class="form-control" />
                <span asp-validation-for="ActivationCodeNotes" class="text-danger"></span>
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-outline-primary w-100">@T["Generate Code"]</button>
            </div>
        </form>

        <div class="d-flex justify-content-between align-items-center mt-4 mb-2">
            <h5 class="mb-0">@T["Activation History"]</h5>
            <span class="text-muted small">@T["Latest 50 generated codes"]</span>
        </div>

        <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle mb-0">
                <thead>
                    <tr>
                        <th>@T["Code"]</th>
                        <th>@T["Days"]</th>
                        <th>@T["Status"]</th>
                        <th>@T["Issued"]</th>
                        <th>@T["Activated"]</th>
                        <th>@T["Notes"]</th>
                        <th>@T["Action"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ActivationCodes.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted">@T["No activation codes generated yet."]</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var code in Model.ActivationCodes)
                        {
                            <tr>
                                <td><code>@code.Code</code></td>
                                <td>@code.DurationDays</td>
                                <td>
                                    @if (code.IsCancelled)
                                    {
                                        <span class="badge bg-secondary">@T["Cancelled"]</span>
                                    }
                                    else if (code.ActivatedAt.HasValue)
                                    {
                                        <span class="badge bg-success">@T["Used"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@T["Available"]</span>
                                    }
                                </td>
                                <td>@code.IssuedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@(code.ActivatedAt.HasValue ? code.ActivatedAt.Value.ToString("dd/MM/yyyy HH:mm") : T["Not used"])</td>
                                <td>@(string.IsNullOrWhiteSpace(code.Notes) ? "-" : code.Notes)</td>
                                <td class="text-nowrap">
                                    <button type="button" class="btn btn-sm btn-outline-secondary js-copy-text" data-copy="@code.Code">@T["Copy"]</button>
                                    @if (!code.IsCancelled && !code.ActivatedAt.HasValue)
                                    {
                                        <form asp-action="CancelCode" method="post" class="d-inline"
                                              onsubmit="return confirm('Cancel code @code.Code? It can no longer be used.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@Model.Id" />
                                            <input type="hidden" name="code" value="@code.Code" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">@T["Cancel"]</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.js-copy-text').forEach(function (button) {
            button.addEventListener('click', async function () {
                const text = button.getAttribute('data-copy') || '';
                if (!text) {
                    return;
                }

                try {
                    await navigator.clipboard.writeText(text);
                    const originalText = button.textContent;
                    button.textContent = 'Copied';
                    setTimeout(function () {
                        button.textContent = originalText;
                    }, 1500);
                } catch {
                    alert('Copy failed. Please copy the text manually.');
                }
            });
        });
    </script>
}
