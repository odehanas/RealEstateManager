@model RealEstateManager.Models.CompanyFormViewModel

@{
    ViewData["Title"] = "Add Internal Company";
}

<h2>Add Internal Company</h2>

<div class="alert alert-info">
    Use this internal page only after sign-in for additional managed companies. Public new-company signup now starts from the login page and creates the first admin user automatically.
</div>

<form asp-action="Create" method="post" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-6">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="BaseCurrency" class="form-label"></label>
        <input asp-for="BaseCurrency" class="form-control" />
        <span asp-validation-for="BaseCurrency" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="FiscalYearStartMonth" class="form-label"></label>
        <select asp-for="FiscalYearStartMonth" class="form-select">
            @for (var month = 1; month <= 12; month++)
            {
                <option value="@month">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)</option>
            }
        </select>
        <span asp-validation-for="FiscalYearStartMonth" class="text-danger"></span>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
