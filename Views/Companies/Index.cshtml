@model RealEstateManager.Models.CompanyListPageViewModel

@{
    ViewData["Title"] = T["Companies / Branch Setup"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">@T["Companies / Branch Setup"]</h2>
    <a asp-action="Create" class="btn btn-primary">@T["Add Internal Company"]</a>
</div>

<div class="alert alert-info">
    @T["New customer onboarding now starts from the login page. Use this internal screen only for additional company records under administration and future branch-style expansion."]
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border-danger shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="mb-0 text-danger">@T["Expired Subscriptions"]</h5>
                    <span class="badge bg-danger">@Model.ExpiredCompanies.Count</span>
                </div>
                @if (Model.ExpiredCompanies.Count == 0)
                {
                    <div class="text-muted small">@T["No expired company subscriptions."]</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var item in Model.ExpiredCompanies.Take(5))
                        {
                            <li class="list-group-item px-0">
                                <div class="fw-semibold">@item.CompanyName</div>
                                <div class="small text-muted">
                                    @T.Format("Status: {0} | Access Until: {1}", item.SubscriptionStatus, item.AccessEndDate?.ToString("dd/MM/yyyy") ?? "-")
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-warning shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="mb-0 text-warning-emphasis">@T["Expiring In 15 Days"]</h5>
                    <span class="badge bg-warning text-dark">@Model.ExpiringSoonCompanies.Count</span>
                </div>
                @if (Model.ExpiringSoonCompanies.Count == 0)
                {
                    <div class="text-muted small">@T["No company subscriptions are close to expiry."]</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var item in Model.ExpiringSoonCompanies.Take(5))
                        {
                            <li class="list-group-item px-0">
                                <div class="fw-semibold">@item.CompanyName</div>
                                <div class="small text-muted">
                                    @T.Format("{0} | {1} day(s) remaining | Access Until: {2}", item.SubscriptionStatus, item.DaysRemaining, item.AccessEndDate?.ToString("dd/MM/yyyy") ?? "-")
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<table class="table table-striped table-bordered align-middle">
    <thead>
        <tr>
            <th>@T["Name"]</th>
            <th>@T["Currency"]</th>
            <th>@T["Fiscal Start"]</th>
            <th>@T["Subscription"]</th>
            <th>@T["Access Until"]</th>
            <th>@T["Codes"]</th>
            <th>@T["Users"]</th>
            <th>@T["Created"]</th>
            <th class="text-center">@T["Actions"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.BaseCurrency</td>
                <td>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(item.FiscalYearStartMonth)</td>
                <td>@item.SubscriptionStatus</td>
                <td>@(item.AccessEndDate.HasValue ? $"{item.AccessEndDate.Value:dd/MM/yyyy} ({item.DaysRemaining} days)" : "-")</td>
                <td>@T.Format("{0} / {1} used", item.ActivationCodesUsed, item.ActivationCodesIssued)</td>
                <td>@item.UsersCount</td>
                <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                <td class="text-center">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">@T["Edit"]</a>
                </td>
            </tr>
        }
    </tbody>
</table>
