@{
    Layout = "_PortalLayout";
    ViewData["Title"] = T["Temporarily Unavailable"];
}

<div class="card shadow-sm mx-auto mt-4" style="max-width:480px">
    <div class="card-body p-4 text-center">
        <h1 class="h5 mb-3">@T["The portal is temporarily unavailable"]</h1>
        <p class="text-muted mb-4">
            @T["Your account information cannot be shown at the moment. This is not a problem with your account and nothing has changed on it."]
        </p>
        <p class="text-muted small mb-4">
            @T["Please contact your property manager directly for your balance, invoices or payments."]
        </p>
        <form asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-secondary btn-sm">@T["Sign out"]</button>
        </form>
    </div>
</div>
