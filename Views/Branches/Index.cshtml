@model RealEstateManager.Models.BranchListViewModel

@{
    ViewData["Title"] = T["Branches"];
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="mb-0">@T["Branches"]</h2>
        <p class="text-muted small mb-0">
            @T.Format("{0} and its branches. Each keeps its own books; the group reports under Reporting add them together.", Model.MotherCompanyName)
        </p>
    </div>
    @if (Model.CanOpenBranch)
    {
        <a asp-action="Create" class="btn btn-primary">@T["Open a Branch"]</a>
    }
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (!Model.CanOpenBranch)
{
    <div class="alert alert-info">
        @T.Format("A new branch is opened by an administrator of {0}.", Model.MotherCompanyName)
    </div>
}

<table class="table table-striped table-bordered align-middle">
    <thead>
        <tr>
            <th>@T["Name"]</th>
            <th>@T["Type"]</th>
            <th class="text-end">@T["Users"]</th>
            <th>@T["Opened"]</th>
            <th class="text-center">@T["Actions"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Companies)
        {
            <tr>
                <td class="@(item.IsMother ? "fw-semibold" : null)">@item.Name</td>
                <td>@(item.IsMother ? T["Mother company"] : T["Branch"])</td>
                <td class="text-end">@item.UsersCount</td>
                <td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                <td class="text-center">
                    @if (item.CompanyId == Model.CurrentCompanyId)
                    {
                        <span class="badge bg-secondary">@T["You are here"]</span>
                    }
                    else if (item.HasAccess)
                    {
                        <form asp-controller="Auth" asp-action="SwitchCompany" method="post" class="d-inline">
                            <input type="hidden" name="companyId" value="@item.CompanyId" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">@T["Switch to it"]</button>
                        </form>
                    }
                    else
                    {
                        <span class="text-muted small">@T["No access"]</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Companies.Count == 1)
{
    <p class="text-muted">@T["No branches yet."]</p>
}
