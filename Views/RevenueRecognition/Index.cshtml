@model IEnumerable<RealEstateManager.Domain.RevenueRecognitionSchedule>

@{
    ViewData["Title"] = T["Revenue Recognition"];
    var asOfDate = (DateTime)ViewBag.AsOfDate;
    var showPosted = (bool)ViewBag.ShowPosted;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@T["Revenue Recognition"]</h2>
</div>

<form method="get" class="row g-3 mb-3">
    <div class="col-md-3">
        <label class="form-label">@T["As Of Date"]</label>
        <input type="date" name="asOfDate" value="@asOfDate.ToString("yyyy-MM-dd")" class="form-control" />
    </div>

    <div class="col-md-3">
        <label class="form-label">@T["Show Posted"]</label>
        <select name="showPosted" class="form-select">
            @if (showPosted)
            {
                <option value="true" selected>@T["Yes"]</option>
                <option value="false">@T["No"]</option>
            }
            else
            {
                <option value="true">@T["Yes"]</option>
                <option value="false" selected>@T["No"]</option>
            }
        </select>
    </div>

    <div class="col-md-3 d-flex align-items-end">
        <button type="submit" class="btn btn-dark">@T["Refresh"]</button>
    </div>
</form>

<form asp-action="PostDue" method="post" class="mb-3">
    @Html.AntiForgeryToken()
    <input type="hidden" name="asOfDate" value="@asOfDate.ToString("yyyy-MM-dd")" />
    <input type="hidden" name="showPosted" value="@showPosted.ToString().ToLower()" />
    <button type="submit" class="btn btn-success">@T["Post All Due Up To Selected Date"]</button>
</form>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>@T["Date"]</th>
            <th>@T["Lease"]</th>
            <th>@T["Property"]</th>
            <th>@T["Unit"]</th>
            <th>@T["Tenant"]</th>
            <th class="text-end">@T["Amount"]</th>
            <th>@T["Status"]</th>
            <th>@T["GL"]</th>
            <th>@T["Action"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.RecognitionDate.ToString("dd/MM/yyyy")</td>
                <td>@item.Lease?.ContractNumber</td>
                <td>@item.Lease?.Unit?.Property?.Name</td>
                <td>@item.Lease?.Unit?.UnitNumber</td>
                <td>@item.Lease?.Tenant?.FullName</td>
                <td class="text-end">@item.Amount.ToString("N2")</td>
                <td>@item.Status</td>
                <td>
                    @if (item.JournalEntryId.HasValue)
                    {
                        <span class="badge bg-success">@T["Posted"]</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">@T["Not Posted"]</span>
                    }
                </td>
                <td>
                    @if (!item.JournalEntryId.HasValue)
                    {
                        <form asp-action="Post" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="hidden" name="asOfDate" value="@asOfDate.ToString("yyyy-MM-dd")" />
                            <input type="hidden" name="showPosted" value="@showPosted.ToString().ToLower()" />
                            <button type="submit" class="btn btn-sm btn-outline-primary">@T["Post"]</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>