@model RealEstateManager.Services.ProjectCostReportService.ReportModel
@{
    ViewData["Title"] = "Project Costs & WIP";
    var c = Model.Currency;
    string M(decimal v) => v.ToString("N2");
    var options = (IEnumerable<dynamic>)ViewBag.ProjectOptions;
    var totals = new
    {
        Budget = Model.Projects.Sum(x => x.Budget),
        Posted = Model.Projects.Sum(x => x.PostedCost),
        Net = Model.Projects.Sum(x => x.BillNet),
        CapVat = Model.Projects.Sum(x => x.BillCapitalisedVat),
        Other = Model.Projects.Sum(x => x.OtherCost),
        RecVat = Model.Projects.Sum(x => x.BillRecoverableVat),
        Transferred = Model.Projects.Sum(x => x.Transferred),
        Wip = Model.Projects.Sum(x => x.WipBalance),
        Committed = Model.Projects.Sum(x => x.Committed),
        Unpaid = Model.Projects.Sum(x => x.Unpaid)
    };
}
<style>
    .pc td, .pc th { white-space: nowrap; font-size: .84rem; }
    .pc td.num, .pc th.num { text-align: right; }
    .pc tr.total td { font-weight: 700; border-top: 2px solid #0f2740; }
    .pc .diff-ok { color: #146c43; font-weight: 600; }
    .pc .diff-bad { color: #b42318; font-weight: 600; }
    @@media print { form.no-print, .no-print { display: none !important; } }
</style>

<div class="d-flex flex-wrap justify-content-between align-items-end mb-3 gap-2">
    <div>
        <h2 class="mb-0">Project Costs &amp; WIP</h2>
        <div class="text-muted">Spend per development project as at @Model.AsOf.ToString("dd MMMM yyyy"): the supplier's net price, VAT taken into cost, VAT recovered, what is committed and paid, and the WIP reconciliation. Amounts in @c.</div>
    </div>
    <form method="get" class="d-flex flex-wrap gap-2 align-items-end no-print">
        <div><label class="form-label small mb-0">As at</label><input type="date" name="asOf" value="@Model.AsOf.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
        <div>
            <label class="form-label small mb-0">Project</label>
            <select name="projectId" class="form-select form-select-sm">
                <option value="">All projects (summary)</option>
                @foreach (var o in options)
                {
                    <option value="@o.Id" selected="@(Model.Project?.Id == (int)o.Id ? "selected" : null)">@o.Label</option>
                }
            </select>
        </div>
        <button class="btn btn-sm btn-dark">Show</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.print()">Print</button>
    </form>
</div>

@if (Model.Projects.Count == 0)
{
    <div class="alert alert-info">There are no development projects yet.</div>
}
else
{
<div class="card shadow-sm mb-4 pc">
    <div class="card-header bg-light"><h5 class="mb-0">1. Cost by project</h5></div>
    <div class="table-responsive">
        <table class="table table-sm table-bordered mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Project</th><th>VAT on costs</th>
                    <th class="num">Budget</th>
                    <th class="num">Bills: net</th><th class="num">Bills: VAT in cost</th><th class="num">Other costs</th>
                    <th class="num">Cost to date</th>
                    <th class="num">VAT recovered</th>
                    <th class="num">Transferred out</th><th class="num">WIP balance</th>
                    <th class="num">Committed (drafts)</th><th class="num">Budget left</th>
                    <th class="num">Unpaid to suppliers</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var p in Model.Projects)
            {
                <tr>
                    <td><a asp-action="Index" asp-route-projectId="@p.Id" asp-route-asOf="@Model.AsOf.ToString("yyyy-MM-dd")"><strong>@p.Code</strong> @p.Name</a>
                        <div class="small text-muted">@p.IntendedUse · @p.Status · @p.WipAccount</div></td>
                    <td class="small">@(p.VatTreatment ?? "per line")</td>
                    <td class="num">@M(p.Budget)</td>
                    <td class="num">@M(p.BillNet)</td><td class="num">@M(p.BillCapitalisedVat)</td><td class="num">@M(p.OtherCost)</td>
                    <td class="num fw-semibold">@M(p.PostedCost)</td>
                    <td class="num">@M(p.BillRecoverableVat)</td>
                    <td class="num">@M(p.Transferred)</td><td class="num fw-semibold">@M(p.WipBalance)</td>
                    <td class="num">@M(p.Committed)</td>
                    <td class="num @(p.Budget > 0 && p.BudgetRemaining < 0 ? "text-danger fw-semibold" : "")">@(p.Budget > 0 ? M(p.BudgetRemaining) : "—")</td>
                    <td class="num">@M(p.Unpaid)</td>
                </tr>
            }
                <tr class="total">
                    <td colspan="2">Total</td>
                    <td class="num">@M(totals.Budget)</td><td class="num">@M(totals.Net)</td><td class="num">@M(totals.CapVat)</td><td class="num">@M(totals.Other)</td>
                    <td class="num">@M(totals.Posted)</td><td class="num">@M(totals.RecVat)</td><td class="num">@M(totals.Transferred)</td><td class="num">@M(totals.Wip)</td>
                    <td class="num">@M(totals.Committed)</td><td class="num"></td><td class="num">@M(totals.Unpaid)</td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="card-body small text-muted">
        <strong>Cost to date</strong> = bills' net + VAT taken into cost + other costs (journals, petty cash, finance costs) posted to the project's WIP account.
        <strong>VAT recovered</strong> sits in VAT Recoverable and is claimed on the VAT return, so it is not part of the cost.
        <strong>WIP balance</strong> = cost to date less what was transferred out on completion. <strong>Committed</strong> = draft bills and journals tagged to the project, not yet posted.
    </div>
</div>

<div class="card shadow-sm mb-4 pc">
    <div class="card-header bg-light"><h5 class="mb-0">2. WIP reconciliation: ledger against projects</h5></div>
    <div class="table-responsive">
        <table class="table table-sm table-bordered mb-0 align-middle">
            <thead class="table-light">
                <tr><th>WIP account</th><th class="num">Balance in the ledger</th><th class="num">Sum of project WIP balances</th><th class="num">Difference</th><th class="num">Postings not tagged to a project</th><th class="num">Still unexplained</th></tr>
            </thead>
            <tbody>
            @foreach (var r in Model.Reconciliation)
            {
                <tr>
                    <td>@r.Account</td>
                    <td class="num">@M(r.LedgerBalance)</td><td class="num">@M(r.ProjectsTotal)</td>
                    <td class="num @(r.Difference == 0 ? "diff-ok" : "diff-bad")">@M(r.Difference)</td>
                    <td class="num">@M(r.Untagged)</td>
                    <td class="num @(r.Unexplained == 0 ? "diff-ok" : "diff-bad")">@(r.Unexplained == 0 ? "0.00 ✓" : M(r.Unexplained))</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="card-body small">
        @foreach (var r in Model.Reconciliation.Where(x => x.UntaggedLines.Count > 0))
        {
            <div class="fw-semibold mt-2">@r.Account: postings without a project (tag them so they belong to a project)</div>
            <table class="table table-sm mb-2">
                <tr><th>Date</th><th>Entry</th><th>Source</th><th>Description</th><th class="num">Amount</th></tr>
                @foreach (var l in r.UntaggedLines)
                {
                    <tr><td>@l.Date.ToString("dd/MM/yyyy")</td><td>@l.EntryNumber</td><td>@l.Source</td><td>@l.Description</td><td class="num">@M(l.Amount)</td></tr>
                }
            </table>
        }
        <div class="text-muted">A difference that untagged postings do not explain usually comes from an opening balance entered on the WIP account itself; give it to a project with a manual journal (credit the account untagged, debit it tagged to the project).</div>
    </div>
</div>
}

@if (Model.Project != null)
{
    var p = Model.Project;
    <h4 class="mt-2">@p.Code @p.Name <span class="text-muted fs-6">@p.IntendedUse · @p.Status@(Model.MainContractor != null ? " · main contractor " + Model.MainContractor : "")</span></h4>

    <div class="row g-3 mb-4 pc">
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light"><h5 class="mb-0">3. Budget against cost, by category</h5></div>
                <table class="table table-sm mb-0">
                    <tr class="table-light"><th>Category</th><th class="num">Budget</th><th class="num">Posted</th><th class="num">Committed</th><th class="num">Left</th></tr>
                    @foreach (var cat in Model.Categories)
                    {
                        <tr>
                            <td>@cat.Category</td><td class="num">@M(cat.Budget)</td><td class="num">@M(cat.Posted)</td><td class="num">@M(cat.Committed)</td>
                            <td class="num @(cat.Budget > 0 && cat.Remaining < 0 ? "text-danger fw-semibold" : "")">@(cat.Budget > 0 ? M(cat.Remaining) : "—")</td>
                        </tr>
                    }
                    <tr class="total"><td>Total</td><td class="num">@M(Model.Categories.Sum(x => x.Budget))</td><td class="num">@M(Model.Categories.Sum(x => x.Posted))</td><td class="num">@M(Model.Categories.Sum(x => x.Committed))</td><td></td></tr>
                </table>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light"><h5 class="mb-0">4. Spend by month (posted)</h5></div>
                <table class="table table-sm mb-0">
                    <tr class="table-light"><th>Month</th><th class="num">Cost</th><th class="num">Cumulative</th></tr>
                    @{ var running = 0m; }
                    @if (Model.Months.Count == 0) { <tr><td colspan="3" class="text-muted">No posted cost yet.</td></tr> }
                    @foreach (var m in Model.Months)
                    {
                        running += m.Amount;
                        <tr><td>@m.Month.ToString("MMM yyyy")</td><td class="num">@M(m.Amount)</td><td class="num">@M(running)</td></tr>
                    }
                </table>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4 pc">
        <div class="card-header bg-light"><h5 class="mb-0">5. Contractors, subcontractors and suppliers (posted bills)</h5></div>
        <div class="table-responsive">
            <table class="table table-sm table-bordered mb-0">
                <tr class="table-light"><th>Vendor</th><th class="num">Bills</th><th class="num">Net</th><th class="num">VAT in cost</th><th class="num">VAT recovered</th><th class="num">Total billed</th><th class="num">Paid</th><th class="num">Unpaid</th></tr>
                @if (Model.Vendors.Count == 0) { <tr><td colspan="8" class="text-muted">No posted bills for this project.</td></tr> }
                @foreach (var v in Model.Vendors)
                {
                    <tr>
                        <td>@v.Vendor @if (v.IsMainContractor) { <span class="badge bg-secondary">main contractor</span> }</td>
                        <td class="num">@v.Bills</td><td class="num">@M(v.Net)</td><td class="num">@M(v.CapitalisedVat)</td><td class="num">@M(v.RecoverableVat)</td>
                        <td class="num fw-semibold">@M(v.Total)</td><td class="num">@M(v.Paid)</td><td class="num">@M(v.Unpaid)</td>
                    </tr>
                }
            </table>
        </div>
    </div>

    <div class="card shadow-sm mb-4 pc">
        <div class="card-header bg-light"><h5 class="mb-0">6. Bills charged to the project</h5></div>
        <div class="table-responsive">
            <table class="table table-sm table-bordered mb-0">
                <tr class="table-light"><th>Date</th><th>Bill</th><th>Vendor</th><th>Status</th><th class="num">Net</th><th class="num">VAT in cost</th><th class="num">VAT recovered</th><th class="num">Total</th><th class="num">Paid</th></tr>
                @if (Model.Bills.Count == 0) { <tr><td colspan="9" class="text-muted">None.</td></tr> }
                @foreach (var b in Model.Bills)
                {
                    <tr class="@(b.Posted ? "" : "table-warning")">
                        <td>@b.Date.ToString("dd/MM/yyyy")</td>
                        <td><a asp-controller="VendorBills" asp-action="Details" asp-route-id="@b.BillId">@b.BillNumber</a> <span class="text-muted small">@b.VendorReference</span></td>
                        <td>@b.Vendor</td><td>@(b.Posted ? b.Status : "Draft (committed)")</td>
                        <td class="num">@M(b.Net)</td><td class="num">@M(b.CapitalisedVat)</td><td class="num">@M(b.RecoverableVat)</td><td class="num">@M(b.Total)</td><td class="num">@M(b.Paid)</td>
                    </tr>
                }
            </table>
        </div>
        <div class="card-body small text-muted">Only the lines of each bill that belong to this project are counted. Payments on a bill are shared across its lines in proportion to their amounts.</div>
    </div>
}
