            </div>

            <div class="col-md-6">
                <label class="form-label">Depreciation Expense</label>
                <select asp-for="DepreciationExpenseAccountId" class="form-select">
                    <option value="">Select Account</option>
                    @foreach (var account in accounts)
                    {
                        <option value="@account.Id">@account.Code - @account.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Finance Cost</label>
                <select asp-for="FinanceCostAccountId" class="form-select">
                    <option value="">Select Account</option>
                    @foreach (var account in accounts)
                    {
                        <option value="@account.Id">@account.Code - @account.Name</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">Equity and Asset Control</h5>
        </div>
        <div class="card-body row g-3">
            <div class="col-md-6">
