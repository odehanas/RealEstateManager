            </div>

            <div class="col-md-6">
                <label class="form-label">Fixed Asset Clearing</label>
                <select asp-for="FixedAssetClearingAccountId" class="form-select">
                    <option value="">Select Account</option>
                    @foreach (var account in accounts)
                    {
                        <option value="@account.Id">@account.Code - @account.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Accumulated Depreciation Default</label>
                <select asp-for="AccumulatedDepreciationDefaultAccountId" class="form-select">
                    <option value="">Select Account</option>
                    @foreach (var account in accounts)
                    {
                        <option value="@account.Id">@account.Code - @account.Name</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">PDC Setup</h5>
        </div>
        <div class="card-body row g-3">
            <div class="col-md-6">
                <label class="form-label">PDC On Hand</label>
                <select asp-for="PdcOnHandAccountId" class="form-select">
