@model RealEstateManager.Models.AccountMappingViewModel
@using RealEstateManager.Domain

@{
    ViewData["Title"] = "Account Mapping Setup";
    var accounts = ViewBag.Accounts as List<Account> ?? new();
}

<h2>Account Mapping Setup</h2>

@if (ViewBag.SuccessMessage != null)
{
    <div class="alert alert-success">@ViewBag.SuccessMessage</div>
}

<form asp-action="Index" method="post">
    @Html.AntiForgeryToken()

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">Core Accounts</h5>
        </div>
        <div class="card-body row g-3">
            <div class="col-md-6">
                <label class="form-label">Default Cash / Bank</label>
                <select asp-for="DefaultCashAccountId" class="form-select">
                    <option value="">Select Account</option>
                    @foreach (var account in accounts)
                    {
                        <option value="@account.Id">@account.Code - @account.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Accounts Receivable</label>
                <select asp-for="AccountsReceivableAccountId" class="form-select">
                    <option value="">Select Account</option>
                    @foreach (var account in accounts)
                    {
                        <option value="@account.Id">@account.Code - @account.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Accounts Payable</label>
                <select asp-for="AccountsPayableAccountId" class="form-select">
                    <option value="">Select Account</option>
                    @foreach (var account in accounts)
                    {
                        <option value="@account.Id">@account.Code - @account.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Advances From Customers</label>
                <select asp-for="AdvancesFromCustomersAccountId" class="form-select">
                    <option value="">Select Account</option>
                    @foreach (var account in accounts)
                    {
                        <option value="@account.Id">@account.Code - @account.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Unearned Revenue</label>
                <select asp-for="UnearnedRevenueAccountId" class="form-select">
                    <option value="">Select Account</option>
                    @foreach (var account in accounts)
                    {
                        <option value="@account.Id">@account.Code - @account.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Tenant Security Deposit Liability</label>
                <select asp-for="TenantSecurityDepositLiabilityAccountId" class="form-select">
                    <option value="">Select Account</option>
                    @foreach (var account in accounts)
                    {
                        <option value="@account.Id">@account.Code - @account.Name</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">Tax and Landlord Accounts</h5>
        </div>
        <div class="card-body row g-3">
            <div class="col-md-6">
                <label class="form-label">VAT Recoverable</label>
                <select asp-for="VatRecoverableAccountId" class="form-select">
                    <option value="">Select Account</option>
                    @foreach (var account in accounts)
                    {
                        <option value="@account.Id">@account.Code - @account.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">VAT Payable</label>
                <select asp-for="VatPayableAccountId" class="form-select">
                    <option value="">Select Account</option>
                    @foreach (var account in accounts)
                    {
                        <option value="@account.Id">@account.Code - @account.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Due To Landlords</label>
                <select asp-for="DueToLandlordsAccountId" class="form-select">
                    <option value="">Select Account</option>
                    @foreach (var account in accounts)
                    {
                        <option value="@account.Id">@account.Code - @account.Name</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
