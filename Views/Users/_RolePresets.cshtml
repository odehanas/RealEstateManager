@using RealEstateManager.Services
@*
    One-click roles. Each button ticks exactly the permissions of a standard role;
    the boxes below can still be adjusted for one person afterwards.
*@
<div class="border rounded p-3 mb-3 bg-light" id="rolePresets">
    <h5 class="mb-1">@T["Role"]</h5>
    <p class="small text-muted mb-2">Choose a role to tick its permissions, then adjust below if this person needs something different.
        Approval limits (how much a Manager or Owner may approve) are set in <a asp-controller="ApprovalLimits" asp-action="Index">Approval Limits</a>.</p>
    <div class="d-flex flex-wrap gap-2">
        @foreach (var role in RoleTemplates.Assignable)
        {
            <button type="button" class="btn btn-outline-dark btn-sm" title="@role.Summary"
                    data-role="@role.Key" data-permissions="@string.Join(",", role.Permissions)">@role.Name</button>
        }
    </div>
    <div class="small mt-2" id="rolePresetNote"></div>
</div>
<script>
    (function () {
        var box = document.getElementById('rolePresets');
        if (!box) { return; }
        var note = document.getElementById('rolePresetNote');
        var summaries = {};
        box.querySelectorAll('[data-role]').forEach(function (b) { summaries[b.getAttribute('data-role')] = b.title; });

        box.addEventListener('click', function (event) {
            var button = event.target.closest('[data-role]');
            if (!button) { return; }
            var wanted = button.getAttribute('data-permissions').split(',');
            var form = box.closest('form');

            form.querySelectorAll('input[type=checkbox][name$=".IsSelected"][name^="PermissionGroups"]').forEach(function (checkbox) {
                var key = form.querySelector('input[type=hidden][name="' + checkbox.name.replace('.IsSelected', '.PermissionKey') + '"]');
                if (key) { checkbox.checked = wanted.indexOf(key.value) >= 0; }
            });

            // The company administrator role also makes the person administrator of the companies ticked above.
            var isAdmin = button.getAttribute('data-role') === '@RoleTemplates.CompanyAdmin';
            form.querySelectorAll('input[type=checkbox][name$=".IsCompanyAdmin"]').forEach(function (checkbox) {
                var selected = form.querySelector('input[type=checkbox][name="' + checkbox.name.replace('.IsCompanyAdmin', '.IsSelected') + '"]');
                checkbox.checked = isAdmin && (!selected || selected.checked);
            });

            box.querySelectorAll('[data-role]').forEach(function (b) { b.classList.toggle('active', b === button); });
            note.textContent = button.textContent + ': ' + summaries[button.getAttribute('data-role')] + ' Remember to Save.';
        });
    })();
</script>
