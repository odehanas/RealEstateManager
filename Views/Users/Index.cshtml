@model List<RealEstateManager.Models.AppUserListItemViewModel>

@{
    ViewData["Title"] = T["Users"];
    var scope = ViewBag.Scope as RealEstateManager.Models.UserAdminScope;
    var companyAdminOnly = scope?.IsCompanyAdminOnly == true;
    var canSetTwoStep = ViewBag.CanSetTwoStep as bool? == true;
    var requireTwoStep = ViewBag.RequireTwoStep as bool? == true;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">@(companyAdminOnly ? T["Users of your company"] : T["Users"])</h2>
        @if (companyAdminOnly)
        {
            <p class="text-muted small mb-0">
                @T["As the company's administrator you manage its users and what each may do. Users who also work for another company, and system administrators, are managed by your service provider."]
            </p>
        }
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="AuthorizationMatrix" asp-action="Index" class="btn btn-outline-dark">@T["Authorization Matrix"]</a>
        <a asp-action="Create" class="btn btn-primary">@T["Add User"]</a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-warning">@errorMessage</div>
}

@if (canSetTwoStep)
{
    <div class="card mb-3">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div style="max-width:820px">
                <div class="fw-semibold">
                    @T["Two-step sign-in"]
                    <span class="badge @(requireTwoStep ? "bg-success" : "bg-secondary")">@(requireTwoStep ? T["Required"] : T["Optional"])</span>
                </div>
                <div class="text-muted small">
                    @T.Format("After the password, the user types a six-digit code from an authenticator app on their phone. Each user can switch it on for themselves; here you can require it of everyone who works in {0}.", User.FindFirst(AppClaimTypes.CurrentCompanyName)?.Value ?? "")
                </div>
            </div>
            <form asp-action="RequireTwoStep" method="post">
                <input type="hidden" name="require" value="@(requireTwoStep ? "false" : "true")" />
                <button type="submit" class="btn @(requireTwoStep ? "btn-outline-secondary" : "btn-primary")">
                    @(requireTwoStep ? T["Make it optional"] : T["Require it for all users"])
                </button>
            </form>
        </div>
    </div>
}

<table class="table table-striped table-bordered align-middle">
    <thead>
        <tr>
            <th>@T["Username"]</th>
            <th>@T["Name"]</th>
            <th>@T["Status"]</th>
            <th>@T["Role"]</th>
            <th>@T["Companies"]</th>
            <th>@T["Permissions"]</th>
            <th>@T["Two-step sign-in"]</th>
            <th>@T["Last Login"]</th>
            <th class="text-center">@T["Actions"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Username</td>
                <td>@item.DisplayName</td>
                <td>@(item.IsActive ? T["Active"] : T["Inactive"])</td>
                <td>@item.RoleDisplay</td>
                <td>@item.CompaniesDisplay</td>
                <td>@(string.IsNullOrWhiteSpace(item.PermissionsDisplay) ? "-" : item.PermissionsDisplay)</td>
                <td>
                    <span class="badge @(item.TwoStepOn ? "bg-success" : "bg-secondary")">@(item.TwoStepOn ? T["On"] : T["Off"])</span>
                </td>
                <td>@(item.LastLoginAt.HasValue ? item.LastLoginAt.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                <td class="text-center">
                    <div class="d-flex flex-wrap gap-1 justify-content-center">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">@T["Edit"]</a>
                        @if (item.TwoStepOn)
                        {
                            <form asp-action="ResetTwoStep" method="post"
                                  onsubmit="return confirm('@T["Reset two-step sign-in for this user? They will sign in with the password alone until they set it up again."]');">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="@T["For a user who lost their phone"]">@T["Reset two-step"]</button>
                            </form>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
