@model RealEstateManager.Models.UnitCreateViewModel
@using RealEstateManager.Domain
@{
    ViewData["Title"] = "Edit Unit";
    var properties = ViewBag.Properties as List<Property> ?? new();
    var id = ViewBag.Id;
}

<h2>Edit Unit</h2>

<form asp-action="Edit" asp-route-id="@id" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="PropertyId" class="form-label"></label>
            <select asp-for="PropertyId" class="form-select">
                <option value="">Select Property</option>
                @foreach (var property in properties)
                {
                    <option value="@property.Id">@property.Code - @property.Name</option>
                }
            </select>
        </div>

        <div class="col-md-4">
            <label asp-for="UnitNumber" class="form-label">Unit Code</label>
            <input asp-for="UnitNumber" class="form-control bg-light" readonly />
            <div class="form-text">Fixed once issued &mdash; contracts are numbered from it.</div>
        </div>

        <div class="col-md-4">
            <label asp-for="Floor" class="form-label"></label>
            <input asp-for="Floor" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="UsageType" class="form-label"></label>
            <select asp-for="UsageType" class="form-select">
                <option value="">Select</option>
                <option>Residential</option>
                <option>Commercial</option>
                <option>Warehouse</option>
                <option>Office</option>
                @* Keep a usage recorded outside this list, or saving the form would wipe it. *@
                @if (!string.IsNullOrWhiteSpace(Model.UsageType) &&
                     !new[] { "Residential", "Commercial", "Warehouse", "Office" }.Contains(Model.UsageType))
                {
                    <option value="@Model.UsageType" selected>@Model.UsageType</option>
                }
            </select>
        </div>

        <div class="col-md-4">
            <label asp-for="AreaSqFt" class="form-label"></label>
            <input asp-for="AreaSqFt" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="StandardAnnualRent" class="form-label"></label>
            <input asp-for="StandardAnnualRent" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="FloorNumber" class="form-label"></label>
            <input asp-for="FloorNumber" class="form-control" min="-10" max="200" placeholder="0 = ground" />
            <div class="form-text">Optional. Read from Floor when empty (G = 0, B1 = -1).</div>
        </div>

        <div class="col-md-4">
            <label asp-for="FloorPosition" class="form-label"></label>
            <input asp-for="FloorPosition" class="form-control" min="1" max="200" placeholder="1 = far left" />
            <div class="form-text">Optional. Left to right in the building view; by unit number when empty.</div>
        </div>

        <div class="col-md-4">
            <label asp-for="FloorSide" class="form-label"></label>
            <select asp-for="FloorSide" class="form-select">
                <option value="">Not set</option>
                <option>Front</option>
                <option>Back</option>
                <option>Left</option>
                <option>Right</option>
            </select>
            <div class="form-text">Optional. Where the unit sits in the 3D building view.</div>
        </div>

        <div class="col-md-4">
            <label asp-for="TitleDeedNumber" class="form-label"></label>
            <input asp-for="TitleDeedNumber" class="form-control" maxlength="50" />
            <div class="form-text">Only when the unit has its own deed (strata title).</div>
        </div>

        <div class="col-md-4">
            <label asp-for="ParkingBays" class="form-label"></label>
            <input asp-for="ParkingBays" class="form-control" min="0" />
        </div>

        <div class="col-md-4">
            <label asp-for="UtilityAccountNumber" class="form-label"></label>
            <input asp-for="UtilityAccountNumber" class="form-control" maxlength="50" />
        </div>

        <div class="col-md-4">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select">
                <option>Vacant</option>
                <option>Reserved</option>
                <option>Occupied</option>
                <option>UnderMaintenance</option>
            </select>
        </div>

        <div class="col-md-4">
            <label asp-for="VatCategory" class="form-label">VAT Treatment</label>
            <select asp-for="VatCategory" class="form-select">
                <option value="">Inherit from property</option>
                <option value="Standard">Standard rated (5%)</option>
                <option value="Exempt">Exempt</option>
                <option value="ZeroRated">Zero rated (0%)</option>
            </select>
            <div class="form-text">
                Affects <strong>new</strong> leases only. Invoices already issued keep their original treatment.
            </div>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-dark">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}