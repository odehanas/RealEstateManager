@model RealEstateManager.Models.UnitCreateViewModel
@using RealEstateManager.Domain
@{
    ViewData["Title"] = T["Create Unit"];
    var properties = ViewBag.Properties as List<Property> ?? new();
}

<h2>@T["Create Unit"]</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="PropertyId" class="form-label"></label>
            <select asp-for="PropertyId" class="form-select">
                <option value="">@T["Select Property"]</option>
                @foreach (var property in properties)
                {
                    <option value="@property.Id">@property.Code - @property.Name</option>
                }
            </select>
        </div>

        <div class="col-md-4">
            <label class="form-label">@T["Unit Code"]</label>
            <input type="text" class="form-control bg-light" value="Generated from the property code" readonly />
            <div class="form-text">
                @T.Html("The property code plus a two-digit unit sequence, e.g. <code>OWN-R-0001-U01</code>.")
            </div>
        </div>

        <div class="col-md-4">
            <label asp-for="Floor" class="form-label"></label>
            <input asp-for="Floor" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="UsageType" class="form-label"></label>
            <select asp-for="UsageType" class="form-select">
                <option value="">@T["Select"]</option>
                <option>@T["Residential"]</option>
                <option>@T["Commercial"]</option>
                <option>@T["Warehouse"]</option>
                <option>@T["Office"]</option>
            </select>
        </div>

        <div class="col-md-4">
            <label asp-for="AreaSqFt" class="form-label"></label>
            <input asp-for="AreaSqFt" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="StandardAnnualRent" class="form-label"></label>
            <input asp-for="StandardAnnualRent" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="FloorNumber" class="form-label"></label>
            <input asp-for="FloorNumber" class="form-control" min="-10" max="200" placeholder="@T["0 = ground"]" />
            <div class="form-text">@T["Optional. Read from Floor when empty (G = 0, B1 = -1)."]</div>
        </div>

        <div class="col-md-4">
            <label asp-for="FloorPosition" class="form-label"></label>
            <input asp-for="FloorPosition" class="form-control" min="1" max="200" placeholder="@T["1 = far left"]" />
            <div class="form-text">@T["Optional. Left to right in the building view; by unit number when empty."]</div>
        </div>

        <div class="col-md-4">
            <label asp-for="FloorSide" class="form-label"></label>
            <select asp-for="FloorSide" class="form-select">
                <option value="">@T["Not set"]</option>
                <option>@T["Front"]</option>
                <option>@T["Back"]</option>
                <option>@T["Left"]</option>
                <option>@T["Right"]</option>
            </select>
            <div class="form-text">@T["Optional. Where the unit sits in the 3D building view."]</div>
        </div>

        <div class="col-md-4">
            <label asp-for="TitleDeedNumber" class="form-label"></label>
            <input asp-for="TitleDeedNumber" class="form-control" maxlength="50" />
            <div class="form-text">@T["Only when the unit has its own deed (strata title)."]</div>
        </div>

        <div class="col-md-4">
            <label asp-for="ParkingBays" class="form-label"></label>
            <input asp-for="ParkingBays" class="form-control" min="0" />
        </div>

        <div class="col-md-4">
            <label asp-for="UtilityAccountNumber" class="form-label"></label>
            <input asp-for="UtilityAccountNumber" class="form-control" maxlength="50" />
        </div>

        <div class="col-md-4">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select">
                <option>@T["Vacant"]</option>
                <option>@T["Reserved"]</option>
                <option>@T["Occupied"]</option>
                <option>@T["UnderMaintenance"]</option>
            </select>
        </div>

        <div class="col-md-4">
            <label asp-for="VatCategory" class="form-label">@T["VAT Treatment"]</label>
            <select asp-for="VatCategory" class="form-select">
                <option value="">@T["Inherit from property"]</option>
                <option value="Standard">@T["Standard rated (5%)"]</option>
                <option value="Exempt">@T["Exempt"]</option>
                <option value="ZeroRated">@T["Zero rated (0%)"]</option>
            </select>
            <div class="form-text">
                @T.Html("Leave as <em>Inherit</em> unless this unit differs from the rest of the building &mdash; for example a shop on the ground floor of a residential tower.")
            </div>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-dark">@T["Save"]</button>
        <a asp-action="Index" class="btn btn-outline-secondary">@T["Back"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}