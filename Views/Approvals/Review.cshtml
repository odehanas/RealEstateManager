@model RealEstateManager.Models.ApprovalReviewViewModel
@using RealEstateManager.Domain

@{
    ViewData["Title"] = $"Approve {Model.Request.DocumentNumber}";
    var request = Model.Request;
    var lease = Model.Lease;
    var pending = request.Status == ApprovalStatuses.Pending;
    var canDecide = pending && Model.FourEyesBlock == null;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <div class="text-muted small">@T["Approval of a contract"]</div>
        <h2 class="mb-0">@request.DocumentNumber</h2>
    </div>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">@T["Back to Approvals"]</a>
</div>

@if (TempData["ApprovalError"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="alert @(pending ? "alert-warning" : request.Status == ApprovalStatuses.Approved ? "alert-success" : "alert-secondary")">
    Submitted by <strong>@request.RequestedByName</strong> on @request.RequestedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm").
    @if (!pending)
    {
        <span>@request.Status by <strong>@request.DecidedByName</strong> on @request.DecidedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm").</span>
        @if (!string.IsNullOrWhiteSpace(request.DecisionComment))
        {
            <div class="mt-1">“@request.DecisionComment”</div>
        }
    }
</div>

@if (lease == null)
{
    <div class="alert alert-danger">@T["The contract no longer exists."]</div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="mb-3">@T["The contract"]</h5>
                    <table class="table table-sm mb-0">
                        <tr><th class="w-50">@T["Tenant"]</th><td>@lease.Tenant?.Code - @lease.Tenant?.FullName</td></tr>
                        <tr><th>@T["Property"]</th><td>@lease.Unit?.Property?.Name (@lease.Unit?.Property?.OwnershipType)</td></tr>
                        <tr><th>@T["Unit"]</th><td>@lease.Unit?.UnitNumber</td></tr>
                        <tr><th>@T["Period"]</th><td>@lease.StartDate.ToString("dd/MM/yyyy") to @lease.EndDate.ToString("dd/MM/yyyy")</td></tr>
                        <tr><th>@T["Annual rent"]</th><td>@lease.AnnualRent.ToString("N2")</td></tr>
                        <tr><th>@T["Billing"]</th><td>Every @lease.BillingFrequencyMonths month(s)</td></tr>
                        <tr>
                            <th>@T["VAT"]</th>
                            <td>
                                @lease.VatCategory @(lease.VatRate > 0 ? $"({lease.VatRate:0.##}%)" : "")
                                @if (!string.IsNullOrWhiteSpace(lease.VatOverrideReason))
                                {
                                    <div class="small text-danger">Overridden: @lease.VatOverrideReason</div>
                                }
                            </td>
                        </tr>
                        <tr><th>@T["Security deposit"]</th><td>@lease.SecurityDepositAmount.ToString("N2")</td></tr>
                        @if (!string.IsNullOrWhiteSpace(lease.Notes))
                        {
                            <tr><th>@T["Notes"]</th><td>@lease.Notes</td></tr>
                        }
                    </table>
                    <a asp-controller="Leases" asp-action="ContractDraft" asp-route-id="@lease.Id" target="_blank"
                       class="btn btn-sm btn-outline-secondary mt-3">@T["Open the draft contract"]</a>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="mb-1">@T["Invoices it will create"]</h5>
                    <p class="small text-muted">@T["Created the moment it is approved, as drafts to post when each falls due."]</p>
                    <table class="table table-sm table-striped mb-0">
                        <thead><tr><th>@T["Date"]</th><th class="text-end">@T["Net"]</th><th class="text-end">@T["VAT"]</th><th class="text-end">@T["Total"]</th></tr></thead>
                        <tbody>
                            @foreach (var invoice in Model.Instalments)
                            {
                                <tr>
                                    <td>@invoice.InvoiceDate.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end">@invoice.Subtotal.ToString("N2")</td>
                                    <td class="text-end">@invoice.VatAmount.ToString("N2")</td>
                                    <td class="text-end">@invoice.TotalAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td>@Model.Instalments.Count invoice(s)</td>
                                <td class="text-end">@Model.Instalments.Sum(x => x.Subtotal).ToString("N2")</td>
                                <td class="text-end">@Model.Instalments.Sum(x => x.VatAmount).ToString("N2")</td>
                                <td class="text-end">@Model.Instalments.Sum(x => x.TotalAmount).ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@if (pending)
{
    <div class="card shadow-sm mt-4">
        <div class="card-body">
            <h5 class="mb-3">@T["Your decision"]</h5>
            @if (Model.FourEyesBlock != null)
            {
                <div class="alert alert-info mb-0">@Model.FourEyesBlock</div>
            }
            else
            {
                <form method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@request.Id" />
                    <div class="col-12">
                        <label class="form-label" for="comment">@T["Remark - required when returning it, so the creator knows what to correct"]</label>
                        <textarea id="comment" name="comment" class="form-control" rows="2" maxlength="1000"></textarea>
                    </div>
                    <div class="col-12 d-flex gap-2">
                        <button type="submit" asp-action="Approve" class="btn btn-success"
                                onclick="return confirm('Approve this contract? Its invoices and income schedule will be created and its terms locked.');">
                            @T["Approve"]
                        </button>
                        <button type="submit" asp-action="Reject" class="btn btn-outline-danger">@T["Return to creator"]</button>
                    </div>
                </form>
            }
        </div>
    </div>
}

@if (Model.History.Count > 1)
{
    <h5 class="mt-4">@T["History of this contract"]</h5>
    <table class="table table-sm table-bordered">
        <thead><tr><th>@T["Submitted"]</th><th>@T["By"]</th><th>@T["Outcome"]</th><th>@T["Decided by"]</th><th>@T["Remark"]</th></tr></thead>
        <tbody>
            @foreach (var step in Model.History)
            {
                <tr>
                    <td>@step.RequestedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@step.RequestedByName</td>
                    <td>@(step.Status == ApprovalStatuses.Rejected ? "Returned" : step.Status)</td>
                    <td>@(step.DecidedByName ?? "-")</td>
                    <td>@(step.DecisionComment ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>
}
