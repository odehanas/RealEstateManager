@model List<RealEstateManager.Services.FixedAssetCategoryService.Row>
@using RealEstateManager.Domain

@{
    ViewData["Title"] = T["Asset Categories"];
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h2 class="mb-1">@T["Asset Categories"]</h2>
        <p class="text-muted mb-0" style="max-width:820px">
            @T["The classes of fixed asset your company keeps, each with its depreciation or amortization programme: the method, the useful life and the accounts. A new asset starts from its category's programme; it can still be changed on the asset itself."]
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="FixedAssets" asp-action="Index" class="btn btn-outline-secondary">@T["Fixed Asset Register"]</a>
        <a asp-action="Create" class="btn btn-dark">@T["Add Category"]</a>
    </div>
</div>

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-warning">@errorMessage</div>
}
@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

<table class="table table-striped table-bordered align-middle">
    <thead>
        <tr>
            <th>@T["Category"]</th>
            <th>@T["Type"]</th>
            <th>@T["Method"]</th>
            <th class="text-end">@T["Useful Life (Months)"]</th>
            <th class="text-end">@T["Residual %"]</th>
            <th>@T["Accounts"]</th>
            <th class="text-end">@T["Assets"]</th>
            <th>@T["Status"]</th>
            <th>@T["Actions"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model)
        {
            var c = row.Category;
            var none = c.DepreciationMethod == DepreciationMethods.None;
            <tr class="@(c.IsActive ? "" : "text-muted")">
                <td>@c.Name</td>
                <td>@T[c.AssetClass == FixedAssetClasses.Intangible ? "Intangible" : "Tangible"]</td>
                <td>@T[DepreciationMethods.Label(c.DepreciationMethod)]@(c.DecliningRatePercent.HasValue ? $" {c.DecliningRatePercent.Value:0.##}%" : "")</td>
                <td class="text-end">@(none ? "-" : c.UsefulLifeMonths.ToString())</td>
                <td class="text-end">@(none ? "-" : c.ResidualPercent.ToString("0.##"))</td>
                <td class="small">
                    @if (c.AssetAccount == null && c.AccumulatedDepreciationAccount == null && c.DepreciationExpenseAccount == null)
                    {
                        <span class="text-muted">@T["Company defaults"]</span>
                    }
                    else
                    {
                        <div>@T["Asset"]: @(c.AssetAccount != null ? $"{c.AssetAccount.Code} - {c.AssetAccount.Name}" : T["Default"])</div>
                        <div>@T["Accumulated"]: @(c.AccumulatedDepreciationAccount != null ? $"{c.AccumulatedDepreciationAccount.Code} - {c.AccumulatedDepreciationAccount.Name}" : T["Default"])</div>
                        <div>@T["Expense"]: @(c.DepreciationExpenseAccount != null ? $"{c.DepreciationExpenseAccount.Code} - {c.DepreciationExpenseAccount.Name}" : T["Default"])</div>
                    }
                </td>
                <td class="text-end">@row.Assets</td>
                <td>
                    <span class="badge @(c.IsActive ? "bg-success" : "bg-secondary")">@(c.IsActive ? T["Offered"] : T["Switched off"])</span>
                </td>
                <td>
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-dark">@T["Edit"]</a>
                        <form asp-action="Toggle" method="post">
                            <input type="hidden" name="id" value="@c.Id" />
                            <button type="submit" class="btn btn-sm @(c.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                @(c.IsActive ? T["Switch off"] : T["Switch on"])
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<p class="text-muted small" style="max-width:820px">
    @T["Renaming a category renames it on the assets that have it. A category that is switched off is no longer offered for new assets; assets that have it keep it. Changing a category's programme does not change assets already in the register."]
</p>
