@model List<RealEstateManager.Models.ReceivedEInvoiceListItemViewModel>
@{
    ViewData["Title"] = T["Received E-Invoices"];
}

<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
    <div>
        <h2 class="mb-1">@T["Received E-Invoices"]</h2>
        <p class="text-muted mb-0">
            @T["E-invoices your suppliers sent through the network. Upload the XML files your provider delivered, then book each one as a vendor bill — the supplier, number, dates and lines are filled in for you."]
        </p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">@T["E-Invoice Monitor"]</a>
</div>

<partial name="_Messages" />

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Upload" method="post" enctype="multipart/form-data" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-8">
                <label class="form-label">@T["E-invoice files (XML)"]</label>
                <input type="file" name="files" class="form-control" accept=".xml,application/xml,text/xml" multiple />
                <div class="form-text">@T["Several at once is fine. The same document is never accepted twice."]</div>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-dark w-100">@T["Upload"]</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>@T["Supplier"]</th>
                    <th>@T["Document"]</th>
                    <th>@T["Date"]</th>
                    <th class="text-end">@T["Total"]</th>
                    <th>@T["Vendor"]</th>
                    <th>@T["Status"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-muted p-3">@T["Nothing received yet."]</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr class="@(item.Status == "Ignored" ? "text-muted" : "")">
                        <td>
                            @item.SupplierName
                            @if (!string.IsNullOrWhiteSpace(item.SupplierTrn))
                            {
                                <div class="small text-muted">TRN @item.SupplierTrn</div>
                            }
                        </td>
                        <td>
                            @item.DocumentNumber
                            <div class="small text-muted">@(item.IsCreditNote ? "Credit note" : "Invoice") &middot; received @item.ReceivedAt.ToLocalTime().ToString("dd/MM/yyyy")</div>
                        </td>
                        <td>@item.IssueDate.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">@item.TotalAmount.ToString("N2")</td>
                        <td>
                            @if (item.VendorName != null)
                            {
                                @item.VendorName
                            }
                            else
                            {
                                <span class="text-danger small">@T["No vendor with this TRN"]</span>
                            }
                        </td>
                        <td>
                            @if (item.VendorBillId != null)
                            {
                                <a asp-controller="VendorBills" asp-action="Details" asp-route-id="@item.VendorBillId" class="badge bg-success text-decoration-none">
                                    Booked as @item.VendorBillNumber
                                </a>
                            }
                            else
                            {
                                <span class="badge @(item.Status == "Ignored" ? "bg-secondary" : "bg-warning text-dark")">@item.Status</span>
                            }
                        </td>
                        <td class="text-nowrap">
                            <a asp-action="ReceivedFile" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark">@T["XML"]</a>
                            @if (item.VendorBillId == null && item.Status != "Ignored")
                            {
                                if (item.IsCreditNote)
                                {
                                    <span class="small text-muted" title="@T["Supplier credit notes are recorded by reducing or reversing the bill they relate to."]">
                                        @T["Record manually"]
                                    </span>
                                }
                                else
                                {
                                    <a asp-controller="VendorBills" asp-action="Create" asp-route-receivedId="@item.Id" class="btn btn-sm btn-primary">@T["Book as bill"]</a>
                                }
                            }
                            @if (item.VendorBillId == null)
                            {
                                <form asp-action="SetReceivedStatus" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="ignore" value="@(item.Status == "Ignored" ? "false" : "true")" />
                                    <button type="submit" class="btn btn-sm btn-link">@(item.Status == "Ignored" ? "Restore" : "Ignore")</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
