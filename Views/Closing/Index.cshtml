@model RealEstateManager.Models.ClosingCockpitViewModel
@using RealEstateManager.Models
@using RealEstateManager.Domain

@{
    ViewData["Title"] = T["Closing Cockpit"];
    var selected = Model.Selected;
    var yearEnd = Model.YearEnd;
}

@functions {
    static string LightClass(ClosingLight light) => light switch
    {
        ClosingLight.Green => "cc-green",
        ClosingLight.Amber => "cc-amber",
        ClosingLight.Red => "cc-red",
        _ => "cc-grey"
    };

    static string LightText(ClosingLight light) => light switch
    {
        ClosingLight.Green => "Done",
        ClosingLight.Amber => "Review",
        ClosingLight.Red => "Action needed",
        _ => "Not applicable"
    };

    static string TileStatus(ClosingPeriodTile tile)
    {
        if (tile.IsClosed) return "Closed";
        if (tile.IsFuture) return "Not started";
        if (tile.IsReopened) return "Reopened";
        if (tile.Light == ClosingLight.Red) return $"{tile.RedCount} to fix";
        if (tile.WaitsForEarlier) return "Done - waits for earlier month";
        return tile.Light == ClosingLight.Amber ? "Ready - review" : "Ready to close";
    }

    static string RequestBadge(string status) => status switch
    {
        PeriodReopenStatuses.Pending => "bg-warning text-dark",
        PeriodReopenStatuses.Approved => "bg-primary",
        PeriodReopenStatuses.Reclosed => "bg-success",
        PeriodReopenStatuses.Rejected => "bg-danger",
        _ => "bg-secondary"
    };
}

<style>
    .cc-light { display: inline-block; width: 16px; height: 16px; border-radius: 50%; flex: 0 0 auto; }
    .cc-green { background: #198754; box-shadow: 0 0 6px rgba(25, 135, 84, .7); }
    .cc-amber { background: #ffc107; box-shadow: 0 0 6px rgba(255, 193, 7, .8); }
    .cc-red { background: #dc3545; box-shadow: 0 0 6px rgba(220, 53, 69, .8); }
    .cc-grey { background: #ced4da; }
    .cc-tile { display: block; text-decoration: none; color: inherit; border: 1px solid #dee2e6; border-radius: .5rem;
               padding: .6rem .75rem; height: 100%; background: #fff; transition: box-shadow .15s; }
    .cc-tile:hover { box-shadow: 0 .25rem .75rem rgba(0, 0, 0, .1); color: inherit; }
    .cc-tile.cc-selected { border: 2px solid #212529; }
    .cc-tile.cc-closed { background: #f1f3f5; }
    .cc-tile.cc-future { opacity: .55; }
    .cc-check td { vertical-align: middle; }
    .cc-rule { font-size: .8rem; color: #6c757d; }
</style>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
    <div>
        <h2 class="mb-0">@T["Closing Cockpit"]</h2>
        <div class="text-muted">@T["Every process the month needs, checked against the general ledger before the period is locked."]</div>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <form method="get" class="d-flex gap-2 align-items-center">
            <label class="form-label mb-0 text-nowrap" for="fiscalYear">@T["Fiscal year"]</label>
            <select id="fiscalYear" name="fiscalYear" class="form-select form-select-sm" style="min-width:6rem" onchange="this.form.submit()">
                @foreach (var year in Model.FiscalYears)
                {
                    <option value="@year" selected="@(year == Model.FiscalYear)">@year</option>
                }
            </select>
        </form>
        @if (Model.CanApproveReopen)
        {
            <a asp-action="ReopenRequests" class="btn btn-sm btn-outline-dark text-nowrap">
                Reopen requests
                @if (Model.PendingRequests.Count > 0)
                {
                    <span class="badge bg-danger">@Model.PendingRequests.Count</span>
                }
            </a>
        }
    </div>
</div>

@if (TempData["ClosingSuccess"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["ClosingError"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="d-flex flex-wrap gap-3 small text-muted mb-2">
    <span><span class="cc-light cc-green align-middle"></span> Processed - ledger agrees</span>
    <span><span class="cc-light cc-amber align-middle"></span> Review - does not stop the close</span>
    <span><span class="cc-light cc-red align-middle"></span> Not processed - blocks the close</span>
    <span><span class="cc-light cc-grey align-middle"></span> Nothing to do this period</span>
</div>

@* ---------------- The twelve periods ---------------- *@
<div class="row row-cols-2 row-cols-md-4 row-cols-xl-6 g-2 mb-4">
    @foreach (var tile in Model.Periods)
    {
        var css = "cc-tile" + (tile.Id == selected?.Id ? " cc-selected" : "") + (tile.IsClosed ? " cc-closed" : "") + (tile.IsFuture ? " cc-future" : "");
        <div class="col">
            <a class="@css" asp-action="Index" asp-route-fiscalYear="@Model.FiscalYear" asp-route-period="@tile.PeriodNumber">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">@tile.Name</span>
                    @if (tile.IsClosed)
                    {
                        <span title="@T["Closed"]" aria-label="@T["Closed"]">&#128274;</span>
                    }
                    else if (!tile.IsFuture)
                    {
                        <span class="cc-light @LightClass(tile.Light)" title="@LightText(tile.Light)"></span>
                    }
                </div>
                <div class="small text-muted">@tile.StartDate.ToString("dd/MM") - @tile.EndDate.ToString("dd/MM/yyyy")</div>
                <div class="small mt-1">
                    @TileStatus(tile)
                    @if (tile.HasPendingRequest)
                    {
                        <span class="badge bg-warning text-dark ms-1">@T["Reopen asked"]</span>
                    }
                    @if (tile.ReopenCount > 0)
                    {
                        <span class="badge bg-light text-dark border ms-1" title="@T["Times reopened"]">&#8635; @tile.ReopenCount</span>
                    }
                </div>
            </a>
        </div>
    }
</div>

@* ---------------- The selected period ---------------- *@
@if (selected != null)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h5 class="mb-0">@selected.Name <span class="text-muted fw-normal">@T.Format("- period {0} of {1}", selected.PeriodNumber, selected.FiscalYear)</span></h5>
                <div class="small text-muted">@selected.StartDate.ToString("dd/MM/yyyy") to @selected.EndDate.ToString("dd/MM/yyyy")</div>
            </div>
            @if (selected.IsClosed)
            {
                <span class="badge bg-dark fs-6">@T["🔒 Closed"]</span>
            }
            else if (selected.IsFuture)
            {
                <span class="badge bg-secondary fs-6">@T["Not started"]</span>
            }
            else
            {
                <div class="d-flex gap-2">
                    <span class="badge bg-danger">@T.Format("{0} red", Model.RedCount)</span>
                    <span class="badge bg-warning text-dark">@T.Format("{0} amber", Model.AmberCount)</span>
                    <span class="badge bg-success">@T.Format("{0} green", Model.GreenCount)</span>
                </div>
            }
        </div>

        @if (selected.IsFuture)
        {
            <div class="card-body text-muted">@T.Format("This period has not started. Its checklist opens on {0}.", selected.StartDate.ToString("dd/MM/yyyy"))</div>
        }
        else if (!selected.IsClosed)
        {
            @if (selected.IsReopened)
            {
                <div class="alert alert-primary m-3 mb-0">
                    @T.Format("This period was reopened on request on {0} by {1}. Make the correction, then close it again below.", selected.ReopenedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm"), selected.ReopenedByName)
                </div>
            }
            <div class="table-responsive">
                <table class="table mb-0 cc-check">
                    <thead class="table-light">
                        <tr>
                            <th style="width:40px"></th>
                            <th>@T["Check"]</th>
                            <th>@T["Result"]</th>
                            <th class="text-end text-nowrap">@T["Scheduled"]</th>
                            <th class="text-end text-nowrap">@T["In ledger"]</th>
                            <th class="text-end" style="width:210px">@T["Action"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var check in Model.Checks)
                        {
                            <tr>
                                <td class="text-center"><span class="cc-light @LightClass(check.Light)" title="@LightText(check.Light)"></span></td>
                                <td>
                                    <div class="fw-semibold">@check.Title</div>
                                    <div class="cc-rule">@check.Rule</div>
                                </td>
                                <td>@check.Detail</td>
                                <td class="text-end text-nowrap">@(check.Expected?.ToString("N2") ?? "")</td>
                                <td class="text-end text-nowrap">@(check.Recorded?.ToString("N2") ?? "")</td>
                                <td class="text-end">
                                    <div class="d-flex flex-wrap justify-content-end gap-1">
                                        @if (check.RunStep != null)
                                        {
                                            <form asp-action="RunStep" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="periodId" value="@selected.Id" />
                                                <input type="hidden" name="step" value="@check.RunStep" />
                                                <button type="submit" class="btn btn-sm btn-dark text-nowrap">@check.RunLabel</button>
                                            </form>
                                        }
                                        @if (check.LinkUrl != null)
                                        {
                                            <a href="@check.LinkUrl" class="btn btn-sm btn-outline-secondary text-nowrap">@check.LinkLabel</a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-white">
                <form asp-action="ClosePeriod" method="post" class="d-flex flex-wrap align-items-center gap-3"
                      onsubmit="return confirm('Close @selected.Name? Nothing can be posted into it afterwards without an approved reopen request.');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="periodId" value="@selected.Id" />
                    @if (!Model.CanClose)
                    {
                        <span class="text-danger">@T["Resolve the red checks before the period can be closed."]</span>
                    }
                    else if (Model.AmberCount > 0)
                    {
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" name="acknowledgeWarnings" value="true" id="ack" required />
                            <label class="form-check-label" for="ack">@T.Format("I have reviewed the {0} amber warning(s); they are recorded with the close.", Model.AmberCount)</label>
                        </div>
                    }
                    else
                    {
                        <span class="text-success">@T["Every check is green."]</span>
                    }
                    <button type="submit" class="btn btn-danger ms-auto" disabled="@(!Model.CanClose)">@T.Format("🔒 Close {0}", selected.Name)</button>
                </form>
            </div>
        }
        else
        {
            <div class="card-body">
                <p class="mb-3">
                    Closed on @selected.ClosedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                    @if (!string.IsNullOrWhiteSpace(selected.ClosedByName))
                    {
                        <text> by <strong>@selected.ClosedByName</strong></text>
                    }.
                    Nothing can be posted, reset, edited or deleted in this period.
                </p>

                @if (Model.PendingRequest != null)
                {
                    <div class="alert alert-warning mb-0">
                        <strong>Reopening requested</strong> by @Model.PendingRequest.RequestedByName on
                        @Model.PendingRequest.RequestedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm"): "@Model.PendingRequest.Reason"
                        <div class="mt-2">@T["Waiting for an approver."]</div>
                        @if (Model.PendingRequest.RequestedByAppUserId == Model.CurrentUserId)
                        {
                            <form asp-action="WithdrawReopen" method="post" class="mt-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="requestId" value="@Model.PendingRequest.Id" />
                                <input type="hidden" name="periodId" value="@selected.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-dark">@T["Withdraw my request"]</button>
                            </form>
                        }
                    </div>
                }
                else if (Model.ReopenBlockReason != null)
                {
                    <div class="alert alert-secondary mb-0">@Model.ReopenBlockReason</div>
                }
                else
                {
                    <form asp-action="RequestReopen" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="periodId" value="@selected.Id" />
                        <label class="form-label fw-semibold" for="reason">@T["Ask for this period to be reopened"]</label>
                        <textarea id="reason" name="reason" class="form-control mb-2" rows="3" maxlength="1000" minlength="15" required
                                  placeholder="@T["What is wrong in this period, and what will be posted to correct it."]"></textarea>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="small text-muted">@T["An approver decides. Once corrected, the period is closed again through the checklist."]</span>
                            <button type="submit" class="btn btn-outline-danger">@T["Request reopening"]</button>
                        </div>
                    </form>
                }
            </div>
        }
    </div>

    @if (Model.RequestHistory.Count > 0 || Model.Events.Count > 0)
    {
        <div class="row g-3 mb-4">
            <div class="col-lg-7">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-light"><h6 class="mb-0">@T.Format("Reopen requests for {0}", selected.Name)</h6></div>
                    <div class="card-body p-0">
                        @if (Model.RequestHistory.Count == 0)
                        {
                            <div class="p-3 text-muted">@T["This period has never been asked to reopen."]</div>
                        }
                        else
                        {
                            <table class="table table-sm mb-0">
                                <thead class="table-light"><tr><th>@T["Asked"]</th><th>@T["Reason"]</th><th>@T["Status"]</th><th>@T["Decision"]</th></tr></thead>
                                <tbody>
                                    @foreach (var r in Model.RequestHistory)
                                    {
                                        <tr>
                                            <td class="text-nowrap small">@r.RequestedAt.ToLocalTime().ToString("dd/MM/yyyy")<br />@r.RequestedByName</td>
                                            <td class="small">@r.Reason</td>
                                            <td><span class="badge @RequestBadge(r.Status)">@r.Status</span></td>
                                            <td class="small">
                                                @if (r.DecidedAt.HasValue)
                                                {
                                                    @r.DecidedByName<br />@r.DecidedAt.Value.ToLocalTime().ToString("dd/MM/yyyy")
                                                    @if (!string.IsNullOrWhiteSpace(r.DecisionComment))
                                                    {
                                                        <div class="text-muted">"@r.DecisionComment"</div>
                                                    }
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-light"><h6 class="mb-0">@T["Period history"]</h6></div>
                    <ul class="list-group list-group-flush small">
                        @foreach (var e in Model.Events)
                        {
                            <li class="list-group-item">
                                <div class="d-flex justify-content-between">
                                    <strong>@e.Action</strong>
                                    <span class="text-muted">@e.At.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <div class="text-muted">@e.ByName</div>
                                @if (!string.IsNullOrWhiteSpace(e.Note))
                                {
                                    <div>@e.Note</div>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }
}

@* ---------------- Requests waiting for this approver ---------------- *@
@if (Model.CanApproveReopen && Model.PendingRequests.Count > 0)
{
    <div class="card shadow-sm border-warning mb-4">
        <div class="card-header bg-warning-subtle"><h5 class="mb-0">@T["Reopen requests waiting for a decision"]</h5></div>
        <div class="card-body p-0">
            @await Html.PartialAsync("_ReopenRequestRows", new ReopenRequestsViewModel
            {
                Pending = Model.PendingRequests,
                CurrentUserId = Model.CurrentUserId,
                OnlyApprover = Model.OnlyApprover
            }, new ViewDataDictionary(ViewData) { ["ReturnTo"] = $"{Context.Request.Path}{Context.Request.QueryString}" })
        </div>
    </div>
}

@* ---------------- Year-end ---------------- *@
<div class="card shadow-sm mb-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h5 class="mb-0">@T.Format("Year-end close - fiscal year {0}", yearEnd.FiscalYear)</h5>
        @if (yearEnd.IsClosed)
        {
            <span class="badge bg-dark fs-6">@T["🔒 Year closed"]</span>
        }
        else if (yearEnd.WasReopened)
        {
            <span class="badge bg-primary fs-6">@T["Reopened - close again"]</span>
        }
        else
        {
            <span class="badge bg-secondary fs-6">@T["Open"]</span>
        }
    </div>
    <div class="card-body">
        <p class="text-muted">
            @T.Format("Clears every revenue and expense account of the year into retained earnings with one entry on {0}, and carries the balance sheet into {1} as its opening balances.", yearEnd.EndDate?.ToString("dd/MM/yyyy") ?? "the last day of the year", yearEnd.FiscalYear + 1)
        </p>

        <div class="row g-3 mb-3">
            <div class="col-md-3">
                <div class="border rounded p-2 h-100">
                    <div class="small text-muted">@T.Format("Revenue {0}", yearEnd.IsClosed ? "cleared" : "to clear")</div>
                    <div class="fs-5 fw-bold">@yearEnd.TotalRevenue.ToString("N2")</div>
                    @if (!yearEnd.IsClosed) { <div class="small text-muted">@T.Format("{0} account(s)", yearEnd.RevenueAccounts)</div> }
                </div>
            </div>
            <div class="col-md-3">
                <div class="border rounded p-2 h-100">
                    <div class="small text-muted">@T.Format("Expenses {0}", yearEnd.IsClosed ? "cleared" : "to clear")</div>
                    <div class="fs-5 fw-bold">@yearEnd.TotalExpenses.ToString("N2")</div>
                    @if (!yearEnd.IsClosed) { <div class="small text-muted">@T.Format("{0} account(s)", yearEnd.ExpenseAccounts)</div> }
                </div>
            </div>
            <div class="col-md-3">
                <div class="border rounded p-2 h-100">
                    <div class="small text-muted">@T.Format("Net {0} to retained earnings", yearEnd.NetProfitOrLoss >= 0 ? "profit" : "loss")</div>
                    <div class="fs-5 fw-bold @(yearEnd.NetProfitOrLoss >= 0 ? "text-success" : "text-danger")">@yearEnd.NetProfitOrLoss.ToString("N2")</div>
                    @if (yearEnd.RetainedEarningsAccount != null) { <div class="small text-muted">@yearEnd.RetainedEarningsAccount</div> }
                </div>
            </div>
            <div class="col-md-3">
                <div class="border rounded p-2 h-100">
                    <div class="small text-muted">@T["Periods closed"]</div>
                    <div class="fs-5 fw-bold">@Model.Periods.Count(x => x.IsClosed) / @Model.Periods.Count</div>
                </div>
            </div>
        </div>

        @if (yearEnd.IsClosed)
        {
            <p class="mb-2">
                Closed on @yearEnd.ClosedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") by @yearEnd.ClosedByName
                @if (yearEnd.JournalEntryNumber != null)
                {
                    <text>@T.HtmlFormat("- closing entry <strong>{0}</strong>.", yearEnd.JournalEntryNumber)</text>
                }
            </p>
            @if (yearEnd.CarryForwards.Count > 0)
            {
                <details>
                    <summary class="fw-semibold mb-2">@T.Format("Opening balances carried into {0} ({1} accounts)", yearEnd.FiscalYear + 1, yearEnd.CarryForwards.Count)</summary>
                    <div class="table-responsive">
                        <table class="table table-sm table-striped mb-0">
                            <thead class="table-light"><tr><th>@T["Account"]</th><th>@T["Type"]</th><th class="text-end">@T["Debit"]</th><th class="text-end">@T["Credit"]</th></tr></thead>
                            <tbody>
                                @foreach (var cf in yearEnd.CarryForwards)
                                {
                                    <tr>
                                        <td>@cf.AccountCode - @cf.AccountName</td>
                                        <td>@cf.AccountType</td>
                                        <td class="text-end">@(cf.DebitBalance == 0 ? "" : cf.DebitBalance.ToString("N2"))</td>
                                        <td class="text-end">@(cf.CreditBalance == 0 ? "" : cf.CreditBalance.ToString("N2"))</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="fw-bold">
                                <tr>
                                    <td colspan="2">@T["Total"]</td>
                                    <td class="text-end">@yearEnd.CarryForwards.Sum(x => x.DebitBalance).ToString("N2")</td>
                                    <td class="text-end">@yearEnd.CarryForwards.Sum(x => x.CreditBalance).ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </details>
            }
        }
        else
        {
            @if (yearEnd.Blockers.Count > 0)
            {
                <ul class="list-unstyled mb-3">
                    @foreach (var blocker in yearEnd.Blockers)
                    {
                        <li class="d-flex gap-2 align-items-start mb-1"><span class="cc-light cc-red mt-1"></span><span>@blocker</span></li>
                    }
                </ul>
            }
            else
            {
                <div class="d-flex gap-2 align-items-center mb-3"><span class="cc-light cc-green"></span><span>@T["Every period is closed. The year is ready to close."]</span></div>
            }
            <form asp-action="CloseYear" method="post"
                  onsubmit="return confirm('Close fiscal year @yearEnd.FiscalYear? Revenue and expenses are transferred to retained earnings.');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="fiscalYear" value="@yearEnd.FiscalYear" />
                <button type="submit" class="btn btn-danger" disabled="@(!yearEnd.CanClose)">@T.Format("Close fiscal year {0}", yearEnd.FiscalYear)</button>
            </form>
        }
    </div>
</div>

@if (Model.FiscalYearClosings.Count > 0)
{
    <div class="card shadow-sm">
        <div class="card-header bg-light"><h5 class="mb-0">@T["Fiscal year closing history"]</h5></div>
        <div class="card-body p-0">
            <table class="table table-bordered table-striped mb-0">
                <thead>
                    <tr>
                        <th>@T["Fiscal year"]</th>
                        <th>@T["Status"]</th>
                        <th class="text-end">@T["Revenue"]</th>
                        <th class="text-end">@T["Expenses"]</th>
                        <th class="text-end">@T["Profit / Loss"]</th>
                        <th>@T["Closed"]</th>
                        <th>@T["Closing entry"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.FiscalYearClosings)
                    {
                        <tr>
                            <td><a asp-action="Index" asp-route-fiscalYear="@item.FiscalYear">@item.FiscalYear</a></td>
                            <td><span class="badge @(item.Status == FiscalYearClosingStatuses.Closed ? "bg-dark" : "bg-primary")">@item.Status</span></td>
                            <td class="text-end">@item.TotalRevenue.ToString("N2")</td>
                            <td class="text-end">@item.TotalExpenses.ToString("N2")</td>
                            <td class="text-end">@item.ProfitOrLossAmount.ToString("N2")</td>
                            <td>@item.ClosedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") @item.ClosedByName</td>
                            <td>@(item.JournalEntryNumber ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
