@model RealEstateManager.Models.AttendanceMonthViewModel

@{
    ViewData["Title"] = T["Attendance Summary"];
    var monthStart = new DateTime(Model.Year, Model.Month, 1);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
    <div>
        <h2 class="mb-0">@T.Format("Attendance — {0}", monthStart.ToString("MMMM yyyy"))</h2>
        <div class="text-muted">@T["Check the month, then turn it into payroll transactions."]</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Month" asp-route-year="@monthStart.AddMonths(-1).Year" asp-route-month="@monthStart.AddMonths(-1).Month" class="btn btn-outline-secondary">&larr; @monthStart.AddMonths(-1).ToString("MMM")</a>
        <a asp-action="Month" asp-route-year="@monthStart.AddMonths(1).Year" asp-route-month="@monthStart.AddMonths(1).Month" class="btn btn-outline-secondary">@monthStart.AddMonths(1).ToString("MMM") &rarr;</a>
        <a asp-action="Index" class="btn btn-outline-dark">@T["Day sheet"]</a>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">@T["Print"]</button>
    </div>
</div>

@if (TempData["HrSuccess"] is string ok) { <div class="alert alert-success">@ok</div> }
@if (TempData["HrError"] is string err) { <div class="alert alert-danger">@err</div> }

<div class="table-responsive">
    <table class="table table-bordered table-striped align-middle">
        <thead class="table-light">
            <tr>
                <th>@T["Employee"]</th><th class="text-end">@T["Present"]</th><th class="text-end">@T["Absent"]</th><th class="text-end">@T["On leave"]</th>
                <th class="text-end">@T["Rest days"]</th><th class="text-end">@T["Not recorded"]</th><th class="text-end">@T["Late days"]</th><th class="text-end">@T["Late minutes"]</th>
                <th class="text-end">@T["Overtime h"]</th><th class="text-end">@T["Rest-day OT h"]</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Rows.Count == 0) { <tr><td colspan="10" class="text-muted">@T["Nobody employed this month."]</td></tr> }
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td><a asp-controller="PayrollAdjustments" asp-action="Index" asp-route-employeeId="@r.EmployeeId" asp-route-status="All">@r.EmployeeCode</a> @r.EmployeeName</td>
                    <td class="text-end">@r.Present</td>
                    <td class="text-end @(r.Absent > 0 ? "text-danger fw-bold" : "")">@r.Absent</td>
                    <td class="text-end">@r.OnLeave</td>
                    <td class="text-end">@r.Off</td>
                    <td class="text-end @(r.NotRecorded > 0 ? "text-warning fw-bold" : "")">@r.NotRecorded</td>
                    <td class="text-end">@r.LateDays</td>
                    <td class="text-end">@r.LateMinutes</td>
                    <td class="text-end">@r.OvertimeHours.ToString("0.##")</td>
                    <td class="text-end">@r.RestDayOvertimeHours.ToString("0.##")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.Rows.Any(x => x.NotRecorded > 0))
{
    <div class="alert alert-warning">@T["Some working days have no attendance recorded. They are treated as worked; complete the day sheets first if that is not right."]</div>
}

<div class="card shadow-sm">
    <div class="card-body d-flex flex-wrap gap-3 align-items-center">
        <div class="me-auto">
            <strong>@T["Generate payroll transactions"]</strong> — overtime, rest-day overtime, unauthorised absence
            @(Model.Settings.DeductLateTime ? "and late arrival" : "(late arrival is not deducted: see Payroll Settings)")
            for every employee, approved and ready for the payroll. Running it again replaces what it made before.
        </div>
        <form asp-action="Generate" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="year" value="@Model.Year" />
            <input type="hidden" name="month" value="@Model.Month" />
            <button class="btn btn-dark">@T.Format("Generate for {0}", monthStart.ToString("MMMM yyyy"))</button>
        </form>
        <a asp-controller="PayrollAdjustments" asp-action="Index" asp-route-month="@monthStart.ToString("yyyy-MM")" asp-route-status="All" class="btn btn-outline-dark">@T["See the transactions"]</a>
    </div>
</div>
