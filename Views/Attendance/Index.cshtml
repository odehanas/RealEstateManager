@model RealEstateManager.Models.AttendanceDayViewModel
@using RealEstateManager.Domain

@{
    ViewData["Title"] = T["Attendance"];
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
    <div>
        <h2 class="mb-0">@T["Attendance"]</h2>
        <div class="text-muted">@T["Mark the day for everyone, or import the file from your time-attendance device."]</div>
    </div>
    <a asp-action="Month" asp-route-year="@Model.Date.Year" asp-route-month="@Model.Date.Month" class="btn btn-outline-dark">@T["Month summary & payroll"]</a>
</div>

@if (TempData["HrSuccess"] is string ok) { <div class="alert alert-success">@ok</div> }
@if (TempData["HrError"] is string err) { <div class="alert alert-danger">@err</div> }

<div class="d-flex flex-wrap gap-3 align-items-end mb-3">
    <form method="get" class="d-flex gap-2 align-items-end">
        <a asp-action="Index" asp-route-date="@Model.Date.AddDays(-1).ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">&larr;</a>
        <div><label class="form-label small mb-0">@T["Date"]</label><input type="date" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" class="form-control" onchange="this.form.submit()" /></div>
        <a asp-action="Index" asp-route-date="@Model.Date.AddDays(1).ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">&rarr;</a>
    </form>
    <div class="fs-5">@Model.Date.ToString("dddd d MMMM yyyy") @if (Model.IsWeeklyOff) { <span class="badge bg-secondary">@T["Weekly rest day"]</span> }</div>
    <form asp-action="Import" method="post" enctype="multipart/form-data" class="d-flex gap-2 align-items-end ms-auto">
        @Html.AntiForgeryToken()
        <div>
            <label class="form-label small mb-0">@T["Import device file (CSV)"]</label>
            <input type="file" name="file" accept=".csv,.txt" class="form-control form-control-sm" />
        </div>
        <button class="btn btn-sm btn-outline-dark">@T["Import"]</button>
    </form>
</div>
<div class="small text-muted mb-2">
    @T.HtmlFormat("Device file columns: <code>EmployeeCode, Date, CheckIn, CheckOut</code> — e.g. <code>EMP-0001, 2026-10-12, 07:58, 17:05</code>. Working day {0}, {1} hours; late after {2} minutes' grace.", Model.Settings.WorkStartTime.ToString(@"hh\:mm"), Model.Settings.WorkingHoursPerDay.ToString("0.#"), Model.Settings.LateGraceMinutes)
</div>

<form asp-action="Save" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" />
    <div class="table-responsive">
        <table class="table table-sm table-bordered align-middle">
            <thead class="table-light">
                <tr><th>@T["Employee"]</th><th style="width:160px">@T["Status"]</th><th style="width:120px">@T["In"]</th><th style="width:120px">@T["Out"]</th>
                    <th class="text-end">@T["Worked"]</th><th class="text-end">@T["Overtime"]</th><th class="text-end">@T["Late (min)"]</th><th>@T["Notes"]</th></tr>
            </thead>
            <tbody>
                @if (Model.Rows.Count == 0) { <tr><td colspan="8" class="text-muted">@T["Nobody was employed on this date."]</td></tr> }
                @for (var i = 0; i < Model.Rows.Count; i++)
                {
                    var r = Model.Rows[i];
                    <tr class="@(r.IsSaved ? "" : "table-warning")">
                        <td>
                            <input type="hidden" name="rows[@i].EmployeeId" value="@r.EmployeeId" />
                            <span class="fw-semibold">@r.EmployeeCode</span> @r.EmployeeName
                            <div class="small text-muted">@r.JobTitle @(r.LeaveType != null ? $"· approved {r.LeaveType.ToLowerInvariant()} leave" : "") @(r.IsSaved ? "" : "· not saved yet")</div>
                        </td>
                        <td>
                            <select name="rows[@i].Status" class="form-select form-select-sm">
                                @foreach (var s in AttendanceStatuses.All)
                                {
                                    <option value="@s" selected="@(s == r.Status)">@AttendanceStatuses.Describe(s)</option>
                                }
                            </select>
                        </td>
                        <td><input type="time" name="rows[@i].CheckIn" value="@r.CheckIn?.ToString(@"hh\:mm")" class="form-control form-control-sm" /></td>
                        <td><input type="time" name="rows[@i].CheckOut" value="@r.CheckOut?.ToString(@"hh\:mm")" class="form-control form-control-sm" /></td>
                        <td class="text-end">@(r.WorkedHours > 0 ? r.WorkedHours.ToString("0.##") : "")</td>
                        <td class="text-end">@(r.OvertimeHours > 0 ? r.OvertimeHours.ToString("0.##") : "")</td>
                        <td class="text-end @(r.LateMinutes > 0 ? "text-danger" : "")">@(r.LateMinutes > 0 ? r.LateMinutes.ToString() : "")</td>
                        <td><input name="rows[@i].Notes" value="@r.Notes" class="form-control form-control-sm" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="small text-muted mb-2">
        @T["Absent means absent without leave: it becomes an unauthorised-absence deduction. Approved leave shows as On leave. Times entered on a weekly off or a holiday are paid as rest-day overtime."]
    </div>
    <button class="btn btn-dark">@T["Save the day"]</button>
</form>
