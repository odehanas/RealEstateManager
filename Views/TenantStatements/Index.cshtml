@model RealEstateManager.Models.TenantStatementViewModel
@using RealEstateManager.Domain

@{
    ViewData["Title"] = T["Tenant Statement"];
    var tenants = ViewBag.Tenants as List<Tenant> ?? new();
    var leases = ViewBag.Leases as List<Lease> ?? new();
}

<h2>@T["Tenant Statement"]</h2>

<div class="alert alert-info">
    @T["Real balance movements appear in the statement section below. Uncleared PDC remains in the separate noted-items section and does not affect the running balance until clearance."]
</div>

<form method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <label class="form-label">@T["Tenant"]</label>
        <select name="tenantId" class="form-select">
            <option value="">@T["Select Tenant"]</option>
            @foreach (var tenant in tenants)
            {
                if (Model.TenantId == tenant.Id)
                {
                    <option value="@tenant.Id" selected>@tenant.Code - @tenant.FullName</option>
                }
                else
                {
                    <option value="@tenant.Id">@tenant.Code - @tenant.FullName</option>
                }
            }
        </select>
    </div>

    <div class="col-md-4">
        <label class="form-label">@T["Lease"]</label>
        <select name="leaseId" class="form-select">
            <option value="">@T["All Leases"]</option>
            @foreach (var lease in leases)
            {
                var leaseText = $"{lease.ContractNumber} - {lease.Unit?.Property?.Code}/{lease.Unit?.UnitNumber}";

                if (Model.LeaseId == lease.Id)
                {
                    <option value="@lease.Id" selected>@leaseText</option>
                }
                else
                {
                    <option value="@lease.Id">@leaseText</option>
                }
            }
        </select>
    </div>

    <div class="col-md-2">
        <label class="form-label">@T["From Date"]</label>
        <input type="date" name="fromDate" value="@Model.FromDate.ToString("yyyy-MM-dd")" class="form-control" />
    </div>

    <div class="col-md-2">
        <label class="form-label">@T["To Date"]</label>
        <input type="date" name="toDate" value="@Model.ToDate.ToString("yyyy-MM-dd")" class="form-control" />
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-dark">@T["View Statement"]</button>
    </div>
</form>

<div asp-validation-summary="All" class="text-danger mb-3"></div>

@if (!Model.TenantId.HasValue)
{
    <div class="alert alert-secondary">
        @T["Select a tenant to view the statement."]
    </div>
}
else
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <strong>@Model.TenantCode - @Model.TenantName</strong>
        </div>
        <div class="card-body">
            <div><strong>Lease Scope:</strong> @Model.LeaseDisplay</div>
            <div><strong>Statement Period:</strong> @Model.FromDate.ToString("dd/MM/yyyy") to @Model.ToDate.ToString("dd/MM/yyyy")</div>
            <div><strong>Opening Balance:</strong> @Model.OpeningBalance.ToString("N2")</div>
            <div><strong>Total Charges:</strong> @Model.TotalCharges.ToString("N2")</div>
            <div><strong>Total Credits:</strong> @Model.TotalCredits.ToString("N2")</div>
            <div><strong>Closing Balance:</strong> @Model.ClosingBalance.ToString("N2")</div>
        </div>
    </div>

    <h4>@T["Statement Movements"]</h4>

    <table class="table table-bordered table-striped table-sm mb-4">
        <thead>
            <tr>
                <th>@T["Date"]</th>
                <th>@T["Type"]</th>
                <th>@T["Reference"]</th>
                <th>@T["Description"]</th>
                <th class="text-end">@T["Charge"]</th>
                <th class="text-end">@T["Credit"]</th>
                <th class="text-end">@T["Running Balance"]</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Rows.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">@T["No statement movements found for the selected period."]</td>
                </tr>
            }
            else
            {
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>@row.TransactionDate.ToString("dd/MM/yyyy")</td>
                        <td>@row.TransactionType</td>
                        <td>@if (row.SourceId.HasValue) { <a asp-controller="Documents" asp-action="Open" asp-route-type="@row.SourceType" asp-route-id="@row.SourceId" title="@T["Open the original document"]">@row.ReferenceNumber</a> } else { @row.ReferenceNumber }</td>
                        <td>@row.Description</td>
                        <td class="text-end">@row.Debit.ToString("N2")</td>
                        <td class="text-end">@row.Credit.ToString("N2")</td>
                        <td class="text-end">@row.RunningBalance.ToString("N2")</td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <h4>@T["Noted Items PDC"]</h4>

    <div class="mb-2">
        <strong>Total Noted PDC:</strong> @Model.NotedPdcTotal.ToString("N2")
    </div>

    <table class="table table-bordered table-striped table-sm">
        <thead>
            <tr>
                <th>@T["Received Date"]</th>
                <th>@T["Cheque Date"]</th>
                <th>@T["Cheque No."]</th>
                <th>@T["Lease"]</th>
                <th>@T["Invoice"]</th>
                <th>@T["Bank"]</th>
                <th>@T["Mode"]</th>
                <th>@T["Status"]</th>
                <th class="text-end">@T["Amount"]</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.NotedPdcItems.Count == 0)
            {
                <tr>
                    <td colspan="9" class="text-center text-muted">@T["No noted PDC items outstanding as of the selected statement date."]</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.NotedPdcItems)
                {
                    <tr>
                        <td>@item.ReceivedDate.ToString("dd/MM/yyyy")</td>
                        <td>@item.ChequeDate.ToString("dd/MM/yyyy")</td>
                        <td>@item.ChequeNumber</td>
                        <td>@item.LeaseDisplay</td>
                        <td>@item.InvoiceDisplay</td>
                        <td>@(string.IsNullOrWhiteSpace(item.BankName) ? "-" : item.BankName)</td>
                        <td>@item.SettlementMode</td>
                        <td>@item.Status</td>
                        <td class="text-end">@item.Amount.ToString("N2")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
}
