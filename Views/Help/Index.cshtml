@model RealEstateManager.Models.HelpCenterViewModel
@{
    ViewData["Title"] = T["Help Center"];
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="mb-1">@T["Help Center"]</h2>
        <p class="text-muted mb-0">
            @T.Html("Every screen's instructions in one place. On any screen, the <strong>Help</strong> button at the top right opens just that screen's topic.")
        </p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Manual" target="_blank" class="btn btn-dark">@T["Full manual"]</a>
        <a href="~/manual/RealEstateManager-User-Manual@(RealEstateManager.Services.Localization.UiLanguages.IsArabic ? "-ar" : "").pdf" target="_blank" class="btn btn-outline-dark">@T["Download PDF"]</a>
        <a asp-action="Training" target="_blank" class="btn btn-outline-dark">@T["Training workbook"]</a>
    </div>
</div>

<form method="get" class="mb-4" role="search">
    <div class="input-group input-group-lg">
        <input type="search" name="q" value="@Model.Query" class="form-control"
               placeholder="@T["Search the help — e.g. post draft, VAT, PDC, petty cash"]" aria-label="@T["Search help"]" autofocus />
        <button type="submit" class="btn btn-primary">@T["Search"]</button>
    </div>
</form>

@if (Model.IsSearching)
{
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h3 class="h6 mb-0 text-muted">
            @Model.Results.Count result@(Model.Results.Count == 1 ? "" : "s") for &ldquo;@Model.Query&rdquo;
        </h3>
        <a asp-action="Index" class="small">@T["Clear search"]</a>
    </div>

    @if (Model.Results.Count == 0)
    {
        <div class="alert alert-light border">
            @T["Nothing matches every word you typed. Try fewer or different words, or browse the topics below."]
        </div>
    }
    else
    {
        <div class="list-group shadow-sm mb-5">
            @foreach (var result in Model.Results)
            {
                <a asp-action="Topic" asp-route-id="@result.Topic.Key" class="list-group-item list-group-item-action py-3">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <strong>@result.Topic.Title</strong>
                        <span class="badge bg-light text-dark border">@result.Topic.GroupTitle</span>
                    </div>
                    <div class="small text-muted mt-1">@result.Excerpt</div>
                </a>
            }
        </div>
    }
}

<div class="row g-4">
    @foreach (var group in Model.Groups)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white"><strong>@group.Title</strong></div>
                <div class="list-group list-group-flush">
                    @foreach (var topic in group.Topics)
                    {
                        <a asp-action="Topic" asp-route-id="@topic.Key" class="list-group-item list-group-item-action">
                            <div class="fw-semibold">@topic.Title</div>
                            <div class="small text-muted">@topic.Summary</div>
                        </a>
                    }
                </div>
            </div>
        </div>
    }
</div>

<div class="text-center text-muted small mt-5">
    Can't find what you need?
    <a asp-controller="Feedback" asp-action="Index">Send feedback</a> and say which screen you were on.
</div>
