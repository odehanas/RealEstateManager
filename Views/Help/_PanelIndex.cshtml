@model IReadOnlyList<RealEstateManager.Services.HelpGroup>
@*
    Shown in the help panel on a screen that has no topic of its own, and when the
    user follows "All help topics" from inside the panel.
*@
<div data-help-title="@T["Help"]" data-help-path="All topics">
    <form action="/Help" method="get" target="_blank" class="mb-3">
        <div class="input-group">
            <input type="search" name="q" class="form-control" placeholder="@T["Search the help"]" aria-label="@T["Search help"]" />
            <button type="submit" class="btn btn-primary">@T["Search"]</button>
        </div>
    </form>

    @foreach (var group in Model)
    {
        <div class="text-uppercase small fw-bold text-muted mt-3 mb-1">@group.Title</div>
        <div class="list-group list-group-flush">
            @foreach (var topic in group.Topics)
            {
                <a href="/Help/Topic/@topic.Key" data-help-topic="@topic.Key"
                   class="list-group-item list-group-item-action px-0 py-2">
                    <div class="fw-semibold small">@topic.Title</div>
                    <div class="small text-muted">@topic.Summary</div>
                </a>
            }
        </div>
    }
</div>
