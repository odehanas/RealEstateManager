        <tr><th>Tenant</th><th>Type</th><th>Notes</th></tr>
        <tr><td>Al Noor Trading LLC</td><td>Company</td><td>Has a TRN on file</td></tr>
        <tr><td>Sara Ahmed</td><td>Individual</td><td>Emirates ID on file</td></tr>
        <tr><td>Omar Haddad</td><td>Individual</td><td>Emirates ID on file</td></tr>
    </table></div>

    <h4>Vendors</h4>
