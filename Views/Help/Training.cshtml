        <tr><th>Vendor</th><th>VAT registered</th><th>Used in</th></tr>
        <tr><td>Coastal Facility Services LLC</td><td>Yes, with TRN</td><td>T13, T17</td></tr>
        <tr><td>Quick Fix Plumbing</td><td>No</td><td>T14, T15, T17</td></tr>
        <tr><td>Gulf Shield Insurance</td><td>Yes, with TRN</td><td>T19</td></tr>
        <tr><td>PowerGen Equipment Trading</td><td>Yes, with TRN</td><td>T22</td></tr>
    </table></div>

    <h4>Accounts you will meet</h4>
