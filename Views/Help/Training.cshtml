        <tr><td>Palm Residences</td><td>Owned</td><td>Apartment 704</td><td>Exempt</td><td>Residential, not a new building</td></tr>
        <tr><td>Garden Villas</td><td>Managed</td><td>Villa 12</td><td>Exempt</td><td>Landlord: Khalid Rahman · Commission 5%</td></tr>
    </table></div>

    <h4>Tenants</h4>
