        <tr><th>Code</th><th>Account</th><th>Code</th><th>Account</th></tr>
        <tr><td>11100</td><td>Cash and Cash Equivalents (bank)</td><td>21300</td><td>Tenant Security Deposits</td></tr>
        <tr><td>11150</td><td>Petty Cash (float)</td><td>21400</td><td>VAT Payable</td></tr>
