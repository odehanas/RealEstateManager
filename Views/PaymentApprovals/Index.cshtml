@model List<RealEstateManager.Domain.PaymentApproval>
@using RealEstateManager.Domain

@{
    ViewData["Title"] = T["Payment Approvals"];
    var blocks = (Dictionary<int, string?>)ViewBag.Blocks;
    bool all = ViewBag.All;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="mb-0">@T["Payment Approvals"]</h2>
        <div class="text-muted">@T["Payments held until someone whose authority covers the amount releases them. Nobody releases a payment they entered."]</div>
    </div>
    <a asp-action="Index" asp-route-all="@(!all)" class="btn btn-outline-dark">@(all ? T["Waiting only"] : T["Show decided too"])</a>
</div>

@if (TempData["ApprovalSuccess"] is string ok) { <div class="alert alert-success">@ok</div> }
@if (TempData["ApprovalError"] is string err) { <div class="alert alert-danger">@err</div> }

@if (Model.Count == 0)
{
    <div class="alert alert-light border">@T["Nothing is waiting."]</div>
}

@foreach (var a in Model)
{
    var pending = a.Status == PaymentApprovalStatuses.Pending;
    var block = pending && blocks.TryGetValue(a.Id, out var b) ? b : null;
    <div class="card shadow-sm mb-3 @(pending ? "border-warning" : "")">
        <div class="card-header bg-light d-flex flex-wrap justify-content-between gap-2">
            <div>
                <strong>@a.Amount.ToString("N2")</strong> — @a.Description
                <div class="small text-muted">
                    @T.HtmlFormat("{0} · entered by {1} on {2} · needs <strong>{3}</strong> or above", a.SourceType, a.RequestedByName, a.RequestedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm"), a.RequiredLevel)
                </div>
            </div>
            <span class="badge align-self-start @(a.Status switch { PaymentApprovalStatuses.Pending => "bg-warning text-dark", PaymentApprovalStatuses.Rejected => "bg-danger", _ => "bg-success" })">
                @(a.Status == PaymentApprovalStatuses.SelfReleased ? T["Released within own limit"] : a.Status)
            </span>
        </div>
        <div class="card-body">
            @if (a.JournalEntry != null)
            {
                <table class="table table-sm mb-2">
                    <tr><th>@T["Account"]</th><th>@T["Details"]</th><th class="text-end">@T["Debit"]</th><th class="text-end">@T["Credit"]</th></tr>
                    @foreach (var l in a.JournalEntry.Lines)
                    {
                        <tr><td>@l.Account?.Code @l.Account?.Name</td><td class="small">@l.Description</td><td class="text-end">@(l.Debit == 0 ? "" : l.Debit.ToString("N2"))</td><td class="text-end">@(l.Credit == 0 ? "" : l.Credit.ToString("N2"))</td></tr>
                    }
                </table>
                <div class="small text-muted mb-2">@T.Format("Journal {0} dated {1} {2}", a.JournalEntry.EntryNumber, a.JournalEntry.EntryDate.ToString("dd/MM/yyyy"), a.JournalEntry.DocumentNumber != null ? "· " + a.JournalEntry.DocumentNumber : "")</div>
            }
            @if (!pending)
            {
                <div class="small">@a.DecidedByName @a.DecidedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") — @a.Comment</div>
            }
            else if (block != null)
            {
                <div class="text-muted small">@block</div>
            }
            else
            {
                <form method="post" class="d-flex flex-wrap gap-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@a.Id" />
                    <input name="comment" class="form-control" style="max-width:420px" placeholder="@T["Comment (required to turn down)"]" />
                    <button class="btn btn-success" asp-action="Approve" onclick="return confirm('Release and post this payment of @a.Amount.ToString("N2")?');">@T["Approve & release"]</button>
                    <button class="btn btn-outline-danger" asp-action="Reject">@T["Turn down"]</button>
                </form>
            }
        </div>
    </div>
}
