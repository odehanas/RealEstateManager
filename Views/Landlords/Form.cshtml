@model RealEstateManager.Models.LandlordEditViewModel
@using RealEstateManager.Domain
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? T["New Landlord"] : T["Edit Landlord"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">@(isNew ? T["New Landlord"] : T["Edit Landlord"])</h2>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">@T["Back to Landlords"]</a>
</div>

<div asp-validation-summary="All" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.Id)" method="post" class="card shadow-sm">
    @Html.AntiForgeryToken()
    <div class="card-body row g-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label fw-semibold"></label>
            <input asp-for="Name" class="form-control" maxlength="200" />
        </div>
        <div class="col-md-3">
            <label asp-for="Trn" class="form-label"></label>
            <input asp-for="Trn" class="form-control" maxlength="20" dir="ltr" />
            <div class="form-text">@T["If VAT registered. Printed on our commission tax invoice."]</div>
        </div>
        <div class="col-md-3">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" maxlength="50" dir="ltr" />
        </div>
        <div class="col-md-6">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" type="email" class="form-control" maxlength="200" dir="ltr" />
        </div>
        <div class="col-md-6">
            <label asp-for="DefaultCollectionMode" class="form-label fw-semibold"></label>
            <select asp-for="DefaultCollectionMode" class="form-select">
                @foreach (var mode in CollectionModes.All)
                {
                    <option value="@mode" selected="@(mode == Model.DefaultCollectionMode ? "selected" : null)">@T[CollectionModes.Describe(mode)]</option>
                }
            </select>
            <div class="form-text">@T["Proposed for each of this landlord's properties; a property can still differ."]</div>
        </div>

        <div class="col-12"><hr class="my-1" /><h6 class="mb-0">@T["The landlord's own bank account"]</h6></div>
        <div class="col-md-4">
            <label asp-for="BankName" class="form-label"></label>
            <input asp-for="BankName" class="form-control" maxlength="100" />
        </div>
        <div class="col-md-4">
            <label asp-for="AccountName" class="form-label"></label>
            <input asp-for="AccountName" class="form-control" maxlength="200" />
        </div>
        <div class="col-md-4">
            <label asp-for="Iban" class="form-label"></label>
            <input asp-for="Iban" class="form-control" maxlength="40" dir="ltr" placeholder="AE07 0331 2345 6789 0123 456" />
        </div>

        <div class="col-12">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="2" maxlength="1000"></textarea>
        </div>
        <div class="col-12">
            <div class="form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-primary">@T["Save"]</button>
        </div>
    </div>
</form>
