@model RealEstateManager.Domain.Vendor

@{
    ViewData["Title"] = "Create Vendor";
}

<h2>Create Vendor</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-3">
            <label class="form-label">Vendor Code</label>
            <input type="text" class="form-control bg-light" value="Generated on save" readonly />
            <div class="form-text">Next free <code>VEN-0001</code> in sequence.</div>
        </div>

        <div class="col-md-9">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="ServiceType" class="form-label"></label>
            <input asp-for="ServiceType" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="ContactPerson" class="form-label"></label>
            <input asp-for="ContactPerson" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="TrnNumber" class="form-label">TRN (Tax Registration Number)</label>
            <input asp-for="TrnNumber" class="form-control" />
            <div class="form-text">Supporting evidence for input tax claimed on this supplier's bills.</div>
        </div>

        <div class="col-md-4">
            <label asp-for="TradeLicenseNumber" class="form-label">Trade Licence Number</label>
            <input asp-for="TradeLicenseNumber" class="form-control" />
            <div class="form-text">
                Unique per company. Stops the same supplier being opened twice under two codes.
            </div>
        </div>

        <div class="col-md-6">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="OpeningBalance" class="form-label">Opening Balance</label>
            <input asp-for="OpeningBalance" type="number" step="0.01" class="form-control" />
            <div class="form-text">
                Amount owed to this vendor at the opening cut-off date (positive = payable,
                negative = advance paid). Feeds the Accounts Payable control account.
            </div>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-dark">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}