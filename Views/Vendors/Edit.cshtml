@model RealEstateManager.Domain.Vendor

@{
    ViewData["Title"] = T["Edit Vendor"];
}

<h2>@T["Edit Vendor"]</h2>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-3">
            <label asp-for="Code" class="form-label">@T["Vendor Code"]</label>
            <input asp-for="Code" class="form-control bg-light" readonly />
            <div class="form-text">@T["Fixed once issued — it identifies the vendor on bills and payments."]</div>
        </div>

        <div class="col-md-9">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="ServiceType" class="form-label"></label>
            <input asp-for="ServiceType" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="ContactPerson" class="form-label"></label>
            <input asp-for="ContactPerson" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="TrnNumber" class="form-label">@T["TRN (Tax Registration Number)"]</label>
            <input asp-for="TrnNumber" class="form-control" />
            <div class="form-text">@T["Supporting evidence for input tax claimed on this supplier's bills."]</div>
        </div>

        <div class="col-md-4">
            <div class="form-check mt-4 pt-2">
                <input asp-for="IsVatRegistered" class="form-check-input" type="checkbox" />
                <label asp-for="IsVatRegistered" class="form-check-label">@T["VAT registered (active)"]</label>
            </div>
            <div class="form-text">
                @T.Html("Tick only while the registration is <strong>live</strong>. Bills from a supplier that is not registered carry no VAT at all and are treated as commercial invoices, with the whole amount charged direct to cost.")
            </div>
        </div>

        <div class="col-md-4">
            <label asp-for="TradeLicenseNumber" class="form-label">@T["Trade Licence Number"]</label>
            <input asp-for="TradeLicenseNumber" class="form-control" />
            <div class="form-text">
                @T["Unique per company. Stops the same supplier being opened twice under two codes."]
            </div>
        </div>

        <div class="col-md-4">
            <label asp-for="TaxIdentificationNumber" class="form-label">@T["TIN (Tax Identification Number)"]</label>
            <input asp-for="TaxIdentificationNumber" class="form-control" maxlength="10" placeholder="@T["10 digits"]" />
            <div class="form-text">
                @T["Matches this supplier's e-invoices to this record. Leave blank when they have a TRN — the TIN is its first 10 digits."]
            </div>
        </div>

        <div class="col-md-6">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="OpeningBalance" class="form-label">@T["Opening Balance"]</label>
            <input asp-for="OpeningBalance" type="number" step="0.01" class="form-control" />
            <div class="form-text">
                @T["Amount owed to this vendor at the opening cut-off date (positive = payable, negative = advance paid). Feeds the Accounts Payable control account."]
            </div>
        </div>

        <div class="col-md-3">
            <div class="form-check mt-4">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-dark">@T["Save"]</button>
        <a asp-action="Index" class="btn btn-outline-secondary">@T["Back"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}