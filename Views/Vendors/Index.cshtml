@model IEnumerable<RealEstateManager.Domain.Vendor>
@inject PermissionService PermissionService

@{
    ViewData["Title"] = T["Vendors"];

    // Accounting users can look a supplier up to enter its bill, but only the master
    // data owner may create one - otherwise the same supplier ends up under two codes.
    var canEdit = await PermissionService.HasPermissionAsync(User, AppPermissions.MasterDataManage);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@T["Vendors"]</h2>
    @if (canEdit)
    {
        <a asp-action="Create" class="btn btn-dark">@T["Add Vendor"]</a>
    }
</div>

@if (!canEdit)
{
    <div class="alert alert-secondary py-2 small">
        @T["You have read-only access to master data. Contact the master data owner to add or amend a vendor."]
    </div>
}

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>@T["Code"]</th>
            <th>@T["Name"]</th>
            <th>@T["Service Type"]</th>
            <th>@T["Contact Person"]</th>
            <th>@T["Email"]</th>
            <th>@T["Phone"]</th>
            <th>@T["Status"]</th>
            <th>@T["Actions"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var vendor in Model)
        {
            <tr>
                <td>@vendor.Code</td>
                <td>@vendor.Name</td>
                <td>@vendor.ServiceType</td>
                <td>@vendor.ContactPerson</td>
                <td>@vendor.Email</td>
                <td>@vendor.Phone</td>
                <td>@(vendor.IsActive ? T["Active"] : T["Inactive"])</td>
                <td>
                    @if (canEdit)
                    {
                        <a asp-action="Edit" asp-route-id="@vendor.Id" class="btn btn-sm btn-primary">@T["Edit"]</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>