@model RealEstateManager.Models.DevelopmentProjectFormViewModel
@using RealEstateManager.Domain

@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New Development Project" : "Edit " + Model.Code;
    var properties = ViewBag.Properties as List<SelectListItem> ?? new();
    var wipAccounts = ViewBag.WipAccounts as List<SelectListItem> ?? new();
    var vendors = ViewBag.Vendors as List<SelectListItem> ?? new();
    var defaults = ViewBag.DefaultWipAccounts as Dictionary<string, int> ?? new();
}

<h2>@(isNew ? "New Development Project" : $"Edit {Model.Code} - {Model.Name}")</h2>

<form asp-action="Save" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label">Project name</label>
            <input asp-for="Name" class="form-control" maxlength="150" required />
        </div>
        <div class="col-md-6">
            <label asp-for="PropertyId" class="form-label"></label>
            <select asp-for="PropertyId" asp-items="properties" class="form-select">
                <option value="">-- choose later --</option>
            </select>
            <div class="form-text">The owned property record for the plot: its title deed, permits and, later, its units.</div>
        </div>
        <div class="col-md-4">
            <label asp-for="IntendedUse" class="form-label"></label>
            <select asp-for="IntendedUse" class="form-select" id="intendedUse">
                @foreach (var use in DevelopmentIntendedUses.All)
                {
                    <option value="@use">@DevelopmentIntendedUses.Describe(use)</option>
                }
            </select>
            <div class="form-text">Decides the account the cost is collected in. Choose the main use; a mixed building is split on completion.</div>
        </div>
        <div class="col-md-4">
            <label asp-for="WipAccountId" class="form-label"></label>
            @if (Model.HasCosts)
            {
                <input type="hidden" asp-for="WipAccountId" />
                <select class="form-select" disabled asp-items="wipAccounts" asp-for="WipAccountId"></select>
                <div class="form-text">Fixed: costs are already posted to it.</div>
            }
            else
            {
                <select asp-for="WipAccountId" asp-items="wipAccounts" class="form-select" id="wipAccount"></select>
            }
        </div>
        <div class="col-md-4">
            <label asp-for="MainContractorVendorId" class="form-label"></label>
            <select asp-for="MainContractorVendorId" asp-items="vendors" class="form-select">
                <option value="">--</option>
            </select>
        </div>
        <div class="col-md-4">
            <label asp-for="InputTaxAttribution" class="form-label"></label>
            <select asp-for="InputTaxAttribution" class="form-select">
                <option value="">Decide on each bill line</option>
                @foreach (var attribution in InputTaxAttributions.All)
                {
                    <option value="@attribution">@InputTaxAttributions.Describe(attribution)</option>
                }
            </select>
            <div class="form-text">Applied to every bill line of this project. Commercial or zero-rated first sale: recoverable. Residential to let: not recoverable (VAT becomes cost). Mixed: apportioned.</div>
        </div>
        <div class="col-md-3">
            <label asp-for="StartDate" class="form-label"></label>
            <input asp-for="StartDate" type="date" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="ExpectedCompletionDate" class="form-label"></label>
            <input asp-for="ExpectedCompletionDate" type="date" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Notes" class="form-label"></label>
            <input asp-for="Notes" class="form-control" maxlength="1000" />
        </div>
    </div>

    <h5 class="mt-4">Budget by Cost Category</h5>
    <table class="table table-sm table-bordered" style="max-width: 640px;">
        <thead><tr><th>Category</th><th class="text-end" style="width: 200px;">Budget</th></tr></thead>
        <tbody>
            @for (var i = 0; i < Model.Budget.Count; i++)
            {
                <tr>
                    <td>
                        @DevelopmentCostCategories.Describe(Model.Budget[i].Category)
                        <input type="hidden" name="Budget[@i].Category" value="@Model.Budget[i].Category" />
                    </td>
                    <td>
                        <input type="number" step="0.01" min="0" name="Budget[@i].Amount"
                               value="@Model.Budget[i].Amount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                               class="form-control form-control-sm text-end budget-amount" />
                    </td>
                </tr>
            }
        </tbody>
        <tfoot><tr class="fw-bold"><td>Total budget</td><td class="text-end" id="budgetTotal">0.00</td></tr></tfoot>
    </table>
    <p class="small text-muted">Only costs directly needed to complete the building belong here. Marketing, sales commissions,
    show-flat running costs and general overheads are expenses, not project cost.</p>

    <div class="mt-3">
        <button type="submit" class="btn btn-dark">Save</button>
        <a asp-action="@(isNew ? "Index" : "Details")" asp-route-id="@(isNew ? null : Model.Id)" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            var defaults = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(defaults));
            var use = document.getElementById('intendedUse');
            var wip = document.getElementById('wipAccount');
            if (use && wip) {
                use.addEventListener('change', function () {
                    if (defaults[use.value]) { wip.value = String(defaults[use.value]); }
                });
            }

            function total() {
                var sum = 0;
                document.querySelectorAll('.budget-amount').forEach(function (i) { sum += parseFloat(i.value) || 0; });
                document.getElementById('budgetTotal').textContent = sum.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }
            document.querySelectorAll('.budget-amount').forEach(function (i) { i.addEventListener('input', total); });
            total();
        })();
    </script>
}
