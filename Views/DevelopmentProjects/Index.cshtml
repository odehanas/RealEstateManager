@model RealEstateManager.Models.DevelopmentProjectIndexViewModel
@using RealEstateManager.Domain

@{
    ViewData["Title"] = "Development Projects";
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <h2 class="mb-0">Development Projects</h2>
    <a asp-action="Create" class="btn btn-dark">New Project</a>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<div class="alert alert-info">
    A building under construction collects its costs - land, design, permits, contractors, supervision and
    borrowing costs - in a work-in-progress account chosen by what it is for: <strong>for sale</strong> (inventory),
    <strong>for rental</strong> (investment property) or <strong>own use</strong> (fixed asset). Tag supplier bills and
    journals to the project and the cost to date below is read straight from the ledger.
</div>

@if (Model.Untagged.Count > 0)
{
    <div class="alert alert-warning">
        <strong>Not in any project:</strong>
        @foreach (var u in Model.Untagged)
        {
            <span class="me-3">@u.AccountCode @u.AccountName: @u.Amount.ToString("N2")</span>
        }
        <div class="small mt-1">These amounts were posted to a development account without choosing a project, so they are on
        the balance sheet but in no project's cost. Correct them with a journal that moves them into the right project.</div>
    </div>
}

<div class="table-responsive">
    <table class="table table-bordered table-striped table-sm">
        <thead>
            <tr>
                <th>Code</th>
                <th>Project</th>
                <th>Property</th>
                <th>For</th>
                <th>Status</th>
                <th>Cost Account</th>
                <th class="text-end">Budget</th>
                <th class="text-end">Cost to Date</th>
                <th class="text-end">% of Budget</th>
                <th class="text-end">Still in WIP</th>
                <th>Completion</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Projects.Count == 0)
            {
                <tr><td colspan="12" class="text-center text-muted">No development projects yet.</td></tr>
            }
            @foreach (var p in Model.Projects)
            {
                <tr>
                    <td>@p.Code</td>
                    <td>@p.Name</td>
                    <td>@(p.PropertyName ?? "-")</td>
                    <td>@DevelopmentIntendedUses.Describe(p.IntendedUse)</td>
                    <td>@DevelopmentProjectStatuses.Describe(p.Status)</td>
                    <td class="small">@p.WipAccount</td>
                    <td class="text-end">@p.Budget.ToString("N2")</td>
                    <td class="text-end">@p.CostToDate.ToString("N2")</td>
                    <td class="text-end @(p.PercentOfBudget > 100 ? "text-danger fw-bold" : "")">@(p.Budget == 0 ? "-" : p.PercentOfBudget.ToString("0.0") + "%")</td>
                    <td class="text-end">@p.InWorkInProgress.ToString("N2")</td>
                    <td>@(p.CompletionDate?.ToString("dd/MM/yyyy") ?? (p.ExpectedCompletionDate.HasValue ? "exp. " + p.ExpectedCompletionDate.Value.ToString("dd/MM/yyyy") : "-"))</td>
                    <td><a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-dark">Open</a></td>
                </tr>
            }
        </tbody>
        @if (Model.Projects.Count > 0)
        {
            <tfoot>
                <tr class="fw-bold">
                    <td colspan="6">Total</td>
                    <td class="text-end">@Model.Projects.Sum(x => x.Budget).ToString("N2")</td>
                    <td class="text-end">@Model.Projects.Sum(x => x.CostToDate).ToString("N2")</td>
                    <td></td>
                    <td class="text-end">@Model.Projects.Sum(x => x.InWorkInProgress).ToString("N2")</td>
                    <td colspan="2"></td>
                </tr>
            </tfoot>
        }
    </table>
</div>
