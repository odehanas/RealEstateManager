@model IEnumerable<RealEstateManager.Domain.CustomerReceipt>

@{
    ViewData["Title"] = T["Customer Receipts"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@T["Customer Receipts"]</h2>
    <a asp-controller="CustomerReceipts" asp-action="Create" class="btn btn-dark">@T["New Receipt"]</a>
</div>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>@T["Receipt"]</th>
            <th>@T["Date"]</th>
            <th>@T["Invoice"]</th>
            <th>@T["Property"]</th>
            <th>@T["Unit"]</th>
            <th>@T["Tenant"]</th>
            <th>@T["Method"]</th>
            <th class="text-end">@T["Amount"]</th>
            <th>@T["GL"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var receipt in Model)
        {
            <tr>
                <td>@receipt.ReceiptNumber</td>
                <td>@receipt.ReceiptDate.ToString("dd/MM/yyyy")</td>
                <td>@receipt.CustomerInvoice?.InvoiceNumber</td>
                <td>@receipt.CustomerInvoice?.Lease?.Unit?.Property?.Name</td>
                <td>@receipt.CustomerInvoice?.Lease?.Unit?.UnitNumber</td>
                <td>@receipt.CustomerInvoice?.Lease?.Tenant?.FullName</td>
                <td>@receipt.PaymentMethod</td>
                <td class="text-end">@receipt.Amount.ToString("N2")</td>
                <td>
                    @if (receipt.JournalEntryId.HasValue)
                    {
                        <span class="badge bg-success">@T["Posted"]</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">@T["Not Posted"]</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>