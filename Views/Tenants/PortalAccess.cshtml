@model RealEstateManager.Models.TenantPortalAccessViewModel
@{
    ViewData["Title"] = T["Portal Access"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">@T["Portal Access"]</h2>
        <p class="text-muted mb-0">@Model.TenantName <span class="text-muted">(@Model.TenantCode)</span></p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">@T["Back to Tenants"]</a>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success py-2">@success</div>
}

<div asp-validation-summary="All" class="text-danger mb-3"></div>

@if (!string.IsNullOrEmpty(Model.IssuedPassword))
{
    <div class="card border-success shadow-sm mb-4">
        <div class="card-header bg-success text-white">@T.Html("<strong>Access issued &mdash; copy these details now</strong>")</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="text-muted small">@T["Username"]</div>
                    <div class="fs-5 fw-bold font-monospace">@Model.Username</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">@T["Temporary password"]</div>
                    <div class="fs-5 fw-bold font-monospace">@Model.IssuedPassword</div>
                </div>
            </div>
            <div class="alert alert-warning mt-3 mb-0 small">
                @T.Html("<strong>This password is shown once and cannot be retrieved.</strong> It is stored only as a hash. If it is lost, issue a reset from this page, which produces a new one. The tenant must change it the first time they sign in.")
            </div>
        </div>
    </div>
}

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light">@T.Html("<strong>Current Status</strong>")</div>
            <div class="card-body">
                @if (!Model.HasAccess)
                {
                    <p class="text-muted mb-0">
                        @T["This tenant has no portal access yet. Issue it below and hand the details over."]
                    </p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <tr>
                            <th style="width:45%">@T["Username"]</th>
                            <td class="font-monospace">@Model.Username</td>
                        </tr>
                        <tr>
                            <th>@T["Status"]</th>
                            <td>
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">@T["Active"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@T["Suspended"]</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>@T["Password"]</th>
                            <td>
                                @if (Model.MustChangePassword)
                                {
                                    <span class="badge bg-warning text-dark">@T["Temporary — not yet changed"]</span>
                                }
                                else
                                {
                                    <span class="text-muted">@T["Set by the tenant"]</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>@T["Last sign in"]</th>
                            <td>@(Model.LastLoginAt.HasValue ? Model.LastLoginAt.Value.ToString("dd/MM/yyyy HH:mm") : "Never")</td>
                        </tr>
                        @if (Model.LockedOutUntil.HasValue && Model.LockedOutUntil > DateTime.UtcNow)
                        {
                            <tr>
                                <th>@T["Locked until"]</th>
                                <td class="text-danger">@Model.LockedOutUntil.Value.ToString("dd/MM/yyyy HH:mm") (too many failed attempts)</td>
                            </tr>
                        }
                    </table>
                }
            </div>
            @if (Model.HasAccess)
            {
                <div class="card-footer bg-white">
                    <form asp-action="SetPortalAccessActive" asp-route-id="@Model.TenantId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="isActive" value="@((!Model.IsActive).ToString().ToLower())" />
                        <button type="submit" class="btn btn-sm @(Model.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                            @(Model.IsActive ? "Suspend access" : "Re-enable access")
                        </button>
                    </form>
                    <span class="text-muted small ms-2">
                        @T["Suspending blocks sign-in immediately but keeps the account."]
                    </span>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light">
                <strong>@(Model.HasAccess ? "Reset Access" : "Issue Access")</strong>
            </div>
            <div class="card-body">
                <form asp-action="IssuePortalAccess" asp-route-id="@Model.TenantId" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="NewUsername" class="form-label"></label>
                        <input asp-for="NewUsername" name="newUsername" class="form-control" />
                        <div class="form-text">
                            @T["The tenant's email address is the usual choice. It must be unique across all tenants."]
                        </div>
                    </div>

                    <button type="submit" class="btn btn-dark">
                        @(Model.HasAccess ? "Reset password" : "Issue portal access")
                    </button>
                </form>

                @if (Model.HasAccess)
                {
                    <div class="alert alert-warning small mt-3 mb-0">
                        @T.Html("Resetting generates a <strong>new</strong> temporary password and invalidates the old one. Use it when a tenant is locked out or has forgotten their password.")
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mt-3">
    <div class="card-body small text-muted">
        <strong class="text-dark">@T["What the tenant can see"]</strong>
        <ul class="mb-2 mt-2">
            <li>@T["Their balance, overdue amount, cheques held and deposit held"]</li>
            <li>@T["Their own invoices, payments, cheques, contracts and account statement"]</li>
        </ul>
        <strong class="text-dark">@T["What they cannot do"]</strong>
        <ul class="mb-0">
            <li>@T["See any other tenant, any property owner, or any company financial report"]</li>
            <li>@T["Change anything — the portal is read-only"]</li>
        </ul>
        <div class="mt-2">@T.Html("The portal is at <code>/portal</code>.")</div>
    </div>
</div>
