@model RealEstateManager.Domain.Tenant

@{
    ViewData["Title"] = "Edit Tenant";
}

<h2>Edit Tenant</h2>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-3">
            <label asp-for="Code" class="form-label">Tenant Code</label>
            <input asp-for="Code" class="form-control bg-light" readonly />
            <div class="form-text">Fixed once issued &mdash; it identifies the tenant on statements and contracts.</div>
        </div>

        <div class="col-md-9">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="Nationality" class="form-label"></label>
            <input asp-for="Nationality" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="TrnNumber" class="form-label">TRN (Tax Registration Number)</label>
            <input asp-for="TrnNumber" class="form-control" placeholder="15 digits, if VAT registered" />
            <div class="form-text">
                With a TRN the tenant receives a <strong>full tax invoice</strong>; without one, a
                <strong>simplified tax invoice</strong>. Invoices already issued keep the TRN captured at the time.
            </div>
        </div>

        <div class="col-md-4">
            <label asp-for="TradeLicenseNumber" class="form-label">Trade Licence Number</label>
            <input asp-for="TradeLicenseNumber" class="form-control" placeholder="Corporate tenants" />
        </div>

        <div class="col-md-4">
            <label asp-for="IdNumber" class="form-label">Emirates ID / ID Number</label>
            <input asp-for="IdNumber" class="form-control" />
        </div>

        <div class="col-md-2">
            <label asp-for="IdExpiryDate" class="form-label">EID expiry</label>
            <input asp-for="IdExpiryDate" type="date" class="form-control @(Model.IdExpiryDate < DateTime.Today ? "is-invalid" : "")" />
            @if (Model.IdExpiryDate < DateTime.Today) { <div class="invalid-feedback d-block">Expired</div> }
        </div>

        <div class="col-md-4">
            <label asp-for="PassportNumber" class="form-label"></label>
            <input asp-for="PassportNumber" class="form-control" />
        </div>

        <div class="col-md-2">
            <label asp-for="PassportExpiryDate" class="form-label">Passport expiry</label>
            <input asp-for="PassportExpiryDate" type="date" class="form-control @(Model.PassportExpiryDate < DateTime.Today ? "is-invalid" : "")" />
            @if (Model.PassportExpiryDate < DateTime.Today) { <div class="invalid-feedback d-block">Expired</div> }
        </div>

        <div class="col-md-12">
            <div class="alert alert-light border py-2 small mb-0">
                Trade licence, Emirates ID, passport and TRN each identify the tenant and must be
                unique. If one is already held by another record the save is refused and the
                existing tenant is named.
            </div>
        </div>

        <partial name="_AddressAndEInvoicing" model="Model" />

        <div class="col-md-4">
            <label asp-for="OpeningBalance" class="form-label">Opening Balance</label>
            <input asp-for="OpeningBalance" type="number" step="0.01" class="form-control" />
            <div class="form-text">
                Amount this tenant owed at the opening cut-off date (positive = receivable,
                negative = advance held). Feeds the Accounts Receivable control account.
            </div>
        </div>

        <div class="col-md-3">
            <div class="form-check mt-4">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-dark">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</form>

<partial name="_RecordDocuments" model="@((RealEstateManager.Domain.RecordDocumentEntities.Tenant, Model.Id))" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}