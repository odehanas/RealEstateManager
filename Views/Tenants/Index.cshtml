@model IEnumerable<RealEstateManager.Domain.Tenant>
@inject PermissionService PermissionService

@{
    ViewData["Title"] = T["Tenants"];

    // Master data is centralised - most users may look it up but not change it.
    var canEdit = await PermissionService.HasPermissionAsync(User, AppPermissions.MasterDataManage);
    var portalLogins = ViewBag.PortalLogins as Dictionary<int, (string Username, bool IsActive, DateTime? LastLoginAt)> ?? new();
    var overview = ViewBag.TenantOverview as Dictionary<int, RealEstateManager.Controllers.TenantsController.TenantOverview> ?? new();
    var canSeeStatement = await PermissionService.HasAnyPermissionAsync(User, AppPermissions.ReportsView, AppPermissions.OwnerOversight);

    string ContractBadge(string status) => status switch
    {
        RealEstateManager.Domain.LeaseStatuses.Active => "bg-success",
        RealEstateManager.Domain.LeaseStatuses.PendingApproval => "bg-warning text-dark",
        _ => "bg-secondary"
    };
    string ContractWord(string status) => status == RealEstateManager.Domain.LeaseStatuses.PendingApproval ? "Awaiting approval" : status;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@T["Tenants"]</h2>
    @if (canEdit)
    {
        <a asp-controller="Tenants" asp-action="Create" class="btn btn-dark">@T["Add Tenant"]</a>
    }
</div>

@if (!canEdit)
{
    <div class="alert alert-secondary py-2 small">
        @T["You have read-only access to master data. Contact the master data owner to add or amend a tenant."]
    </div>
}

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>@T["Code"]</th>
            <th>@T["Full Name"]</th>
            <th>@T["Contact"]</th>
            <th>@T["Unit and contract"]</th>
            <th class="text-end">@T["Balance due"]</th>
            <th class="text-end">@T["Cheques in hand"]</th>
            <th>@T["Status"]</th>
            <th>@T["Portal login"]</th>
            <th>@T["Actions"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                @{ overview.TryGetValue(item.Id, out var o); }
                <td>@item.Code</td>
                <td>
                    @item.FullName
                    @if (!string.IsNullOrWhiteSpace(item.Nationality) || !string.IsNullOrWhiteSpace(item.IdNumber))
                    {
                        <div class="small text-muted">@item.Nationality@(!string.IsNullOrWhiteSpace(item.Nationality) && !string.IsNullOrWhiteSpace(item.IdNumber) ? " · " : "")@item.IdNumber</div>
                    }
                </td>
                <td>
                    <div>@item.Email</div>
                    <div class="small text-muted">@item.Phone</div>
                </td>
                <td>
                    @if (o == null || o.Contracts.Count == 0)
                    {
                        <span class="text-muted small">@T["No contract"]</span>
                    }
                    else
                    {
                        @foreach (var contract in o.Contracts)
                        {
                            <div class="mb-1">
                                <span class="fw-semibold">@contract.Unit</span>
                                <span class="badge @ContractBadge(contract.Status)">@T[ContractWord(contract.Status)]</span>
                                <div class="small @(contract.Current && contract.EndDate < DateTime.Today.AddDays(90) ? "text-danger" : "text-muted")">
                                    @(contract.EndDate < DateTime.Today ? T.Format("ended {0}", contract.EndDate.ToString("dd/MM/yyyy")) : T.Format("ends {0}", contract.EndDate.ToString("dd/MM/yyyy")))
                                </div>
                            </div>
                        }
                    }
                </td>
                <td class="text-end">
                    @if (o == null || o.BalanceDue == 0m)
                    {
                        <span class="text-muted">-</span>
                    }
                    else
                    {
                        <div class="fw-semibold">@o.BalanceDue.ToString("N2")</div>
                        @if (o.Overdue > 0m)
                        {
                            <div class="small text-danger">@T.Format("{0} overdue", o.Overdue.ToString("N2"))</div>
                        }
                    }
                </td>
                <td class="text-end">
                    @if (o == null || o.Cheques == 0)
                    {
                        <span class="text-muted">-</span>
                    }
                    else
                    {
                        <div class="fw-semibold">@o.ChequesAmount.ToString("N2")</div>
                        <div class="small text-muted">@T.Format("{0} cheque(s)", o.Cheques)</div>
                        @if (o.ChequesDue > 0)
                        {
                            <div class="small text-danger">@T.Format("{0} due to deposit: {1}", o.ChequesDue, o.ChequesDueAmount.ToString("N2"))</div>
                        }
                        else if (o.NextChequeDate.HasValue)
                        {
                            <div class="small text-muted">@T.Format("next {0}", o.NextChequeDate.Value.ToString("dd/MM/yyyy"))</div>
                        }
                    }
                </td>
                <td>@(item.IsActive ? T["Active"] : T["Inactive"])</td>
                <td>
                    @if (portalLogins.TryGetValue(item.Id, out var login))
                    {
                        <span class="badge @(login.IsActive ? "bg-success" : "bg-secondary")">@(login.IsActive ? T["Can sign in"] : T["Suspended"])</span>
                        <div class="small text-muted">@login.Username</div>
                        <div class="small text-muted">@(login.LastLoginAt.HasValue ? T.Format("Last signed in {0}", login.LastLoginAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")) : T["Has not signed in yet"])</div>
                    }
                    else
                    {
                        <span class="text-muted small">@T["No login"]</span>
                    }
                </td>
                <td>
                    <div class="d-flex flex-wrap gap-1">
                        @if (canEdit)
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">@T["Edit"]</a>
                            <a asp-action="PortalAccess" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark">@T["Portal"]</a>
                        }
                        @if (canSeeStatement)
                        {
                            <a asp-controller="TenantStatements" asp-action="Index" asp-route-tenantId="@item.Id" class="btn btn-sm btn-outline-secondary"
                               title="@T["Every invoice, receipt and cheque of this tenant"]">@T["Statement"]</a>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>