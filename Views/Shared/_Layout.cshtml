@using RealEstateManager.Models
@using RealEstateManager.Services
@inject ICurrentCompanyAccessor CurrentCompanyAccessor
@inject AppAuthService AppAuthService
@inject PermissionService PermissionService
@inject SubscriptionService SubscriptionService
@inject HelpCatalogService HelpCatalog
@inject PlatformOwnerService PlatformOwnerService
@inject ApprovalService ApprovalService
@inject PeriodClosingService PeriodClosingService
@inject PaymentApprovalService PaymentApprovals
@inject RealEstateManager.Services.Assistant.AssistantService Assistant

@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var currentCompanyId = CurrentCompanyAccessor.CompanyId;
    var currentCompanyName = User.FindFirst(AppClaimTypes.CurrentCompanyName)?.Value ?? "No Company Selected";
    var displayName = User.FindFirst(AppClaimTypes.DisplayName)?.Value ?? User.Identity?.Name ?? "User";
    var isSystemAdmin = User.IsInRole("SystemAdmin");
    var isPlatformOwner = PlatformOwnerService.IsOwner(User);
    // A customer's own administrator: manages the users of the company they are in.
    var isCompanyAdmin = !isSystemAdmin && isAuthenticated && currentCompanyId.HasValue
                         && CurrentCompanyAccessor.UserId.HasValue
                         && await AppAuthService.IsCompanyAdminAsync(CurrentCompanyAccessor.UserId.Value, currentCompanyId.Value);
    var subscriptionStatus = isAuthenticated && currentCompanyId.HasValue
        ? await SubscriptionService.GetStatusAsync(currentCompanyId.Value)
        : null;
    var subscriptionBlocked = subscriptionStatus != null && subscriptionStatus.IsExpired && !isSystemAdmin;
    // The last two weeks of a paid period, or the last five days of the 15-day trial (two
    // weeks' warning there would nag from its second day). Not shown to System Admins, who
    // work across customers' companies and follow expiry from Companies & Subscriptions.
    var subscriptionEndingSoon = subscriptionStatus != null && !subscriptionStatus.IsExpired && !isSystemAdmin
                                 && subscriptionStatus.DaysRemaining <= (subscriptionStatus.IsInTrial ? 5 : 14);
    // Master data is centralised: reading it is broadly available, creating and
    // amending it is not. The menu follows the read right; the Create/Edit controls
    // inside each page follow the manage right.
    var canViewMasterData = isAuthenticated && await PermissionService.HasAnyPermissionAsync(
        User,
        AppPermissions.MasterDataView,
        AppPermissions.MasterDataManage);
    var canManageLeases = isAuthenticated && await PermissionService.HasPermissionAsync(User, AppPermissions.LeasesManage);
    var canHandleServiceRequests = isAuthenticated && await PermissionService.HasPermissionAsync(User, AppPermissions.ServiceRequestsManage);
    var canDoMaintenance = isAuthenticated && await PermissionService.HasPermissionAsync(User, AppPermissions.MaintenanceExecute);
    // A maintenance engineer and nothing else: their jobs and the help, no company figures or subscription.
    var isMaintenanceOnly = isAuthenticated && canDoMaintenance && await PermissionService.IsMaintenanceOnlyAsync(User);
    // Approvers see the queue in the menu with how many contracts wait for them (not their own).
    var canApproveContracts = isAuthenticated && currentCompanyId.HasValue
                              && await PermissionService.HasPermissionAsync(User, AppPermissions.LeasesApprove);
    var approvalsWaiting = canApproveContracts && CurrentCompanyAccessor.UserId.HasValue
        ? await ApprovalService.CountAwaitingAsync(CurrentCompanyAccessor.UserId.Value)
        : 0;
    var canManageAccounting = isAuthenticated && await PermissionService.HasPermissionAsync(User, AppPermissions.AccountingManage);
    // Approvers of period reopening see their queue with how many requests wait.
    var canApproveReopen = isAuthenticated && currentCompanyId.HasValue
                           && await PermissionService.HasPermissionAsync(User, AppPermissions.PeriodReopenApprove);
    var reopenRequestsWaiting = canApproveReopen
        ? await PeriodClosingService.CountPendingReopenRequestsAsync()
        : 0;
    var canViewReports = isAuthenticated && await PermissionService.HasPermissionAsync(User, AppPermissions.ReportsView);
    var canViewVendors = isAuthenticated && await PermissionService.HasAnyPermissionAsync(
        User,
        AppPermissions.MasterDataView,
        AppPermissions.MasterDataManage,
        AppPermissions.AccountingManage);
    var showMasterDataMenu = canViewMasterData || canManageLeases || canViewVendors || canApproveContracts;
    var showAccountsMenu = canManageAccounting;
    // Operations opens for either job: keeping the books, or answering tenants.
    var showOperationsMenu = canManageAccounting || canHandleServiceRequests || canDoMaintenance;
    var showReportsMenu = canViewReports;
    var canManageHr = isAuthenticated && await PermissionService.HasPermissionAsync(User, AppPermissions.HrManage);
    var canRunPayroll = isAuthenticated && await PermissionService.HasAnyPermissionAsync(User, AppPermissions.PayrollManage, AppPermissions.PayrollApprove);
    var showHrMenu = canManageHr || canRunPayroll;
    var isOwner = isAuthenticated && await PermissionService.HasPermissionAsync(User, AppPermissions.OwnerOversight);
    var canReleasePayments = isAuthenticated && await PermissionService.HasAnyPermissionAsync(User, AppPermissions.PaymentsApprove, AppPermissions.OwnerOversight);
    var paymentsWaiting = canReleasePayments && currentCompanyId.HasValue ? await PaymentApprovals.CountPendingAsync() : 0;
    var canViewPerformance = isAuthenticated && await PermissionService.HasAnyPermissionAsync(User, AppPermissions.PerformanceView, AppPermissions.OwnerOversight);
    var showControlsMenu = isOwner || canReleasePayments || canViewPerformance;
    showReportsMenu = showReportsMenu || isOwner;
    if (subscriptionBlocked)
    {
        showMasterDataMenu = false;
        showAccountsMenu = false;
        showOperationsMenu = false;
        showReportsMenu = false;
        showHrMenu = false;
        showControlsMenu = false;
    }
    var companies = isAuthenticated && CurrentCompanyAccessor.UserId.HasValue
        ? await AppAuthService.GetAccessibleCompaniesAsync(CurrentCompanyAccessor.UserId.Value, currentCompanyId)
        : new List<CompanyOptionViewModel>();

    // The help topic for the screen being shown. The Help button opens it in a side
    // panel; on a screen with no topic of its own the panel lists every topic instead.
    var helpTopic = HelpCatalog.ForScreen(
        ViewContext.RouteData.Values["controller"]?.ToString(),
        ViewContext.RouteData.Values["action"]?.ToString());

    // The AI assistant: only when switched on in the server settings, for staff with
    // the Assistant.Use permission, in a company whose subscription is running.
    var showAssistant = isAuthenticated && !subscriptionBlocked && await Assistant.IsAvailableAsync(User);
}

<!DOCTYPE html>
<html lang="@RealEstateManager.Services.Localization.UiLanguages.Current" dir="@(RealEstateManager.Services.Localization.UiLanguages.IsArabic ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RealEstateManager</title>
    <partial name="_AppHead" model="@("/")" />
    @if (RealEstateManager.Services.Localization.UiLanguages.IsArabic)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* Help topic typography. Every rule is scoped under .help-content, so it cannot touch the application's own tables. *@
    <link rel="stylesheet" href="~/help/help.css" asp-append-version="true" />
    @if (showAssistant)
    {
        <link rel="stylesheet" href="~/css/assistant.css" asp-append-version="true" />
    }
    @* Print rules for the whole application. media="print" so it costs nothing on screen. *@
    <link rel="stylesheet" href="~/css/document-print.css" media="print" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-xl navbar-dark bg-dark shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="@(isMaintenanceOnly ? "MaintenanceJobs" : "Home")" asp-action="Index">@T["RealEstateManager"]</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    @if (isAuthenticated)
                    {
                    @*
                        Menu order follows the order the work is actually done:
                        System Setup (configure the company once) -> Master Data (the
                        things being managed) -> Operations (the daily transactions) ->
                        Reporting (what came out of them).
                    *@
                    <ul class="navbar-nav me-auto mb-2 mb-xl-0">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="@(isMaintenanceOnly ? "MaintenanceJobs" : "Home")" asp-action="Index">@(isMaintenanceOnly ? T["My Jobs"] : T["Home"])</a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="setupDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @T["System Setup"]
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="setupDropdown">
                                @if (canManageAccounting)
                                {
                                    <li><h6 class="dropdown-header">@T["Accounting Setup"]</h6></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="ChartOfAccounts" asp-action="Index">@T["Chart of Accounts"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="AccountMappings" asp-action="Index">@T["Account Mapping"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="OpeningBalances" asp-action="Index">@T["Opening Balances"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="OwnerWithdrawalCategories" asp-action="Index">@T["Owner Withdrawal Categories"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="VatSettings" asp-action="Index">@T["VAT Settings"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="EInvoicing" asp-action="Settings">@T["E-Invoicing Settings"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="RevenueRecognition" asp-action="Index">@T["Revenue Recognition"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Prepayments" asp-action="Index">@T["Recurring Prepayments"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Closing" asp-action="Index">@T["Closing Cockpit"]</a>
                                    </li>
                                }
                                @if (canApproveReopen)
                                {
                                    <li>
                                        <a class="dropdown-item d-flex justify-content-between align-items-center" asp-controller="Closing" asp-action="ReopenRequests">
                                            Period Reopen Requests
                                            @if (reopenRequestsWaiting > 0)
                                            {
                                                <span class="badge bg-danger ms-2">@reopenRequestsWaiting</span>
                                            }
                                        </a>
                                    </li>
                                }
                                @if (isSystemAdmin)
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><h6 class="dropdown-header">@T["Administration"]</h6></li>
                                    @if (isPlatformOwner)
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Companies" asp-action="Index">@T["Companies & Subscriptions"]</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="DatabaseUpdates" asp-action="Index">@T["Database Updates"]</a>
                                        </li>
                                    }
                                    <li>
                                        <a class="dropdown-item" asp-controller="Users" asp-action="Index">@T["Users & Permissions"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="AuditLogs" asp-action="Index">@T["Audit Logs"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Feedback" asp-action="Manage">@T["Feedback Review"]</a>
                                    </li>
                                }
                                else if (isCompanyAdmin)
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><h6 class="dropdown-header">@T["Company Administration"]</h6></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Users" asp-action="Index">@T["Users & Permissions"]</a>
                                    </li>
                                }
                                @if (currentCompanyId.HasValue)
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><h6 class="dropdown-header">@(isMaintenanceOnly ? T["Help"] : T["Subscription & Help"])</h6></li>
                                    @if (!isMaintenanceOnly)
                                    {
                                    <li>
                                        <a class="dropdown-item" asp-controller="Subscription" asp-action="Index">@T["Subscription"]</a>
                                    </li>
                                    }
                                    <li>
                                        <a class="dropdown-item" asp-controller="Help" asp-action="Index">@T["Help"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Help" asp-action="Manual" target="_blank">@T["User Manual"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Help" asp-action="Training" target="_blank">@T["Training Workbook"]</a>
                                    </li>
                                    @if (!isMaintenanceOnly)
                                    {
                                    <li>
                                        <a class="dropdown-item" asp-controller="Feedback" asp-action="Index">@T["Send Feedback"]</a>
                                    </li>
                                    }
                                }
                            </ul>
                        </li>

                        @if (showMasterDataMenu)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="masterDataDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @T["Master Data"]
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="masterDataDropdown">
                                    @if (canViewMasterData)
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Properties" asp-action="Index">@T["Properties"]</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Units" asp-action="Index">@T["Units"]</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Tenants" asp-action="Index">@T["Tenants"]</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="RecordDocuments" asp-action="Expiry">@T["Document Expiry"]</a>
                                        </li>
                                    }
                                    @if (canManageLeases)
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Leases" asp-action="Index">@T["Leases"]</a>
                                        </li>
                                    }
                                    @if (canApproveContracts)
                                    {
                                        <li>
                                            <a class="dropdown-item d-flex justify-content-between align-items-center gap-3" asp-controller="Approvals" asp-action="Index">
                                                Approvals
                                                @if (approvalsWaiting > 0)
                                                {
                                                    <span class="badge rounded-pill bg-warning text-dark">@approvalsWaiting</span>
                                                }
                                            </a>
                                        </li>
                                    }
                                    @if (canViewVendors)
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Vendors" asp-action="Index">@T["Vendors"]</a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }

                        @if (showOperationsMenu)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="operationsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @T["Operations"]
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="operationsDropdown">
                                    @if (showAccountsMenu)
                                    {
                                    <li>
                                        <a class="dropdown-item" asp-controller="Workflow" asp-action="Index">@T["Workflow Guide"]</a>
                                    </li>
                                    }

                                    @if (canHandleServiceRequests || canDoMaintenance)
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><h6 class="dropdown-header">@T["Tenant Services"]</h6></li>
                                        @if (canHandleServiceRequests)
                                        {
                                        <li>
                                            <a class="dropdown-item" asp-controller="ServiceRequests" asp-action="Index">
                                                @T["Tenant Requests"]
                                            </a>
                                        </li>
                                        }
                                        <li>
                                            <a class="dropdown-item" asp-controller="MaintenanceJobs" asp-action="Index">
                                                @(canHandleServiceRequests ? T["Maintenance Jobs"] : T["My Maintenance Jobs"])
                                            </a>
                                        </li>
                                    }

                                    @if (showAccountsMenu)
                                    {
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><h6 class="dropdown-header">@T["Receivables — Tenants"]</h6></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="CustomerInvoices" asp-action="Index">@T["Customer Invoices"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="CustomerCreditNotes" asp-action="Index">@T["Credit Notes"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="CustomerReceipts" asp-action="Index">@T["Customer Receipts"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="PdcReceipts" asp-action="Index">@T["PDC Receipts"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="SecurityDeposits" asp-action="Index">@T["Security Deposits"]</a>
                                    </li>

                                    <li><hr class="dropdown-divider" /></li>
                                    <li><h6 class="dropdown-header">@T["E-Invoicing"]</h6></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="EInvoicing" asp-action="Index">@T["E-Invoice Monitor"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="EInvoicing" asp-action="Received">@T["Received E-Invoices"]</a>
                                    </li>

                                    @* Vendors is master data, not an operation - it lives under Master Data only. *@
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><h6 class="dropdown-header">@T["Payables — Vendors"]</h6></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="VendorBills" asp-action="Index">@T["Vendor Bills"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="VendorPayments" asp-action="Index">@T["Vendor Payments"]</a>
                                    </li>

                                    <li><hr class="dropdown-divider" /></li>
                                    <li><h6 class="dropdown-header">@T["Development"]</h6></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="DevelopmentProjects" asp-action="Index">@T["Development Projects"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="UnitSales" asp-action="Index">@T["Unit Sales"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="CapitalAssetVat" asp-action="Index">@T["Capital Assets Scheme (VAT)"]</a>
                                    </li>

                                    <li><hr class="dropdown-divider" /></li>
                                    <li><h6 class="dropdown-header">@T["Landlords — Managed Properties"]</h6></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="OwnerSettlements" asp-action="Index">@T["Owner Settlements"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="OwnerRecharges" asp-action="Index">@T["Recharges to Owners"]</a>
                                    </li>

                                    <li><hr class="dropdown-divider" /></li>
                                    <li><h6 class="dropdown-header">@T["General Ledger"]</h6></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="PettyCash" asp-action="Index">@T["Petty Cash"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="FixedAssets" asp-action="Index">@T["Fixed Assets"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="ManualJournals" asp-action="Index">@T["Manual Journals"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="OwnerWithdrawals" asp-action="Index">@T["Owner Withdrawals"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Journal" asp-action="Index">@T["Journal Inquiry"]</a>
                                    </li>
                                    }
                                </ul>
                            </li>
                        }

                        @if (showControlsMenu)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="controlsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Controls
                                    @if (paymentsWaiting > 0) { <span class="badge bg-danger">@paymentsWaiting</span> }
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="controlsDropdown">
                                    @if (canViewPerformance)
                                    {
                                        <li><a class="dropdown-item fw-semibold" asp-controller="Performance" asp-action="Index">@T["Business Performance"]</a></li>
                                    }
                                    @if (isOwner)
                                    {
                                        <li><a class="dropdown-item" asp-controller="Oversight" asp-action="Index">@T["Owner Monitor"]</a></li>
                                        <li><a class="dropdown-item" asp-controller="MaintenanceJobs" asp-action="Dashboard">@T["Maintenance Dashboard"]</a></li>
                                        <li><a class="dropdown-item" asp-controller="RecordDocuments" asp-action="Expiry">@T["Document Expiry"]</a></li>
                                    }
                                    @if (canReleasePayments)
                                    {
                                    <li>
                                        <a class="dropdown-item d-flex justify-content-between align-items-center" asp-controller="PaymentApprovals" asp-action="Index">
                                            Payment Approvals
                                            @if (paymentsWaiting > 0) { <span class="badge bg-danger ms-2">@paymentsWaiting</span> }
                                        </a>
                                    </li>
                                    }
                                    @if (isOwner)
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" asp-controller="AuthorizationMatrix" asp-action="Index">@T["Authorization Matrix"]</a></li>
                                        <li><a class="dropdown-item" asp-controller="ApprovalLimits" asp-action="Index">@T["Approval Limits & Delegation"]</a></li>
                                        <li><a class="dropdown-item" asp-controller="Help" asp-action="Controls">@T["Controls & Security Guide"]</a></li>
                                    }
                                </ul>
                            </li>
                        }

                        @if (showHrMenu)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="hrDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @T["HR & Payroll"]
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="hrDropdown">
                                    <li><h6 class="dropdown-header">@T["People"]</h6></li>
                                    <li><a class="dropdown-item" asp-controller="Employees" asp-action="Index">@T["Employees"]</a></li>
                                    @if (canManageHr)
                                    {
                                        <li><a class="dropdown-item" asp-controller="Attendance" asp-action="Index">@T["Attendance"]</a></li>
                                        <li><a class="dropdown-item" asp-controller="Leave" asp-action="Index">@T["Leave"]</a></li>
                                        <li><a class="dropdown-item" asp-controller="EmployeeRequests" asp-action="Index">@T["Employee Requests"]</a></li>
                                        <li><a class="dropdown-item" asp-controller="Employees" asp-action="Documents">@T["Expiring Documents"]</a></li>
                                        <li><a class="dropdown-item" asp-controller="Departments" asp-action="Index">@T["Departments"]</a></li>
                                    }
                                    @if (canRunPayroll)
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><h6 class="dropdown-header">@T["Payroll"]</h6></li>
                                        <li><a class="dropdown-item" asp-controller="PayrollAdjustments" asp-action="Index">@T["Payroll Transactions"]</a></li>
                                        <li><a class="dropdown-item" asp-controller="Payroll" asp-action="Index">@T["Payroll Runs"]</a></li>
                                        <li><a class="dropdown-item" asp-controller="EmployeeAdvances" asp-action="Index">@T["Salary Advances"]</a></li>
                                        <li><a class="dropdown-item" asp-controller="Payroll" asp-action="Settings">@T["Payroll Settings"]</a></li>
                                    }
                                </ul>
                            </li>
                        }

                        @if (showReportsMenu)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="reportingDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @T["Reporting"]
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="reportingDropdown">
                                    <li><a class="dropdown-item fw-semibold" asp-controller="ReportBuilder" asp-action="Index">@T["Build Your Own Report"]</a></li>
                                    <li><a class="dropdown-item" asp-controller="ProjectCosts" asp-action="Index">@T["Project Costs & WIP"]</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><h6 class="dropdown-header">@T["Financial Reports"]</h6></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Reports" asp-action="TrialBalance">@T["Trial Balance"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Reports" asp-action="ProfitAndLoss">@T["Profit & Loss"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Reports" asp-action="BalanceSheet">@T["Balance Sheet"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Reports" asp-action="CashFlow">@T["Statement of Cash Flows"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="InvestmentProperty" asp-action="Index">@T["Investment Property Note"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Reports" asp-action="GeneralJournal">@T["General Journal"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Journal" asp-action="GeneralLedger">@T["General Ledger"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Reports" asp-action="VatReturn">@T["VAT Return"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Reports" asp-action="OwnerVatReturn">@T["Owner VAT Return"]</a>
                                    </li>

                                    <li><hr class="dropdown-divider" /></li>
                                    <li><h6 class="dropdown-header">@T["Management — Tenants & Properties"]</h6></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="BuildingView" asp-action="Index">@T["Building View"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="TenantStatements" asp-action="Index">@T["Tenant Statement"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="VendorStatements" asp-action="Index">@T["Vendor Statement"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Reports" asp-action="TenantHealth">@T["Tenant Health & Ranking"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Reports" asp-action="PropertyUtilization">@T["Property Utilization"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Reports" asp-action="ProfitAndLossByProperty">@T["P&L by Property"]</a>
                                    </li>

                                    <li><hr class="dropdown-divider" /></li>
                                    <li><h6 class="dropdown-header">@T["Management — Owners"]</h6></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Reports" asp-action="OwnerTenancySchedule">@T["Owner Tenancy Schedule"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Reports" asp-action="OwnerProfitability">@T["Owner Property Profitability"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Reports" asp-action="OwnerCombined">@T["Owner's Combined View"]</a>
