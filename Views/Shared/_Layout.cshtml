@using RealEstateManager.Models
@using RealEstateManager.Services
@inject ICurrentCompanyAccessor CurrentCompanyAccessor
@inject AppAuthService AppAuthService
@inject PermissionService PermissionService
@inject SubscriptionService SubscriptionService
@inject HelpCatalogService HelpCatalog
@inject PlatformOwnerService PlatformOwnerService
@inject ApprovalService ApprovalService
@inject PeriodClosingService PeriodClosingService
@inject PaymentApprovalService PaymentApprovals
@inject RealEstateManager.Services.Assistant.AssistantService Assistant

@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var currentCompanyId = CurrentCompanyAccessor.CompanyId;
    var currentCompanyName = User.FindFirst(AppClaimTypes.CurrentCompanyName)?.Value ?? "No Company Selected";
    var displayName = User.FindFirst(AppClaimTypes.DisplayName)?.Value ?? User.Identity?.Name ?? "User";
    var isSystemAdmin = User.IsInRole("SystemAdmin");
    var isPlatformOwner = PlatformOwnerService.IsOwner(User);
    // A customer's own administrator: manages the users of the company they are in.
    var isCompanyAdmin = !isSystemAdmin && isAuthenticated && currentCompanyId.HasValue
                         && CurrentCompanyAccessor.UserId.HasValue
                         && await AppAuthService.IsCompanyAdminAsync(CurrentCompanyAccessor.UserId.Value, currentCompanyId.Value);
    var subscriptionStatus = isAuthenticated && currentCompanyId.HasValue
        ? await SubscriptionService.GetStatusAsync(currentCompanyId.Value)
        : null;
    var subscriptionBlocked = subscriptionStatus != null && subscriptionStatus.IsExpired && !isSystemAdmin;
    // The last two weeks of a paid period, or the last five days of the 15-day trial (two
    // weeks' warning there would nag from its second day). Not shown to System Admins, who
    // work across customers' companies and follow expiry from Companies & Subscriptions.
    var subscriptionEndingSoon = subscriptionStatus != null && !subscriptionStatus.IsExpired && !isSystemAdmin
                                 && subscriptionStatus.DaysRemaining <= (subscriptionStatus.IsInTrial ? 5 : 14);
    // Master data is centralised: reading it is broadly available, creating and
    // amending it is not. The menu follows the read right; the Create/Edit controls
    // inside each page follow the manage right.
    var canViewMasterData = isAuthenticated && await PermissionService.HasAnyPermissionAsync(
        User,
        AppPermissions.MasterDataView,
        AppPermissions.MasterDataManage);
    var canManageLeases = isAuthenticated && await PermissionService.HasPermissionAsync(User, AppPermissions.LeasesManage);
    var canHandleServiceRequests = isAuthenticated && await PermissionService.HasPermissionAsync(User, AppPermissions.ServiceRequestsManage);
    var canDoMaintenance = isAuthenticated && await PermissionService.HasPermissionAsync(User, AppPermissions.MaintenanceExecute);
    // A maintenance engineer and nothing else: their jobs and the help, no company figures or subscription.
    var isMaintenanceOnly = isAuthenticated && canDoMaintenance && await PermissionService.IsMaintenanceOnlyAsync(User);
    // Approvers see the queue in the menu with how many contracts wait for them (not their own).
    var canApproveContracts = isAuthenticated && currentCompanyId.HasValue
                              && await PermissionService.HasPermissionAsync(User, AppPermissions.LeasesApprove);
    var approvalsWaiting = canApproveContracts && CurrentCompanyAccessor.UserId.HasValue
        ? await ApprovalService.CountAwaitingAsync(CurrentCompanyAccessor.UserId.Value)
        : 0;
    var canManageAccounting = isAuthenticated && await PermissionService.HasPermissionAsync(User, AppPermissions.AccountingManage);
    // Approvers of period reopening see their queue with how many requests wait.
    var canApproveReopen = isAuthenticated && currentCompanyId.HasValue
                           && await PermissionService.HasPermissionAsync(User, AppPermissions.PeriodReopenApprove);
    var reopenRequestsWaiting = canApproveReopen
        ? await PeriodClosingService.CountPendingReopenRequestsAsync()
        : 0;
    var canViewReports = isAuthenticated && await PermissionService.HasPermissionAsync(User, AppPermissions.ReportsView);
    var canViewVendors = isAuthenticated && await PermissionService.HasAnyPermissionAsync(
        User,
        AppPermissions.MasterDataView,
        AppPermissions.MasterDataManage,
        AppPermissions.AccountingManage);
    // Importing from a previous system: master data, contracts or employees, each by its own right.
    var canImportData = isAuthenticated && await PermissionService.HasAnyPermissionAsync(
        User, AppPermissions.MasterDataManage, AppPermissions.LeasesManage, AppPermissions.HrManage);
    var showMasterDataMenu = canViewMasterData || canManageLeases || canViewVendors || canApproveContracts || canImportData;
    var showAccountsMenu = canManageAccounting;
    // Operations opens for either job: keeping the books, or answering tenants.
    var showOperationsMenu = canManageAccounting || canHandleServiceRequests || canDoMaintenance;
    var showReportsMenu = canViewReports;
    var canManageHr = isAuthenticated && await PermissionService.HasPermissionAsync(User, AppPermissions.HrManage);
    var canRunPayroll = isAuthenticated && await PermissionService.HasAnyPermissionAsync(User, AppPermissions.PayrollManage, AppPermissions.PayrollApprove);
    var showHrMenu = canManageHr || canRunPayroll;
    var isOwner = isAuthenticated && await PermissionService.HasPermissionAsync(User, AppPermissions.OwnerOversight);
    var canReleasePayments = isAuthenticated && await PermissionService.HasAnyPermissionAsync(User, AppPermissions.PaymentsApprove, AppPermissions.OwnerOversight);
    var paymentsWaiting = canReleasePayments && currentCompanyId.HasValue ? await PaymentApprovals.CountPendingAsync() : 0;
    var canViewPerformance = isAuthenticated && await PermissionService.HasAnyPermissionAsync(User, AppPermissions.PerformanceView, AppPermissions.OwnerOversight);
    var showControlsMenu = isOwner || canReleasePayments || canViewPerformance;
    showReportsMenu = showReportsMenu || isOwner;
    if (subscriptionBlocked)
    {
        showMasterDataMenu = false;
        showAccountsMenu = false;
        showOperationsMenu = false;
        showReportsMenu = false;
        showHrMenu = false;
        showControlsMenu = false;
    }
    var companies = isAuthenticated && CurrentCompanyAccessor.UserId.HasValue
        ? await AppAuthService.GetAccessibleCompaniesAsync(CurrentCompanyAccessor.UserId.Value, currentCompanyId)
        : new List<CompanyOptionViewModel>();

    // The help topic for the screen being shown. The Help button opens it in a side
    // panel; on a screen with no topic of its own the panel lists every topic instead.
    var helpTopic = HelpCatalog.ForScreen(
        ViewContext.RouteData.Values["controller"]?.ToString(),
        ViewContext.RouteData.Values["action"]?.ToString());

    // The AI assistant: only when switched on in the server settings, for staff with
    // the Assistant.Use permission, in a company whose subscription is running.
    var showAssistant = isAuthenticated && !subscriptionBlocked && await Assistant.IsAvailableAsync(User);
}

<!DOCTYPE html>
<html lang="@RealEstateManager.Services.Localization.UiLanguages.Current" dir="@(RealEstateManager.Services.Localization.UiLanguages.IsArabic ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RealEstateManager</title>
    <partial name="_AppHead" model="@("/")" />
    @if (RealEstateManager.Services.Localization.UiLanguages.IsArabic)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true" />
    @* Help topic typography. Every rule is scoped under .help-content, so it cannot touch the application's own tables. *@
    <link rel="stylesheet" href="~/help/help.css" asp-append-version="true" />
    @if (showAssistant)
    {
        <link rel="stylesheet" href="~/css/assistant.css" asp-append-version="true" />
    }
    @* Print rules for the whole application. media="print" so it costs nothing on screen. *@
    <link rel="stylesheet" href="~/css/document-print.css" media="print" asp-append-version="true" />
</head>
<body class="@(isAuthenticated ? "has-sidebar" : "")">
    @* Before anything is drawn, so a hidden menu does not flash open on each page. *@
    <script>try { if (localStorage.getItem('rem-sidebar') === 'hidden') document.body.classList.add('sidebar-hidden'); } catch (e) { }</script>
    <header class="app-topbar navbar navbar-dark bg-dark shadow-sm">
        <div class="container-fluid flex-nowrap gap-2">
            @if (isAuthenticated)
            {
                @* Shows or hides the side menu; on a wide screen the choice is remembered. *@
                <button type="button" class="btn btn-outline-light btn-sm sidebar-toggle" data-sidebar-toggle
                        aria-controls="appSidebar" aria-expanded="true" title="@T["Show or hide the menu"]">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
                    <span class="visually-hidden">@T["Menu"]</span>
                </button>
            }
            <a class="navbar-brand fw-bold me-2" asp-controller="@(isMaintenanceOnly ? "MaintenanceJobs" : "Home")" asp-action="Index">@T["RealEstateManager"]</a>

                    <div class="topbar-actions d-flex align-items-center gap-2 flex-wrap justify-content-end ms-auto">
                        @if (isAuthenticated)
                        {
                            @if (companies.Count > 1)
                            {
                                <form asp-controller="Auth" asp-action="SwitchCompany" method="post" class="d-flex align-items-center gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                    <select name="companyId" class="form-select form-select-sm" onchange="this.form.submit()">
                                        @foreach (var company in companies)
                                        {
                                            <option value="@company.CompanyId" selected="@(company.IsCurrent ? "selected" : null)">
                                                @company.CompanyName
                                            </option>
                                        }
                                    </select>
                                </form>
                            }
                            else
                            {
                                <span class="navbar-text text-light small">
                                    @currentCompanyName
                                </span>
                            }

                            <span class="navbar-text text-light small d-none d-md-inline">
                                @displayName
                            </span>

                            <button type="button" class="btn btn-light btn-sm fw-semibold"
                                    data-bs-toggle="offcanvas" data-bs-target="#helpPanel" aria-controls="helpPanel"
                                    data-help-key="@helpTopic?.Key"
                                    title="@(helpTopic != null ? $"Help: {helpTopic.Title}" : T["Help"])">
                                <span aria-hidden="true">?</span> @T["Help"]
                            </button>

                            <partial name="_LanguageSwitch" model="@("btn-outline-light btn-sm")" />

                            <a class="btn btn-outline-light btn-sm" asp-controller="Profile" asp-action="ChangePassword">@T["Password"]</a>

                            <form asp-controller="Auth" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-light btn-sm">@T["Logout"]</button>
                            </form>
                        }
                        else
                        {
                            <partial name="_LanguageSwitch" model="@("btn-outline-light btn-sm")" />
                            <a class="btn btn-outline-light btn-sm" asp-controller="Auth" asp-action="Login">@T["Login"]</a>
                        }
                    </div>
        </div>
    </header>

    @if (isAuthenticated)
    {
        @*
                        Menu order follows the order the work is actually done:
                        System Setup (configure the company once) -> Master Data (the
                        things being managed) -> Operations (the daily transactions) ->
                        Reporting (what came out of them).
                    *@
        <aside class="app-sidebar" id="appSidebar" aria-label="@T["Main menu"]">
            <nav>
                    <ul class="sidebar-nav">

                        <li>
                            <a class="sidebar-link" asp-controller="@(isMaintenanceOnly ? "MaintenanceJobs" : "Home")" asp-action="Index"><svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/></svg><span class="sidebar-label">@(isMaintenanceOnly ? T["My Jobs"] : T["Home"])</span></a>
                        </li>

                        <li class="sidebar-group">
                                <button type="button" class="sidebar-link sidebar-group-toggle collapsed" data-bs-toggle="collapse" data-bs-target="#sb-setup" aria-expanded="false" aria-controls="sb-setup">
                                    <svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg><span class="sidebar-label">@T["System Setup"]</span><span class="sidebar-caret" aria-hidden="true"></span>
                                </button>
                                <ul class="collapse sidebar-sub" id="sb-setup">
                                @if (canManageAccounting)
                                {
                                    <li class="sidebar-heading">@T["Accounting Setup"]</li>
                                    <li>
                                        <a class="sidebar-link" asp-controller="ChartOfAccounts" asp-action="Index">@T["Chart of Accounts"]</a>
                                    </li>
                                    <li>
                                        <a class="sidebar-link" asp-controller="AccountMappings" asp-action="Index">@T["Account Mapping"]</a>
                                    </li>
                                    <li>
                                        <a class="sidebar-link" asp-controller="OpeningBalances" asp-action="Index">@T["Opening Balances"]</a>
                                    </li>
                                    <li>
                                        <a class="sidebar-link" asp-controller="OwnerWithdrawalCategories" asp-action="Index">@T["Owner Withdrawal Categories"]</a>
                                    </li>
                                    <li>
                                        <a class="sidebar-link" asp-controller="VatSettings" asp-action="Index">@T["VAT Settings"]</a>
                                    </li>
                                    <li>
                                        <a class="sidebar-link" asp-controller="EInvoicing" asp-action="Settings">@T["E-Invoicing Settings"]</a>
                                    </li>
                                    <li>
                                        <a class="sidebar-link" asp-controller="RevenueRecognition" asp-action="Index">@T["Revenue Recognition"]</a>
                                    </li>
                                    <li>
                                        <a class="sidebar-link" asp-controller="Prepayments" asp-action="Index">@T["Recurring Prepayments"]</a>
                                    </li>
                                    <li>
                                        <a class="sidebar-link" asp-controller="Closing" asp-action="Index">@T["Closing Cockpit"]</a>
                                    </li>
                                }
                                @if (canApproveReopen)
                                {
                                    <li>
                                        <a class="sidebar-link d-flex justify-content-between align-items-center" asp-controller="Closing" asp-action="ReopenRequests">
                                            @T["Period Reopen Requests"]
                                            @if (reopenRequestsWaiting > 0)
                                            {
                                                <span class="badge bg-danger ms-2">@reopenRequestsWaiting</span>
                                            }
                                        </a>
                                    </li>
                                }
                                @if (isSystemAdmin)
                                {
                                    <li class="sidebar-divider" role="separator"></li>
                                    <li class="sidebar-heading">@T["Administration"]</li>
                                    @if (isPlatformOwner)
                                    {
                                        <li>
                                            <a class="sidebar-link" asp-controller="Companies" asp-action="Index">@T["Companies & Subscriptions"]</a>
                                        </li>
                                        <li>
                                            <a class="sidebar-link" asp-controller="DatabaseUpdates" asp-action="Index">@T["Database Updates"]</a>
                                        </li>
                                    }
                                    <li>
                                        <a class="sidebar-link" asp-controller="Users" asp-action="Index">@T["Users & Permissions"]</a>
                                    </li>
                                    <li>
                                        <a class="sidebar-link" asp-controller="AuditLogs" asp-action="Index">@T["Audit Logs"]</a>
                                    </li>
                                    <li>
                                        <a class="sidebar-link" asp-controller="Feedback" asp-action="Manage">@T["Feedback Review"]</a>
                                    </li>
                                }
                                else if (isCompanyAdmin)
                                {
                                    <li class="sidebar-divider" role="separator"></li>
                                    <li class="sidebar-heading">@T["Company Administration"]</li>
                                    <li>
                                        <a class="sidebar-link" asp-controller="Users" asp-action="Index">@T["Users & Permissions"]</a>
                                    </li>
                                }
                                @if (currentCompanyId.HasValue)
                                {
                                    <li class="sidebar-divider" role="separator"></li>
                                    <li class="sidebar-heading">@(isMaintenanceOnly ? T["Help"] : T["Subscription & Help"])</li>
                                    @if (!isMaintenanceOnly)
                                    {
                                    <li>
                                        <a class="sidebar-link" asp-controller="Subscription" asp-action="Index">@T["Subscription"]</a>
                                    </li>
                                    }
                                    <li>
                                        <a class="sidebar-link" asp-controller="Help" asp-action="Index">@T["Help"]</a>
                                    </li>
                                    <li>
                                        <a class="sidebar-link" asp-controller="Help" asp-action="Manual" target="_blank">@T["User Manual"]</a>
                                    </li>
                                    <li>
                                        <a class="sidebar-link" asp-controller="Help" asp-action="Training" target="_blank">@T["Training Workbook"]</a>
                                    </li>
                                    @if (!isMaintenanceOnly)
                                    {
                                    <li>
                                        <a class="sidebar-link" asp-controller="Feedback" asp-action="Index">@T["Send Feedback"]</a>
                                    </li>
                                    }
                                }
                            </ul>
                        </li>

                        @if (showMasterDataMenu)
                        {
                            <li class="sidebar-group">
                                <button type="button" class="sidebar-link sidebar-group-toggle collapsed" data-bs-toggle="collapse" data-bs-target="#sb-masterData" aria-expanded="false" aria-controls="sb-masterData">
                                    <svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21h18"/><path d="M5 21V6l7-3 7 3v15"/><path d="M9 21v-5h6v5"/><path d="M9 9h2M13 9h2M9 12.5h2M13 12.5h2"/></svg><span class="sidebar-label">@T["Master Data"]</span><span class="sidebar-caret" aria-hidden="true"></span>
                                </button>
                                <ul class="collapse sidebar-sub" id="sb-masterData">
                                    @if (canViewMasterData)
                                    {
                                        <li>
                                            <a class="sidebar-link" asp-controller="Properties" asp-action="Index">@T["Properties"]</a>
                                        </li>
                                        <li>
                                            <a class="sidebar-link" asp-controller="Units" asp-action="Index">@T["Units"]</a>
                                        </li>
                                        <li>
                                            <a class="sidebar-link" asp-controller="Tenants" asp-action="Index">@T["Tenants"]</a>
                                        </li>
                                        <li>
                                            <a class="sidebar-link" asp-controller="RecordDocuments" asp-action="Expiry">@T["Document Expiry"]</a>
                                        </li>
                                    }
                                    @if (canManageLeases)
                                    {
                                        <li>
                                            <a class="sidebar-link" asp-controller="Leases" asp-action="Index">@T["Leases"]</a>
                                        </li>
                                    }
                                    @if (canApproveContracts)
                                    {
                                        <li>
                                            <a class="sidebar-link d-flex justify-content-between align-items-center gap-3" asp-controller="Approvals" asp-action="Index">
                                                @T["Approvals"]
                                                @if (approvalsWaiting > 0)
                                                {
                                                    <span class="badge rounded-pill bg-warning text-dark">@approvalsWaiting</span>
                                                }
                                            </a>
                                        </li>
                                    }
                                    @if (canViewVendors)
                                    {
                                        <li>
                                            <a class="sidebar-link" asp-controller="Vendors" asp-action="Index">@T["Vendors"]</a>
                                        </li>
                                    }
                                    @if (canImportData)
                                    {
                                        <li class="sidebar-divider" role="separator"></li>
                                        <li>
                                            <a class="sidebar-link" asp-controller="DataImport" asp-action="Index">@T["Import Data"]</a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }

                        @if (showOperationsMenu)
                        {
                            <li class="sidebar-group">
                                <button type="button" class="sidebar-link sidebar-group-toggle collapsed" data-bs-toggle="collapse" data-bs-target="#sb-operations" aria-expanded="false" aria-controls="sb-operations">
                                    <svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"/><path d="M17 15l3 2-3 2"/></svg><span class="sidebar-label">@T["Operations"]</span><span class="sidebar-caret" aria-hidden="true"></span>
                                </button>
                                <ul class="collapse sidebar-sub" id="sb-operations">
                                    @if (showAccountsMenu)
                                    {
                                    <li>
                                        <a class="sidebar-link" asp-controller="Workflow" asp-action="Index">@T["Workflow Guide"]</a>
                                    </li>
                                    }

                                    @if (canHandleServiceRequests || canDoMaintenance)
                                    {
                                        <li class="sidebar-divider" role="separator"></li>
                                        <li class="sidebar-heading">@T["Tenant Services"]</li>
                                        @if (canHandleServiceRequests)
                                        {
                                        <li>
                                            <a class="sidebar-link" asp-controller="ServiceRequests" asp-action="Index">
                                                @T["Tenant Requests"]
                                            </a>
                                        </li>
                                        }
                                        <li>
                                            <a class="sidebar-link" asp-controller="MaintenanceJobs" asp-action="Index">
                                                @(canHandleServiceRequests ? T["Maintenance Jobs"] : T["My Maintenance Jobs"])
                                            </a>
                                        </li>
                                    }

                                    @if (showAccountsMenu)
                                    {
                                    <li class="sidebar-divider" role="separator"></li>
                                    <li class="sidebar-heading">@T["Receivables — Tenants"]</li>
                                    <li>
                                        <a class="sidebar-link" asp-controller="CustomerInvoices" asp-action="Index">@T["Customer Invoices"]</a>
                                    </li>
                                    <li>
                                        <a class="sidebar-link" asp-controller="CustomerCreditNotes" asp-action="Index">@T["Credit Notes"]</a>
                                    </li>
                                    <li>
                                        <a class="sidebar-link" asp-controller="CustomerReceipts" asp-action="Index">@T["Customer Receipts"]</a>
                                    </li>
                                    <li>
                                        <a class="sidebar-link" asp-controller="PdcReceipts" asp-action="Index">@T["PDC Receipts"]</a>
                                    </li>
                                    <li>
                                        <a class="sidebar-link" asp-controller="SecurityDeposits" asp-action="Index">@T["Security Deposits"]</a>
                                    </li>

                                    <li class="sidebar-divider" role="separator"></li>
                                    <li class="sidebar-heading">@T["E-Invoicing"]</li>
                                    <li>
                                        <a class="sidebar-link" asp-controller="EInvoicing" asp-action="Index">@T["E-Invoice Monitor"]</a>
                                    </li>
                                    <li>
                                        <a class="sidebar-link" asp-controller="EInvoicing" asp-action="Received">@T["Received E-Invoices"]</a>
                                    </li>

                                    @* Vendors is master data, not an operation - it lives under Master Data only. *@
                                    <li class="sidebar-divider" role="separator"></li>
                                    <li class="sidebar-heading">@T["Payables — Vendors"]</li>
                                    <li>
                                        <a class="sidebar-link" asp-controller="VendorBills" asp-action="Index">@T["Vendor Bills"]</a>
                                    </li>
                                    <li>
                                        <a class="sidebar-link" asp-controller="VendorPayments" asp-action="Index">@T["Vendor Payments"]</a>
                                    </li>

                                    <li class="sidebar-divider" role="separator"></li>
                                    <li class="sidebar-heading">@T["Development"]</li>
                                    <li>
                                        <a class="sidebar-link" asp-controller="DevelopmentProjects" asp-action="Index">@T["Development Projects"]</a>
                                    </li>
                                    <li>
                                        <a class="sidebar-link" asp-controller="UnitSales" asp-action="Index">@T["Unit Sales"]</a>
                                    </li>
                                    <li>
                                        <a class="sidebar-link" asp-controller="CapitalAssetVat" asp-action="Index">@T["Capital Assets Scheme (VAT)"]</a>
                                    </li>

                                    <li class="sidebar-divider" role="separator"></li>
                                    <li class="sidebar-heading">@T["Landlords — Managed Properties"]</li>
                                    <li>
                                        <a class="sidebar-link" asp-controller="OwnerSettlements" asp-action="Index">@T["Owner Settlements"]</a>
                                    </li>
                                    <li>
                                        <a class="sidebar-link" asp-controller="OwnerRecharges" asp-action="Index">@T["Recharges to Owners"]</a>
                                    </li>

                                    <li class="sidebar-divider" role="separator"></li>
