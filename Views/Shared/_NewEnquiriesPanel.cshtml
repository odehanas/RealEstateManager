@using RealEstateManager.Services
@using RealEstateManager.Domain
@inject ListingService Listings
@inject PermissionService PermissionService
@inject ICurrentCompanyAccessor CurrentCompanyAccessor
@{
    // Enquiries from the vacancy website that nobody has answered yet. Each one is a person
    // looking for a unit now, so it stands at the very top of the dashboard and of the Owner
    // Monitor, and goes away by itself once every enquiry is marked Contacted or Closed.
    const int shown = 5;
    var rows = new List<ListingService.EnquiryRow>();
    var total = 0;
    if (CurrentCompanyAccessor.CompanyId.HasValue
        && await PermissionService.HasAnyPermissionAsync(User, AppPermissions.LeasesManage, AppPermissions.MasterDataManage, AppPermissions.OwnerOversight))
    {
        total = await Listings.CountNewEnquiriesAsync();
        if (total > 0)
        {
            rows = await Listings.GetEnquiriesAsync(EnquiryStatuses.New, shown);
        }
    }
}
@if (total > 0)
{
    <div class="card border-danger shadow-sm mb-3 dashboard-no-print d-print-none" role="status">
        <div class="card-header bg-danger text-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <span class="me-1" aria-hidden="true">&#128276;</span>
                <strong>@(total == 1 ? T["1 new enquiry from the vacancy website"] : T.Format("{0} new enquiries from the vacancy website", total))</strong>
                <span class="d-none d-md-inline"> — @T["someone is looking for a unit now. Call back while they are still looking."]</span>
            </div>
            <a asp-controller="Listings" asp-action="Enquiries" asp-route-status="@EnquiryStatuses.New" class="btn btn-sm btn-light text-nowrap">@T["Open enquiries"]</a>
        </div>
        <ul class="list-group list-group-flush">
            @foreach (var enquiry in rows)
            {
                <li class="list-group-item">
                    <div class="d-flex flex-wrap justify-content-between gap-2">
                        <div>
                            <strong>@enquiry.Name</strong>
                            <span class="text-muted">·</span>
                            <a href="tel:@enquiry.Phone" dir="ltr">@enquiry.Phone</a>
                            <span class="text-muted">·</span>
                            <span>@(enquiry.UnitId.HasValue ? $"{enquiry.PropertyName} · {enquiry.UnitNumber}" : T["General enquiry"])</span>
                        </div>
                        <span class="text-muted small text-nowrap">@enquiry.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(enquiry.Message))
                    {
                        <div class="text-muted small text-truncate" dir="auto">@enquiry.Message</div>
                    }
                </li>
            }
            @if (total > rows.Count)
            {
                <li class="list-group-item small">
                    <a asp-controller="Listings" asp-action="Enquiries" asp-route-status="@EnquiryStatuses.New">@T.Format("and {0} more", total - rows.Count)</a>
                </li>
            }
        </ul>
    </div>
}
