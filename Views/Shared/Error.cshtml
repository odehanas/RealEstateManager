@model ErrorViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Something went wrong - RealEstateManager</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <div class="container py-5" style="max-width:960px">
        <h1 class="h3">@T["This page could not be shown"]</h1>
        <p class="text-muted">Something went wrong while opening @(string.IsNullOrEmpty(Model.Path) ? "the page" : Model.Path). Nothing was saved by this request.</p>

        @if (Model.ShowRequestId)
        {
            <p>If you report it, quote this reference: <code>@Model.RequestId</code></p>
        }

        @if (!string.IsNullOrEmpty(Model.Detail))
        {
            <div class="card border-danger mt-4">
                <div class="card-header bg-danger text-white">@T["Cause (shown to the system administrator only)"]</div>
                <pre class="card-body small mb-0" style="white-space:pre-wrap">@Model.Detail</pre>
            </div>
        }

        <div class="mt-4 d-flex gap-2">
            <a href="javascript:history.back()" class="btn btn-outline-secondary">@T["Back"]</a>
            <a href="~/" class="btn btn-dark">@T["Home"]</a>
        </div>
    </div>
</body>
</html>
