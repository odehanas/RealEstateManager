@model IEnumerable<RealEstateManager.Domain.SecurityDeposit>

@{
    ViewData["Title"] = "Security Deposits";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Security Deposits</h2>
    <a asp-action="Create" class="btn btn-dark">Receive Deposit</a>
</div>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Reference</th>
            <th>Date</th>
            <th>Lease</th>
            <th>Property</th>
            <th>Unit</th>
            <th>Tenant</th>
            <th>Method</th>
            <th>Status</th>
            <th class="text-end">Amount</th>
            <th>GL</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var deposit in Model)
        {
            <tr>
                <td>@deposit.ReferenceNumber</td>
                <td>@deposit.ReceiptDate.ToString("dd/MM/yyyy")</td>
                <td>@deposit.Lease?.ContractNumber</td>
                <td>@deposit.Lease?.Unit?.Property?.Name</td>
                <td>@deposit.Lease?.Unit?.UnitNumber</td>
                <td>@deposit.Lease?.Tenant?.FullName</td>
                <td>@deposit.PaymentMethod</td>
                <td>@deposit.Status</td>
                <td class="text-end">@deposit.Amount.ToString("N2")</td>
                <td>
                    @if (deposit.JournalEntryId.HasValue)
                    {
                        <span class="badge bg-success">Posted</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Not Posted</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>