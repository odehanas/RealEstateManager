@model RealEstateManager.Models.FixedAssetCreateViewModel
@using RealEstateManager.Domain

@{
    ViewData["Title"] = T["Add Fixed Asset"];
    var properties = ViewBag.Properties as List<Property> ?? new();
    var accounts = ViewBag.Accounts as List<Account> ?? new();
    var vendors = ViewBag.Vendors as List<Vendor> ?? new();
}

<h2>@T["Add Fixed Asset"]</h2>

<div class="alert alert-info">
    @T["Save the asset as a draft first, then add acquisition and landed-cost style allocations, and capitalize it only when the asset is ready for use."]
</div>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            @T.Html("<strong>Asset Details</strong>")
        </div>
        <div class="card-body row g-3">
            <div class="col-md-4">
                <label asp-for="AssetCode" class="form-label">@T["Asset Code"]</label>
                <input asp-for="AssetCode" class="form-control" />
            </div>

            <div class="col-md-4">
                <label asp-for="Name" class="form-label">@T["Asset Name"]</label>
                <input asp-for="Name" class="form-control" />
            </div>

            <div class="col-md-4">
                <label asp-for="AssetCategory" class="form-label">@T["Category"]</label>
                <input asp-for="AssetCategory" class="form-control" placeholder="@T["Furniture, Equipment, Vehicles..."]" />
            </div>

            <div class="col-md-6">
                <label asp-for="PropertyId" class="form-label">@T["Property"]</label>
                <select asp-for="PropertyId" class="form-select">
                    <option value="">@T["Not Property-Specific"]</option>
                    @foreach (var property in properties)
                    {
                        <option value="@property.Id">@property.Code - @property.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label asp-for="AcquisitionDate" class="form-label">@T["Acquisition Date"]</label>
                <input asp-for="AcquisitionDate" type="date" class="form-control" />
            </div>

            <div class="col-md-3">
                <label asp-for="InServiceDate" class="form-label">@T["In Service Date"]</label>
                <input asp-for="InServiceDate" type="date" class="form-control" />
            </div>

            <div class="col-md-4">
                <label asp-for="Cost" class="form-label">@T["Initial Acquisition Cost"]</label>
                <input asp-for="Cost" class="form-control" />
                <div class="form-text">@T["Optional. If entered, you must also select the payment or payable account."]</div>
            </div>

            <div class="col-md-4">
                <label asp-for="InitialCreditAccountId" class="form-label">@T["Paid / Payable From"]</label>
                <select asp-for="InitialCreditAccountId" class="form-select">
                    <option value="">@T["Select Account"]</option>
                    @foreach (var account in accounts)
                    {
                        <option value="@account.Id">@account.Code - @account.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label asp-for="InitialVendorId" class="form-label">@T["Vendor"]</label>
                <select asp-for="InitialVendorId" class="form-select">
                    <option value="">@T["Select Vendor"]</option>
                    @foreach (var vendor in vendors)
                    {
                        <option value="@vendor.Id">@vendor.Code - @vendor.Name</option>
                    }
                </select>
                <div class="form-text">@T["Required when the source account is Accounts Payable."]</div>
            </div>

            <div class="col-md-4">
                <label asp-for="ResidualValue" class="form-label">@T["Residual Value"]</label>
                <input asp-for="ResidualValue" class="form-control" />
            </div>

            <div class="col-md-4">
                <label asp-for="UsefulLifeMonths" class="form-label">@T["Useful Life (Months)"]</label>
                <input asp-for="UsefulLifeMonths" class="form-control" />
            </div>

            <div class="col-12">
                <label asp-for="Notes" class="form-label">@T["Notes"]</label>
                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            @T.Html("<strong>Opening Balance (brought forward)</strong>")
        </div>
        <div class="card-body row g-3">
            <div class="col-12">
                <div class="alert alert-secondary mb-0">
                    @T.Html("Use these fields only when migrating from a legacy system. They feed the Fixed Asset Cost and Accumulated Depreciation control accounts as opening balances and do <strong>not</strong> generate any journal entry. Leave both at zero for assets newly acquired through this system.")
                </div>
            </div>

            <div class="col-md-4">
                <label asp-for="OpeningCost" class="form-label">@T["Opening Cost"]</label>
                <input asp-for="OpeningCost" type="number" step="0.01" class="form-control" />
            </div>

            <div class="col-md-4">
                <label asp-for="OpeningAccumulatedDepreciation" class="form-label">@T["Opening Accumulated Depreciation"]</label>
                <input asp-for="OpeningAccumulatedDepreciation" type="number" step="0.01" class="form-control" />
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            @T.Html("<strong>Account Mapping</strong>")
        </div>
        <div class="card-body row g-3">
            <div class="col-md-4">
                <label asp-for="AssetAccountId" class="form-label">@T["Asset Account"]</label>
                <select asp-for="AssetAccountId" class="form-select">
                    <option value="">@T["Select Account"]</option>
                    @foreach (var account in accounts)
                    {
                        <option value="@account.Id">@account.Code - @account.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label asp-for="AccumulatedDepreciationAccountId" class="form-label">@T["Accumulated Depreciation Account"]</label>
                <select asp-for="AccumulatedDepreciationAccountId" class="form-select">
                    <option value="">@T["Select Account"]</option>
                    @foreach (var account in accounts)
                    {
                        <option value="@account.Id">@account.Code - @account.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label asp-for="DepreciationExpenseAccountId" class="form-label">@T["Depreciation Expense Account"]</label>
                <select asp-for="DepreciationExpenseAccountId" class="form-select">
                    <option value="">@T["Select Account"]</option>
                    @foreach (var account in accounts)
                    {
                        <option value="@account.Id">@account.Code - @account.Name</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-dark">@T["Save Draft Asset"]</button>
        <a asp-action="Index" class="btn btn-outline-secondary">@T["Back"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
