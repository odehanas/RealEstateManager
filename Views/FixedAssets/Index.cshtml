@model RealEstateManager.Models.FixedAssetRegisterViewModel

@{
    ViewData["Title"] = T["Fixed Asset Register"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">@T["Fixed Asset Register"]</h2>
        <div class="text-muted">@T["Maintain depreciable assets and run monthly depreciation posting."]</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="FixedAssetCategories" asp-action="Index" class="btn btn-outline-secondary">@T["Asset Categories"]</a>
        <a asp-action="Create" class="btn btn-dark">@T["Add Fixed Asset"]</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (Model.Overdue.HasAny)
{
    var blocked = Model.Overdue.Months.Any(x => x.PeriodState != "Open");
    <div class="card shadow-sm mb-4 border-start border-4 border-danger">
        <div class="card-header bg-light d-flex flex-wrap justify-content-between align-items-center gap-2">
            <strong>@T["Monthly run not done"]</strong>
            @if (Model.Overdue.Months.Count > 0)
            {
                <span class="badge bg-danger">@T.Format("{0} month(s), {1} unposted", Model.Overdue.Months.Count, Model.Overdue.Amount.ToString("N2"))</span>
            }
        </div>
        <div class="card-body">
            @if (Model.Overdue.Months.Count > 0)
            {
                <p class="mb-2">@T["These months have ended, but their depreciation / amortization has not been posted to the ledger:"]</p>
                <table class="table table-sm align-middle" style="max-width:760px">
                    <thead class="table-light">
                        <tr>
                            <th>@T["Period"]</th>
                            <th class="text-end">@T["Assets"]</th>
                            <th class="text-end">@T["Schedule lines"]</th>
                            <th class="text-end">@T["Amount"]</th>
                            <th>@T["Accounting period"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var month in Model.Overdue.Months)
                        {
                            <tr>
                                <td>@month.Name</td>
                                <td class="text-end">@month.Assets</td>
                                <td class="text-end">@month.Lines</td>
                                <td class="text-end">@month.Amount.ToString("N2")</td>
                                <td>
                                    @if (month.PeriodState == "Closed")
                                    {
                                        <span class="badge bg-secondary">@T["Closed"]</span>
                                    }
                                    else if (month.PeriodState == "NoPeriod")
                                    {
                                        <span class="badge bg-warning text-dark">@T["No period"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">@T["Open"]</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (blocked)
                {
                    <div class="text-danger small mb-2">@T["A month whose accounting period is closed or missing cannot be posted: reopen or create the period first. The run stops at the first such month."]</div>
                }
                <form asp-action="RunMonthly" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="postingDate" value="@Model.Overdue.LastMonthEnd.ToString("yyyy-MM-dd")" />
                    <button type="submit" class="btn btn-danger">@T.Format("Post the missed months up to {0}", Model.Overdue.LastMonthEnd.ToString("dd/MM/yyyy"))</button>
                </form>
            }
            @if (Model.Overdue.AssetsWithoutSchedule.Count > 0)
            {
                <div class="mt-3">@T.Format("In service but with no schedule at all, so nothing will ever be posted for them: {0}", string.Join(", ", Model.Overdue.AssetsWithoutSchedule))</div>
            }
        </div>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">@T["Asset Cost"]</div>
                <div class="fs-4 fw-bold">@Model.TotalCost.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">@T["Accumulated Depreciation"]</div>
                <div class="fs-4 fw-bold">@Model.TotalAccumulatedDepreciation.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">@T["Net Book Value"]</div>
                <div class="fs-4 fw-bold">@Model.TotalNetBookValue.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">@T["Due to Post"]</div>
                <div class="fs-4 fw-bold">@Model.PendingDepreciationAmount.ToString("N2")</div>
                <div>@T.Format("{0} schedule(s)", Model.PendingDepreciationCount)</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light">
        @T.Html("<strong>Monthly Depreciation Run</strong>")
    </div>
    <div class="card-body">
        <form asp-action="RunMonthly" method="post" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-4">
                <label class="form-label">@T["Posting Date"]</label>
                <input type="date" name="postingDate" class="form-control" value="@Model.PostingDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-8">
                <button type="submit" class="btn btn-dark">@T["Post Due Depreciation"]</button>
                <span class="text-muted ms-2">@T["Posts all planned schedules up to the month-end of the selected date."]</span>
            </div>
        </form>
    </div>
</div>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>@T["Asset"]</th>
            <th>@T["Category"]</th>
            <th>@T["Property"]</th>
            <th>@T["In Service"]</th>
                    <th>@T["Capitalized"]</th>
            <th>@T["Status"]</th>
            <th class="text-end">@T["Cost"]</th>
            <th class="text-end">@T["Accum. Dep."]</th>
            <th class="text-end">@T["NBV"]</th>
            <th class="text-end">@T["Monthly"]</th>
            <th class="text-end">@T["Due"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Assets.Count == 0)
        {
            <tr>
                <td colspan="12" class="text-center text-muted py-4">@T["No fixed assets found."]</td>
            </tr>
        }
        else
        {
            @foreach (var asset in Model.Assets)
            {
                var badgeClass = asset.Status switch
                {
                    "FullyDepreciated" => "bg-success",
                    "Disposed" => "bg-secondary",
                    "Draft" => "bg-warning text-dark",
                    _ => "bg-primary"
                };

                <tr>
                    <td>
                        <div>@asset.AssetCode - @asset.Name</div>
                        <small class="text-muted">@T.Format("Acquired {0}", asset.AcquisitionDate.ToString("dd/MM/yyyy"))</small>
                    </td>
                    <td>
                        <div>@asset.AssetCategory</div>
                        <small class="text-muted">
                            @if (asset.DepreciationMethod != RealEstateManager.Domain.DepreciationMethods.None)
                            {
                                @T[asset.AssetClass == RealEstateManager.Domain.FixedAssetClasses.Intangible ? "Amortized" : "Depreciated"]<text>: </text>
                            }
                            @T[RealEstateManager.Domain.DepreciationMethods.Label(asset.DepreciationMethod)]@(asset.DecliningRatePercent.HasValue ? $" {asset.DecliningRatePercent.Value:0.##}%" : "")
                        </small>
                    </td>
                    <td>@asset.PropertyDisplay</td>
                    <td>@asset.InServiceDate.ToString("dd/MM/yyyy")</td>
                    <td>@(asset.CapitalizationDate.HasValue ? asset.CapitalizationDate.Value.ToString("dd/MM/yyyy") : "-")</td>
                    <td>
                        <span class="badge @badgeClass">@asset.Status</span>
                        @if (asset.IsRevalued)
                        {
                            <span class="badge bg-info text-dark">@T["Revalued"]</span>
                        }
                    </td>
                    <td class="text-end">@asset.Cost.ToString("N2")</td>
                    <td class="text-end">@asset.AccumulatedDepreciation.ToString("N2")</td>
                    <td class="text-end">@asset.NetBookValue.ToString("N2")</td>
                    <td class="text-end">@asset.MonthlyDepreciation.ToString("N2")</td>
                    <td class="text-end">@asset.PendingDepreciationAmount.ToString("N2")</td>
                    <td>
                        <a asp-action="Acquisition" asp-route-id="@asset.FixedAssetId" class="btn btn-outline-dark btn-sm">@T["Acquisition"]</a>
                        <a asp-action="Depreciation" asp-route-id="@asset.FixedAssetId" class="btn btn-outline-secondary btn-sm">@T["Depreciation"]</a>
                        @if (asset.Status is "Active" or "FullyDepreciated")
                        {
                            <a asp-action="Revalue" asp-route-id="@asset.FixedAssetId" class="btn btn-outline-secondary btn-sm">@T["Revalue"]</a>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
