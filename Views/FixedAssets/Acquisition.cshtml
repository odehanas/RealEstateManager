@model RealEstateManager.Models.FixedAssetAcquisitionViewModel
@using RealEstateManager.Domain

@{
    ViewData["Title"] = T["Asset Acquisition and Capitalization"];
    var accounts = ViewBag.Accounts as List<Account> ?? new();
    var vendors = ViewBag.Vendors as List<Vendor> ?? new();
    var canCapitalize = Model.Status == "Draft" && Model.OpenCapitalizableCost > 0m;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">@T["Asset Acquisition and Capitalization"]</h2>
        <div class="text-muted">@Model.AssetCode - @Model.AssetName</div>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">@T["Back to Register"]</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">@T["Status"]</div>
                <div class="fs-5 fw-bold">@Model.Status</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">@T["Capitalizable Cost"]</div>
                <div class="fs-5 fw-bold">@Model.CapitalizableCost.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">@T["Open to Capitalize"]</div>
                <div class="fs-5 fw-bold">@Model.OpenCapitalizableCost.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">@T["Capitalization Date"]</div>
                <div class="fs-5 fw-bold">@(Model.CapitalizationDate.HasValue ? Model.CapitalizationDate.Value.ToString("dd/MM/yyyy") : "-")</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light">
        @T.Html("<strong>Asset Profile</strong>")
    </div>
    <div class="card-body row g-3">
        <div class="col-md-3">
            <div class="text-muted small">@T["Category"]</div>
            <div>@Model.AssetCategory</div>
        </div>
        <div class="col-md-3">
            <div class="text-muted small">@T["Property"]</div>
            <div>@Model.PropertyDisplay</div>
        </div>
        <div class="col-md-2">
            <div class="text-muted small">@T["Acquisition Date"]</div>
            <div>@Model.AcquisitionDate.ToString("dd/MM/yyyy")</div>
        </div>
        <div class="col-md-2">
            <div class="text-muted small">@T["In Service Date"]</div>
            <div>@Model.InServiceDate.ToString("dd/MM/yyyy")</div>
        </div>
        <div class="col-md-2">
            <div class="text-muted small">@T["Useful Life"]</div>
            <div>@T.Format("{0} month(s)", Model.UsefulLifeMonths)</div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light">
        @T.Html("<strong>Add Acquisition Cost</strong>")
    </div>
    <div class="card-body">
        <div class="alert alert-info">
            @T["Every acquisition cost posts immediately to accounting. Capitalizable costs post to the fixed asset clearing account, and the selected payment or payable account is credited."]
        </div>

        <form asp-action="AddCost" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="FixedAssetId" value="@Model.FixedAssetId" />

            <div class="col-md-2">
                <label class="form-label">@T["Cost Date"]</label>
                <input type="date" name="CostDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>

            <div class="col-md-2">
                <label class="form-label">@T["Cost Type"]</label>
                <select name="CostType" class="form-select">
                    <option value="Purchase">@T["Purchase"]</option>
                    <option value="Freight">@T["Freight"]</option>
                    <option value="Installation">@T["Installation"]</option>
                    <option value="Customs">@T["Customs"]</option>
                    <option value="Testing">@T["Testing"]</option>
                    <option value="Other">@T["Other"]</option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">@T["Description"]</label>
                <input type="text" name="Description" class="form-control" placeholder="@T["Freight, installation, supplier invoice..."]" />
            </div>

            <div class="col-md-2">
                <label class="form-label">@T["Amount"]</label>
                <input type="number" step="0.01" min="0.01" name="Amount" class="form-control" />
            </div>

            <div class="col-md-2">
                <label class="form-label">@T["Capitalizable"]</label>
                <select name="IsCapitalizable" class="form-select">
                    <option value="true">@T["Yes"]</option>
                    <option value="false">@T["No"]</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">@T["Source Document"]</label>
                <input type="text" name="SourceDocumentNumber" class="form-control" />
            </div>

            <div class="col-md-3">
                <label class="form-label">@T["Reference"]</label>
                <input type="text" name="ReferenceNumber" class="form-control" />
            </div>

            <div class="col-md-3">
                <label class="form-label">@T["Paid / Payable From"]</label>
                <select name="CreditAccountId" class="form-select">
                    <option value="">@T["Select Account"]</option>
                    @foreach (var account in accounts)
                    {
                        if (Model.DefaultOffsetAccountId == account.Id)
                        {
                            <option value="@account.Id" selected>@account.Code - @account.Name</option>
                        }
                        else
                        {
                            <option value="@account.Id">@account.Code - @account.Name</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">@T["Vendor"]</label>
                <select name="VendorId" class="form-select">
                    <option value="">@T["Select Vendor"]</option>
                    @foreach (var vendor in vendors)
                    {
                        <option value="@vendor.Id">@vendor.Code - @vendor.Name</option>
                    }
                </select>
                <div class="form-text">@T["Required when the source account is Accounts Payable."]</div>
            </div>

            <div class="col-md-3">
                <label class="form-label">@T["Expense Account"]</label>
                <select name="ExpenseAccountId" class="form-select">
                    <option value="">@T["Use Default"]</option>
                    @foreach (var account in accounts)
                    {
                        if (Model.DefaultExpenseAccountId == account.Id)
                        {
                            <option value="@account.Id" selected>@account.Code - @account.Name</option>
                        }
                        else
                        {
                            <option value="@account.Id">@account.Code - @account.Name</option>
                        }
                    }
                </select>
                <div class="form-text">@T["Used only when `Capitalizable = No`."]</div>
            </div>

            <div class="col-md-6">
                <label class="form-label">@T["Notes"]</label>
                <input type="text" name="Notes" class="form-control" />
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-dark" @(Model.Status != "Draft" ? "disabled" : null)>@T["Add Cost"]</button>
                @if (Model.Status != "Draft")
                {
                    <span class="text-muted ms-2">@T["Only draft assets accept new acquisition cost allocations."]</span>
                }
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light">
        @T.Html("<strong>Cost Allocation Lines</strong>")
    </div>
    <div class="card-body p-0">
        <table class="table table-striped table-bordered mb-0">
            <thead>
                <tr>
                    <th>@T["Date"]</th>
                    <th>@T["Type"]</th>
                    <th>@T["Description"]</th>
                    <th>@T["Source"]</th>
                    <th>@T["Reference"]</th>
                    <th>@T["Offset Account"]</th>
                    <th>@T["Vendor / Bill"]</th>
                    <th>@T["Status"]</th>
                    <th>@T["Journal"]</th>
                    <th class="text-end">@T["Amount"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Costs.Count == 0)
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted py-4">@T["No acquisition costs have been recorded."]</td>
                    </tr>
                }
                else
                {
                    @foreach (var cost in Model.Costs)
                    {
                        <tr>
                            <td>@cost.CostDate.ToString("dd/MM/yyyy")</td>
                            <td>@cost.CostType</td>
                            <td>
                                <div>@cost.Description</div>
                                @if (!cost.IsCapitalizable)
                                {
                                    <small class="text-muted">@T["Non-capitalizable"]</small>
                                }
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(cost.SourceDocumentNumber) ? "-" : cost.SourceDocumentNumber)</td>
                            <td>@(string.IsNullOrWhiteSpace(cost.ReferenceNumber) ? "-" : cost.ReferenceNumber)</td>
                            <td>
                                <div>@(string.IsNullOrWhiteSpace(cost.OffsetAccountDisplay) ? "-" : cost.OffsetAccountDisplay)</div>
                                @if (!string.IsNullOrWhiteSpace(cost.ExpenseAccountDisplay))
                                {
                                    <small class="text-muted">@T.Format("Exp: {0}", cost.ExpenseAccountDisplay)</small>
                                }
                            </td>
                            <td>
                                <div>@(string.IsNullOrWhiteSpace(cost.VendorDisplay) ? "-" : cost.VendorDisplay)</div>
                                @if (!string.IsNullOrWhiteSpace(cost.VendorBillNumber))
                                {
                                    <small class="text-muted">@cost.VendorBillNumber</small>
                                }
                            </td>
                            <td>@cost.Status</td>
                            <td>@(string.IsNullOrWhiteSpace(cost.JournalEntryNumber) ? "-" : cost.JournalEntryNumber)</td>
                            <td class="text-end">@cost.Amount.ToString("N2")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-light">
        @T.Html("<strong>Capitalize Asset</strong>")
    </div>
    <div class="card-body">
        <div class="alert alert-warning">
            @T["Capitalization posts the asset into the fixed asset account and clears the accumulated acquisition cost from the selected clearing account. Depreciation starts only after capitalization."]
        </div>

        <form asp-action="Capitalize" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="FixedAssetId" value="@Model.FixedAssetId" />

            <div class="col-md-3">
                <label class="form-label">@T["Capitalization Date"]</label>
                <input type="date" name="CapitalizationDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>

            <div class="col-md-3">
                <label class="form-label">@T["In Service Date"]</label>
                <input type="date" name="InServiceDate" class="form-control" value="@Model.InServiceDate.ToString("yyyy-MM-dd")" />
            </div>

            <div class="col-md-6">
                <label class="form-label">@T["Credit Account (Fixed Asset Clearing / CWIP)"]</label>
                <select name="CreditAccountId" class="form-select">
                    <option value="">@T["Select Account"]</option>
                    @foreach (var account in accounts)
                    {
                        if (Model.DefaultClearingAccountId == account.Id)
                        {
                            <option value="@account.Id" selected>@account.Code - @account.Name</option>
                        }
                        else
                        {
                            <option value="@account.Id">@account.Code - @account.Name</option>
                        }
                    }
                </select>
            </div>

            <div class="col-12">
                <label class="form-label">@T["Remarks"]</label>
                <input type="text" name="Remarks" class="form-control" placeholder="@T["Ready for use, capitalization approved..."]" />
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-success" @(!canCapitalize ? "disabled" : null)>@T["Capitalize Asset"]</button>
                @if (!canCapitalize)
                {
                    <span class="text-muted ms-2">@T["A draft asset needs open capitalizable costs before it can be capitalized."]</span>
                }
            </div>
        </form>
    </div>
</div>
