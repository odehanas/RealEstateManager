@model IEnumerable<RealEstateManager.Domain.CustomerInvoice>
@using RealEstateManager.Domain

@{
    ViewData["Title"] = T["Customer Invoices"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@T["Customer Invoices"]</h2>
    <div class="d-flex gap-2">
        <a asp-controller="EInvoicing" asp-action="Index" class="btn btn-outline-primary">@T["E-Invoice Monitor"]</a>
        <a asp-controller="CustomerReceipts" asp-action="Create" class="btn btn-dark">@T["Receive Payment"]</a>
    </div>
</div>

@if (TempData["InvoiceSuccess"] is string success)
{
    <div class="alert alert-success py-2">@success</div>
}
@if (TempData["InvoiceError"] is string error)
{
    <div class="alert alert-danger py-2">@error</div>
}

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>@T["Invoice"]</th>
            <th>@T["Property"]</th>
            <th>@T["Unit"]</th>
            <th>@T["Tenant"]</th>
            <th>@T["Invoice Date"]</th>
            <th>@T["Due Date"]</th>
            <th class="text-end">@T["Total"]</th>
            <th class="text-end">@T["Paid"]</th>
            <th class="text-end">@T["Balance"]</th>
            <th>@T["Status"]</th>
            <th>@T["GL"]</th>
            <th>@T["E-Invoice"]</th>
            <th>@T["Action"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var invoice in Model)
        {
            var balance = invoice.TotalAmount - invoice.AmountPaid;
            var invoicePosted = invoice.JournalEntry?.IsPosted == true;

            <tr>
                <td>
                    @invoice.InvoiceNumber
                    @if (!string.IsNullOrWhiteSpace(invoice.TaxInvoiceNumber))
                    {
                        <div class="small text-muted">@invoice.TaxInvoiceNumber</div>
                    }
                </td>
                <td>@invoice.Lease?.Unit?.Property?.Name</td>
                <td>@invoice.Lease?.Unit?.UnitNumber</td>
                <td>@invoice.Lease?.Tenant?.FullName</td>
                <td>@invoice.InvoiceDate.ToString("dd/MM/yyyy")</td>
                <td>@invoice.DueDate.ToString("dd/MM/yyyy")</td>
                <td class="text-end">@invoice.TotalAmount.ToString("N2")</td>
                <td class="text-end">
                    @invoice.CashReceived.ToString("N2")
                    @if (invoice.CreditedAmount > 0m)
                    {
                        <div class="small text-muted">+ @invoice.CreditedAmount.ToString("N2") credited</div>
                    }
                </td>
                <td class="text-end">@balance.ToString("N2")</td>
                <td>@invoice.Status</td>
                @* Posted means the journal is POSTED, not merely that one exists. A journal
                   can exist as a draft - after Reset to Draft, or one created by an older
                   version of the receipt screen - and such an invoice is not in the accounts. *@
                <td>
                    @if (invoicePosted)
                    {
                        <span class="badge bg-success">@T["Posted"]</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">@T["Not Posted"]</span>
                    }
                </td>
                <td>
                    <span class="badge @EInvoiceStatuses.BadgeClass(invoice.EInvoiceStatus)">
                        @EInvoiceStatuses.Describe(invoice.EInvoiceStatus)
                    </span>
                </td>
                <td>
                    <div class="d-flex gap-2 flex-wrap">
                        @if (!invoicePosted)
                        {
                            <form asp-action="Post" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@invoice.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">@T["Post"]</button>
                            </form>
                        }

                        <a asp-action="TaxInvoice" asp-route-id="@invoice.Id" target="_blank"
                           class="btn btn-sm btn-outline-dark"
                           title="@(invoice.TaxInvoiceNumber != null ? "Print the tax invoice" : "Print the invoice — no output tax on this supply")">
                            @(invoice.TaxInvoiceNumber != null ? "Tax Invoice" : "Invoice")
                        </a>

                        @if (balance > 0 && invoicePosted)
                        {
                            <a asp-controller="CustomerReceipts" asp-action="Create" asp-route-invoiceId="@invoice.Id" class="btn btn-sm btn-outline-success">
                                @T["Receive"]
                            </a>
                            <a asp-controller="CustomerCreditNotes" asp-action="Create" asp-route-invoiceId="@invoice.Id"
                               class="btn btn-sm btn-outline-danger"
                               title="@T["Reduce or cancel this invoice. Once it has been e-invoiced, a credit note is the only way."]">
                                @T["Credit Note"]
                            </a>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
