@model RealEstateManager.Models.LeaseCreateViewModel
@using RealEstateManager.Domain
@{
    ViewData["Title"] = T["Create Lease"];
    var units = ViewBag.Units as List<Unit> ?? new();
    var tenants = ViewBag.Tenants as List<Tenant> ?? new();
}

<h2>@T["Create Lease"]</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">@T["Contract Code"]</label>
            <input type="text" class="form-control bg-light" value="Generated on save" readonly />
            <div class="form-text">
                @T.Html("Unit code + contract number + year, e.g. <code>OWN-R-0001-U01-C001-2026</code>. Renewing with the <strong>same tenant on the same unit</strong> keeps the contract number and moves the year on; a <strong>different tenant</strong> starts a new contract number.")
            </div>
        </div>

        <div class="col-md-4">
            <label asp-for="UnitId" class="form-label"></label>
            <select asp-for="UnitId" class="form-select">
                <option value="">@T["Select Unit"]</option>
                @foreach (var unit in units)
                {
                    <option value="@unit.Id">@unit.Property?.Code - @unit.UnitNumber</option>
                }
            </select>
        </div>

        <div class="col-md-4">
            <label asp-for="TenantId" class="form-label"></label>
            <select asp-for="TenantId" class="form-select">
                <option value="">@T["Select Tenant"]</option>
                @foreach (var tenant in tenants)
                {
                    <option value="@tenant.Id">@tenant.Code - @tenant.FullName</option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <label asp-for="StartDate" class="form-label"></label>
            <input asp-for="StartDate" type="date" class="form-control" />
        </div>

        <div class="col-md-3">
            <label asp-for="EndDate" class="form-label"></label>
            <input asp-for="EndDate" type="date" class="form-control" />
        </div>

        <div class="col-md-3">
            <label asp-for="RentBasis" class="form-label">@T["Rent Agreed As"]</label>
            <select asp-for="RentBasis" class="form-select" id="RentBasis">
                <option value="Annual">@T["Annual rent (tenancy)"]</option>
                <option value="Monthly">@T["Monthly rate (short stay)"]</option>
                <option value="Weekly">@T["Weekly rate (short stay)"]</option>
                <option value="Daily">@T["Daily rate (short stay)"]</option>
            </select>
        </div>

        <div class="col-md-3" data-rent="stay">
            <label asp-for="RentRate" class="form-label" id="rentRateLabel">@T["Rate"]</label>
            <input asp-for="RentRate" class="form-control" id="RentRate" />
            <span asp-validation-for="RentRate" class="text-danger"></span>
            <div class="form-text">@T["Billed for the days of the stay, both dates included."]</div>
        </div>

        <div class="col-md-3">
            <label asp-for="AnnualRent" class="form-label"></label>
            <input asp-for="AnnualRent" class="form-control" />
        </div>

        <div class="col-md-3">
            <label asp-for="BillingFrequencyMonths" class="form-label"></label>
            <select asp-for="BillingFrequencyMonths" class="form-select">
                <option value="1">@T["Monthly"]</option>
                <option value="2">@T["Every 2 Months"]</option>
                <option value="3">@T["Quarterly"]</option>
                <option value="4">@T["Every 4 Months"]</option>
                <option value="6">@T["Semi-Annual"]</option>
                <option value="12">@T["Annual"]</option>
            </select>
        </div>

        <div class="col-md-6">
            <label asp-for="VatCategoryOverride" class="form-label">@T["VAT Treatment"]</label>
            <select asp-for="VatCategoryOverride" class="form-select" id="vatCategoryOverride">
                <option value="">@T["Use the unit's treatment (recommended)"]</option>
                <option value="Standard">@T["Override — Standard rated (5%)"]</option>
                <option value="Exempt">@T["Override — Exempt"]</option>
                <option value="ZeroRated">@T["Override — Zero rated (0%)"]</option>
            </select>
            <div class="form-text">
                @T.Html("VAT is derived from the unit, falling back to the property. Commercial leases are standard rated. A residential lease of <strong>less than six months</strong> (daily, weekly or monthly letting) is a taxable supply, standard rated at 5%. Longer residential leases are exempt, except the <strong>first</strong> lease of a unit in a new building (within three years of its completion date), which is zero rated automatically. Override only for a genuine exception, and say why.")
            </div>
            <div id="vatPreview" class="alert py-2 px-3 mt-2 mb-0 d-none" data-url="@Url.Action("VatPreview", "Leases")"></div>
        </div>

        <div class="col-md-6">
            <label asp-for="VatOverrideReason" class="form-label">@T["Reason For Override"]</label>
            <input asp-for="VatOverrideReason" class="form-control" id="vatOverrideReason"
                   placeholder="@T["Required only when overriding"]" />
            <span asp-validation-for="VatOverrideReason" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="SecurityDepositAmount" class="form-label"></label>
            <input asp-for="SecurityDepositAmount" class="form-control" />
        </div>

        <div class="col-md-12">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
        </div>
    </div>

    <div class="mt-4 d-flex flex-wrap gap-2">
        @if (ViewBag.ApprovalRequired is true)
        {
            <button type="submit" name="nextStep" value="submit" class="btn btn-warning">@T["Save and Submit for Approval"]</button>
        }
        else
        {
            <button type="submit" name="nextStep" value="activate" class="btn btn-dark">@T["Save and Activate"]</button>
        }
        <button type="submit" name="nextStep" value="draft" class="btn btn-outline-dark">@T["Save as Draft"]</button>
        <a asp-action="Index" class="btn btn-outline-secondary">@T["Back"]</a>
    </div>
    <div class="form-text mt-2">
        @if (ViewBag.ApprovalRequired is true)
        {
            <text>This company requires approval: the contract takes effect - its invoices created, its terms locked - once a second person approves it.</text>
        }
        else
        {
            <text>Activating creates the contract's rent invoices and locks its terms. Save it as a draft to finish it later.</text>
        }
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var basis = document.getElementById('RentBasis');
            var annual = document.getElementById('AnnualRent');
            var billing = document.getElementById('BillingFrequencyMonths');
            var rate = document.getElementById('RentRate');
            if (!basis || !annual) { return; }
            var labels = { Monthly: '@T["Rate per Month"]', Weekly: '@T["Rate per Week"]', Daily: '@T["Rate per Day"]' };

            function apply() {
                var stay = basis.value !== 'Annual';
                document.querySelectorAll('[data-rent="stay"]').forEach(function (el) { el.style.display = stay ? '' : 'none'; });
                [annual, billing].forEach(function (el) {
                    var box = el && el.closest('[class*="col-"]');
                    if (box) { box.style.display = stay ? 'none' : ''; }
                });
                if (stay) {
                    // The yearly figure is worked out from the rate when the contract is saved.
                    if (!annual.value) { annual.value = '0'; }
                    document.getElementById('rentRateLabel').textContent = labels[basis.value];
                } else if (!rate.value) {
                    rate.value = '0';
                }
            }

            basis.addEventListener('change', apply);
            apply();
        })();
    </script>
    <script>
        (function () {
            var box = document.getElementById('vatPreview');
            var unit = document.getElementById('UnitId');
            var start = document.getElementById('StartDate');
            var end = document.getElementById('EndDate');
            var rentBasis = document.getElementById('RentBasis');
            var rentRate = document.getElementById('RentRate');
            if (!box || !start || !end) { return; }
            var unitId = function () { return unit ? unit.value : box.dataset.unitId; };

            function refresh() {
                if (!unitId() || !start.value || !end.value) { box.classList.add('d-none'); return; }
                var url = box.dataset.url + '?unitId=' + encodeURIComponent(unitId()) +
                    '&startDate=' + encodeURIComponent(start.value) + '&endDate=' + encodeURIComponent(end.value) +
                    (box.dataset.leaseId ? '&leaseId=' + encodeURIComponent(box.dataset.leaseId) : '') +
                    (rentBasis ? '&rentBasis=' + encodeURIComponent(rentBasis.value) + '&rentRate=' + encodeURIComponent(rentRate.value || '0') : '');
                fetch(url, { credentials: 'same-origin' })
                    .then(function (r) { return r.json(); })
                    .then(function (d) {
                        if (!d.ok) { box.classList.add('d-none'); return; }
                        box.className = 'alert py-2 px-3 mt-2 mb-0 ' + (d.shortTerm ? 'alert-warning' : 'alert-secondary');
                        box.textContent = '';
                        var strong = document.createElement('strong');
                        strong.textContent = d.label + '. ';
                        box.appendChild(strong);
                        box.appendChild(document.createTextNode(d.reason));
                        if (d.stay) {
                            var stayLine = document.createElement('div');
                            stayLine.className = 'mt-1 fw-semibold';
                            stayLine.textContent = d.stay;
                            box.appendChild(stayLine);
                        }
                        if (d.warning) {
                            var extra = document.createElement('div');
                            extra.className = 'mt-1';
                            extra.textContent = d.warning;
                            box.appendChild(extra);
                        }
                    })
                    .catch(function () { box.classList.add('d-none'); });
            }

            [unit, start, end, rentBasis, rentRate].forEach(function (el) { if (el) { el.addEventListener('change', refresh); } });
            refresh();
        })();
    </script>
}