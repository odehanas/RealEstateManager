@model RealEstateManager.Models.LeaseCreateViewModel
@using RealEstateManager.Domain
@{
    ViewData["Title"] = "Edit Lease";
    var units = ViewBag.Units as List<Unit> ?? new();
    var tenants = ViewBag.Tenants as List<Tenant> ?? new();
    var id = ViewBag.Id;
    var status = ViewBag.Status as string ?? LeaseStatuses.Draft;
    var termsLocked = ViewBag.TermsLocked is true;
    var approvalRequired = ViewBag.ApprovalRequired is true;
    var history = ViewBag.ApprovalHistory as List<ApprovalRequest> ?? new();
    var lastReturn = history.FirstOrDefault(x => x.Status == ApprovalStatuses.Rejected);
}

<h2>@(termsLocked ? "Contract" : "Edit Lease") <small class="text-muted fs-6">@LeaseStatuses.Describe(status)</small></h2>

@if (status == LeaseStatuses.Draft && lastReturn != null && history.FirstOrDefault() == lastReturn)
{
    <div class="alert alert-danger">
        <strong>Returned by @lastReturn.DecidedByName</strong> on @lastReturn.DecidedAt?.ToLocalTime().ToString("dd/MM/yyyy"):
        “@lastReturn.DecisionComment” Correct it and submit it again.
    </div>
}
else if (status == LeaseStatuses.PendingApproval)
{
    <div class="alert alert-warning">This contract is awaiting approval, so it cannot be changed. Withdraw it from the Leases list to correct it.</div>
}
else if (termsLocked)
{
    <div class="alert alert-info">
        This contract is @status.ToLowerInvariant(): its invoices were created from these terms, so they are locked.
        Only the notes can be updated.
    </div>
}

<form asp-action="Edit" asp-route-id="@id" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <fieldset @(termsLocked ? "disabled" : "")>
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="ContractNumber" class="form-label">Contract Code</label>
            <input asp-for="ContractNumber" class="form-control bg-light" readonly />
            <div class="form-text">Fixed once issued &mdash; it appears on the signed contract and in its QR code.</div>
        </div>

        <div class="col-md-4">
            <label asp-for="UnitId" class="form-label"></label>
            <select asp-for="UnitId" class="form-select">
                <option value="">Select Unit</option>
                @foreach (var unit in units)
                {
                    <option value="@unit.Id">@unit.Property?.Code - @unit.UnitNumber</option>
                }
            </select>
        </div>

        <div class="col-md-4">
            <label asp-for="TenantId" class="form-label"></label>
            <select asp-for="TenantId" class="form-select">
                <option value="">Select Tenant</option>
                @foreach (var tenant in tenants)
                {
                    <option value="@tenant.Id">@tenant.Code - @tenant.FullName</option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <label asp-for="StartDate" class="form-label"></label>
            <input asp-for="StartDate" type="date" class="form-control" />
        </div>

        <div class="col-md-3">
            <label asp-for="EndDate" class="form-label"></label>
            <input asp-for="EndDate" type="date" class="form-control" />
        </div>

        <div class="col-md-3">
            <label asp-for="AnnualRent" class="form-label"></label>
            <input asp-for="AnnualRent" class="form-control" />
        </div>

        <div class="col-md-3">
            <label asp-for="BillingFrequencyMonths" class="form-label"></label>
            <select asp-for="BillingFrequencyMonths" class="form-select">
                <option value="1">Monthly</option>
                <option value="2">Every 2 Months</option>
                <option value="3">Quarterly</option>
                <option value="4">Every 4 Months</option>
                <option value="6">Semi-Annual</option>
                <option value="12">Annual</option>
            </select>
        </div>

        <div class="col-md-6">
            <label asp-for="VatCategoryOverride" class="form-label">VAT Treatment</label>
            <select asp-for="VatCategoryOverride" class="form-select">
                <option value="">Use the unit's treatment</option>
                <option value="Standard">Override &mdash; Standard rated (5%)</option>
                <option value="Exempt">Override &mdash; Exempt</option>
                <option value="ZeroRated">Override &mdash; Zero rated (0%)</option>
            </select>
            <div class="form-text">
                Changing this affects invoices generated <strong>from now on</strong>. Invoices already
                raised keep the treatment they were issued under.
            </div>
        </div>

        <div class="col-md-6">
            <label asp-for="VatOverrideReason" class="form-label">Reason For Override</label>
            <input asp-for="VatOverrideReason" class="form-control" />
        </div>

        <div class="col-md-3">
            <label asp-for="SecurityDepositAmount" class="form-label"></label>
            <input asp-for="SecurityDepositAmount" class="form-control" />
        </div>

    </div>
    </fieldset>

    <div class="row g-3 mt-1">
        <div class="col-md-12">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="3" disabled="@(status == LeaseStatuses.PendingApproval)"></textarea>
        </div>
    </div>

    <div class="mt-4 d-flex flex-wrap gap-2">
        @if (status == LeaseStatuses.Draft)
        {
            <button type="submit" name="nextStep" value="draft" class="btn btn-outline-dark">Save Draft</button>
            @if (approvalRequired)
            {
                <button type="submit" name="nextStep" value="submit" class="btn btn-warning">Save and Submit for Approval</button>
            }
            else
            {
                <button type="submit" name="nextStep" value="activate" class="btn btn-success"
                        onclick="return confirm('Activate this contract? Its invoices will be created and its terms locked.');">Save and Activate</button>
            }
        }
        else if (status != LeaseStatuses.PendingApproval)
        {
            <button type="submit" class="btn btn-dark">Save Notes</button>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</form>

@if (id is int leaseId && leaseId > 0)
{
    <partial name="_RecordDocuments" model="@((RecordDocumentEntities.Lease, leaseId))" />
}

@if (history.Count > 0)
{
    <h5 class="mt-5">Approval history</h5>
    <table class="table table-sm table-bordered">
        <thead><tr><th>Submitted</th><th>By</th><th>Outcome</th><th>Decided by</th><th>Remark</th></tr></thead>
        <tbody>
            @foreach (var step in history)
            {
                <tr>
                    <td>@step.RequestedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@step.RequestedByName</td>
                    <td>@(step.Status == ApprovalStatuses.Rejected ? "Returned" : step.Status == ApprovalStatuses.Pending ? "Waiting" : step.Status)</td>
                    <td>@(step.DecidedByName ?? "-")</td>
                    <td>@(step.DecisionComment ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}