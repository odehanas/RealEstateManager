@model RealEstateManager.Domain.VendorBill
@{
    ViewData["Title"] = $"Bill {Model.BillNumber}";

    var company = ViewBag.Company as RealEstateManager.Domain.Company;
    var currency = company?.BaseCurrency ?? "AED";
    var periodClosed = Model.JournalEntry?.AccountingPeriod?.IsClosed ?? false;
    var isPosted = Model.JournalEntry?.IsPosted ?? false;
    var clearings = ViewBag.Clearings as List<RealEstateManager.Domain.VendorClearingLine> ?? new();
    var hasPayments = Model.Payments.Any(x => x.JournalEntryId != null && x.VendorBillId == Model.Id && !x.IsAdvance)
                      || clearings.Any(x => x.VendorClearing?.Status == RealEstateManager.Domain.VendorClearingStatuses.Posted);
    var accountingDate = Model.AccountingDate == default ? Model.BillDate : Model.AccountingDate;

    string Money(decimal value) => value.ToString("N2");

    // Address assembled once so the letterhead does not carry blank lines for
    // whatever the company has not filled in.
    var issuerLines = new[]
    {
        company?.AddressLine1,
        company?.AddressLine2,
        string.Join(", ", new[] { company?.City, company?.Country }.Where(x => !string.IsNullOrWhiteSpace(x))),
        string.Join("  ·  ", new[] { company?.Phone, company?.Email }.Where(x => !string.IsNullOrWhiteSpace(x)))
    }
    .Where(x => !string.IsNullOrWhiteSpace(x))
    .ToList();
}

<style>
    /* Screen only. Everything print-related lives in document-print.css. */
    .doc-table th { background: #0f2740; color: #fff; font-size: .78rem; text-transform: uppercase; letter-spacing: .03em; }
    .doc-table td, .doc-table th { vertical-align: middle; }
    .doc-table .num { text-align: right; white-space: nowrap; }
    .doc-meta-screen dt { font-weight: 600; color: #5b6b7c; font-size: .8rem; }
    .doc-meta-screen dd { margin-bottom: .6rem; }
    .totals-box { max-width: 360px; margin-left: auto; }
    .totals-box .row { padding: .3rem 0; }
    .totals-box .grand { border-top: 2px solid #0f2740; font-weight: 700; font-size: 1.08rem; }
</style>

@if (TempData["BillSuccess"] != null)
{
    <div class="alert alert-success no-print">@TempData["BillSuccess"]</div>
}
@if (TempData["BillError"] != null)
{
    <div class="alert alert-danger no-print">@TempData["BillError"]</div>
}

@* ======================================================================
   SCREEN HEADER - title and the workflow buttons. Dropped from the print.
   ====================================================================== *@
<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-3 no-print">
    <div>
        <h2 class="mb-1">
            @Model.BillNumber
            @if (isPosted)
            {
                <span class="badge bg-success align-middle">@T["Posted"]</span>
            }
            else
            {
                <span class="badge bg-warning text-dark align-middle">@T["Draft"]</span>
            }
            @if (periodClosed)
            {
                <span class="badge bg-dark align-middle">@T["Period locked"]</span>
            }
        </h2>
        <p class="text-muted mb-0">@Model.DocumentType from @Model.Vendor?.Name</p>
    </div>

    @* Draft -> Post -> Reset to Draft. Both actions route through
       JournalWorkflowService, so a closed period blocks them here for exactly
       the same reason it does everywhere else. *@
    <div class="d-flex gap-2">
        @if (Model.IsEditable)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-dark">@T["Edit"]</a>

            <form asp-action="Post" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-dark">@T["Post"]</button>
            </form>
        }
        else if (periodClosed)
        {
            <button type="button" class="btn btn-outline-secondary" disabled
                    title="@Model.JournalEntry?.AccountingPeriod?.Name is closed. Post a correcting journal instead.">
                @T["Reset to Draft"]
            </button>
        }
        else if (hasPayments)
        {
            <button type="button" class="btn btn-outline-secondary" disabled
                    title="@T["Payments have been made against this bill. Reset those first."]">
                @T["Reset to Draft"]
            </button>
        }
        else
        {
            <form asp-action="ResetToDraft" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-outline-warning">@T["Reset to Draft"]</button>
            </form>
        }

        @if (Model.BalanceDue > 0 && isPosted)
        {
            <a asp-controller="VendorPayments" asp-action="Create" asp-route-billId="@Model.Id"
               class="btn btn-success">@T["Register Payment"]</a>
        }

        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">@T["Print"]</button>
        <a asp-action="Index" class="btn btn-outline-secondary">@T["Back"]</a>
    </div>
</div>

<div class="doc">

    @* ==================================================================
       LETTERHEAD - print only. On screen the page already has the app's
       own header, so repeating the company name would be noise.
       ================================================================== *@
    <div class="doc-letterhead d-none d-print-flex">
        <div>
            <div class="doc-issuer-name">@(company?.LegalName ?? company?.Name ?? "RealEstateManager")</div>
            <div class="doc-issuer-detail">
                @foreach (var line in issuerLines)
                {
                    <div>@line</div>
                }
                @if (!string.IsNullOrWhiteSpace(company?.TrnNumber))
                {
                    <div><strong>TRN @company.TrnNumber</strong></div>
                }
            </div>
        </div>
        <div class="doc-title-block">
            <div class="doc-title">@Model.DocumentType</div>
            <div class="doc-number">@Model.BillNumber</div>
            <span class="doc-status">@(isPosted ? "Posted" : "Draft")</span>
        </div>
    </div>

    @if (!Model.VendorIsVatRegistered)
    {
        <div class="alert alert-warning print-keep">
            <strong>@T["Commercial invoice — no input tax."]</strong>
            @Model.Vendor?.Name is not VAT registered, so no tax was charged and none is recoverable.
            The full amount is a direct cost.
        </div>
    }

    @* ==================================================================
       META - two panels on paper, the existing three-column block on screen.
       ================================================================== *@
    <div class="doc-meta d-none d-print-flex">
        <div class="doc-panel">
            <div class="doc-panel-title">@T["Supplier"]</div>
            <div class="doc-party-name">@Model.Vendor?.Name</div>
            <div class="doc-party-line">@Model.Vendor?.Code</div>
            @if (!string.IsNullOrWhiteSpace(Model.SupplierTrn))
            {
                <div class="doc-party-line"><strong>TRN @Model.SupplierTrn</strong></div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Vendor?.TradeLicenseNumber))
            {
                <div class="doc-party-line">Licence @Model.Vendor.TradeLicenseNumber</div>
            }
            <div class="doc-field" style="margin-top:2mm">
                <span class="label">@T["Supplier's bill no."]</span>
                <span class="value">@(string.IsNullOrWhiteSpace(Model.VendorReference) ? "—" : Model.VendorReference)</span>
            </div>
        </div>

        <div class="doc-panel">
            <div class="doc-panel-title">@T["Bill Details"]</div>
            <div class="doc-field"><span class="label">@T["Bill date"]</span><span class="value">@Model.BillDate.ToString("dd/MM/yyyy")</span></div>
            <div class="doc-field"><span class="label">@T["Accounting date"]</span><span class="value">@accountingDate.ToString("dd/MM/yyyy")</span></div>
            <div class="doc-field"><span class="label">@T["Due date"]</span><span class="value">@Model.DueDate.ToString("dd/MM/yyyy")</span></div>
            <div class="doc-field">
                <span class="label">@T["Period"]</span>
                <span class="value">@(Model.JournalEntry?.AccountingPeriod?.Name ?? "—")</span>
            </div>
            <div class="doc-field">
                <span class="label">@T["Category"]</span>
                <span class="value">@(string.IsNullOrWhiteSpace(Model.ExpenseCategory) ? "—" : Model.ExpenseCategory)</span>
            </div>
            @if (Model.DevelopmentProject != null)
            {
                <div class="doc-field">
                    <span class="label">@T["Development project"]</span>
                    <span class="value">@Model.DevelopmentProject.Code @Model.DevelopmentProject.Name</span>
                </div>
            }
            <div class="doc-field">
                <span class="label">@T["Journal entry"]</span>
                <span class="value">@(Model.JournalEntry?.EntryNumber ?? "Not journalised")</span>
            </div>
        </div>
    </div>

    @* Screen version of the same information. *@
    <div class="card shadow-sm mb-3 d-print-none">
        <div class="card-body">
            <div class="row doc-meta-screen">
                <div class="col-md-4">
                    <dl class="mb-0">
                        <dt>@T["Supplier"]</dt>
                        <dd>
                            @Model.Vendor?.Code &mdash; @Model.Vendor?.Name<br />
                            @if (!string.IsNullOrWhiteSpace(Model.SupplierTrn))
                            {
                                <span class="small text-muted">TRN @Model.SupplierTrn</span>
                            }
                        </dd>
                        <dt>@T["Supplier's Bill No."]</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.VendorReference) ? "—" : Model.VendorReference)</dd>
                    </dl>
                </div>
                <div class="col-md-4">
                    <dl class="mb-0">
                        <dt>@T["Bill Date"]</dt>
                        <dd>@Model.BillDate.ToString("dd/MM/yyyy")</dd>
                        <dt>@T["Accounting Date"]</dt>
                        <dd>
                            @accountingDate.ToString("dd/MM/yyyy")
                            @if (Model.JournalEntry?.AccountingPeriod != null)
                            {
                                <span class="small text-muted">(@Model.JournalEntry.AccountingPeriod.Name)</span>
                            }
                        </dd>
                        <dt>@T["Due Date"]</dt>
                        <dd>@Model.DueDate.ToString("dd/MM/yyyy")</dd>
                    </dl>
                </div>
                <div class="col-md-4">
                    <dl class="mb-0">
                        <dt>@T["Category"]</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.ExpenseCategory) ? "—" : Model.ExpenseCategory)</dd>
                        @if (Model.DevelopmentProject != null)
                        {
                            <dt>@T["Development project"]</dt>
                            <dd><a asp-controller="DevelopmentProjects" asp-action="Details" asp-route-id="@Model.DevelopmentProjectId">@Model.DevelopmentProject.Code @Model.DevelopmentProject.Name</a></dd>
                        }
                        <dt>@T["Journal Entry"]</dt>
                        <dd>
                            @if (Model.JournalEntry != null)
                            {
                                var entryDate = Model.JournalEntry.EntryDate;
                                <a asp-controller="Journal" asp-action="Index"
                                   asp-route-fromDate="@entryDate.ToString("yyyy-MM-dd")"
                                   asp-route-toDate="@entryDate.ToString("yyyy-MM-dd")"
                                   asp-route-sourceType="VendorBill"
                                   asp-route-postedOnly="false">
                                    @Model.JournalEntry.EntryNumber
                                </a>
                                <span class="badge @(isPosted ? "bg-success" : "bg-warning text-dark")">
                                    @(isPosted ? "Posted" : "Draft")
                                </span>
                            }
                            else if (Model.JournalEntryId.HasValue)
                            {
                                @* The bill points at an entry that is gone or belongs to another company. *@
                                <span class="text-danger">Entry #@Model.JournalEntryId not found</span>
                            }
                            else
                            {
                                <span class="text-muted">@T["Not journalised yet"]</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    @* ==================================================================
       LINES - one table serving both media. doc-lines carries the print
       treatment, the Bootstrap classes carry the screen one.
       ================================================================== *@
    <div class="card shadow-sm mb-3">
        <div class="table-responsive">
            <table class="table table-bordered table-sm mb-0 doc-table doc-lines">
                <thead>
                    <tr>
                        <th class="seq" style="width:3%">#</th>
                        <th style="width:24%">@T["Description"]</th>
                        <th style="width:21%">@T["Account"]</th>
                        <th style="width:13%">@T["Property"]</th>
                        <th style="width:7%" class="num">@T["Qty"]</th>
                        <th style="width:10%" class="num">@T["Unit Price"]</th>
                        <th style="width:10%" class="num">@T["Net"]</th>
                        <th style="width:6%" class="num">@T["VAT"]</th>
                        <th style="width:10%" class="num">@T["Total"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Lines.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-muted">
                                This bill was raised automatically and carries no detail lines.
                                Its total is @Money(Model.TotalAmount) @currency.
                            </td>
                        </tr>
                    }
                    @foreach (var line in Model.Lines.OrderBy(x => x.LineNumber))
                    {
                        <tr>
                            <td class="seq">@line.LineNumber</td>
                            <td>
                                @line.Description
                                @if (line.NonRecoverableVatAmount > 0m)
                                {
                                    <span class="doc-line-note">
                                        Includes @Money(line.NonRecoverableVatAmount) irrecoverable VAT
                                        (@RealEstateManager.Domain.InputTaxAttributions.Describe(line.InputTaxAttribution))
                                    </span>
                                }
                            </td>
                            <td class="doc-line-sub">
                                @if (line.Account != null)
                                {
                                    <text>@line.Account.Code &mdash; @line.Account.Name</text>
                                }
                                else
                                {
                                    <span class="text-danger">@T["No account"]</span>
                                }
                            </td>
                            <td class="doc-line-sub code">@(line.Property?.Code ?? "—")</td>
                            <td class="num">@line.Quantity.ToString("N2")</td>
                            <td class="num">@line.UnitPrice.ToString("N2")</td>
                            <td class="num">@Money(line.LineSubtotal)</td>
                            <td class="num">@(line.IsTaxable ? Money(line.VatAmount) : "—")</td>
                            <td class="num">@Money(line.LineTotal)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* ==================================================================
       CLOSE - notes on the left, totals on the right. Print only; the
       screen keeps its own two-column card layout below.
       ================================================================== *@
    <div class="doc-close d-none d-print-flex">
        <div class="doc-close-left">
            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <div class="doc-notes">
                    <strong>@T["Notes"]</strong><br />
                    @Model.Notes
                </div>
            }
            @if (Model.VatAmount > 0m)
            {
                <div>
                    Input tax of @Money(Model.VatAmount) @currency:
                    @Money(Model.RecoverableVatAmount) recoverable,
                    @Money(Model.NonRecoverableVatAmount) charged to cost.
                </div>
            }
        </div>

        <div class="doc-totals">
            <div class="doc-total-row"><span>@T["Subtotal"]</span><span class="amount">@Money(Model.Subtotal)</span></div>
            <div class="doc-total-row"><span>@T["VAT"]</span><span class="amount">@Money(Model.VatAmount)</span></div>
            <div class="doc-total-row grand"><span>Total @currency</span><span class="amount">@Money(Model.TotalAmount)</span></div>
            <div class="doc-total-row"><span>@T["Paid"]</span><span class="amount">@Money(Model.AmountPaid)</span></div>
            <div class="doc-total-row balance"><span>@T["Balance Due"]</span><span class="amount">@Money(Model.BalanceDue)</span></div>
        </div>
    </div>

    @* Screen version of notes and totals. *@
    <div class="row g-3 d-print-none">
        <div class="col-md-7">
            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="small text-uppercase text-muted mb-1">@T["Notes"]</div>
                        <div>@Model.Notes</div>
                    </div>
                </div>
            }
        </div>
        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-body totals-box">
                    <div class="row"><div class="col">@T["Subtotal"]</div><div class="col text-end">@Money(Model.Subtotal)</div></div>
                    <div class="row"><div class="col">@T["VAT"]</div><div class="col text-end">@Money(Model.VatAmount)</div></div>
                    <div class="row grand"><div class="col">Total (@currency)</div><div class="col text-end">@Money(Model.TotalAmount)</div></div>
                    <div class="row"><div class="col">@T["Paid"]</div><div class="col text-end">@Money(Model.AmountPaid)</div></div>
                    <div class="row fw-bold"><div class="col">@T["Balance Due"]</div><div class="col text-end">@Money(Model.BalanceDue)</div></div>

                    @if (Model.VatAmount > 0m)
                    {
                        <hr class="my-2" />
                        <div class="row small text-muted">
                            <div class="col">@T["Recoverable input tax"]</div>
                            <div class="col text-end">@Money(Model.RecoverableVatAmount)</div>
                        </div>
                        <div class="row small text-muted">
                            <div class="col">@T["Added to cost"]</div>
                            <div class="col text-end">@Money(Model.NonRecoverableVatAmount)</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (clearings.Count > 0)
    {
        <div class="card shadow-sm mt-3">
            <div class="card-header bg-white d-print-none d-flex justify-content-between">
                <strong>@T["Settled by"]</strong>
                <span>@(Model.ClearingNumber != null ? $"Cleared by {Model.ClearingNumber} on {Model.ClearedDate:dd/MM/yyyy}" : $"Open {Money(Model.TotalAmount - Model.AmountPaid)}")</span>
            </div>
            <div class="table-responsive">
                <table class="table table-sm mb-0 doc-lines">
                    <thead><tr><th>@T["Clearing document"]</th><th>@T["Date"]</th><th>@T["By"]</th><th class="num">@T["Amount"]</th><th>@T["Status"]</th></tr></thead>
                    <tbody>
                        @foreach (var line in clearings)
                        {
                            var c = line.VendorClearing!;
                            var source = c.ClearingType == RealEstateManager.Domain.VendorClearingTypes.Advance ? c.AdvancePayment : c.VendorPayment;
                            <tr>
                                <td>@c.ClearingNumber</td>
                                <td>@c.ClearingDate.ToString("dd/MM/yyyy")</td>
                                <td>@(c.ClearingType == RealEstateManager.Domain.VendorClearingTypes.Advance ? "Advance " : "Payment ")<a asp-controller="VendorPayments" asp-action="Details" asp-route-id="@source?.Id">@source?.PaymentNumber</a></td>
                                <td class="num">@Money(line.Amount)</td>
                                <td>@c.Status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (Model.Payments.Any())
    {
        <div class="card shadow-sm mt-3">
            <div class="card-header bg-white d-print-none">@T.Html("<strong>Payments</strong>")</div>
            <div class="table-responsive">
                <table class="table table-sm mb-0 doc-lines">
                    <thead>
                        <tr>
                            <th>@T["Payment"]</th><th>@T["Date"]</th><th class="num">@T["Amount"]</th><th>@T["Status"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in Model.Payments.OrderBy(x => x.PaymentDate))
                        {
                            <tr>
                                <td>@payment.PaymentNumber</td>
                                <td>@payment.PaymentDate.ToString("dd/MM/yyyy")</td>
                                <td class="num">@Money(payment.Amount)</td>
                                <td>@(payment.JournalEntryId.HasValue ? "Posted" : "Draft")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* ==================================================================
       APPROVAL AND FOOTER - print only. A supplier invoice is an internal
       control document as much as an accounting one, so the paper copy
       carries somewhere to sign it off.
       ================================================================== *@
    <div class="doc-signatures d-none d-print-flex">
        <div class="doc-signature">@T["Prepared by"]</div>
        <div class="doc-signature">@T["Checked by"]</div>
        <div class="doc-signature">@T["Approved by"]</div>
    </div>

    <div class="doc-footer d-none d-print-flex">
        <span>@(company?.LegalName ?? company?.Name) &middot; @Model.BillNumber &middot; @Model.DocumentType</span>
        <span>Printed @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
    </div>
</div>
