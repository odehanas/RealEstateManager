@model List<RealEstateManager.Services.HrService.ExpiringDocument>

@{
    ViewData["Title"] = "Expiring Documents";
    int days = ViewBag.Days;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="mb-0">Expiring Documents</h2>
        <div class="text-muted">Passports, Emirates IDs, visas, labour cards, insurance and limited contracts of current staff.</div>
    </div>
    <div class="d-flex gap-2">
        <form method="get" class="d-flex gap-2">
            <select name="days" class="form-select" onchange="this.form.submit()">
                @foreach (var d in new[] { 30, 60, 90, 180 })
                {
                    <option value="@d" selected="@(d == days)">Within @d days</option>
                }
            </select>
        </form>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">Print</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Employees</a>
    </div>
</div>

<table class="table table-bordered table-striped">
    <thead class="table-light">
        <tr><th>Employee</th><th>Document</th><th>Number</th><th>Expiry</th><th>Status</th></tr>
    </thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr><td colspan="5" class="text-muted">Nothing expires within @days days.</td></tr>
        }
        @foreach (var d in Model)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@d.EmployeeId">@d.EmployeeCode</a> @d.EmployeeName</td>
                <td>@d.Document</td>
                <td>@d.Number</td>
                <td>@d.Expiry.ToString("dd/MM/yyyy")</td>
                <td>
                    @if (d.DaysLeft < 0)
                    {
                        <span class="badge bg-danger">Expired @(-d.DaysLeft) day(s) ago</span>
                    }
                    else
                    {
                        <span class="badge @(d.DaysLeft <= 30 ? "bg-warning text-dark" : "bg-light text-dark border")">@d.DaysLeft day(s) left</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
