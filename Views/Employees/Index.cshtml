@model RealEstateManager.Models.EmployeeListViewModel
@using RealEstateManager.Domain

@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="mb-0">Employees</h2>
        <div class="text-muted">Staff records, UAE documents, salary and payment details.</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Documents" class="btn btn-outline-danger">
            Expiring documents
            @if (Model.ExpiringDocuments > 0)
            {
                <span class="badge bg-danger">@Model.ExpiringDocuments</span>
            }
        </a>
        <a asp-action="Create" class="btn btn-dark">Add Employee</a>
    </div>
</div>

@if (TempData["HrSuccess"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <select name="status" class="form-select" onchange="this.form.submit()">
            @foreach (var s in EmployeeStatuses.All.Append("All"))
            {
                <option value="@s" selected="@(s == Model.Status)">@s</option>
            }
        </select>
    </div>
    <div class="col-md-5">
        <input name="q" value="@Model.Search" class="form-control" placeholder="Search by code, name, job title or Emirates ID" />
    </div>
    <div class="col-md-2"><button class="btn btn-outline-dark w-100">Search</button></div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Job title</th>
                <th>Department</th>
                <th>Building</th>
                <th>Joined</th>
                <th class="text-end">Monthly gross</th>
                <th>Paid by</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Employees.Count == 0)
            {
                <tr><td colspan="9" class="text-muted">No employees found.</td></tr>
            }
            @foreach (var e in Model.Employees)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@e.Id">@e.EmployeeCode</a></td>
                    <td>@e.FullName</td>
                    <td>@e.JobTitle</td>
                    <td>@e.Department?.Name</td>
                    <td>@e.Property?.Name</td>
                    <td>@e.JoiningDate.ToString("dd/MM/yyyy")</td>
                    <td class="text-end">@e.MonthlyGross.ToString("N2")</td>
                    <td>@SalaryPaymentMethods.Describe(e.PaymentMethod)</td>
                    <td><span class="badge @(e.Status == EmployeeStatuses.Active ? "bg-success" : "bg-secondary")">@e.Status</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>
