@model RealEstateManager.Models.EmployeeDetailsViewModel
@using RealEstateManager.Domain
@inject RealEstateManager.Services.PermissionService PermissionService

@{
    var e = Model.Employee;
    ViewData["Title"] = e.FullName;

    string Expiry(DateTime? date)
    {
        if (!date.HasValue) return "";
        var days = (date.Value.Date - DateTime.Today).Days;
        return days < 0 ? "bg-danger" : days <= 60 ? "bg-warning text-dark" : "bg-light text-dark border";
    }
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="mb-0">@e.FullName <span class="text-muted fw-normal fs-5">@e.EmployeeCode</span></h2>
        <div class="text-muted">@e.JobTitle @(e.Department != null ? "· " + e.Department.Name : "") @(e.Property != null ? "· " + e.Property.Name : "")</div>
    </div>
    <div class="d-flex gap-2">
        <span class="badge fs-6 @(e.Status == EmployeeStatuses.Active ? "bg-success" : "bg-secondary") align-self-center">@e.Status</span>
        <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-dark">@T["Edit"]</a>
        <a asp-action="Index" class="btn btn-outline-secondary">@T["Back"]</a>
    </div>
</div>

@if (TempData["HrSuccess"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["HrError"] is string err)
{
    <div class="alert alert-danger">@err</div>
}
@if (TempData["PortalTemporaryPassword"] is string temporary)
{
    <div class="alert alert-warning">
        Temporary password: <code class="fs-5">@temporary</code> &mdash; give it to the employee now; it is not shown again.
        They sign in at <strong>@($"{Context.Request.Scheme}://{Context.Request.Host}/me")</strong> and must choose their own password.
    </div>
}
@foreach (var doc in Model.ExpiringDocuments)
{
    <div class="alert @(doc.DaysLeft < 0 ? "alert-danger" : "alert-warning") py-2">
        <strong>@doc.Document</strong> @(doc.DaysLeft < 0 ? $"expired {-doc.DaysLeft} day(s) ago" : $"expires in {doc.DaysLeft} day(s)") (@doc.Expiry.ToString("dd/MM/yyyy")).
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card shadow-sm h-100"><div class="card-body">
            <div class="small text-muted text-uppercase">@T["Monthly gross"]</div>
            <div class="fs-3 fw-bold">@e.MonthlyGross.ToString("N2")</div>
            <div class="small">@T.Format("Basic {0} · Allowances {1}", e.BasicSalary.ToString("N2"), (e.HousingAllowance + e.TransportAllowance + e.OtherAllowance).ToString("N2"))</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm h-100"><div class="card-body">
            <div class="small text-muted text-uppercase">@T["Annual leave available"]</div>
            <div class="fs-3 fw-bold">@T.Format("{0} days", Model.LeaveBalance.Available.ToString("0.##"))</div>
            <div class="small">Earned @Model.LeaveBalance.Accrued.ToString("0.##") + opening @Model.LeaveBalance.Opening.ToString("0.##") − taken @Model.LeaveBalance.Taken.ToString("0.##")
                @if (Model.LeaveBalance.Pending > 0) { <text>@T.Format("· {0} pending", Model.LeaveBalance.Pending.ToString("0.##"))</text> }</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm h-100"><div class="card-body">
            <div class="small text-muted text-uppercase">@T["End-of-service gratuity today"]</div>
            <div class="fs-3 fw-bold">@Model.Gratuity.Amount.ToString("N2")</div>
            <div class="small">
                @Model.Gratuity.ServiceYears years of service.
                @if (!Model.Gratuity.Eligible) { <span class="text-danger">@T["Not yet payable: less than one year."]</span> }
                @if (Model.Gratuity.Capped) { <span>@T["Capped at two years' basic pay."]</span> }
            </div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm h-100"><div class="card-body">
            <div class="small text-muted text-uppercase">@T["Provided in the accounts"]</div>
            <div class="fs-3 fw-bold">@Model.GratuityProvisionBooked.ToString("N2")</div>
            <div class="small">@T["Charged by approved payrolls, plus any opening provision."]</div>
        </div></div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light"><h6 class="mb-0">@T["Personal and contract"]</h6></div>
            <table class="table table-sm mb-0">
                <tr><th class="w-50">@T["Arabic name"]</th><td dir="rtl">@e.NameArabic</td></tr>
                <tr><th>@T["Gender · Nationality"]</th><td>@e.Gender · @e.Nationality</td></tr>
                <tr><th>@T["Date of birth"]</th><td>@e.DateOfBirth?.ToString("dd/MM/yyyy")</td></tr>
                <tr><th>@T["Mobile · Email"]</th><td>@e.Mobile @e.Email</td></tr>
                <tr><th>@T["Emergency contact"]</th><td>@e.EmergencyContactName @e.EmergencyContactPhone</td></tr>
                <tr><th>@T["Joined · Probation ends"]</th><td>@e.JoiningDate.ToString("dd/MM/yyyy") · @e.ProbationEndDate?.ToString("dd/MM/yyyy")</td></tr>
                <tr><th>@T["Contract"]</th><td>@e.ContractType @(e.ContractEndDate.HasValue ? "until " + e.ContractEndDate.Value.ToString("dd/MM/yyyy") : "")</td></tr>
                @if (e.LeavingDate.HasValue)
                {
                    <tr><th>@T["Last working day"]</th><td>@e.LeavingDate.Value.ToString("dd/MM/yyyy") — @e.LeavingReason</td></tr>
                }
                <tr><th>@T["Paid by"]</th><td>@SalaryPaymentMethods.Describe(e.PaymentMethod) · @e.BankName @e.Iban</td></tr>
            </table>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light"><h6 class="mb-0">@T["Documents"]</h6></div>
            <table class="table table-sm mb-0">
                <tr><th>@T["Document"]</th><th>@T["Number"]</th><th>@T["Expiry"]</th></tr>
                <tr><td>@T["Passport"]</td><td>@e.PassportNumber</td><td><span class="badge @Expiry(e.PassportExpiry)">@e.PassportExpiry?.ToString("dd/MM/yyyy")</span></td></tr>
                <tr><td>@T["Emirates ID"]</td><td>@e.EmiratesIdNumber</td><td><span class="badge @Expiry(e.EmiratesIdExpiry)">@e.EmiratesIdExpiry?.ToString("dd/MM/yyyy")</span></td></tr>
                <tr><td>@T["Residence visa"]</td><td>@e.ResidenceVisaNumber</td><td><span class="badge @Expiry(e.ResidenceVisaExpiry)">@e.ResidenceVisaExpiry?.ToString("dd/MM/yyyy")</span></td></tr>
                <tr><td>@T["Labour card"]</td><td>@e.LabourCardNumber</td><td><span class="badge @Expiry(e.LabourCardExpiry)">@e.LabourCardExpiry?.ToString("dd/MM/yyyy")</span></td></tr>
                <tr><td>@T["Health insurance"]</td><td>@e.HealthInsuranceNumber</td><td><span class="badge @Expiry(e.HealthInsuranceExpiry)">@e.HealthInsuranceExpiry?.ToString("dd/MM/yyyy")</span></td></tr>
                <tr><td>@T["MOHRE person code"]</td><td colspan="2">@(e.MohrePersonCode ?? "—")</td></tr>
            </table>
        </div>
    </div>
</div>

@if (await PermissionService.HasPermissionAsync(User, RealEstateManager.Services.AppPermissions.HrManage))
{
    var portalUser = Model.PortalUser;
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-light"><h6 class="mb-0">@T["Employee portal (payslips, leave and certificates on their phone)"]</h6></div>
        <div class="card-body small">
            @if (portalUser == null)
            {
                <p class="mb-2">@T["No portal login yet."]</p>
            }
            else
            {
                <p class="mb-2">
                    @T.HtmlFormat("Username <strong>{0}</strong> · {1} {2} {3} {4}", portalUser.Username, portalUser.IsActive ? "active" : "disabled", portalUser.MustChangePassword ? "· still on the temporary password" : "", portalUser.LastLoginAt.HasValue ? $"· last sign-in {portalUser.LastLoginAt.Value.ToLocalTime():dd/MM/yyyy HH:mm}" : "· never signed in", portalUser.LockedOutUntil > DateTime.UtcNow ? "· locked after wrong passwords" : "")
                </p>
            }
            <div class="d-flex flex-wrap gap-2">
                <form asp-action="IssuePortalAccess" asp-route-id="@e.Id" method="post" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <input name="username" class="form-control form-control-sm" style="width:220px" value="@(portalUser?.Username ?? e.Mobile ?? e.Email)" placeholder="@T["Username (mobile or email)"]" />
                    <button class="btn btn-sm btn-dark">@(portalUser == null ? T["Give portal access"] : T["Reset password"])</button>
                </form>
                @if (portalUser != null)
                {
                    <form asp-action="SetPortalAccess" asp-route-id="@e.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="active" value="@(portalUser.IsActive ? "false" : "true")" />
                        <button class="btn btn-sm @(portalUser.IsActive ? "btn-outline-danger" : "btn-outline-success")">@(portalUser.IsActive ? T["Disable"] : T["Enable"])</button>
                    </form>
                }
            </div>
        </div>
    </div>
}

<div class="card shadow-sm mb-3">
    <div class="card-header bg-light"><h6 class="mb-0">@T["End-of-service gratuity — how it is worked out"]</h6></div>
    <div class="card-body small">
        @T.HtmlFormat("Daily basic pay {0} (basic ÷ 30) × ({1} days for the first five years at 21 days a year + {2} days for later years at 30 days a year) = <strong>{3}</strong>, never more than two years' basic pay. Under UAE law nothing is payable before one year of continuous service.", Model.Gratuity.DailyBasic.ToString("N2"), Model.Gratuity.FirstFiveYearsDays.ToString("0.##"), Model.Gratuity.LaterYearsDays.ToString("0.##"), Model.Gratuity.Amount.ToString("N2"))
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light d-flex justify-content-between"><h6 class="mb-0">@T["Leave"]</h6><a asp-controller="Leave" asp-action="Index" class="small">@T["All leave"]</a></div>
            <table class="table table-sm mb-0">
                <tr><th>@T["Type"]</th><th>@T["From"]</th><th>@T["To"]</th><th class="text-end">@T["Days"]</th><th>@T["Status"]</th></tr>
                @foreach (var l in Model.Leave)
                {
                    <tr><td>@l.LeaveType</td><td>@l.StartDate.ToString("dd/MM/yyyy")</td><td>@l.EndDate.ToString("dd/MM/yyyy")</td><td class="text-end">@l.Days.ToString("0.##")</td><td>@l.Status</td></tr>
                }
            </table>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light"><h6 class="mb-0">@T["Payslips"]</h6></div>
            <table class="table table-sm mb-0">
                <tr><th>@T["Month"]</th><th class="text-end">@T["Gross"]</th><th class="text-end">@T["Deductions"]</th><th class="text-end">@T["Net"]</th><th></th></tr>
                @foreach (var p in Model.Payslips)
                {
                    <tr>
                        <td>@p.PayrollRun!.RunNumber</td>
                        <td class="text-end">@p.Gross.ToString("N2")</td>
                        <td class="text-end">@p.TotalDeductions.ToString("N2")</td>
                        <td class="text-end">@p.Net.ToString("N2")</td>
                        <td><a asp-controller="Payroll" asp-action="Payslip" asp-route-id="@p.Id" target="_blank">@T["Payslip"]</a></td>
                    </tr>
                }
            </table>
            @if (Model.Advances.Count > 0)
            {
                <div class="card-header bg-light border-top"><h6 class="mb-0">@T["Salary advances"]</h6></div>
                <table class="table table-sm mb-0">
                    <tr><th>@T["Date"]</th><th class="text-end">@T["Amount"]</th><th class="text-end">@T["Monthly"]</th><th class="text-end">@T["Outstanding"]</th></tr>
                    @foreach (var a in Model.Advances)
                    {
                        <tr><td>@a.AdvanceDate.ToString("dd/MM/yyyy")</td><td class="text-end">@a.Amount.ToString("N2")</td><td class="text-end">@a.MonthlyInstalment.ToString("N2")</td><td class="text-end">@a.Outstanding.ToString("N2")</td></tr>
                    }
                </table>
            }
        </div>
    </div>
</div>
