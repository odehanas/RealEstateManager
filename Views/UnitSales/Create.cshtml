@{
    ViewData["Title"] = "New Sale Contract";
    var units = ViewBag.Units as List<SelectListItem> ?? new();
    var buyers = ViewBag.Buyers as List<SelectListItem> ?? new();
}

<h2>New Sale Contract</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Unit</label>
            <select name="unitId" id="unitId" asp-items="units" class="form-select" required>
                <option value="">--</option>
            </select>
            <div class="form-text">Owned units not already under a sale contract. Off-plan units can be sold before completion; handover needs the unit's cost transferred to held for sale.</div>
        </div>
        <div class="col-md-6">
            <label class="form-label">Buyer</label>
            <select name="buyerId" asp-items="buyers" class="form-select" required>
                <option value="">--</option>
            </select>
            <div class="form-text">From the customer register (Master Data &rsaquo; Tenants) - add the buyer there first, with their ID and TRN.</div>
        </div>
        <div class="col-md-3">
            <label class="form-label">Contract date</label>
            <input type="date" name="contractDate" id="contractDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" required />
        </div>
        <div class="col-md-3">
            <label class="form-label">Sale price (before VAT)</label>
            <input type="number" step="0.01" min="0.01" name="salePrice" id="salePrice" class="form-control" required />
        </div>
        <div class="col-md-6">
            <label class="form-label">VAT treatment</label>
            <div class="form-control bg-light" id="vatBox" style="min-height: 38px;">Choose the unit and price.</div>
        </div>
        <div class="col-12">
            <label class="form-label">Notes</label>
            <input type="text" name="notes" class="form-control" maxlength="1000" />
        </div>
    </div>

    <h5 class="mt-4">Payment Plan <span class="small text-muted">(amounts include VAT; they must add up to the price including VAT)</span></h5>
    <table class="table table-sm table-bordered" style="max-width: 820px;">
        <thead><tr><th>Description</th><th style="width: 180px;">Due date</th><th class="text-end" style="width: 200px;">Amount</th></tr></thead>
        <tbody>
            @{
                var defaults = new[] { ("Down payment", 0), ("During construction", 6), ("During construction", 12), ("On handover", 18), ("", 0), ("", 0) };
            }
            @for (var i = 0; i < defaults.Length; i++)
            {
                <tr>
                    <td><input type="text" name="planDescription" value="@defaults[i].Item1" class="form-control form-control-sm" maxlength="150" /></td>
                    <td><input type="date" name="planDueDate" value="@(defaults[i].Item1 == "" ? "" : DateTime.Today.AddMonths(defaults[i].Item2).ToString("yyyy-MM-dd"))" class="form-control form-control-sm" /></td>
                    <td><input type="number" step="0.01" min="0" name="planAmount" class="form-control form-control-sm text-end plan-amount" /></td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="fw-bold"><td colspan="2">Plan total <span class="text-muted fw-normal" id="planCheck"></span></td><td class="text-end" id="planTotal">0.00</td></tr>
        </tfoot>
    </table>
    <p class="small text-muted">Leave the plan empty for a single payment of the full price on the contract date. <button type="button" class="btn btn-link btn-sm p-0" id="split">Split 20 / 30 / 30 / 20</button></p>

    <button type="submit" class="btn btn-dark">Sign Contract</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <script>
        (function () {
            var unit = document.getElementById('unitId'), date = document.getElementById('contractDate'), price = document.getElementById('salePrice');
            var box = document.getElementById('vatBox'), rate = 0;

            function total() { return Math.round((parseFloat(price.value) || 0) * (100 + rate)) / 100; }

            function check() {
                var sum = 0;
                document.querySelectorAll('.plan-amount').forEach(function (i) { sum += parseFloat(i.value) || 0; });
                document.getElementById('planTotal').textContent = sum.toFixed(2);
                var t = total();
                document.getElementById('planCheck').textContent = sum === 0 ? '' : (Math.abs(sum - t) < 0.005 ? '- matches' : '- price incl. VAT is ' + t.toFixed(2));
            }

            function preview() {
                if (!unit.value) { box.textContent = 'Choose the unit and price.'; return; }
                fetch('@Url.Action("VatPreview")?unitId=' + unit.value + '&contractDate=' + date.value)
                    .then(function (r) { return r.json(); })
                    .then(function (d) {
                        rate = d.rate;
                        box.textContent = d.reason + (price.value ? ' Price incl. VAT: ' + total().toFixed(2) : '');
                        check();
                    });
            }

            document.getElementById('split').addEventListener('click', function () {
                var t = total(), parts = [0.2, 0.3, 0.3], amounts = document.querySelectorAll('.plan-amount'), used = 0;
                parts.forEach(function (p, i) { var a = Math.round(t * p * 100) / 100; amounts[i].value = a.toFixed(2); used += a; });
                amounts[3].value = (Math.round((t - used) * 100) / 100).toFixed(2);
                check();
            });

            unit.addEventListener('change', preview); date.addEventListener('change', preview);
            price.addEventListener('input', preview);
            document.querySelectorAll('.plan-amount').forEach(function (i) { i.addEventListener('input', check); });
        })();
    </script>
}
