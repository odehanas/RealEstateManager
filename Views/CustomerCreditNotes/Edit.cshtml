@model RealEstateManager.Models.CreditNoteEditViewModel
@using RealEstateManager.Domain
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New Credit Note" : $"Credit Note {Model.CreditNoteNumber}";
    var taxable = VatCategories.IsTaxable(Model.VatCategory);
    var rate = taxable ? Model.VatRate : 0m;
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h2 class="mb-1">@(isNew ? "New Credit Note" : $"Credit Note {Model.CreditNoteNumber}")</h2>
        <p class="text-muted mb-0">
            Against invoice <strong>@(Model.TaxInvoiceNumber ?? Model.InvoiceNumber)</strong> of @Model.InvoiceDate.ToString("dd MMM yyyy")
            &mdash; @Model.TenantName, @Model.PropertyUnit, contract @Model.ContractNumber.
        </p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">@T["Back"]</a>
</div>

@if (EInvoiceStatuses.IsLocked(Model.InvoiceEInvoiceStatus))
{
    <div class="alert alert-info py-2">
        @T["This invoice has been reported through e-invoicing. The credit note will be e-invoiced too once posted."]
    </div>
}

<div class="row g-4">
    <div class="col-lg-8">
        <form asp-action="@(isNew ? "Create" : "Edit")" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CustomerInvoiceId" />

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="CreditNoteDate" class="form-label">@T["Credit note date"]</label>
                            <input asp-for="CreditNoteDate" type="date" class="form-control" />
                            <div class="form-text">@T["Decides the VAT return the reduction falls in."]</div>
                        </div>

                        <div class="col-md-8">
                            <label asp-for="ReasonCode" class="form-label">@T["Reason"]</label>
                            <select asp-for="ReasonCode" class="form-select">
                                @foreach (var reason in CreditNoteReasons.ForLeases)
                                {
                                    <option value="@reason.Key">@reason.Value</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Reason" class="form-label">@T["Explanation (printed on the credit note)"]</label>
                            <input asp-for="Reason" class="form-control" maxlength="500"
                                   placeholder="@T["e.g. Lease terminated on 31 March 2027 by mutual agreement - April rent cancelled"]" />
                        </div>

                        <div class="col-md-12">
                            <div class="form-check">
                                <input asp-for="CreditFullOutstanding" class="form-check-input" type="checkbox" id="fullCredit" />
                                <label class="form-check-label" for="fullCredit">
                                    Credit everything still outstanding (@Model.Outstanding.ToString("N2"))
                                </label>
                            </div>
                        </div>

                        <div class="col-md-4" id="netBox">
                            <label asp-for="NetAmount" class="form-label">@T["Net amount to credit"]</label>
                            <input asp-for="NetAmount" type="number" step="0.01" min="0" class="form-control text-end" id="netAmount" />
                        </div>

                        <div class="col-md-8">
                            <label asp-for="DebitAccountId" class="form-label">@T["Reverse into account"]</label>
                            <select asp-for="DebitAccountId" class="form-select">
                                <option value="">Same account as the invoice (@Model.DefaultAccountName)</option>
                                @foreach (var account in Model.Accounts)
                                {
                                    <option value="@account.Value">@account.Text</option>
                                }
                            </select>
                            <div class="form-text">
                                @T["Leave as it is to reverse the invoice exactly. Choose a revenue account for a discount on rent already recognised."]
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-outline-dark">@T["Save as Draft"]</button>
                <button type="submit" name="PostNow" value="true" class="btn btn-dark">@T["Save & Post"]</button>
            </div>
        </form>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header bg-light">@T.Html("<strong>The invoice</strong>")</div>
            <div class="card-body small">
                <div class="d-flex justify-content-between"><span>@T["Net"]</span><span>@Model.InvoiceSubtotal.ToString("N2")</span></div>
                <div class="d-flex justify-content-between"><span>VAT &mdash; @VatCategories.Describe(Model.VatCategory)</span><span>@Model.InvoiceVat.ToString("N2")</span></div>
                <div class="d-flex justify-content-between fw-semibold border-top pt-1"><span>@T["Total"]</span><span>@Model.InvoiceTotal.ToString("N2")</span></div>
                <div class="d-flex justify-content-between text-muted"><span>@T["Paid or credited"]</span><span>@Model.AlreadySettled.ToString("N2")</span></div>
                <div class="d-flex justify-content-between fw-semibold"><span>@T["Outstanding"]</span><span>@Model.Outstanding.ToString("N2")</span></div>
            </div>
            <div class="card-header bg-light border-top">@T.Html("<strong>This credit note</strong>")</div>
            <div class="card-body small">
                <div class="d-flex justify-content-between"><span>@T["Net"]</span><span id="pNet">-</span></div>
                <div class="d-flex justify-content-between"><span>@T["VAT reversed"]</span><span id="pVat">-</span></div>
                <div class="d-flex justify-content-between fw-semibold border-top pt-1"><span>@T["Total credited"]</span><span id="pTotal">-</span></div>
                <div class="text-muted mt-2">@T["Amounts already paid cannot be credited — they are refunded."]</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var rate = @rate.ToString(System.Globalization.CultureInfo.InvariantCulture) / 100;
            var outstanding = @Model.Outstanding.ToString(System.Globalization.CultureInfo.InvariantCulture);
            var full = document.getElementById('fullCredit'), net = document.getElementById('netAmount'), box = document.getElementById('netBox');
            function round(v) { return Math.round((v + Number.EPSILON) * 100) / 100; }
            function fmt(v) { return v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
            function update() {
                box.style.display = full.checked ? 'none' : '';
                var n = full.checked ? round(outstanding / (1 + rate)) : (parseFloat(net.value) || 0);
                var v = round(n * rate);
                if (full.checked) { v = round(outstanding - n); }
                document.getElementById('pNet').textContent = fmt(n);
                document.getElementById('pVat').textContent = fmt(v);
                document.getElementById('pTotal').textContent = fmt(n + v);
            }
            full.addEventListener('change', update);
            net.addEventListener('input', update);
            update();
        })();
    </script>
}
