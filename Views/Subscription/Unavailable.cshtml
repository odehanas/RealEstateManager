@{
    ViewData["Title"] = T["Temporarily Unavailable"];
}

<div class="card shadow-sm mx-auto mt-4" style="max-width:520px">
    <div class="card-body p-4 text-center">
        <h1 class="h5 mb-3">@T["The system is temporarily unavailable"]</h1>
        <p class="text-muted mb-4">
            @T["Your company's subscription needs renewing before jobs can be opened. This is not a problem with your account."]
        </p>
        <p class="text-muted small mb-4">
            @T["Please tell your manager or the company's administrator."]
        </p>
        <form asp-controller="Auth" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-secondary btn-sm">@T["Sign out"]</button>
        </form>
    </div>
</div>
