@model List<RealEstateManager.Domain.PayrollRunLine>
@{
    Layout = "_SelfServiceLayout";
    ViewData["Title"] = T["Payslips"];
}

<h1 class="h5 mb-3">@T["My payslips"]</h1>
@if (Model.Count == 0)
{
    <div class="card shadow-sm"><div class="card-body text-muted">@T["Your payslips appear here once a payroll is approved."]</div></div>
}
else
{
    <div class="list-group shadow-sm">
        @foreach (var l in Model)
        {
            <a asp-action="Payslip" asp-route-id="@l.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                <span><strong>@l.PayrollRun!.PeriodStart.ToString("MMMM yyyy")</strong><br /><span class="small text-muted">@l.PayrollRun.Status</span></span>
                <span class="fw-bold">@l.Net.ToString("N2")</span>
            </a>
        }
    </div>
}
