@{
    ViewData["Title"] = T["Apply Advance to Bills"];
    var vendors = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Vendors;
    int? vendorId = ViewBag.VendorId;
    int? advanceId = ViewBag.AdvanceId;
}
<style>
    .aa td, .aa th { font-size: .88rem; vertical-align: middle; }
    .aa input.amount { max-width: 140px; text-align: right; margin-left: auto; }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">@T["Apply Advance to Bills"]</h2>
        <div class="text-muted">@T["Settle a vendor's open bills from an advance already paid (SAP F-54): Dr Accounts Payable, Cr 11550 Advances to Suppliers. No money moves; a clearing document number is given."]</div>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">@T["Back"]</a>
</div>

@if (TempData["PaymentError"] is string err) { <div class="alert alert-danger">@err</div> }

<form asp-action="ApplyAdvance" method="post" id="aaForm">
    @Html.AntiForgeryToken()
    <div class="card shadow-sm mb-3">
        <div class="card-body row g-3">
            <div class="col-md-5">
                <label class="form-label fw-semibold" for="vendorId">@T["Vendor"]</label>
                <select name="vendorId" id="vendorId" class="form-select">
                    <option value="0">@T["Choose the vendor…"]</option>
                    @foreach (var v in vendors) { <option value="@v.Value" selected="@(v.Value == vendorId?.ToString() ? "selected" : null)">@v.Text</option> }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold" for="advanceId">@T["Advance to apply"]</label>
                <select name="advanceId" id="advanceId" class="form-select"></select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold" for="clearingDate">@T["Clearing date"]</label>
                <input type="date" name="clearingDate" id="clearingDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3 aa">
        <div class="card-header bg-light d-flex justify-content-between"><h5 class="mb-0">@T["Open bills"]</h5><span class="small text-muted" id="note"></span></div>
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead class="table-light"><tr><th style="width:36px"></th><th>@T["Bill"]</th><th>@T["Supplier ref"]</th><th>@T["Due"]</th><th class="text-end">@T["Open"]</th><th class="text-end" style="width:160px">@T["Settle from advance"]</th></tr></thead>
                <tbody id="body"></tbody>
            </table>
        </div>
        <div class="card-body d-flex justify-content-between">
            <span>Advance left: <strong id="left">0.00</strong></span>
            <span>Applying: <strong id="applying">0.00</strong></span>
        </div>
    </div>

    <button type="submit" class="btn btn-dark">@T["Apply and Post"]</button>
</form>

@section Scripts {
<script>
(function () {
    var vendor = document.getElementById('vendorId');
    var adv = document.getElementById('advanceId');
    var body = document.getElementById('body');
    var note = document.getElementById('note');
    var wantAdvance = @(advanceId?.ToString() ?? "null");
    var advances = [];
    function fmt(n) { return Number(n || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
    function cell(tr, t, c) { var td = document.createElement('td'); if (c) { td.className = c; } td.textContent = t; tr.appendChild(td); }

    function recalc() {
        var a = advances.find(function (x) { return String(x.paymentId) === adv.value; });
        var left = a ? a.open : 0, sum = 0;
        body.querySelectorAll('tr').forEach(function (tr) {
            var box = tr.querySelector('input[type=checkbox]'), amt = tr.querySelector('input.amount');
            amt.disabled = !box.checked;
            if (box.checked) { sum += parseFloat(amt.value) || 0; }
        });
        document.getElementById('left').textContent = fmt(left);
        var applying = document.getElementById('applying');
        applying.textContent = fmt(sum);
        applying.className = sum > left + 0.001 ? 'text-danger' : '';
    }

    function load() {
        body.innerHTML = ''; adv.innerHTML = ''; advances = [];
        if (!vendor.value || vendor.value === '0') { note.textContent = 'Choose a vendor.'; recalc(); return; }
        fetch('/VendorPayments/OpenItems?vendorId=' + vendor.value, { credentials: 'same-origin' })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                advances = data.advances;
                if (!advances.length) { adv.appendChild(new Option('No open advances', '')); }
                advances.forEach(function (a) {
                    var o = new Option(a.paymentNumber + ' - ' + fmt(a.open) + ' open', a.paymentId);
                    if (wantAdvance === a.paymentId) { o.selected = true; }
                    adv.appendChild(o);
                });
                var i = 0;
                data.bills.filter(function (b) { return b.open > 0; }).forEach(function (b) {
                    var tr = document.createElement('tr');
                    var td = document.createElement('td'); var box = document.createElement('input'); box.type = 'checkbox'; box.className = 'form-check-input'; td.appendChild(box); tr.appendChild(td);
                    cell(tr, b.billNumber); cell(tr, b.vendorReference || ''); cell(tr, b.dueDate.substring(0, 10)); cell(tr, fmt(b.open), 'text-end');
                    var p = document.createElement('td'); p.className = 'text-end';
                    var id = document.createElement('input'); id.type = 'hidden'; id.name = 'allocations[' + i + '].BillId'; id.value = b.billId;
                    var amt = document.createElement('input'); amt.type = 'number'; amt.step = '0.01'; amt.min = '0'; amt.max = b.open; amt.value = b.open.toFixed(2);
                    amt.className = 'form-control form-control-sm amount'; amt.name = 'allocations[' + i + '].Amount';
                    p.appendChild(id); p.appendChild(amt); tr.appendChild(p);
                    box.addEventListener('change', recalc); amt.addEventListener('input', recalc);
                    body.appendChild(tr); i++;
                });
                note.textContent = i === 0 ? 'No open bills.' : i + ' open bill(s).';
                recalc();
            });
    }
    vendor.addEventListener('change', function () { wantAdvance = null; load(); });
    adv.addEventListener('change', recalc);
    load();
})();
</script>
}
