@model IEnumerable<RealEstateManager.Domain.VendorPayment>
@using RealEstateManager.Domain
@{
    ViewData["Title"] = T["Vendor Payments"];
    var bills = (Dictionary<int, string>)ViewBag.Bills;
    var applications = (List<VendorClearing>)ViewBag.Applications;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="mb-0">@T["Vendor Payments"]</h2>
        <div class="text-muted">@T["Payments of open bills (each with its clearing document), advances paid before a bill, and advances applied to bills."]</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ApplyAdvance" class="btn btn-outline-dark">@T["Apply advance to bills"]</a>
        <a asp-action="Create" asp-route-advance="true" class="btn btn-outline-dark">@T["Pay an advance"]</a>
        <a asp-action="Create" class="btn btn-dark">@T["New Vendor Payment"]</a>
    </div>
</div>

@if (TempData["PaymentSuccess"] is string ok) { <div class="alert alert-success">@ok</div> }

<table class="table table-bordered table-striped table-sm align-middle">
    <thead class="table-light">
        <tr><th>@T["Payment"]</th><th>@T["Date"]</th><th>@T["Vendor"]</th><th>@T["Type"]</th><th>@T["Clearing document"]</th><th>@T["Bills settled"]</th><th>@T["Method / ref."]</th><th class="text-end">@T["Amount"]</th><th class="text-end">@T["Advance open"]</th><th>@T["Status"]</th></tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        var posted = p.JournalEntry?.IsPosted == true;
        <tr>
            <td><a asp-action="Details" asp-route-id="@p.Id">@p.PaymentNumber</a></td>
            <td>@p.PaymentDate.ToString("dd/MM/yyyy")</td>
            <td>@(p.Vendor?.Name ?? p.VendorBill?.Vendor?.Name)</td>
            <td>@(p.IsAdvance ? "Advance" : "Payment")</td>
            <td>@p.ClearingNumber</td>
            <td class="small">@(bills.TryGetValue(p.Id, out var b) ? b : p.VendorBill?.BillNumber)</td>
            <td class="small">@p.PaymentMethod @p.Reference</td>
            <td class="text-end">@p.Amount.ToString("N2")</td>
            <td class="text-end">@(p.IsAdvance ? p.AdvanceOpen.ToString("N2") : "")</td>
            <td>@if (posted) { <span class="badge bg-success">@T["Posted"]</span> } else { <span class="badge bg-warning text-dark">@T["Awaiting approval / draft"]</span> }</td>
        </tr>
    }
    </tbody>
</table>

@if (applications.Count > 0)
{
    <h4 class="mt-4">@T["Advances applied to bills"]</h4>
    <table class="table table-bordered table-sm align-middle">
        <thead class="table-light"><tr><th>@T["Clearing document"]</th><th>@T["Date"]</th><th>@T["Vendor"]</th><th>@T["Advance"]</th><th>@T["Bills settled"]</th><th class="text-end">@T["Amount"]</th><th>@T["Status"]</th></tr></thead>
        <tbody>
        @foreach (var c in applications)
        {
            <tr>
                <td>@c.ClearingNumber</td><td>@c.ClearingDate.ToString("dd/MM/yyyy")</td><td>@c.Vendor?.Name</td>
                <td><a asp-action="Details" asp-route-id="@c.AdvancePaymentId">@c.AdvancePayment?.PaymentNumber</a></td>
                <td class="small">@string.Join(", ", c.Lines.Select(l => l.VendorBill?.BillNumber))</td>
                <td class="text-end">@c.Amount.ToString("N2")</td><td>@c.Status</td>
            </tr>
        }
        </tbody>
    </table>
}
