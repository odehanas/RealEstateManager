@model RealEstateManager.Models.ServiceRequestDetailViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using RealEstateManager.Domain
@{
    ViewData["Title"] = Model.RequestNumber;

    var staffUsers = ViewBag.StaffUsers as List<SelectListItem> ?? new List<SelectListItem>();
    var priorities = ViewBag.Priorities as List<SelectListItem> ?? new List<SelectListItem>();

    var isFinished = Model.Status == ServiceRequestStatuses.Closed
                     || Model.Status == ServiceRequestStatuses.Cancelled;
}

@if (TempData["RequestSuccess"] != null)
{
    <div class="alert alert-success">@TempData["RequestSuccess"]</div>
}
@if (TempData["RequestError"] != null)
{
    <div class="alert alert-danger">@TempData["RequestError"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">
            @Model.RequestNumber
            <span class="badge @ServiceRequestStatuses.BadgeClass(Model.Status) align-middle">
                @ServiceRequestStatuses.Describe(Model.Status)
            </span>
        </h2>
        <p class="text-muted mb-0">
            @ServiceRequestTypes.Describe(Model.RequestType)
            @if (!string.IsNullOrWhiteSpace(Model.Category))
            {
                <text>&middot; @Model.Category</text>
            }
        </p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">@T["Back to queue"]</a>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <h3 class="h6">@Model.Subject</h3>
                <p class="mb-0" style="white-space: pre-wrap">@Model.Description</p>

                @if (Model.PreferredVisitDate.HasValue)
                {
                    <div class="small text-muted mt-2">
                        @T.HtmlFormat("Tenant's preferred visit date: <strong>{0}</strong>", Model.PreferredVisitDate.Value.ToString("dd/MM/yyyy"))
                    </div>
                }
            </div>
        </div>

        @* ----------------------------------------------------------------
           Payment postponement. Agreeing and actually moving the date are
           two separate decisions, so they are two separate actions.
           ---------------------------------------------------------------- *@
        @if (Model.RequestType == ServiceRequestTypes.PaymentPostponement && Model.RelatedInvoiceNumber != null)
        {
            <div class="card shadow-sm mb-3 border-warning">
                <div class="card-header bg-white">@T.Html("<strong>Payment postponement</strong>")</div>
                <div class="card-body">
                    <div class="row small mb-3">
                        <div class="col-6 col-md-3">
                            <div class="text-muted">@T["Invoice"]</div>
                            <div class="fw-bold">@Model.RelatedInvoiceNumber</div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-muted">@T["Outstanding"]</div>
                            <div class="fw-bold">@Model.RelatedInvoiceOutstanding?.ToString("N2")</div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-muted">@T["Current due date"]</div>
                            <div class="fw-bold">@Model.RelatedInvoiceDueDate?.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-muted">@T["Requested"]</div>
                            <div class="fw-bold">@Model.RequestedNewDueDate?.ToString("dd/MM/yyyy")</div>
                        </div>
                    </div>

                    @if (Model.PostponementApplied)
                    {
                        <div class="alert alert-success mb-0 small">
                            @T.HtmlFormat("<strong>Applied.</strong> The invoice due date was moved on {0}. The invoice amount, its VAT and its journal were not touched.", Model.PostponementAppliedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
                        </div>
                    }
                    else if (Model.AwaitingPostponementAction)
                    {
                        <form asp-action="ApplyPostponement" asp-route-id="@Model.Id" method="post"
                              onsubmit="return confirm('Move the due date on @Model.RelatedInvoiceNumber to @Model.RequestedNewDueDate?.ToString("dd/MM/yyyy")?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-warning">
                                @T.Format("Apply new due date to {0}", Model.RelatedInvoiceNumber)
                            </button>
                            <div class="form-text">
                                @T["Changes only the invoice's due date, which is what drives chasing and the ageing report. The amount owed, the VAT and the journal entry are untouched — granting more time to pay is not a credit note."]
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-secondary mb-0 small">
                            @T.Html("Mark the request <strong>Resolved</strong> once you have agreed terms with the tenant. The button to move the invoice due date appears after that.")
                        </div>
                    }
                </div>
            </div>
        }

        @* ---- Conversation ---- *@
        <div class="card shadow-sm">
            <div class="card-header bg-white">@T.Html("<strong>Conversation</strong>")</div>
            <div class="card-body">
                @if (Model.Comments.Count == 0)
                {
                    <p class="text-muted small mb-0">@T["No messages yet."]</p>
                }
                else
                {
                    foreach (var comment in Model.Comments)
                    {
                        <div class="mb-3 p-2 rounded @(comment.IsInternal ? "bg-warning-subtle border border-warning" : comment.IsFromTenant ? "bg-light" : "border")">
                            <div class="small text-muted mb-1">
                                <strong>@comment.AuthorName</strong>
                                <span class="badge bg-secondary">@comment.AuthorType</span>
                                @if (comment.IsInternal)
                                {
                                    <span class="badge bg-warning text-dark">@T["Internal — tenant cannot see this"]</span>
                                }
                                &middot; @comment.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </div>
                            <div style="white-space: pre-wrap">@comment.Body</div>
                        </div>
                    }
                }
            </div>

            <div class="card-footer bg-white">
                <form asp-action="AddComment" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <textarea name="body" class="form-control" rows="3" maxlength="4000" required
                                  placeholder="@T["Write a reply..."]"></textarea>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="isInternal" value="true" id="isInternal" />
                            <input type="hidden" name="isInternal" value="false" />
                            <label class="form-check-label small" for="isInternal">
                                @T.Html("Internal note &mdash; the tenant will <strong>not</strong> see this")
                            </label>
                        </div>
                        <button type="submit" class="btn btn-dark btn-sm">@T["Post"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white">@T.Html("<strong>Tenant</strong>")</div>
            <div class="card-body small">
                <div class="fw-bold">@Model.TenantName</div>
                <div class="text-muted">@Model.TenantCode</div>
                @if (!string.IsNullOrWhiteSpace(Model.TenantEmail))
                {
                    <div class="mt-2">@Model.TenantEmail</div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.TenantPhone))
                {
                    <div>@Model.TenantPhone</div>
                }
                <hr />
                <div class="d-flex justify-content-between">
                    <span class="text-muted">@T["Property"]</span>
                    <span>@(Model.PropertyName ?? "—")</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">@T["Unit"]</span>
                    <span>@(Model.UnitDisplay ?? "—")</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">@T["Contract"]</span>
                    <span>@(Model.ContractNumber ?? "—")</span>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white">@T.Html("<strong>History</strong>")</div>
            <div class="card-body small">
                <div class="d-flex justify-content-between">
                    <span class="text-muted">@T["Submitted"]</span>
                    <span>@Model.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                @if (Model.AcknowledgedAt.HasValue)
                {
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">@T["Acknowledged"]</span>
                        <span>@Model.AcknowledgedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                }
                @if (Model.ResolvedAt.HasValue)
                {
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">@T["Resolved"]</span>
                        <span>@Model.ResolvedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                }
                @if (Model.ClosedAt.HasValue)
                {
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">@T["Closed"]</span>
                        <span>@Model.ClosedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                }
            </div>
        </div>

        @if (!isFinished)
        {
            <div class="card shadow-sm">
                <div class="card-header bg-white">@T.Html("<strong>Update</strong>")</div>
                <div class="card-body">
                    <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-2">
                            <label class="form-label small mb-1" for="status">@T["Status"]</label>
                            <select class="form-select form-select-sm" id="status" name="status">
                                @foreach (var status in new[]
                                {
                                    ServiceRequestStatuses.Acknowledged,
                                    ServiceRequestStatuses.InProgress,
                                    ServiceRequestStatuses.Resolved,
                                    ServiceRequestStatuses.Rejected,
                                    ServiceRequestStatuses.Closed
                                })
                                {
                                    <option value="@status" selected="@(status == Model.Status ? "selected" : null)">
                                        @ServiceRequestStatuses.Describe(status)
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-2">
                            <label class="form-label small mb-1" for="priority">@T["Priority"]</label>
                            <select class="form-select form-select-sm" id="priority" name="priority">
                                @foreach (var priority in priorities)
                                {
                                    <option value="@priority.Value" selected="@(priority.Value == Model.Priority ? "selected" : null)">
                                        @priority.Text
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-2">
                            <label class="form-label small mb-1" for="assignedToAppUserId">@T["Assigned to"]</label>
                            <select class="form-select form-select-sm" id="assignedToAppUserId" name="assignedToAppUserId">
                                <option value="">@T["-- nobody --"]</option>
                                @foreach (var user in staffUsers)
                                {
                                    <option value="@user.Value" selected="@(user.Value == Model.AssignedToAppUserId?.ToString() ? "selected" : null)">
                                        @user.Text
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-2">
                            <label class="form-label small mb-1" for="resolutionNotes">
                                @T["Response to the tenant"]
                            </label>
                            <textarea class="form-control form-control-sm" id="resolutionNotes"
                                      name="resolutionNotes" rows="4" maxlength="4000"
                                      placeholder="@T["Required when resolving or declining. The tenant reads this."]">@Model.ResolutionNotes</textarea>
                        </div>

                        <button type="submit" class="btn btn-dark btn-sm w-100">@T["Save update"]</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
