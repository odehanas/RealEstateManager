@model IEnumerable<RealEstateManager.Domain.Property>
@inject PermissionService PermissionService

@{
    ViewData["Title"] = T["Properties"];

    // Master data is centralised - most users may look it up but not change it.
    var canEdit = await PermissionService.HasPermissionAsync(User, AppPermissions.MasterDataManage);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@T["Properties"]</h2>
    @if (canEdit)
    {
        <a asp-controller="Properties" asp-action="Create" class="btn btn-dark">@T["Add Property"]</a>
    }
</div>

@if (!canEdit)
{
    <div class="alert alert-secondary py-2 small">
        @T["You have read-only access to master data. Contact the master data owner to add or amend a property."]
    </div>
}

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>@T["Code"]</th>
            <th>@T["Name"]</th>
            <th>@T["Type"]</th>
            <th>@T["Ownership"]</th>
            <th>@T["Owner"]</th>
            <th>@T["Emirate"]</th>
            <th>@T["Title Deed"]</th>
            <th class="text-end">@T["Asset Value"]</th>
            <th class="text-end">@T["Commission %"]</th>
            <th>@T["Status"]</th>
            <th>@T["Actions"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Code</td>
                <td>@item.Name</td>
                <td>@item.PropertyType</td>
                <td>@item.OwnershipType</td>
                <td>@item.OwnerName</td>
                <td>@item.Emirate</td>
                <td>@item.TitleDeedNumber</td>
                <td class="text-end">@item.AssetValue.ToString("N2")</td>
                <td class="text-end">@item.CommissionPercentage.ToString("N2")</td>
                <td>@(item.IsActive ? "Active" : "Inactive")</td>
                <td class="text-nowrap">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark">@T["View"]</a>
                    @if (canEdit)
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">@T["Edit"]</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>