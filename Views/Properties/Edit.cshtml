@model RealEstateManager.Domain.Property

@{
    ViewData["Title"] = "Edit Property";
}

<h2>Edit Property</h2>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-3">
            <label asp-for="Code" class="form-label"></label>
            <input asp-for="Code" class="form-control" />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>

        <div class="col-md-9">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control" />
        </div>

        <div class="col-md-3">
            <label asp-for="PropertyType" class="form-label"></label>
            <select asp-for="PropertyType" class="form-select">
                <option value="">Select</option>
                <option>Residential</option>
                <option>Commercial</option>
                <option>Warehouse</option>
                <option>MixedUse</option>
            </select>
        </div>

        <div class="col-md-3">
            <label asp-for="OwnershipType" class="form-label"></label>
            <select asp-for="OwnershipType" class="form-select">
                <option>Owned</option>
                <option>Managed</option>
            </select>
        </div>

        <div class="col-md-3">
            <label asp-for="VatCategory" class="form-label">VAT Treatment</label>
            <select asp-for="VatCategory" class="form-select">
                <option value="Standard">Standard rated (5%)</option>
                <option value="Exempt">Exempt</option>
                <option value="ZeroRated">Zero rated (0%)</option>
            </select>
            <div class="form-text">
                Changing this affects <strong>new</strong> leases only. Invoices already issued keep the
                treatment they were raised under.
            </div>
        </div>

        <div class="col-md-4">
            <label asp-for="OwnerName" class="form-label"></label>
            <input asp-for="OwnerName" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="OwnerTrn" class="form-label">Owner TRN</label>
            <input asp-for="OwnerTrn" class="form-control" maxlength="20" />
            <div class="form-text">Managed properties only, if the owner is VAT registered. Printed on our commission tax invoice.</div>
        </div>

        <div class="col-md-4">
            <label asp-for="AssetValue" class="form-label"></label>
            <input asp-for="AssetValue" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="CommissionPercentage" class="form-label"></label>
            <input asp-for="CommissionPercentage" class="form-control" />
        </div>

        <div class="col-md-3">
            <div class="form-check mt-4">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
        </div>
    </div>

    <partial name="_RegistrationFields" model="Model" />

    <div class="mt-4">
        <button type="submit" class="btn btn-dark">Save</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Back</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}