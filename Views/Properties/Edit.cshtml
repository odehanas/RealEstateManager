@model RealEstateManager.Domain.Property

@{
    ViewData["Title"] = T["Edit Property"];
}

<h2>@T["Edit Property"]</h2>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-3">
            <label asp-for="Code" class="form-label"></label>
            <input asp-for="Code" class="form-control" />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>

        <div class="col-md-9">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control" />
        </div>

        <div class="col-md-3">
            <label asp-for="PropertyType" class="form-label"></label>
            <select asp-for="PropertyType" class="form-select">
                <option value="">@T["Select"]</option>
                <option value="Residential">@T["Residential"]</option>
                <option value="Commercial">@T["Commercial"]</option>
                <option value="Warehouse">@T["Warehouse"]</option>
                <option value="MixedUse">@T["MixedUse"]</option>
            </select>
        </div>

        <div class="col-md-3">
            <label asp-for="OwnershipType" class="form-label"></label>
            <select asp-for="OwnershipType" class="form-select">
                <option value="Owned">@T["Owned"]</option>
                <option value="Managed">@T["Managed"]</option>
            </select>
        </div>

        <div class="col-md-3">
            <label asp-for="VatCategory" class="form-label">@T["VAT Treatment"]</label>
            <select asp-for="VatCategory" class="form-select">
                <option value="Standard">@T["Standard rated (5%)"]</option>
                <option value="Exempt">@T["Exempt"]</option>
                <option value="ZeroRated">@T["Zero rated (0%)"]</option>
            </select>
            <div class="form-text">
                @T.Html("Changing this affects <strong>new</strong> leases only. Invoices already issued keep the treatment they were raised under.")
            </div>
        </div>

        <div class="col-md-4">
            <label asp-for="OwnerName" class="form-label"></label>
            <input asp-for="OwnerName" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="OwnerTrn" class="form-label">@T["Owner TRN"]</label>
            <input asp-for="OwnerTrn" class="form-control" maxlength="20" />
            <div class="form-text">@T["Managed properties only, if the owner is VAT registered. Printed on our commission tax invoice."]</div>
        </div>

        <div class="col-md-8">
            <div class="form-check mt-md-4">
                <input asp-for="RentBilledInOwnerName" class="form-check-input" type="checkbox" />
                <label asp-for="RentBilledInOwnerName" class="form-check-label">@T["Invoice tenants in the owner's name (we act as the owner's agent)"]</label>
            </div>
            <div class="form-text">
                @T["Managed properties only. Rent invoices show the owner as supplier with the owner's TRN; when the owner has no TRN no VAT is charged. The rent VAT is the owner's and stays off our VAT return; our commission is invoiced to the owner under our TRN. Applies to contracts and invoices posted after it is switched on."]
            </div>
        </div>

        <div class="col-md-4">
            <label asp-for="AssetValue" class="form-label"></label>
            <input asp-for="AssetValue" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="CommissionPercentage" class="form-label"></label>
            <input asp-for="CommissionPercentage" class="form-control" />
        </div>

        <div class="col-md-3">
            <div class="form-check mt-4">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
        </div>
    </div>

    <partial name="_RegistrationFields" model="Model" />

    <div class="mt-4">
        <button type="submit" class="btn btn-dark">@T["Save"]</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">@T["Back"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}