@model RealEstateManager.Domain.Property
@using RealEstateManager.Domain

@* Registration details: shared by Create and Edit. Everything here is optional - fill in what
   the title deed, affection plan and permits show. *@

<h5 class="mt-4 mb-2">Location</h5>
<div class="row g-3">
    <div class="col-md-3">
        <label asp-for="Emirate" class="form-label"></label>
        <select asp-for="Emirate" class="form-select">
            <option value="">--</option>
            @foreach (var emirate in PropertyRegistrationLists.Emirates)
            {
                <option value="@emirate">@emirate</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label asp-for="AreaName" class="form-label"></label>
        <input asp-for="AreaName" class="form-control" maxlength="100" />
    </div>
    <div class="col-md-3">
        <label asp-for="PlotNumber" class="form-label"></label>
        <input asp-for="PlotNumber" class="form-control" maxlength="50" />
    </div>
    <div class="col-md-3">
        <label asp-for="MunicipalityNumber" class="form-label"></label>
        <input asp-for="MunicipalityNumber" class="form-control" maxlength="50" />
    </div>
    <div class="col-md-4">
        <label asp-for="LocationReference" class="form-label"></label>
        <input asp-for="LocationReference" class="form-control" maxlength="50" placeholder="e.g. Makani number" />
    </div>
    <div class="col-md-4">
        <label asp-for="Latitude" class="form-label">Latitude (GPS)</label>
        <input asp-for="Latitude" class="form-control" step="0.000001" placeholder="25.789123" />
    </div>
    <div class="col-md-4">
        <label asp-for="Longitude" class="form-label">Longitude (GPS)</label>
        <input asp-for="Longitude" class="form-control" step="0.000001" placeholder="55.943210" />
    </div>
</div>

<h5 class="mt-4 mb-2">Title Deed &amp; Land</h5>
<div class="row g-3">
    <div class="col-md-3">
        <label asp-for="TitleDeedNumber" class="form-label"></label>
        <input asp-for="TitleDeedNumber" class="form-control" maxlength="50" />
    </div>
    <div class="col-md-3">
        <label asp-for="TitleDeedDate" class="form-label"></label>
        <input asp-for="TitleDeedDate" type="date" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="TitleDeedAuthority" class="form-label"></label>
        <input asp-for="TitleDeedAuthority" class="form-control" maxlength="100" placeholder="Land department or municipality that issued the deed" />
    </div>
    <div class="col-md-3">
        <label asp-for="TenureType" class="form-label"></label>
        <select asp-for="TenureType" class="form-select">
            <option value="">--</option>
            @foreach (var tenure in PropertyRegistrationLists.TenureTypes)
            {
                <option value="@tenure">@tenure</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label asp-for="LandUse" class="form-label"></label>
        <select asp-for="LandUse" class="form-select">
            <option value="">--</option>
            @foreach (var use in PropertyRegistrationLists.LandUses)
            {
                <option value="@use">@use</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label asp-for="PlotAreaSqFt" class="form-label"></label>
        <input asp-for="PlotAreaSqFt" class="form-control" step="0.01" min="0" />
    </div>
    <div class="col-md-3">
        <label asp-for="OwnershipPercentage" class="form-label"></label>
        <input asp-for="OwnershipPercentage" class="form-control" step="0.01" min="0" max="100" placeholder="100" />
    </div>
    <div class="col-md-3">
        <div class="form-check mt-4">
            <input asp-for="IsMortgaged" class="form-check-input" type="checkbox" />
            <label asp-for="IsMortgaged" class="form-check-label">Title is mortgaged</label>
        </div>
    </div>
    <div class="col-md-9">
        <label asp-for="MortgageDetails" class="form-label"></label>
        <input asp-for="MortgageDetails" class="form-control" maxlength="300" placeholder="Lender, mortgage reference, amount" />
    </div>
</div>

<h5 class="mt-4 mb-2">Building &amp; Completion</h5>
<div class="row g-3">
    <div class="col-md-3">
        <label asp-for="BuildingPermitNumber" class="form-label"></label>
        <input asp-for="BuildingPermitNumber" class="form-control" maxlength="50" />
    </div>
    <div class="col-md-3">
        <label asp-for="BuildingPermitDate" class="form-label"></label>
        <input asp-for="BuildingPermitDate" type="date" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="CompletionCertificateNumber" class="form-label"></label>
        <input asp-for="CompletionCertificateNumber" class="form-control" maxlength="50" />
    </div>
    <div class="col-md-3">
        <label asp-for="CompletionDate" class="form-label"></label>
        <input asp-for="CompletionDate" type="date" class="form-control" />
        <div class="form-text">From the completion certificate. Starts the 3-year VAT zero-rating window for new residential units.</div>
    </div>
    <div class="col-md-3">
        <label asp-for="BuiltUpAreaSqFt" class="form-label"></label>
        <input asp-for="BuiltUpAreaSqFt" class="form-control" step="0.01" min="0" />
    </div>
    <div class="col-md-3">
        <label asp-for="NumberOfFloors" class="form-label"></label>
        <input asp-for="NumberOfFloors" class="form-control" min="0" />
    </div>
    <div class="col-md-3">
        <label asp-for="ParkingBays" class="form-label"></label>
        <input asp-for="ParkingBays" class="form-control" min="0" />
    </div>
    <div class="col-md-3"></div>
    <div class="col-md-4">
        <label asp-for="DeveloperName" class="form-label"></label>
        <input asp-for="DeveloperName" class="form-control" maxlength="150" />
    </div>
    <div class="col-md-4">
        <label asp-for="MainContractor" class="form-label"></label>
        <input asp-for="MainContractor" class="form-control" maxlength="150" />
    </div>
    <div class="col-md-4">
        <label asp-for="ConsultantName" class="form-label"></label>
        <input asp-for="ConsultantName" class="form-control" maxlength="150" />
    </div>
</div>

<h5 class="mt-4 mb-2">Utilities &amp; Insurance</h5>
<div class="row g-3">
    <div class="col-md-3">
        <label asp-for="UtilityAccountNumber" class="form-label"></label>
        <input asp-for="UtilityAccountNumber" class="form-control" maxlength="100" />
    </div>
    <div class="col-md-3">
        <label asp-for="Insurer" class="form-label"></label>
        <input asp-for="Insurer" class="form-control" maxlength="150" />
    </div>
    <div class="col-md-3">
        <label asp-for="InsurancePolicyNumber" class="form-label"></label>
        <input asp-for="InsurancePolicyNumber" class="form-control" maxlength="50" />
    </div>
    <div class="col-md-3">
        <label asp-for="InsuranceExpiryDate" class="form-label"></label>
        <input asp-for="InsuranceExpiryDate" type="date" class="form-control" />
    </div>
    <div class="col-12">
        <label asp-for="RegistrationNotes" class="form-label"></label>
        <textarea asp-for="RegistrationNotes" class="form-control" rows="2" maxlength="1000"></textarea>
    </div>
</div>

<h5 class="mt-4 mb-2">Valuation</h5>
<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="FairValue" class="form-label"></label>
        <input asp-for="FairValue" class="form-control" step="0.01" min="0" />
        <div class="form-text">Latest independent valuation. Disclosed in the investment property note, not booked.</div>
    </div>
    <div class="col-md-4">
        <label asp-for="FairValueDate" class="form-label"></label>
        <input asp-for="FairValueDate" type="date" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="ValuerName" class="form-label"></label>
        <input asp-for="ValuerName" class="form-control" maxlength="150" />
    </div>
</div>
