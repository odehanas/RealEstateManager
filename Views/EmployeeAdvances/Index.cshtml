@model RealEstateManager.Models.AdvanceListViewModel

@{
    ViewData["Title"] = T["Salary Advances"];
}

<h2>@T["Salary Advances"]</h2>
<p class="text-muted">@T["Money advanced to staff is an asset (11600 Employee Advances) until the payroll recovers it, one instalment a month."]</p>

@if (TempData["HrSuccess"] is string ok) { <div class="alert alert-success">@ok</div> }
@if (TempData["HrError"] is string err) { <div class="alert alert-danger">@err</div> }

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light"><h5 class="mb-0">@T["Pay an advance"]</h5></div>
    <div class="card-body">
        <form asp-action="Create" method="post" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-3">
                <label class="form-label">@T["Employee"]</label>
                <select asp-for="NewAdvance.EmployeeId" asp-items="Model.Employees" class="form-select"><option value="">@T["Choose"]</option></select>
            </div>
            <div class="col-md-2"><label class="form-label">@T["Date"]</label><input asp-for="NewAdvance.AdvanceDate" type="date" class="form-control" /></div>
            <div class="col-md-2"><label class="form-label">@T["Amount"]</label><input asp-for="NewAdvance.Amount" class="form-control" /></div>
            <div class="col-md-2"><label class="form-label">@T["Monthly recovery"]</label><input asp-for="NewAdvance.MonthlyInstalment" class="form-control" /></div>
            <div class="col-md-3">
                <label class="form-label">@T["Paid from"]</label>
                <select asp-for="NewAdvance.PaidFromAccountId" asp-items="Model.BankAccounts" class="form-select"></select>
            </div>
            <div class="col-md-4"><label class="form-label">@T["Reference"]</label><input asp-for="NewAdvance.Reference" class="form-control" placeholder="@T["Cheque or transfer reference"]" /></div>
            <div class="col-md-6"><label class="form-label">@T["Notes"]</label><input asp-for="NewAdvance.Notes" class="form-control" /></div>
            <div class="col-md-2"><button class="btn btn-dark w-100">@T["Save and Post"]</button></div>
        </form>
    </div>
</div>

<table class="table table-bordered table-striped">
    <thead class="table-light">
        <tr><th>@T["Date"]</th><th>@T["Employee"]</th><th class="text-end">@T["Amount"]</th><th class="text-end">@T["Monthly"]</th><th class="text-end">@T["Recovered"]</th><th class="text-end">@T["Outstanding"]</th><th>@T["Reference"]</th></tr>
    </thead>
    <tbody>
        @if (Model.Advances.Count == 0) { <tr><td colspan="7" class="text-muted">@T["No advances."]</td></tr> }
        @foreach (var a in Model.Advances)
        {
            <tr>
                <td>@a.AdvanceDate.ToString("dd/MM/yyyy")</td>
                <td>@a.Employee?.EmployeeCode @a.Employee?.FullName</td>
                <td class="text-end">@a.Amount.ToString("N2")</td>
                <td class="text-end">@a.MonthlyInstalment.ToString("N2")</td>
                <td class="text-end">@a.RecoveredAmount.ToString("N2")</td>
                <td class="text-end fw-semibold">@a.Outstanding.ToString("N2")</td>
                <td>@a.Reference</td>
            </tr>
        }
    </tbody>
</table>
