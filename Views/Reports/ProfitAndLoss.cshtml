@model RealEstateManager.Services.ProfitAndLossReportDto

@{
    ViewData["Title"] = "Profit and Loss";
    var ledgerFrom = (Model.StartDate).ToString("yyyy-MM-dd");
    var ledgerTo = (Model.EndDate).ToString("yyyy-MM-dd");
    // Every account figure opens the general ledger behind it (drill-down).
    string? LedgerUrl(int accountId) => accountId > 0
        ? Url.Action("GeneralLedger", "Journal", new { accountId, fromDate = ledgerFrom, toDate = ledgerTo, returnUrl = Context.Request.Path + Context.Request.QueryString, returnTo = ViewData["Title"] })
        : null;
    Microsoft.AspNetCore.Html.IHtmlContent Drill(string? url, string text) => new Microsoft.AspNetCore.Html.HtmlString(url == null
        ? System.Net.WebUtility.HtmlEncode(text)
        : $"<a href=\"{System.Net.WebUtility.HtmlEncode(url)}\" class=\"drill\" title=\"Open the general ledger\">{System.Net.WebUtility.HtmlEncode(text)}</a>");
}

<style>
    a.drill { color: inherit; text-decoration: none; border-bottom: 1px dotted #6c757d; }
    a.drill:hover { color: var(--bs-link-color); border-bottom-style: solid; }
</style>

<h2>Profit and Loss</h2>

<form method="get" class="mb-3">
    <label for="asOfDate">As Of Date</label>
    <input type="date" id="asOfDate" name="asOfDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
    <button type="submit">Refresh</button>
</form>

<h4>Revenue</h4>
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Code</th>
            <th>Account</th>
            <th class="text-end">Amount</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model.Revenue)
        {
            <tr>
                <td>@Drill(LedgerUrl(row.AccountId), row.AccountCode)</td>
                <td>@Drill(LedgerUrl(row.AccountId), row.AccountName)</td>
                <td class="text-end">@Drill(LedgerUrl(row.AccountId), row.Amount.ToString("N2"))</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="2">Total Revenue</th>
            <th class="text-end">@Model.TotalRevenue.ToString("N2")</th>
        </tr>
    </tfoot>
</table>

<h4>Expenses</h4>
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Code</th>
            <th>Account</th>
            <th class="text-end">Amount</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model.Expenses)
        {
            <tr>
                <td>@Drill(LedgerUrl(row.AccountId), row.AccountCode)</td>
                <td>@Drill(LedgerUrl(row.AccountId), row.AccountName)</td>
                <td class="text-end">@Drill(LedgerUrl(row.AccountId), row.Amount.ToString("N2"))</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="2">Total Expenses</th>
            <th class="text-end">@Model.TotalExpenses.ToString("N2")</th>
        </tr>
        <tr>
            <th colspan="2">Net Profit / Loss</th>
            <th class="text-end">@Model.NetProfitOrLoss.ToString("N2")</th>
        </tr>
    </tfoot>
</table>