@model RealEstateManager.Services.ProfitAndLossReportDto

@{
    ViewData["Title"] = T["Profit and Loss"];
    var ledgerFrom = (Model.StartDate).ToString("yyyy-MM-dd");
    var ledgerTo = (Model.EndDate).ToString("yyyy-MM-dd");
    // Every account figure opens the general ledger behind it (drill-down).
    string? LedgerUrl(int accountId) => accountId > 0
        ? Url.Action("GeneralLedger", "Journal", new { accountId, fromDate = ledgerFrom, toDate = ledgerTo, returnUrl = Context.Request.Path + Context.Request.QueryString, returnTo = ViewData["Title"] })
        : null;
    Microsoft.AspNetCore.Html.IHtmlContent Drill(string? url, string text) => new Microsoft.AspNetCore.Html.HtmlString(url == null
        ? System.Net.WebUtility.HtmlEncode(text)
        : $"<a href=\"{System.Net.WebUtility.HtmlEncode(url)}\" class=\"drill\" title=\"Open the general ledger\">{System.Net.WebUtility.HtmlEncode(text)}</a>");
}

<style>
    a.drill { color: inherit; text-decoration: none; border-bottom: 1px dotted #6c757d; }
    a.drill:hover { color: var(--bs-link-color); border-bottom-style: solid; }
</style>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-1">
    <h2 class="mb-0">@T["Profit and Loss"]</h2>
    <form method="get" class="d-flex gap-2 align-items-center">
        <label for="asOfDate" class="small text-muted">@T["As of"]</label>
        <input type="date" id="asOfDate" name="asOfDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        <button type="submit" class="btn btn-sm btn-dark">@T["Refresh"]</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.print()">@T["Print"]</button>
    </form>
</div>
<p class="text-muted">@Model.StartDate.ToString("dd/MM/yyyy") to @Model.EndDate.ToString("dd/MM/yyyy"). Each account sits on the line chosen for it in the chart of accounts (Income statement line).</p>

<style>
    .is-table td, .is-table th { padding: .3rem .6rem; }
    .is-table .line-head td { font-weight: 600; background: #f6f8fa; }
    .is-table .acct td:first-child { padding-left: 1.6rem; }
    .is-table .subtotal td { font-weight: 600; border-top: 1px solid #adb5bd; }
    .is-table .result td { font-weight: 700; border-top: 2px solid #0f2740; background: #eef3f8; }
    .is-table .neg { color: #b42318; }
</style>

@{
    string Money(decimal value) => value < 0 ? $"({Math.Abs(value):N2})" : value.ToString("N2");
}

<table class="table table-sm is-table">
    <tbody>
        @* ---------------- Revenue *@
        <tr class="line-head"><td colspan="3">@T["Revenue"]</td></tr>
        @foreach (var line in RealEstateManager.Domain.StatementLines.Revenue)
        {
            var rows = Model.RowsOf(line).ToList();
            if (rows.Count == 0) { continue; }
            <tr><td colspan="2" class="fw-semibold">@RealEstateManager.Domain.StatementLines.Describe(line)</td><td class="text-end fw-semibold">@Money(Model.TotalOf(line))</td></tr>
            @foreach (var row in rows)
            {
                <tr class="acct"><td>@Drill(LedgerUrl(row.AccountId), row.AccountCode) @Drill(LedgerUrl(row.AccountId), row.AccountName)</td><td class="text-end text-muted">@Drill(LedgerUrl(row.AccountId), row.Amount.ToString("N2"))</td><td></td></tr>
            }
        }
        <tr class="subtotal"><td colspan="2">@T["Total revenue"]</td><td class="text-end">@Money(Model.TotalRevenue)</td></tr>

        @* ---------------- Cost of revenue and gross profit *@
        <tr class="line-head"><td colspan="3">@T["Less: cost of revenue"]</td></tr>
        @foreach (var row in Model.RowsOf(RealEstateManager.Domain.StatementLines.CostOfRevenue))
        {
            <tr class="acct"><td>@Drill(LedgerUrl(row.AccountId), row.AccountCode) @Drill(LedgerUrl(row.AccountId), row.AccountName)</td><td class="text-end text-muted">@Drill(LedgerUrl(row.AccountId), row.Amount.ToString("N2"))</td><td></td></tr>
        }
        <tr class="subtotal"><td colspan="2">@T["Total cost of revenue"]</td><td class="text-end">(@Model.CostOfRevenue.ToString("N2"))</td></tr>
        <tr class="result"><td colspan="2">@T["Gross profit"]</td><td class="text-end @(Model.GrossProfit < 0 ? "neg" : "")">@Money(Model.GrossProfit)</td></tr>

        @* ---------------- Operating costs: fixed, then recurring *@
        @foreach (var line in new[] { RealEstateManager.Domain.StatementLines.FixedCosts, RealEstateManager.Domain.StatementLines.RecurringCosts })
        {
            <tr class="line-head"><td colspan="3">Less: @RealEstateManager.Domain.StatementLines.Describe(line).ToLowerInvariant()</td></tr>
            @foreach (var row in Model.RowsOf(line))
            {
                <tr class="acct"><td>@Drill(LedgerUrl(row.AccountId), row.AccountCode) @Drill(LedgerUrl(row.AccountId), row.AccountName)</td><td class="text-end text-muted">@Drill(LedgerUrl(row.AccountId), row.Amount.ToString("N2"))</td><td></td></tr>
            }
            <tr class="subtotal"><td colspan="2">Total @RealEstateManager.Domain.StatementLines.Describe(line).ToLowerInvariant()</td><td class="text-end">(@Model.TotalOf(line).ToString("N2"))</td></tr>
        }
        <tr class="result"><td colspan="2">@T["Operating profit"]</td><td class="text-end @(Model.OperatingProfit < 0 ? "neg" : "")">@Money(Model.OperatingProfit)</td></tr>

        @* ---------------- Finance costs and the result *@
        <tr class="line-head"><td colspan="3">@T["Less: finance costs"]</td></tr>
        @foreach (var row in Model.RowsOf(RealEstateManager.Domain.StatementLines.FinanceCosts))
        {
            <tr class="acct"><td>@Drill(LedgerUrl(row.AccountId), row.AccountCode) @Drill(LedgerUrl(row.AccountId), row.AccountName)</td><td class="text-end text-muted">@Drill(LedgerUrl(row.AccountId), row.Amount.ToString("N2"))</td><td></td></tr>
        }
        <tr class="subtotal"><td colspan="2">@T["Total finance costs"]</td><td class="text-end">(@Model.FinanceCosts.ToString("N2"))</td></tr>
        <tr class="result"><td colspan="2">@T["Net profit / (loss)"]</td><td class="text-end @(Model.NetProfitOrLoss < 0 ? "neg" : "")">@Money(Model.NetProfitOrLoss)</td></tr>
    </tbody>
</table>

<p class="small text-muted">
    The rent of managed properties belongs to their owners and is not revenue here; only the commission is. Costs of managed
    properties are charged to their owners (Due to Landlords) and do not appear here either &mdash; see
    <a asp-action="OwnerProfitability">Owner Property Profitability</a> and <a asp-action="OwnerCombined">the owner's combined view</a>.
</p>
