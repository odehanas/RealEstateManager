@model RealEstateManager.Services.TrialBalanceReportDto

@{
    ViewData["Title"] = "Trial Balance";
    var ledgerFrom = (new DateTime(Model.AsOfDate.Year, 1, 1)).ToString("yyyy-MM-dd");
    var ledgerTo = (Model.AsOfDate).ToString("yyyy-MM-dd");
}

<h2>Trial Balance</h2>

<form method="get" class="mb-3">
    <label for="asOfDate">As Of Date</label>
    <input type="date" id="asOfDate" name="asOfDate" value="@Model.AsOfDate.ToString("yyyy-MM-dd")" />
    <button type="submit">Refresh</button>
</form>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Code</th>
            <th>Account</th>
            <th>Type</th>
            <th class="text-end">Debit</th>
            <th class="text-end">Credit</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model.Rows)
        {
            <tr>
                <td>@if (row.AccountId > 0) { <a asp-controller="Journal" asp-action="GeneralLedger" asp-route-accountId="@row.AccountId" asp-route-fromDate="@ledgerFrom" asp-route-toDate="@ledgerTo" title="Open the ledger">@row.AccountCode</a> } else { @row.AccountCode }</td>
                <td>@row.AccountName</td>
                <td>@row.AccountType</td>
                <td class="text-end">@row.DebitBalance.ToString("N2")</td>
                <td class="text-end">@row.CreditBalance.ToString("N2")</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3">Totals</th>
            <th class="text-end">@Model.TotalDebit.ToString("N2")</th>
            <th class="text-end">@Model.TotalCredit.ToString("N2")</th>
        </tr>
    </tfoot>
</table>