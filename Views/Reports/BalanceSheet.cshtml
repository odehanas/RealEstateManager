@model RealEstateManager.Services.BalanceSheetReportDto

@{
    ViewData["Title"] = T["Balance Sheet"];
    var ledgerFrom = (new DateTime(Model.AsOfDate.Year, 1, 1)).ToString("yyyy-MM-dd");
    var ledgerTo = (Model.AsOfDate).ToString("yyyy-MM-dd");
    // Every account figure opens the general ledger behind it (drill-down).
    string? LedgerUrl(int accountId) => accountId > 0
        ? Url.Action("GeneralLedger", "Journal", new { accountId, fromDate = ledgerFrom, toDate = ledgerTo, returnUrl = Context.Request.Path + Context.Request.QueryString, returnTo = ViewData["Title"] })
        : null;
    Microsoft.AspNetCore.Html.IHtmlContent Drill(string? url, string text) => new Microsoft.AspNetCore.Html.HtmlString(url == null
        ? System.Net.WebUtility.HtmlEncode(text)
        : $"<a href=\"{System.Net.WebUtility.HtmlEncode(url)}\" class=\"drill\" title=\"Open the general ledger\">{System.Net.WebUtility.HtmlEncode(text)}</a>");
    var equityAccounts = ViewBag.EquityAccountIds as Dictionary<string, int> ?? new();
    int EquityId(string code) => equityAccounts.TryGetValue(code, out var id) ? id : 0;
}

<style>
    a.drill { color: inherit; text-decoration: none; border-bottom: 1px dotted #6c757d; }
    a.drill:hover { color: var(--bs-link-color); border-bottom-style: solid; }
</style>

<h2>@T["Balance Sheet"]</h2>

<form method="get" class="mb-3">
    <label for="asOfDate">@T["As Of Date"]</label>
    <input type="date" id="asOfDate" name="asOfDate" value="@Model.AsOfDate.ToString("yyyy-MM-dd")" />
    <button type="submit">@T["Refresh"]</button>
</form>

<h4>@T["Assets"]</h4>
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>@T["Code"]</th>
            <th>@T["Account"]</th>
            <th class="text-end">@T["Amount"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model.Assets)
        {
            <tr>
                <td>@Drill(LedgerUrl(row.AccountId), row.AccountCode)</td>
                <td>@Drill(LedgerUrl(row.AccountId), row.AccountName)</td>
                <td class="text-end">@Drill(LedgerUrl(row.AccountId), row.Amount.ToString("N2"))</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="2">@T["Total Assets"]</th>
            <th class="text-end">@Model.TotalAssets.ToString("N2")</th>
        </tr>
    </tfoot>
</table>

<h4>@T["Liabilities"]</h4>
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>@T["Code"]</th>
            <th>@T["Account"]</th>
            <th class="text-end">@T["Amount"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model.Liabilities)
        {
            <tr>
                <td>@Drill(LedgerUrl(row.AccountId), row.AccountCode)</td>
                <td>@Drill(LedgerUrl(row.AccountId), row.AccountName)</td>
                <td class="text-end">@Drill(LedgerUrl(row.AccountId), row.Amount.ToString("N2"))</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="2">@T["Total Liabilities"]</th>
            <th class="text-end">@Model.TotalLiabilities.ToString("N2")</th>
        </tr>
    </tfoot>
</table>

<h4>@T["Equity"]</h4>
<table class="table table-bordered table-striped">
    <tbody>
        <tr>
            <td>@Drill(LedgerUrl(EquityId("31100")), "31100")</td>
            <td>@Drill(LedgerUrl(EquityId("31100")), "Share Capital")</td>
            <td class="text-end">@Drill(LedgerUrl(EquityId("31100")), Model.ShareCapital.ToString("N2"))</td>
        </tr>
        <tr>
            <td>@Drill(LedgerUrl(EquityId("32100")), "32100")</td>
            <td>@Drill(LedgerUrl(EquityId("32100")), "Retained Earnings - Prior Years")</td>
            <td class="text-end">@Drill(LedgerUrl(EquityId("32100")), Model.RetainedEarningsPriorYears.ToString("N2"))</td>
        </tr>

        @foreach (var row in Model.OtherEquityRows)
        {
            <tr>
                <td>@Drill(LedgerUrl(row.AccountId), row.AccountCode)</td>
                <td>@Drill(LedgerUrl(row.AccountId), row.AccountName)</td>
                <td class="text-end">@Drill(LedgerUrl(row.AccountId), row.Amount.ToString("N2"))</td>
            </tr>
        }

        <tr>
            <td></td>
            <td><a asp-action="ProfitAndLoss" asp-route-asOfDate="@Model.AsOfDate.ToString("yyyy-MM-dd")" class="drill" title="@T["Open the profit and loss"]">@T["Current Year Profit / Loss"]</a></td>
            <td class="text-end"><a asp-action="ProfitAndLoss" asp-route-asOfDate="@Model.AsOfDate.ToString("yyyy-MM-dd")" class="drill" title="@T["Open the profit and loss"]">@Model.CurrentYearProfitOrLoss.ToString("N2")</a></td>
        </tr>
    </tbody>
    <tfoot>
        <tr>
            <th colspan="2">@T["Total Equity"]</th>
            <th class="text-end">@Model.TotalEquity.ToString("N2")</th>
        </tr>
        <tr>
            <th colspan="2">@T["Total Liabilities and Equity"]</th>
            <th class="text-end">@Model.TotalLiabilitiesAndEquity.ToString("N2")</th>
        </tr>
    </tfoot>
</table>