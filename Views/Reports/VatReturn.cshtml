@model RealEstateManager.Services.VatReturnReportDto
@using RealEstateManager.Domain
@{
    ViewData["Title"] = T["VAT Return"];
    var washUp = ViewBag.WashUp as RealEstateManager.Services.VatWashUpDto;
}

<style>
    .vat-table { font-size: .88rem; }
    .vat-table th { background: #0f2740; color: #fff; white-space: nowrap; }
    .vat-table td { white-space: nowrap; }
    .vat-table td.lbl { white-space: normal; }
    .vat-table tfoot td { font-weight: 700; background: #eef2f7; }
    .scroll-x { overflow-x: auto; }
    @@media print { .no-print { display: none !important; } }
</style>

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-3">
    <div>
        <h2 class="mb-1">@T["VAT Return"]</h2>
        <p class="text-muted mb-0">
            @Model.CompanyName
            @if (!string.IsNullOrWhiteSpace(Model.CompanyTrn)) { <text>@T.Format("· TRN {0}", Model.CompanyTrn)</text> }
        </p>
    </div>
    <div class="d-flex gap-2 no-print">
        <a asp-controller="VatSettings" asp-action="Index" class="btn btn-outline-secondary btn-sm">@T["VAT Settings"]</a>
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">@T["Print"]</button>
    </div>
</div>

@if (string.IsNullOrWhiteSpace(Model.CompanyTrn))
{
    <div class="alert alert-warning">
        @T.Html("<strong>No TRN is configured.</strong> Set it under <strong>Setup &rsaquo; VAT Settings</strong>. This report is still accurate, but it is not a filing document without it.")
    </div>
}

<form method="get" class="row g-2 align-items-end mb-3 no-print">
    <div class="col-auto">
        <label class="form-label mb-1" for="startDate">@T["Period From"]</label>
        <input type="date" class="form-control form-control-sm" id="startDate" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-auto">
        <label class="form-label mb-1" for="endDate">@T["Period To"]</label>
        <input type="date" class="form-control form-control-sm" id="endDate" name="endDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary btn-sm">@T["Refresh"]</button>
    </div>
</form>

<div class="d-none d-print-block mb-3">
    @T.HtmlFormat("<strong>Tax period:</strong> {0} to {1}", Model.StartDate.ToString("dd/MM/yyyy"), Model.EndDate.ToString("dd/MM/yyyy"))
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm h-100 border-0 bg-primary text-white">
            <div class="card-body py-3">
                <div class="small text-uppercase opacity-75">@T["Output Tax Due"]</div>
                <div class="h4 fw-bold mb-0">@Model.StandardRatedVat.ToString("N2")</div>
                <div class="small opacity-75">@T.Format("On {0} of standard rated supplies", Model.StandardRatedNet.ToString("N0"))</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm h-100 border-0 bg-success text-white">
            <div class="card-body py-3">
                <div class="small text-uppercase opacity-75">@T["Input Tax Recoverable"]</div>
                <div class="h4 fw-bold mb-0">@Model.InputVatRecoverable.ToString("N2")</div>
                <div class="small opacity-75">@T.Format("{0} irrecoverable", Model.InputVatNonRecoverable.ToString("N2"))</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm h-100 border-0 @(Model.NetVatPayable >= 0 ? "bg-danger" : "bg-dark") text-white">
            <div class="card-body py-3">
                <div class="small text-uppercase opacity-75">@(Model.NetVatPayable >= 0 ? T["Net VAT Payable"] : T["Net VAT Reclaimable"])</div>
                <div class="h4 fw-bold mb-0">@Math.Abs(Model.NetVatPayable).ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm h-100 border-0 bg-secondary text-white">
            <div class="card-body py-3">
                <div class="small text-uppercase opacity-75">@T["Recovery Rate"]</div>
                <div class="h4 fw-bold mb-0">@Model.ActualRecoveryRate.ToString("N2")%</div>
                <div class="small opacity-75">@T.Format("Provisional {0}%", Model.ProvisionalRecoveryRate.ToString("N2"))</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light">@T.Html("<strong>Output Tax &mdash; Supplies Made</strong>")</div>
    <div class="scroll-x">
        <table class="table table-bordered table-sm mb-0 vat-table">
            <thead>
                <tr>
                    <th class="lbl">@T["VAT Treatment"]</th>
                    <th class="text-end">@T["Documents"]</th>
                    <th class="text-end">@T["Net Amount"]</th>
                    <th class="text-end">@T["VAT"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.OutputLines.Count == 0)
                {
                    <tr><td colspan="4" class="text-muted">@T["No supplies posted in this period."]</td></tr>
                }
                @foreach (var line in Model.OutputLines)
                {
                    <tr class="@(line.IsCreditNote ? "text-danger" : "")">
                        <td class="lbl">
                            @if (line.IsCreditNote)
                            {
                                <text>@T.Format("Less credit notes — {0}", VatCategories.Describe(line.VatCategory))</text>
                            }
                            else
                            {
                                @(line.Label ?? VatCategories.Describe(line.VatCategory))
                            }
                        </td>
                        <td class="text-end">@line.SupplyCount</td>
                        <td class="text-end">@line.NetAmount.ToString("N2")</td>
                        <td class="text-end">@line.VatAmount.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td>@T["Total supplies"]</td>
                    <td class="text-end">@Model.OutputLines.Sum(x => x.SupplyCount)</td>
                    <td class="text-end">@Model.TotalSuppliesNet.ToString("N2")</td>
                    <td class="text-end">@Model.StandardRatedVat.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light">@T.Html("<strong>Input Tax &mdash; Purchases</strong>")</div>
    <div class="scroll-x">
        <table class="table table-bordered table-sm mb-0 vat-table">
            <thead>
                <tr>
                    <th class="lbl">@T["Attribution"]</th>
                    <th class="text-end">@T["Bills"]</th>
                    <th class="text-end">@T["Net Amount"]</th>
                    <th class="text-end">@T["VAT Charged"]</th>
                    <th class="text-end">@T["Recoverable"]</th>
                    <th class="text-end">@T["Irrecoverable"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.InputLines.Count == 0)
                {
                    <tr><td colspan="6" class="text-muted">@T["No purchases posted in this period."]</td></tr>
                }
                @foreach (var line in Model.InputLines)
                {
                    <tr>
                        <td class="lbl">@(line.Attribution == "CapitalAssetsScheme" ? T["Capital Assets Scheme adjustment"] : InputTaxAttributions.Describe(line.Attribution))</td>
                        <td class="text-end">@line.BillCount</td>
                        <td class="text-end">@line.NetAmount.ToString("N2")</td>
                        <td class="text-end">@line.VatAmount.ToString("N2")</td>
                        <td class="text-end text-success">@line.RecoverableVat.ToString("N2")</td>
                        <td class="text-end text-danger">@line.NonRecoverableVat.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td>@T["Total"]</td>
                    <td class="text-end">@Model.InputLines.Sum(x => x.BillCount)</td>
                    <td class="text-end">@Model.InputLines.Sum(x => x.NetAmount).ToString("N2")</td>
                    <td class="text-end">@Model.InputVatTotal.ToString("N2")</td>
                    <td class="text-end">@Model.InputVatRecoverable.ToString("N2")</td>
                    <td class="text-end">@Model.InputVatNonRecoverable.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="card-body py-3 small text-muted">
        @T["Irrecoverable VAT is not lost from the accounts — it was added to the expense account when each bill was posted, so it already sits in the Profit & Loss as part of the cost."]
    </div>
</div>

@if (washUp != null && Model.HasExemptSupplies)
{
    <div class="card shadow-sm mb-4 border-warning">
        <div class="card-header bg-warning bg-opacity-25">
            <strong>@T["Annual Apportionment Wash-Up"]</strong>
            <span class="text-muted small ms-2">@washUp.YearStart.ToString("dd/MM/yyyy") to @washUp.YearEnd.ToString("dd/MM/yyyy")</span>
        </div>
        <div class="scroll-x">
            <table class="table table-bordered table-sm mb-0 vat-table">
                <tbody>
                    <tr>
                        <td class="lbl">@T["Standard rated supplies for the year"]</td>
                        <td class="text-end">@washUp.StandardRatedNet.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td class="lbl">@T["Zero rated supplies for the year"]</td>
                        <td class="text-end">@washUp.ZeroRatedNet.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td class="lbl">@T["Exempt supplies for the year"]</td>
                        <td class="text-end">@washUp.ExemptNet.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td class="lbl">@T.Html("<strong>Actual recovery rate</strong> &mdash; (standard + zero rated) ÷ total supplies")</td>
                        <td class="text-end fw-bold">@washUp.ActualRecoveryRate.ToString("N2")%</td>
                    </tr>
                    <tr>
                        <td class="lbl">@T["Provisional rate applied during the year"]</td>
                        <td class="text-end">@washUp.ProvisionalRecoveryRate.ToString("N2")%</td>
                    </tr>
                    <tr>
                        <td class="lbl">@T["Residual input tax for the year"]</td>
                        <td class="text-end">@washUp.ResidualInputVat.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td class="lbl">@T["Recoverable at the actual rate"]</td>
                        <td class="text-end">@washUp.RecoverableAtActualRate.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td class="lbl">@T["Already recovered at the provisional rate"]</td>
                        <td class="text-end">@washUp.AlreadyRecovered.ToString("N2")</td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr>
                        <td class="lbl">
                            <strong>@(washUp.Adjustment >= 0 ? T["Additional input tax recoverable"] : T["Input tax to repay"])</strong>
                        </td>
                        <td class="text-end fw-bold @(washUp.Adjustment >= 0 ? "text-success" : "text-danger")">
                            @Math.Abs(washUp.Adjustment).ToString("N2")
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="card-body py-3 small">
            <strong>@T["This figure is not posted automatically."]</strong>
            Post it yourself as a manual journal in the final period of the year:
            @if (washUp.Adjustment >= 0)
            {
                <text>Dr <code>11300</code> VAT Recoverable, Cr the expense account that carried the irrecoverable VAT.</text>
            }
            else
            {
                <text>Dr the expense account, Cr <code>11300</code> VAT Recoverable.</text>
            }
            Then set the provisional rate for next year to <strong>@washUp.ActualRecoveryRate.ToString("N2")%</strong>
            under Setup &rsaquo; VAT Settings.
        </div>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body py-3 small text-muted">
        <strong class="text-dark">@T["How this is built"]</strong>
        <ul class="mb-0 mt-2">
            <li>@T.Html("<strong>Output tax</strong> comes from posted customer invoices, grouped by the VAT treatment snapshotted on each one. Draft and cancelled invoices are excluded because they have no ledger effect.")</li>
            <li>@T.Html("<strong>Input tax</strong> comes from posted vendor bills, using the recoverable / irrecoverable split fixed when each bill was posted &mdash; so this report always agrees with the ledger rather than re-deriving it.")</li>
            <li>@T.Html("<strong>Recovery rate</strong> is the standard apportionment method: supplies carrying the right of recovery divided by total supplies. If your business needs a special method, it must be approved by the FTA.")</li>
            <li>@T["The default period is the calendar quarter containing the end date. Change the dates for a different tax period."]</li>
        </ul>
    </div>
</div>
