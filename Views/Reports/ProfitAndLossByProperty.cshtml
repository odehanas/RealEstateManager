@model RealEstateManager.Services.PropertyProfitAndLossReportDto
@{
    ViewData["Title"] = T["Profit & Loss by Property"];
    var propertyOptions = ViewBag.PropertyOptions as List<RealEstateManager.Services.PropertyColumnDto>
        ?? new List<RealEstateManager.Services.PropertyColumnDto>();
    var ownerOptions = ViewBag.OwnerOptions as List<RealEstateManager.Services.PropertyOwnerOptionDto>
        ?? new List<RealEstateManager.Services.PropertyOwnerOptionDto>();
    var ownerName = ownerOptions.FirstOrDefault(x => x.Key == Model.FilteredOwner)?.Name;
    var cols = Model.Columns;
}

<style>
    .pnl-matrix { font-size: .85rem; }
    .pnl-matrix th, .pnl-matrix td { white-space: nowrap; }
    .pnl-matrix thead th { position: sticky; top: 0; background: #0f2740; color: #fff; z-index: 2; }
    .pnl-matrix th.acct, .pnl-matrix td.acct { white-space: normal; min-width: 230px; }
    .pnl-matrix .grp td {
        background: #eef2f7; font-weight: 700; color: #0f2740;
        text-transform: uppercase; letter-spacing: .04em; font-size: .74rem;
    }
    .pnl-matrix tfoot td, .pnl-matrix .subtotal td { font-weight: 700; background: #f7f9fb; }
    .pnl-matrix .net td { background: #0f2740; color: #fff; font-weight: 700; }
    .pnl-matrix .unalloc { background: #fff8e6 !important; }
    .neg { color: #a3341f; }
    .scroll-x { overflow-x: auto; }
    @@media print { .no-print { display: none !important; } .pnl-matrix thead th { position: static; } }
</style>

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-3">
    <div>
        <h2 class="mb-1">@T["Profit & Loss by Property"]</h2>
        <p class="text-muted mb-0">
            @T["General ledger revenue and expenses analysed over the property dimension carried on each journal line."]
        </p>
    </div>
    <button type="button" class="btn btn-outline-secondary btn-sm no-print" onclick="window.print()">@T["Print"]</button>
</div>

<form method="get" class="row g-2 align-items-end mb-3 no-print">
    <div class="col-auto">
        <label class="form-label mb-1" for="startDate">@T["From Date"]</label>
        <input type="date" class="form-control form-control-sm" id="startDate" name="startDate"
               value="@Model.StartDate.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-auto">
        <label class="form-label mb-1" for="endDate">@T["To Date"]</label>
        <input type="date" class="form-control form-control-sm" id="endDate" name="endDate"
               value="@Model.EndDate.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-auto">
        <label class="form-label mb-1" for="owner">@T["Owner"]</label>
        <select class="form-select form-select-sm" id="owner" name="owner">
            <option value="">@T["All owners"]</option>
            @foreach (var option in ownerOptions)
            {
                <option value="@option.Key" selected="@(Model.FilteredOwner == option.Key ? "selected" : null)">
                    @(option.Key == RealEstateManager.Services.PropertyOwnerOptionDto.CompanyKey ? T[option.Name] : option.Name)
                </option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label mb-1" for="propertyId">@T["Property"]</label>
        <select class="form-select form-select-sm" id="propertyId" name="propertyId">
            <option value="">@T["All properties"]</option>
            @foreach (var option in propertyOptions)
            {
                <option value="@option.PropertyId" data-owner="@option.OwnerKey" selected="@(Model.FilteredPropertyId == option.PropertyId ? "selected" : null)">
                    @option.PropertyCode - @option.PropertyName
                </option>
            }
        </select>
    </div>
    <div class="col-auto">
        <div class="form-check mb-1">
            <input type="hidden" name="byUnit" value="false" id="byUnitOff" disabled="@(Model.ByUnit ? "disabled" : null)" />
            <input class="form-check-input" type="checkbox" id="byUnit" name="byUnit" value="true" checked="@(Model.ByUnit ? "checked" : null)" />
            <label class="form-check-label" for="byUnit">@T["Show each unit"]</label>
        </div>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary btn-sm">@T["Refresh"]</button>
    </div>
</form>

<div class="d-none d-print-block mb-3">
    @T.HtmlFormat("<strong>Period:</strong> {0} to {1}", Model.StartDate.ToString("dd/MM/yyyy"), Model.EndDate.ToString("dd/MM/yyyy"))
    @if (ownerName != null) { <span>&middot; <strong>@T["Owner"]:</strong> @(Model.FilteredOwner == RealEstateManager.Services.PropertyOwnerOptionDto.CompanyKey ? T[ownerName] : ownerName)</span> }
</div>

@if (Model.FilteredOwner != null && Model.FilteredOwner != RealEstateManager.Services.PropertyOwnerOptionDto.CompanyKey)
{
    <div class="alert alert-info py-2 small">
        @T.Html("<strong>These are the company's own figures for this owner's properties</strong>: the management commission it earned and the costs it bore itself. The rent belongs to the owner and is not the company's revenue, so it is not here.")
        <a asp-action="OwnerProfitability">@T["Open Owner Property Profitability for the owner's own income, costs and net result."]</a>
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card shadow-sm h-100 border-0 bg-success text-white">
            <div class="card-body py-3">
                <div class="small text-uppercase opacity-75">@T["Total Revenue"]</div>
                <div class="h4 fw-bold mb-0">@Model.TotalRevenue.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100 border-0 bg-secondary text-white">
            <div class="card-body py-3">
                <div class="small text-uppercase opacity-75">@T["Total Expenses"]</div>
                <div class="h4 fw-bold mb-0">@Model.TotalExpenses.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100 border-0 @(Model.NetProfitOrLoss >= 0 ? "bg-primary" : "bg-danger") text-white">
            <div class="card-body py-3">
                <div class="small text-uppercase opacity-75">@T.Format("Net {0}", Model.NetProfitOrLoss >= 0 ? T["Profit"] : "Loss")</div>
                <div class="h4 fw-bold mb-0">@Model.NetProfitOrLoss.ToString("N2")</div>
            </div>
        </div>
    </div>
</div>

@if (Model.HasUnallocatedActivity)
{
    <div class="alert alert-warning py-2 small">
        @T.Html("<strong>Unallocated column present.</strong> Some revenue or expense lines carry no property dimension &mdash; most commonly manual journals posted without a unit / cost centre. Reopen those journals and set the unit so the amount is attributed to a property. The matrix total always reconciles to the general ledger Profit &amp; Loss for the same dates, whether or not lines are allocated.")
    </div>
}

@if (cols.Count == 0)
{
    <div class="alert alert-info">@T["No revenue or expense activity was posted in this period."]</div>
}
else
{
    <div class="card shadow-sm">
        <div class="scroll-x">
            <table class="table table-bordered table-sm mb-0 pnl-matrix">
                <thead>
                    <tr>
                        <th class="acct">@T["Account"]</th>
                        @foreach (var col in cols)
                        {
                            <th class="text-end @(col.PropertyId.HasValue ? "" : "unalloc")">
                                @col.PropertyCode
                                <div class="fw-normal opacity-75" style="font-size:.72rem">@col.PropertyName</div>
                            </th>
                        }
                        <th class="text-end">@T["Total"]</th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="grp"><td colspan="@(cols.Count + 2)">@T["Revenue"]</td></tr>
                    @foreach (var row in Model.Revenue)
                    {
                        <tr>
                            <td class="acct"><span class="text-muted">@row.AccountCode</span> @row.AccountName</td>
                            @foreach (var col in cols)
                            {
                                var amount = row.AmountFor(col.Key);
                                <td class="text-end @(col.PropertyId.HasValue ? "" : "unalloc") @(amount < 0 ? "neg" : "")">
                                    @(amount == 0m ? "-" : amount.ToString("N2"))
                                </td>
                            }
                            <td class="text-end fw-semibold @(row.Total < 0 ? "neg" : "")">@row.Total.ToString("N2")</td>
                        </tr>
                    }
                    <tr class="subtotal">
                        <td>@T["Total Revenue"]</td>
                        @foreach (var col in cols)
                        {
                            <td class="text-end">@Model.RevenueFor(col.Key).ToString("N2")</td>
                        }
                        <td class="text-end">@Model.TotalRevenue.ToString("N2")</td>
                    </tr>

                    <tr class="grp"><td colspan="@(cols.Count + 2)">@T["Expenses"]</td></tr>
                    @foreach (var row in Model.Expenses)
                    {
                        <tr>
                            <td class="acct"><span class="text-muted">@row.AccountCode</span> @row.AccountName</td>
                            @foreach (var col in cols)
                            {
                                var amount = row.AmountFor(col.Key);
                                <td class="text-end @(col.PropertyId.HasValue ? "" : "unalloc") @(amount < 0 ? "neg" : "")">
                                    @(amount == 0m ? "-" : amount.ToString("N2"))
                                </td>
                            }
                            <td class="text-end fw-semibold @(row.Total < 0 ? "neg" : "")">@row.Total.ToString("N2")</td>
                        </tr>
                    }
                    <tr class="subtotal">
                        <td>@T["Total Expenses"]</td>
                        @foreach (var col in cols)
                        {
                            <td class="text-end">@Model.ExpensesFor(col.Key).ToString("N2")</td>
                        }
                        <td class="text-end">@Model.TotalExpenses.ToString("N2")</td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr class="net">
                        <td>@T["Net Profit / (Loss)"]</td>
                        @foreach (var col in cols)
                        {
                            <td class="text-end">@Model.NetFor(col.Key).ToString("N2")</td>
                        }
                        <td class="text-end">@Model.NetProfitOrLoss.ToString("N2")</td>
                    </tr>
                    <tr class="subtotal">
                        <td>@T["Net Margin %"]</td>
                        @foreach (var col in cols)
                        {
                            <td class="text-end">@Model.MarginFor(col.Key).ToString("N1")%</td>
                        }
                        <td class="text-end">
                            @((Model.TotalRevenue == 0m ? 0m : Math.Round(Model.NetProfitOrLoss / Model.TotalRevenue * 100m, 1)).ToString("N1"))%
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <p class="text-muted small mt-2 mb-0">
        @T["Revenue is shown as credits less debits; expenses as debits less credits. A negative figure therefore indicates a reversal or reclassification in the period."]
    </p>

    @if (Model.ByUnit)
    {
        <h4 class="mt-4 mb-2">@T["Profitability by unit"]</h4>
        @if (Model.Units.Count == 0)
        {
            <div class="alert alert-info">@T["No revenue or expense in this period is tagged to a property."]</div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="scroll-x">
                    <table class="table table-bordered table-sm mb-0 pnl-matrix">
                        <thead>
                            <tr>
                                <th class="acct">@T["Property"] / @T["Unit"]</th>
                                <th class="text-end">@T["Revenue"]</th>
                                <th class="text-end">@T["Expenses"]</th>
                                <th class="text-end">@T["Net Profit / (Loss)"]</th>
                                <th class="text-end">@T["Net Margin %"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var property in Model.Units.GroupBy(x => new { x.PropertyId, x.PropertyCode, x.PropertyName }))
                            {
                                var revenue = property.Sum(x => x.Revenue);
                                var expenses = property.Sum(x => x.Expenses);
                                <tr class="grp"><td colspan="5">@property.Key.PropertyCode &middot; @property.Key.PropertyName</td></tr>
                                @foreach (var unit in property)
                                {
                                    <tr>
                                        <td class="acct">@(unit.UnitId.HasValue ? unit.UnitNumber : T["Building as a whole (no unit)"])</td>
                                        <td class="text-end @(unit.Revenue < 0 ? "neg" : "")">@(unit.Revenue == 0m ? "-" : unit.Revenue.ToString("N2"))</td>
                                        <td class="text-end @(unit.Expenses < 0 ? "neg" : "")">@(unit.Expenses == 0m ? "-" : unit.Expenses.ToString("N2"))</td>
                                        <td class="text-end fw-semibold @(unit.Net < 0 ? "neg" : "")">@unit.Net.ToString("N2")</td>
                                        <td class="text-end">@(unit.Revenue == 0m ? "-" : unit.Margin.ToString("N1") + "%")</td>
                                    </tr>
                                }
                                <tr class="subtotal">
                                    <td>@T.Format("Total {0}", property.Key.PropertyCode)</td>
                                    <td class="text-end">@revenue.ToString("N2")</td>
                                    <td class="text-end">@expenses.ToString("N2")</td>
                                    <td class="text-end @(revenue - expenses < 0 ? "neg" : "")">@((revenue - expenses).ToString("N2"))</td>
                                    <td class="text-end">@(revenue == 0m ? "-" : Math.Round((revenue - expenses) / revenue * 100m, 1).ToString("N1") + "%")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <p class="text-muted small mt-2 mb-0">
                @T["Each property's units add up to its column in the table above. Costs of the building that were not given a unit are on the line \"Building as a whole\"."]
            </p>
        }
    }
}

<script>
    // Choosing an owner leaves only that owner's properties in the Property list.
    (function () {
        var owner = document.getElementById('owner'), property = document.getElementById('propertyId');
        var unit = document.getElementById('byUnit'), unitOff = document.getElementById('byUnitOff');
        if (!owner || !property) { return; }
        function narrow() {
            Array.prototype.forEach.call(property.options, function (option) {
                var show = !option.value || !owner.value || option.getAttribute('data-owner') === owner.value;
                option.hidden = !show;
                option.disabled = !show;
                if (!show && option.selected) { property.value = ''; }
            });
        }
        owner.addEventListener('change', narrow);
        narrow();
        // An unticked box still has to say "no", or the report would switch the units back on.
        if (unit && unitOff) { unit.addEventListener('change', function () { unitOff.disabled = unit.checked; }); }
    })();
</script>
