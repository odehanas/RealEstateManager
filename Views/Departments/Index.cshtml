@model List<RealEstateManager.Domain.Department>

@{
    ViewData["Title"] = T["Departments"];
    var counts = (Dictionary<int, int>)ViewBag.Counts;
}

<h2>@T["Departments"]</h2>

@if (TempData["HrSuccess"] is string ok) { <div class="alert alert-success">@ok</div> }
@if (TempData["HrError"] is string err) { <div class="alert alert-danger">@err</div> }

<form asp-action="Create" method="post" class="row g-2 mb-3">
    @Html.AntiForgeryToken()
    <div class="col-md-5"><input name="name" class="form-control" placeholder="@T["New department, e.g. Building Maintenance"]" /></div>
    <div class="col-md-2"><button class="btn btn-dark w-100">@T["Add"]</button></div>
</form>

<table class="table table-bordered table-striped" style="max-width:720px">
    <thead class="table-light"><tr><th>@T["Department"]</th><th class="text-end">@T["Active staff"]</th><th>@T["Status"]</th><th></th></tr></thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td>@d.Name</td>
                <td class="text-end">@(counts.TryGetValue(d.Id, out var c) ? c : 0)</td>
                <td>@(d.IsActive ? "Active" : "Inactive")</td>
                <td>
                    <form asp-action="Toggle" asp-route-id="@d.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-outline-secondary">@(d.IsActive ? "Deactivate" : "Activate")</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
