@model List<RealEstateManager.Services.MaintenanceService.JobRow>
@using RealEstateManager.Domain
@{
    var seesAll = ViewBag.SeesAll as bool? ?? false;
    var show = ViewBag.Show as string ?? "Open";
    var technicianId = ViewBag.TechnicianId as int?;
    var kind = ViewBag.Kind as string ?? "Normal";
    var kinds = new[]
    {
        (Key: "Normal", Label: "Requests and repairs", Open: ViewBag.OpenNormal as int? ?? 0),
        (Key: "Planned", Label: "Planned maintenance", Open: ViewBag.OpenPlanned as int? ?? 0),
        (Key: "Paid", Label: "Paid services", Open: ViewBag.OpenPaid as int? ?? 0)
    };
    var technicians = ViewBag.Technicians as List<RealEstateManager.Services.MaintenanceService.Technician> ?? new();
    var awaiting = ViewBag.AwaitingMakeReady as List<RealEstateManager.Services.MaintenanceService.VacantUnit> ?? new();
    ViewData["Title"] = seesAll ? "Maintenance Jobs" : "My Maintenance Jobs";

    string Hours(double? hours) => hours == null ? "-" : hours < 48 ? $"{hours:0.#} h" : $"{hours / 24:0.#} days";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="mb-1">@ViewData["Title"]</h2>
        <div class="text-muted">
            @(seesAll ? T["Every maintenance job, whether a tenant asked, management raised it or the planned programme opened it, with who is doing it."] : T["The maintenance jobs assigned to you. Open one to record the work and the materials used."])
        </div>
    </div>
    @if (seesAll)
    {
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Create" class="btn btn-dark">@T["Raise a Job"]</a>
            <a asp-controller="MaintenancePlans" asp-action="Index" class="btn btn-outline-dark">@T["Planned Maintenance"]</a>
            <a asp-action="Dashboard" class="btn btn-outline-primary">@T["Maintenance Dashboard"]</a>
        </div>
    }
</div>

@if (awaiting.Count > 0)
{
    <div class="card shadow-sm mb-3 border-warning">
        <div class="card-header bg-white"><strong>@T["Vacant units to make ready"]</strong> <span class="badge bg-warning text-dark">@awaiting.Count</span></div>
        <div class="card-body small">
            <p class="text-muted">@T["Their tenancy has ended and no make-ready job has been raised since."]</p>
            <div class="table-responsive">
                <table class="table table-sm mb-0 align-middle">
                    <thead class="table-light"><tr><th>@T["Unit"]</th><th>@T["Property"]</th><th>@T["Tenancy ended"]</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var unit in awaiting)
                        {
                            <tr>
                                <td>@unit.Unit</td>
                                <td>@unit.Property</td>
                                <td>@unit.LastTenancyEnded.ToString("dd/MM/yyyy")</td>
                                <td class="text-end"><a asp-action="Create" asp-route-unitId="@unit.UnitId" asp-route-purpose="@MaintenancePurposes.MakeReady" class="btn btn-sm btn-outline-dark">@T["Raise make-ready job"]</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<partial name="_AppInstallPanel" model="true" />

<ul class="nav nav-tabs mb-3">
    @foreach (var tab in kinds)
    {
        <li class="nav-item">
            <a class="nav-link @(kind == tab.Key ? "active fw-semibold" : "")" asp-action="Index" asp-route-kind="@tab.Key" asp-route-show="@show" asp-route-technicianId="@technicianId">
                @T[tab.Label]
                <span class="badge @(tab.Open > 0 ? (tab.Key == "Paid" ? "bg-primary" : "bg-dark") : "bg-secondary")" title="@T["still open"]">@tab.Open</span>
            </a>
        </li>
    }
</ul>
<p class="text-muted small">
    @(kind == "Paid"
        ? T["Services a tenant ordered from the price list and pays for. A job marked On hold until paid waits for its invoice to be paid."]
        : kind == "Planned"
            ? T["Jobs the planned maintenance programme opened on their due dates."]
            : T["Repairs tenants asked for, and jobs management raised: make-ready, inspections and repairs."])
</p>

<form method="get" class="d-flex flex-wrap gap-2 align-items-center mb-3">
    <input type="hidden" name="kind" value="@kind" />
    <div class="btn-group" role="group" aria-label="@T["Which jobs"]">
        @foreach (var option in new[] { "Open", "Done", "All" })
        {
            <a asp-action="Index" asp-route-kind="@kind" asp-route-show="@option" asp-route-technicianId="@technicianId"
               class="btn btn-sm @(show == option ? "btn-dark" : "btn-outline-dark")">@option</a>
        }
    </div>
    @if (seesAll && technicians.Count > 0)
    {
        <input type="hidden" name="show" value="@show" />
        <select name="technicianId" class="form-select form-select-sm" style="max-width:240px" onchange="this.form.submit()" aria-label="@T["Technician"]">
            <option value="">@T["All technicians"]</option>
            @foreach (var t in technicians)
            {
                <option value="@t.Id" selected="@(t.Id == technicianId ? "selected" : null)">@t.Name</option>
            }
        </select>
    }
</form>

@if (seesAll && technicians.Count == 0)
{
    <div class="alert alert-warning">
        @T.Html("No user carries out maintenance jobs yet. Create a user for the maintenance engineer in <strong>System Setup &gt; Users</strong> and give them <strong>Carry Out Maintenance Jobs</strong>; new maintenance requests are then assigned to them automatically.")
    </div>
}

@if (Model.Count == 0)
{
    <div class="card shadow-sm"><div class="card-body text-muted">@T["No jobs to show."]</div></div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@T["Job"]</th>
                        <th>@T["Priority"]</th>
                        <th>@T["What"]</th>
                        <th>@T["Unit"]</th>
                        <th>@T["Tenant / raised by"]</th>
                        @if (seesAll) { <th>@T["Technician"]</th> }
                        <th>@T["Status"]</th>
                        <th class="text-end">@T["Age"]</th>
                        <th class="text-end">@T["Materials"]</th>
                        <th class="text-end">@T["Rating"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in Model)
                    {
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@job.Id" class="fw-semibold">@job.Number</a></td>
                            <td>
                                <span class="badge @(job.Priority == ServiceRequestPriorities.Urgent ? "bg-danger" : job.Priority == ServiceRequestPriorities.High ? "bg-warning text-dark" : "bg-secondary")">@job.Priority</span>
                            </td>
                            <td>
                                @job.Subject @if (!string.IsNullOrWhiteSpace(job.Category)) { <span class="text-muted small">(@job.Category)</span> }
                                @if (job.IsPaidService)
                                {
                                    <span class="badge bg-primary">@T["Paid service"]</span>
                                    if (job.PaidServiceOnHold) { <span class="badge bg-warning text-dark">@T["On hold until paid"]</span> }
                                }
                            </td>
                            <td>@job.Place</td>
                            <td>
                                @if (job.Tenant != null) { @job.Tenant }
                                else
                                {
                                    <span class="badge bg-light text-dark border">@T[ServiceRequestSources.Describe(job.Source)]</span>
                                    <div class="small text-muted">@T[MaintenancePurposes.Describe(job.Purpose)]@(job.DueDate.HasValue ? " · " + job.DueDate.Value.ToString("dd/MM/yyyy") : "")</div>
                                }
                            </td>
                            @if (seesAll) { <td>@(job.Technician ?? "not assigned")</td> }
                            <td><span class="badge @ServiceRequestStatuses.BadgeClass(job.Status)">@ServiceRequestStatuses.Describe(job.Status)</span></td>
                            <td class="text-end @(job.IsOpen && job.ResolveLate ? "text-danger fw-semibold" : "")" title="@(job.IsOpen && job.ResolveLate ? (job.IsPlanned ? T["Past its due date"] : T["Past the target time for this priority"]) : "")">@Hours(job.AgeHours)</td>
                            <td class="text-end">@(job.Materials == 0m ? "" : job.Materials.ToString("N2"))</td>
                            <td class="text-end">
                                @if (job.Rating.HasValue)
                                {
                                    <span class="badge @ServiceRequestRatings.BadgeClass(job.Rating.Value)">@job.Rating</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
