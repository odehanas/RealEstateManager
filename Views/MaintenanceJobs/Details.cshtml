@model RealEstateManager.Models.ServiceRequestDetailViewModel
@using RealEstateManager.Domain
@{
    ViewData["Title"] = $"Job {Model.RequestNumber}";
    var materials = ViewBag.Materials as List<MaintenanceMaterial> ?? new();
    var workStartedAt = ViewBag.WorkStartedAt as DateTime?;
    var seesAll = ViewBag.SeesAll as bool? ?? false;
    var technicians = ViewBag.Technicians as List<RealEstateManager.Services.MaintenanceService.Technician> ?? new();
    var chargedTo = ViewBag.ChargedTo as string ?? "the company";
    var target = MaintenanceStandards.TargetFor(Model.Priority);
    var isOpen = Model.Status is ServiceRequestStatuses.Submitted or ServiceRequestStatuses.Acknowledged or ServiceRequestStatuses.InProgress;

    string Local(DateTime? utc) => utc.HasValue ? utc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "-";
    string Since(DateTime? utc) =>
        utc.HasValue ? ((utc.Value - Model.SubmittedAt).TotalHours is var h && h < 48 ? $"{h:0.#} h after the request" : $"{(utc.Value - Model.SubmittedAt).TotalDays:0.#} days after the request") : "";
}

@if (TempData["JobSuccess"] != null) { <div class="alert alert-success">@TempData["JobSuccess"]</div> }
@if (TempData["JobError"] != null) { <div class="alert alert-danger">@TempData["JobError"]</div> }

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="mb-1">
            Job @Model.RequestNumber
            <span class="badge @ServiceRequestStatuses.BadgeClass(Model.Status) align-middle">@ServiceRequestStatuses.Describe(Model.Status)</span>
            <span class="badge @(Model.Priority == ServiceRequestPriorities.Urgent ? "bg-danger" : Model.Priority == ServiceRequestPriorities.High ? "bg-warning text-dark" : "bg-secondary") align-middle">@Model.Priority</span>
        </h2>
        <div class="text-muted">@Model.Subject @if (!string.IsNullOrWhiteSpace(Model.Category)) { <span>&middot; @Model.Category</span> }</div>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">@T["Back to jobs"]</a>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white">@T.Html("<strong>The request</strong>")</div>
            <div class="card-body">
                <p style="white-space:pre-wrap">@Model.Description</p>
                <dl class="row mb-0 small">
                    <dt class="col-sm-4">@T["Unit"]</dt><dd class="col-sm-8">@(Model.UnitDisplay ?? "-") @if (Model.PropertyName != null) { <span class="text-muted">(@Model.PropertyName)</span> }</dd>
                    <dt class="col-sm-4">@T["Tenant"]</dt><dd class="col-sm-8">@Model.TenantName @if (Model.TenantPhone != null) { <span>&middot; <a href="tel:@Model.TenantPhone">@Model.TenantPhone</a></span> }</dd>
                    <dt class="col-sm-4">@T["Preferred visit"]</dt><dd class="col-sm-8">@(Model.PreferredVisitDate?.ToString("dddd dd/MM/yyyy") ?? "any time")</dd>
                    <dt class="col-sm-4">@T["Technician"]</dt><dd class="col-sm-8">@(Model.AssignedToName ?? "not assigned")</dd>
                </dl>
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white"><strong>@T["Timeline"]</strong> <span class="text-muted small">@T.Format("target: first response within {0} h, done within {1}", target.ResponseHours, target.ResolveHours >= 48 ? $"{target.ResolveHours / 24} days" : $"{target.ResolveHours} h")</span></div>
            <ul class="list-group list-group-flush small">
                <li class="list-group-item d-flex justify-content-between"><span>@T["Requested"]</span><span>@Local(Model.SubmittedAt)</span></li>
                <li class="list-group-item d-flex justify-content-between"><span>@T["First response"]</span><span>@Local(Model.AcknowledgedAt) <span class="text-muted">@Since(Model.AcknowledgedAt)</span></span></li>
                <li class="list-group-item d-flex justify-content-between"><span>@T["Work started"]</span><span>@Local(workStartedAt) <span class="text-muted">@Since(workStartedAt)</span></span></li>
                <li class="list-group-item d-flex justify-content-between"><span>@T["Resolved"]</span><span>@Local(Model.ResolvedAt) <span class="text-muted">@Since(Model.ResolvedAt)</span></span></li>
            </ul>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white d-flex justify-content-between">
                <strong>@T["Materials used"]</strong>
                <span class="small text-muted">@T.Format("Charged to {0}", chargedTo)</span>
            </div>
            @if (materials.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead class="table-light"><tr><th>@T["Date"]</th><th>@T["Item"]</th><th>@T["From"]</th><th class="text-end">@T["Qty"]</th><th class="text-end">@T["Unit cost"]</th><th class="text-end">@T["Amount"]</th></tr></thead>
                        <tbody>
                            @foreach (var m in materials)
                            {
                                <tr>
                                    <td>@m.MaterialDate.ToString("dd/MM/yyyy")</td>
                                    <td>@m.Description</td>
                                    <td>
                                        @if (m.Source == MaintenanceMaterialSources.Stock)
                                        {
                                            <span>@T["Store"]</span>
                                            if (m.JournalEntryId.HasValue) { <a asp-controller="Documents" asp-action="Entry" asp-route-id="@m.JournalEntryId" class="small">@T["entry"]</a> }
                                        }
                                        else { <span>@T.Format("Bought ({0})", m.Reference)</span> }
                                    </td>
                                    <td class="text-end">@m.Quantity.ToString("0.###")</td>
                                    <td class="text-end">@m.UnitCost.ToString("N2")</td>
                                    <td class="text-end">@m.Amount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot><tr class="fw-semibold"><td colspan="5" class="text-end">@T["Total"]</td><td class="text-end">@materials.Sum(x => x.Amount).ToString("N2")</td></tr></tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="card-body text-muted small py-2">@T["No materials recorded."]</div>
            }
            @if (Model.Status != ServiceRequestStatuses.Closed && Model.Status != ServiceRequestStatuses.Rejected)
            {
                <form asp-action="AddMaterial" method="post" class="card-body border-top row g-2 align-items-end">
                    <input type="hidden" name="JobId" value="@Model.Id" />
                    <div class="col-md-4"><label class="form-label small mb-0" for="matDesc">@T["Item"]</label><input id="matDesc" name="Description" class="form-control form-control-sm" required maxlength="300" placeholder="@T["e.g. AC filter 24x24"]" /></div>
                    <div class="col-md-2"><label class="form-label small mb-0" for="matQty">@T["Qty"]</label><input id="matQty" name="Quantity" type="number" step="0.001" min="0.001" value="1" class="form-control form-control-sm" required /></div>
                    <div class="col-md-2"><label class="form-label small mb-0" for="matCost">@T["Unit cost"]</label><input id="matCost" name="UnitCost" type="number" step="0.01" min="0" class="form-control form-control-sm" required /></div>
                    <div class="col-md-2">
                        <label class="form-label small mb-0" for="matSource">@T["From"]</label>
                        <select id="matSource" name="Source" class="form-select form-select-sm">
                            <option value="Stock">@T["Maintenance store"]</option>
                            <option value="Purchased">@T["Bought for the job"]</option>
                        </select>
                    </div>
                    <div class="col-md-2"><label class="form-label small mb-0" for="matRef">@T["Bill / receipt"]</label><input id="matRef" name="Reference" class="form-control form-control-sm" maxlength="100" placeholder="@T["if bought"]" /></div>
                    <div class="col-12 d-flex justify-content-between align-items-center">
                        <span class="small text-muted">@T.Format("An item from the store is posted out of account {0} at once. A bought item is costed by its bill or petty cash voucher.", MaintenanceStandards.StockAccountCode)</span>
                        <button type="submit" class="btn btn-sm btn-dark">@T["Add material"]</button>
                    </div>
                </form>
            }
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white">@T.Html("<strong>Next step</strong>")</div>
            <div class="card-body">
                @if (Model.Status == ServiceRequestStatuses.Submitted)
                {
                    <form asp-action="Step" method="post" class="mb-2">
                        <input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="step" value="acknowledge" />
                        <button class="btn btn-outline-primary w-100">@T["Acknowledge — I have seen it"]</button>
                    </form>
                }
                @if (Model.Status is ServiceRequestStatuses.Submitted or ServiceRequestStatuses.Acknowledged)
                {
                    <form asp-action="Step" method="post" class="mb-2">
                        <input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="step" value="start" />
                        <button class="btn btn-primary w-100">@T["Start work"]</button>
                    </form>
                }
                @if (isOpen)
                {
                    <form asp-action="Step" method="post">
                        <input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="step" value="resolve" />
                        <label class="form-label small" for="resolveNotes">@T["What was done (the tenant reads this)"]</label>
                        <textarea id="resolveNotes" name="notes" class="form-control mb-2" rows="3" required maxlength="4000">@Model.ResolutionNotes</textarea>
                        <button class="btn btn-success w-100">@T["Mark as done"]</button>
                    </form>
                }
                @if (Model.Status == ServiceRequestStatuses.Resolved)
                {
                    <div class="small mb-2">@T.HtmlFormat("<strong>Done:</strong> {0}", Model.ResolutionNotes)</div>
                    <form asp-action="Step" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="step" value="reopen" />
                        <button class="btn btn-sm btn-outline-secondary">@T["Reopen"]</button>
                    </form>
                    @if (seesAll)
                    {
                        <form asp-action="Step" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="step" value="close" />
                            <button class="btn btn-sm btn-dark">@T["Close the job"]</button>
                        </form>
                    }
                }
                @if (Model.Status is ServiceRequestStatuses.Closed or ServiceRequestStatuses.Rejected)
                {
                    <div class="text-muted small">@T.Format("This job is {0}.", ServiceRequestStatuses.Describe(Model.Status).ToLowerInvariant())</div>
                }

                @if (seesAll && isOpen && technicians.Count > 0)
                {
                    <form asp-action="Assign" method="post" class="mt-3 pt-3 border-top d-flex gap-2">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <select name="assignTo" class="form-select form-select-sm" aria-label="@T["Assign to"]">
                            @foreach (var t in technicians)
                            {
                                <option value="@t.Id" selected="@(t.Id == Model.AssignedToAppUserId ? "selected" : null)">@t.Name</option>
                            }
                        </select>
                        <button class="btn btn-sm btn-outline-dark text-nowrap">@T["Assign"]</button>
                    </form>
                }
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-white">@T.Html("<strong>Messages</strong>")</div>
            <ul class="list-group list-group-flush small">
                @foreach (var c in Model.Comments)
                {
                    <li class="list-group-item @(c.IsInternal ? "bg-light" : "")">
                        <div class="d-flex justify-content-between text-muted">
                            <span>@c.AuthorName @if (c.IsInternal) { <span class="badge bg-secondary">@T["internal"]</span> }</span>
                            <span>@c.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</span>
                        </div>
                        <div style="white-space:pre-wrap">@c.Body</div>
                    </li>
                }
            </ul>
            <form asp-action="Note" method="post" class="card-body border-top">
                <input type="hidden" name="id" value="@Model.Id" />
                <textarea name="body" class="form-control form-control-sm mb-2" rows="2" required maxlength="4000" placeholder="@T["e.g. Visited, compressor needs replacing, parts ordered"]" aria-label="@T["Message"]"></textarea>
                <div class="d-flex justify-content-between align-items-center">
                    <div class="form-check small">
                        <input class="form-check-input" type="checkbox" name="isInternal" value="true" id="internalNote" checked />
                        <label class="form-check-label" for="internalNote">@T["Internal (the tenant does not see it)"]</label>
                    </div>
                    <button class="btn btn-sm btn-outline-dark">@T["Add"]</button>
                </div>
            </form>
        </div>
    </div>
</div>
