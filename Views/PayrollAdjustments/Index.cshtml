@model RealEstateManager.Models.PayrollAdjustmentListViewModel
@using RealEstateManager.Domain

@{
    ViewData["Title"] = "Payroll Transactions";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
    <div>
        <h2 class="mb-0">Payroll Transactions</h2>
        <div class="text-muted">Additions and deductions per employee. Approved ones are paid by the next payroll; draft payrolls update by themselves.</div>
    </div>
    <a asp-controller="Attendance" asp-action="Month" class="btn btn-outline-dark">Generate from attendance</a>
</div>

@if (TempData["HrSuccess"] is string ok) { <div class="alert alert-success">@ok</div> }
@if (TempData["HrError"] is string err) { <div class="alert alert-danger">@err</div> }

<div class="card shadow-sm mb-3">
    <div class="card-header bg-light"><h5 class="mb-0">New transaction</h5></div>
    <div class="card-body">
        <form asp-action="Create" method="post" class="row g-2 align-items-end" id="new-adjustment">
            @Html.AntiForgeryToken()
            <div class="col-md-3">
                <label class="form-label">Employee</label>
                <select asp-for="NewAdjustment.EmployeeId" asp-items="Model.Employees" class="form-select"><option value="">Choose</option></select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Date</label>
                <input asp-for="NewAdjustment.Date" type="date" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Kind</label>
                <select asp-for="NewAdjustment.Category" class="form-select" id="adj-category">
                    <optgroup label="Additions">
                        @foreach (var c in PayrollAdjustmentCategories.All.Where(x => x.IsAddition)) { <option value="@c.Key" data-unit="@c.Unit">@c.Name</option> }
                    </optgroup>
                    <optgroup label="Deductions">
                        @foreach (var c in PayrollAdjustmentCategories.All.Where(x => !x.IsAddition)) { <option value="@c.Key" data-unit="@c.Unit">@c.Name</option> }
                    </optgroup>
                </select>
            </div>
            <div class="col-md-2" id="adj-qty">
                <label class="form-label" id="adj-qty-label">Hours</label>
                <input asp-for="NewAdjustment.Quantity" class="form-control" />
            </div>
            <div class="col-md-2" id="adj-amount">
                <label class="form-label">Amount</label>
                <input asp-for="NewAdjustment.Amount" class="form-control" />
            </div>
            <div class="col-md-6"><label class="form-label">Description</label><input asp-for="NewAdjustment.Description" class="form-control" placeholder="e.g. Penalty for damaged equipment, memo HR-12" /></div>
            <div class="col-md-3">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="approveNow" value="true" id="approveNow" />
                    <label class="form-check-label" for="approveNow">Approve now</label>
                </div>
            </div>
            <div class="col-md-3"><button class="btn btn-dark w-100">Save</button></div>
            <div class="col-12 small text-muted">
                Overtime is priced at the overtime rate on the basic hourly wage (basic ÷ 30 ÷ daily hours); late minutes at that wage;
                unauthorised absence reduces the days paid, so it comes off the whole fixed salary.
            </div>
        </form>
    </div>
</div>

<form method="get" class="row g-2 mb-2">
    <div class="col-md-2">
        <select name="status" class="form-select" onchange="this.form.submit()">
            @foreach (var s in new[] { "Open", PayrollAdjustmentStatuses.Pending, PayrollAdjustmentStatuses.Approved, PayrollAdjustmentStatuses.Rejected, "All" })
            {
                <option value="@s" selected="@(s == Model.Status)">@(s == "Open" ? "Not yet paid" : s)</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <select name="employeeId" asp-items="Model.Employees" class="form-select" onchange="this.form.submit()">
            <option value="">All employees</option>
        </select>
    </div>
    <div class="col-md-2"><input type="month" name="month" value="@Model.Month" class="form-control" onchange="this.form.submit()" /></div>
</form>

<form method="post" id="bulk">
    @Html.AntiForgeryToken()
    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width:32px"><input type="checkbox" onclick="document.querySelectorAll('.pick').forEach(c => c.checked = this.checked)" /></th>
                    <th>Date</th><th>Employee</th><th>Kind</th><th class="text-end">Quantity</th><th class="text-end">Value</th>
                    <th>Description</th><th>Source</th><th>Status</th><th>Payroll</th><th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Adjustments.Count == 0) { <tr><td colspan="11" class="text-muted">Nothing here.</td></tr> }
                @foreach (var a in Model.Adjustments)
                {
                    var def = PayrollAdjustmentCategories.Get(a.Category);
                    var paid = a.PayrollRun != null && a.PayrollRun.Status != PayrollRunStatuses.Draft;
                    <tr>
                        <td>@if (!paid) { <input type="checkbox" class="pick" name="ids" value="@a.Id" /> }</td>
                        <td>@a.Date.ToString("dd/MM/yyyy")</td>
                        <td>@a.Employee?.EmployeeCode @a.Employee?.FullName</td>
                        <td><span class="badge @(def.IsAddition ? "bg-success" : "bg-danger")">@(def.IsAddition ? "+" : "−")</span> @def.Name</td>
                        <td class="text-end">@(def.Unit == PayrollAdjustmentCategories.Money ? "" : $"{a.Quantity:0.##} {def.Unit}")</td>
                        <td class="text-end">@(Model.Values.TryGetValue(a.Id, out var v) ? v.ToString("N2") : "")</td>
                        <td class="small">@a.Description</td>
                        <td class="small">@a.Source</td>
                        <td>@a.Status @if (a.DecidedByName != null) { <div class="small text-muted">@a.DecidedByName</div> }</td>
                        <td class="small">@(a.PayrollRun == null ? "Waiting" : $"{a.PayrollRun.RunNumber} ({a.PayrollRun.Status})")</td>
                        <td>
                            @if (!paid)
                            {
                                <button class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@a.Id" onclick="return confirm('Remove this transaction?');">Remove</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-success" asp-action="Approve">Approve selected</button>
        <button class="btn btn-outline-danger" asp-action="Reject">Reject selected</button>
    </div>
</form>

<script>
    (function () {
        const cat = document.getElementById('adj-category');
        const qty = document.getElementById('adj-qty'), amount = document.getElementById('adj-amount'), label = document.getElementById('adj-qty-label');
        function sync() {
            const unit = cat.selectedOptions[0].dataset.unit;
            const money = unit === 'amount';
            qty.style.display = money ? 'none' : '';
            amount.style.display = money ? '' : 'none';
            label.textContent = unit.charAt(0).toUpperCase() + unit.slice(1);
        }
        cat.addEventListener('change', sync); sync();
    })();
</script>
